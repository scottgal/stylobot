<Project>

  <!-- Shared metadata for all NuGet packages in this solution -->
  <PropertyGroup>
    <Authors>Scott Galloway</Authors>
    <Company>Mostlylucid</Company>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/scottgal/stylobot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scottgal/stylobot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) Scott Galloway</Copyright>
  </PropertyGroup>

  <!-- Common build settings -->
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CA code-quality analyzers stay at warning (see the root .editorconfig) and
         are never promoted to build-breaking errors, even in projects that set
         TreatWarningsAsErrors (e.g. StyloExtract). Real compiler warnings (CSxxxx)
         are unaffected. This is what lets a clean build on SDK 10.0.201 succeed
         without -p:RunAnalyzers=false. -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Shared icon for all packages (only included when packing) -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' OR '$(PackAsTool)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Link="icon.png" Visible="false" />
  </ItemGroup>

  <!-- Ensure test projects are never packable -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
