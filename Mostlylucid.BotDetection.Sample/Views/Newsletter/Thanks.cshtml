@{
    ViewData["Title"] = "Thanks";
    var real = (bool)(ViewBag.Real ?? false);
}
<div class="text-center" style="padding:3rem 1rem;">
    <div style="font-size:4rem;margin-bottom:1rem;">&#10003;</div>
    @if (real)
    {
        <h1>You're subscribed!</h1>
        <p class="muted mb-2">Check your inbox for a confirmation email.</p>
    }
    else
    {
        @*
            Bots see the same success page as real users.
            There is no way for the bot to know the submission was discarded.
        *@
        <h1>Thank you!</h1>
        <p class="muted mb-2">We'll be in touch.</p>
    }
    <a href="/" class="btn btn-primary">Back to shop</a>
</div>
