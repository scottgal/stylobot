@{
    ViewData["Title"] = "Newsletter";
    ViewBag.PageContext = "AI bots see a data-licensing message; other bots see a warning; humans see the pitch.";
}

@*
    NEWSLETTER PAGE - demonstrates:
      <sb-honeypot>    protects the subscribe form
      <sb-human>       only humans see the subscription pitch
      <sb-bot>         bots see a different (non-committal) message
      <sb-gate>        AI bot-specific message
      Server-side:     NewsletterController silently accepts bot submissions
                       without adding the address to the real mailing list
*@

<div style="max-width:520px;margin:2rem auto;">
    <h1 class="mb-1">&#128140; Newsletter</h1>

    @*
        Human pitch: shown only to real visitors.
        Keep marketing copy away from scrapers.
    *@
    <sb-human>
        <p class="muted mb-2">
            Get exclusive deals, new arrivals, and discount codes delivered straight to
            your inbox. Subscribe below &mdash; unsubscribe any time.
        </p>
    </sb-human>

    @*
        AI scrapers sometimes harvest email subscription endpoints to build datasets.
        Show them a polite, non-committing message.
    *@
    <sb-gate bot-type="AiBot">
        <div class="alert alert-info mb-2">
            This email subscription endpoint is for human readers.
            For data licensing enquiries please contact us directly.
        </div>
    </sb-gate>

    @*
        Generic bot message for non-AI automated clients.
    *@
    <sb-bot>
        <sb-gate bot-type="AiBot" negate="true">
            <div class="alert alert-warning mb-2">
                &#9888; Automated subscription attempts are discarded.
            </div>
        </sb-gate>
    </sb-bot>

    <div class="card">
        <form method="post" action="/Newsletter/Subscribe">
            @Html.AntiForgeryToken()

            @*
                Three honeypot trap fields here because newsletter forms are a common
                target for spam bots that harvest email lists.
            *@
            <sb-honeypot prefix="nl" fields="3"></sb-honeypot>

            <div class="form-group">
                <label for="email">Your email address</label>
                <input type="email" id="email" name="email"
                       placeholder="you@example.com" autocomplete="email" />
            </div>
            <button type="submit" class="btn btn-success" style="width:100%;">
                Subscribe
            </button>
        </form>
    </div>

    <div class="muted text-center mt-2" style="font-size:0.75rem;">
        Protected by StyloBot. Spam bots are silently discarded with no error feedback.
    </div>
</div>
