@{
    ViewData["Title"] = "My Detection Profile";
    ViewBag.PageContext = "Live view of every signal StyloBot used to classify this request.";
}

@*
    MY DETECTION PAGE - demonstrates:
      <bot-detection-details>   full detection details panel (ViewComponent)
      <sb-summary variant="card"> compact detection card
      <sb-confidence display="both"> bar + text combined
      <sb-risk-pill>            risk band pill
      <sb-badge variant="full"> full badge (icon + label + risk)
      HttpContext extension methods exposed via ViewBag
*@

<h1 class="mb-1">&#128100; My Detection Profile</h1>
<p class="muted mb-3">
    This page shows how StyloBot has classified your current request.
    Use <code>ml-bot-test-mode</code> header to simulate different bot types.
</p>

@*
    <bot-detection-details> renders the full detection details panel.
    It includes: badge, confidence bar, risk band, top reasons list,
    and an expandable detector contributions table.
    collapsed="false" starts it expanded.
*@
<bot-detection-details collapsed="false"></bot-detection-details>

<hr style="margin:2rem 0;border:none;border-top:1px solid #dee2e6;" />
<h2>Tag Helper Showcase</h2>

<div class="grid-2 mb-3">
    <div>
        <div class="card">
            <div class="mb-1"><strong>sb-summary (card variant)</strong></div>
            <sb-summary variant="card"></sb-summary>
        </div>
    </div>
    <div>
        <div class="card">
            <div class="mb-1"><strong>sb-confidence (bar + text)</strong></div>
            <sb-confidence display="both" width="100%"></sb-confidence>

            <div style="margin-top:1rem;" class="mb-1"><strong>sb-risk-pill</strong></div>
            <sb-risk-pill></sb-risk-pill>

            <div style="margin-top:1rem;" class="mb-1"><strong>sb-badge (full)</strong></div>
            <sb-badge variant="full"></sb-badge>
        </div>
    </div>
</div>

@* -----------------------------------------------------------------------
   Gate demos: visible indicators of which gates are open for this request
   ----------------------------------------------------------------------- *@
<h2 class="mb-2">Gate Status for Your Session</h2>
<div class="card mb-3">
    <table>
        <thead>
            <tr>
                <th>Tag helper</th>
                <th>Attributes</th>
                <th>Visible to you?</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>&lt;sb-human&gt;</code></td>
                <td>default fallback="show"</td>
                <td>
                    <sb-human><span style="color:#16a34a;">&#10003; YES</span></sb-human>
                    <sb-bot><span style="color:#dc2626;">&#10007; NO</span></sb-bot>
                </td>
            </tr>
            <tr>
                <td><code>&lt;sb-bot&gt;</code></td>
                <td>default fallback="hide"</td>
                <td>
                    <sb-bot fallback="show"><span style="color:#16a34a;">&#10003; YES</span></sb-bot>
                    <sb-human><span style="color:#dc2626;">&#10007; NO</span></sb-human>
                </td>
            </tr>
            <tr>
                <td><code>&lt;sb-gate max-risk="Low"&gt;</code></td>
                <td>max-risk="Low"</td>
                <td>
                    <sb-gate max-risk="Low"><span style="color:#16a34a;">&#10003; YES</span></sb-gate>
                    <sb-gate min-risk="Medium"><span style="color:#dc2626;">&#10007; NO</span></sb-gate>
                </td>
            </tr>
            <tr>
                <td><code>&lt;sb-gate min-risk="Medium"&gt;</code></td>
                <td>min-risk="Medium"</td>
                <td>
                    <sb-gate min-risk="Medium"><span style="color:#16a34a;">&#10003; YES</span></sb-gate>
                    <sb-gate max-risk="Low"><span style="color:#dc2626;">&#10007; NO</span></sb-gate>
                </td>
            </tr>
            <tr>
                <td><code>&lt;sb-gate bot-type="SearchEngine"&gt;</code></td>
                <td>bot-type="SearchEngine"</td>
                <td>
                    <sb-gate bot-type="SearchEngine"><span style="color:#16a34a;">&#10003; YES</span></sb-gate>
                    <sb-gate bot-type="SearchEngine" negate="true"><span style="color:#dc2626;">&#10007; NO</span></sb-gate>
                </td>
            </tr>
            <tr>
                <td><code>&lt;sb-signal&gt;</code></td>
                <td>signal="ip.is_datacenter" condition="true"</td>
                <td>
                    <sb-signal signal="ip.is_datacenter" condition="true">
                        <span style="color:#16a34a;">&#10003; YES (datacenter IP)</span>
                    </sb-signal>
                    <sb-signal signal="ip.is_datacenter" condition="false">
                        <span style="color:#dc2626;">&#10007; NO (residential IP)</span>
                    </sb-signal>
                </td>
            </tr>
        </tbody>
    </table>
</div>

@* -----------------------------------------------------------------------
   HttpContext extension methods — raw values from ViewBag
   ----------------------------------------------------------------------- *@
<h2 class="mb-2">HttpContext Extension Values</h2>
<div class="card">
    <table>
        <thead>
            <tr><th>Method</th><th>Value</th></tr>
        </thead>
        <tbody>
            <tr><td><code>context.IsBot()</code></td>
                <td>@(ViewBag.IsBot ? "true" : "false")</td></tr>
            <tr><td><code>context.IsHuman()</code></td>
                <td>@(ViewBag.IsHuman ? "true" : "false")</td></tr>
            <tr><td><code>context.IsVerifiedBot()</code></td>
                <td>@(ViewBag.IsVerifiedBot ? "true" : "false")</td></tr>
            <tr><td><code>context.IsSearchEngineBot()</code></td>
                <td>@(ViewBag.IsSearchEngine ? "true" : "false")</td></tr>
            <tr><td><code>context.GetBotProbability()</code></td>
                <td>@(((double)ViewBag.Probability).ToString("P1"))</td></tr>
            <tr><td><code>context.GetBotConfidence()</code></td>
                <td>@(((double)ViewBag.Confidence).ToString("P1"))</td></tr>
            <tr><td><code>context.GetRiskBand()</code></td>
                <td>@ViewBag.RiskBand</td></tr>
            <tr><td><code>context.GetBotType()</code></td>
                <td>@ViewBag.BotType</td></tr>
            <tr><td><code>context.GetBotName()</code></td>
                <td>@ViewBag.BotName</td></tr>
        </tbody>
    </table>

    @if (((List<string>)ViewBag.Reasons).Count > 0)
    {
        <div style="margin-top:1rem;">
            <strong>Detection reasons:</strong>
            <ul style="margin-top:.5rem;padding-left:1.25rem;font-size:.875rem;color:#374151;">
                @foreach (var reason in (List<string>)ViewBag.Reasons)
                {
                    <li>@reason</li>
                }
            </ul>
        </div>
    }
</div>

<div class="muted mt-2" style="font-size:.8rem;">
    Tip: send <code>ml-bot-test-mode: googlebot</code> header to simulate a search engine,
    or <code>ml-bot-test-mode: scraper</code> to simulate a malicious bot.
    Both modes require <code>EnableTestMode: true</code> in appsettings.json.
</div>
