<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.BotDetection.Api</PackageId>
        <MinVerTagPrefix>botdetection-v</MinVerTagPrefix>
        <Authors>Mostlylucid</Authors>
        <Description>StyloBot Public REST API for bot detection and dashboard data.</Description>
        <!-- Endpoint handler XML doc comments feed the generated OpenAPI document's
             summary/description fields (via Microsoft.AspNetCore.OpenApi); without this,
             they're inert prose that never reaches /api/v1/openapi.json. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- Source-generate the Minimal API request delegates so RequestDelegateFactory
             doesn't reflect over endpoint signatures at startup. Required for Native AOT:
             without it, the host throws NotSupportedException trying to resolve JsonTypeInfo
             for the Task<Ok<T>> wrapper around each handler. -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mostlylucid.BotDetection\Mostlylucid.BotDetection.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.UI\Mostlylucid.BotDetection.UI.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.Llm.Tunnel\Mostlylucid.BotDetection.Llm.Tunnel.csproj" />
        <!-- Direct refs for types that Api RE-EXPORTS through its public surface (via UI)
             but only reached transitively. Without these, a project that references Api
             directly (e.g. the commercial test suite) fails with CS0012 — "the type is
             defined in an assembly that is not referenced" — because the leaked types'
             assemblies aren't in Api's own reference closure. Making them direct
             references flows them to Api's consumers. Mostlylucid.BotDetection.OpenApi
             is the FOSS project (distinct from the Microsoft.OpenApi package below);
             Mostlylucid.Ephemeral.Atoms.Taxonomy comes in via the core lib. -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.OpenApi\Mostlylucid.BotDetection.OpenApi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
      <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
      <!-- See the OpenApi ProjectReference note above: Api's public surface exposes
           Ephemeral.Atoms.Taxonomy types transitively; pin the direct ref so consumers
           of Api don't hit CS0012. Version matches the core lib's pin. -->
      <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Taxonomy" Version="2.10.0" />
    </ItemGroup>

</Project>
