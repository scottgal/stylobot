<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StyloBot Trailblazor Demo</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { font-family: -apple-system, system-ui, sans-serif; max-width: 880px; margin: 2rem auto; padding: 0 1.5rem; line-height: 1.5; color: #1f2937; }
        h1 { margin-top: 0; }
        h2 { margin-top: 2rem; border-bottom: 1px solid #e5e7eb; padding-bottom: 0.25rem; }
        nav.topbar { display: flex; gap: 1rem; align-items: center; padding-bottom: 1rem; border-bottom: 1px solid #e5e7eb; margin-bottom: 1.5rem; }
        nav.topbar a { text-decoration: none; color: #1f2937; }
        nav.topbar a:hover { text-decoration: underline; }
        .sb-risk-pill { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600; background: #e5e7eb; color: #374151; }
        .sb-risk-pill--verylow, .sb-risk-pill--low { background: #d1fae5; color: #065f46; }
        .sb-risk-pill--elevated { background: #fef3c7; color: #92400e; }
        .sb-risk-pill--medium { background: #fed7aa; color: #9a3412; }
        .sb-risk-pill--high, .sb-risk-pill--veryhigh { background: #fecaca; color: #991b1b; }
        .sb-risk-pill--unknown { background: #e5e7eb; color: #6b7280; }
        .demo-controls { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 0.5rem; padding: 0.75rem 1rem; margin: 1rem 0; font-size: 0.9rem; }
        .demo-controls a { display: inline-block; margin: 0.15rem 0.4rem 0.15rem 0; padding: 0.25rem 0.75rem; background: #1f2937; color: white; border-radius: 0.25rem; text-decoration: none; font-size: 0.85rem; }
        .demo-controls a:hover { background: #374151; }
        .demo-controls a.reset { background: #6b7280; }
        form { margin: 1rem 0; padding: 1rem; background: #f9fafb; border-radius: 0.5rem; }
        form input[type=email] { width: 100%; padding: 0.5rem; margin: 0.5rem 0; border: 1px solid #d1d5db; border-radius: 0.25rem; box-sizing: border-box; }
        form button { padding: 0.5rem 1rem; background: #1f2937; color: white; border: none; border-radius: 0.25rem; cursor: pointer; }
        .alert { padding: 0.75rem 1rem; border-radius: 0.5rem; margin: 1rem 0; }
        .alert-warning { background: #fef3c7; border: 1px solid #fcd34d; color: #92400e; }
        code { background: #f3f4f6; padding: 0.1rem 0.3rem; border-radius: 0.25rem; font-size: 0.9em; }
    </style>
</head>
<body>
    <aside class="aspnet-demo-banner" style="background:#0b1220;color:#e5e7eb;font-size:0.78rem;padding:0.5rem 1rem;border-bottom:1px solid #1f2937;display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;font-family:-apple-system,system-ui,sans-serif;">
        <span>Live demo of stylobot in ASP.NET middleware mode with SQLite storage.</span>
        <span style="color:#6b7280;">|</span>
        <span>Source on <a href="https://github.com/scottgal/stylobot" rel="noopener" style="color:#7cd9a8;">GitHub</a>.</span>
        <span style="color:#6b7280;">|</span>
        <span>Want the paid pack? See <a href="https://stylo.bot/packs/aspnet" rel="noopener" style="color:#7cd9a8;">stylo.bot/packs/aspnet</a>.</span>
    </aside>
    <header>
        <nav class="topbar">
            <strong><a asp-controller="Home" asp-action="Index">StyloBot Demo</a></strong>
            <a asp-controller="Home" asp-action="Signals" style="font-size: 0.9rem;">All signals</a>
            <a href="/sitemap.xml" style="font-size: 0.9rem;">Adaptive sitemap</a>
            <span style="margin-left: auto; font-size: 0.85rem; color: #6b7280;">Your verdict:</span>
            <sb-risk-pill />
            <a href="/_stylobot" style="font-size: 0.85rem;">Dashboard</a>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer style="margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e5e7eb; font-size: 0.85rem; color: #6b7280;">
        StyloBot middleware demo. FOSS, no gateway, no third-party calls.
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
    <bot-detection-script />
</body>
</html>