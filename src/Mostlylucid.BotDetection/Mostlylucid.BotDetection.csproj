<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <PackageId>mostlylucid.botdetection</PackageId>
        <Authors>Scott Galloway</Authors>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/scottgal/stylobot</RepositoryUrl>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <PackageTags>bot-detection;middleware;aspnetcore;security;crawler;web</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>
            Enterprise bot detection and anonymous entity resolution for ASP.NET Core — the detection engine behind StyloBot (https://stylo.bot). Probabilistic and behavioural, not just User-Agent matching: UA/header/IP analysis, JA3/JA4/HTTP2/QUIC/TCP-IP fingerprinting, Leiden cluster discovery, 129-dim Markov session vectors, metastable fingerprint identity, and optional LLM classification. Zero-PII (HMAC-SHA256), SQLite-backed, single-call UseStyloBot() setup.
        </Description>
        <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/ReleaseNotes.txt"))</PackageReleaseNotes>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Emit XML doc file next to the DLL. SignalCatalog reflects SignalKeys at
             runtime AND reads this XML for descriptions; without it, SignalDescriptor.Short
             / Long stay empty. CS1591 is suppressed broadly because the public surface
             far predates the catalog and we don't want a churn-the-world XML-doc commit. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- NU5104: Mostlylucid.Common is a sibling project ref whose Debug MinVer build
             stamps an alpha SemVer; the pack step then flags the dep range as prerelease.
             Harmless: Release builds with synced MinVer tags produce stable versions. -->
        <NoWarn>$(NoWarn);CS1591;NU5104</NoWarn>

        <!-- AOT/trim posture: every own-code call site is either source-generated or
             explicitly annotated with [RequiresUnreferencedCode] / [RequiresDynamicCode] /
             UnconditionalSuppressMessage at the function that opts into reflective behaviour
             (LLM coordinators, anomaly export, signal projection, GeoLocation duck-typing).
             AOT publish of the Sidecar is clean of own-code IL warnings; the remaining ~11
             warnings are third-party (Serilog single-file warnings, VYaml rollup, IL3000 on
             Serilog.Settings.Configuration). -->
        <IsTrimmable>false</IsTrimmable>
        <!-- Source-generate the IConfiguration -> TOptions binders so BindConfiguration<T>
             and Configure<T> calls don't require RequiresDynamicCode at runtime. Kills the
             ~25 IL2026 / IL3050 warnings the Options binder would otherwise emit per AOT
             publish. Introduced in .NET 8. -->
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <UserSecretsId>0c2c1992-7d5d-4581-ada1-8af3d1aee8fc</UserSecretsId>
    </PropertyGroup>
    <PropertyGroup>
        <MinVerTagPrefix>botdetection-v</MinVerTagPrefix>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Mostlylucid.BotDetection.Test" />
        <InternalsVisibleTo Include="Mostlylucid.BotDetection.Orchestration.Tests" />
        <InternalsVisibleTo Include="Mostlylucid.BotDetection.Benchmarks" />
        <!-- Commercial durability tests assert on WriteBehindLfuStore.FlushDirtyAsync
             (a durability barrier that throws on persist failure). Exposed per overview's
             request so the commercial suite can flush deterministically. -->
        <InternalsVisibleTo Include="Stylobot.Commercial.IntegrationTests" />
        <!-- DetectionBroadcastMiddleware uses FingerprintNameComposer as a request-path
             backstop when evidence.PrimaryBotName is null (matcher race against
             UserAgentContributor leaving signals[ua.raw] unset). Same composer, just
             one more call site with the raw UA from HttpContext threaded in. -->
        <InternalsVisibleTo Include="Mostlylucid.BotDetection.UI" />
    </ItemGroup>
    <PropertyGroup>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" Version="1.5.1" />
        <!-- LLM packages moved to Mostlylucid.BotDetection.Llm.Ollama / LlamaSharp projects -->
        <PackageReference Include="MessagePack" Version="3.1.7" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
        <!-- StyloFlow: NuGet package references -->
        <PackageReference Include="Mostlylucid.StyloFlow.Core" Version="2.8.1" />
        <PackageReference Include="Mostlylucid.StyloFlow.Retrieval.Core" Version="2.8.1" />
        <!-- Ephemeral: Core signal/coordination infrastructure (NuGet packages) -->
        <PackageReference Include="Mostlylucid.Ephemeral" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Taxonomy" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.KeyedSequential" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.SlidingCache" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Batching" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Llm" Version="2.10.0" />
        <!-- Session rearchitecture (signals + compression): SiteCoordinator composition -->
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Escalator" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Echo" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Data.Sqlite" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Taxonomy.Coordinator" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Molecules" Version="2.10.0" />
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Signalaware" Version="2.10.0" />
        <PackageReference Include="HNSW" Version="26.6.1848" />
        <PackageReference Include="System.Numerics.Tensors" Version="10.0.9" />
        <!-- NSec.Cryptography: native Ed25519 / X25519 / ChaCha20-Poly1305 -->
        <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
        <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
        <PackageReference Include="Microsoft.Recognizers.Text" Version="1.8.13" />
        <PackageReference Include="Microsoft.Recognizers.Text.DateTime" Version="1.8.13" />
        <PackageReference Include="Microsoft.Recognizers.Text.Sequence" Version="1.8.13" />
        <!-- Override transitive NuGet.CommandLine pulled in by Microsoft.Recognizers.Text 1.8.13
             (it drags in 5.11.5 which has a critical GHSA-68w7-72jg-6qpp advisory). NuGet.CommandLine
             is a build-tool binary we don't execute at runtime; pinning to 7.3.1 clears the alert
             without affecting any shipped code. PrivateAssets=all stops this leaking into consumers. -->
        <PackageReference Include="NuGet.CommandLine" Version="7.6.0" PrivateAssets="all" />
        <!-- VYaml: AOT-native YAML parser via source generation. Replaced YamlDotNet +
             Vecc.YamlDotNet.Analyzers.StaticGenerator after the latter failed silently
             on init-only properties (CS8852 in generator output). VYaml's [YamlObject]
             generates object-initializer-style construction so init/required are first
             class. ~6x faster, ~1/50 heap allocations vs YamlDotNet. -->
        <PackageReference Include="VYaml" Version="1.4.0" />
        <PackageReference Include="MinVer" Version="7.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Mostlylucid.Common" Version="8.0.0-alpha2" />
    </ItemGroup>

    <ItemGroup>
        <None Include="ReleaseNotes.txt" />
        <Content Include="docs\ai-detection.md" />
    </ItemGroup>

    <!-- Embed JS files as resources for served-endpoint delivery -->
    <ItemGroup>
        <EmbeddedResource Include="ClientSide\botdetection.js" />
        <EmbeddedResource Include="ClientSide\challenge.js" />
    </ItemGroup>

    <!-- Embed policy definition YAML files -->
    <ItemGroup>
        <EmbeddedResource Include="Definitions\Actions\*.yaml" />
        <EmbeddedResource Include="Definitions\BotPatterns\*.yaml" />
        <EmbeddedResource Include="Definitions\RegistryClients\*.yaml" />
        <EmbeddedResource Include="Definitions\Webhooks\*.yaml" />
        <EmbeddedResource Include="Definitions\IdentityArchetypes\*.yaml" />
        <EmbeddedResource Include="Definitions\BrowserModes\*.yaml" />
        <EmbeddedResource Include="Definitions\VendorHomeHosts\*.yaml" />
        <EmbeddedResource Include="Definitions\TlsReference\*.yaml" />
        <EmbeddedResource Include="Definitions\PolicyFacets\*.yaml" />
        <EmbeddedResource Include="Definitions\WellKnownBots\*.json" />
        <EmbeddedResource Include="Data\UserAgents\*.yaml" />
        <EmbeddedResource Include="Data\Schema\*.sql">
            <LogicalName>Mostlylucid.BotDetection.Data.Schema.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Embed detector and pipeline YAML manifests -->
    <ItemGroup>
        <EmbeddedResource Include="Orchestration\Manifests\detectors\*.yaml" />
        <EmbeddedResource Include="Orchestration\Manifests\pipelines\*.yaml" />
        <EmbeddedResource Include="Orchestration\Manifests\entities\*.yaml" />
        <EmbeddedResource Include="Orchestration\Manifests\schemas\*.json" />
        <EmbeddedResource Include="Orchestration\Manifests\proxy-headers.yaml" />
    </ItemGroup>

    <!-- Embed simulation pack YAML definitions.
         LogicalName is explicit (not relying on the SDK's default
         {RootNamespace}.{TransformedPath}.{Filename} convention) because a
         sibling glob below also has a `wordpress.yaml` file. Both end up
         under different manifest namespaces matching SimulationPackLoader's
         resource-prefix filter (`Mostlylucid.BotDetection.SimulationPacks.Packs.`). -->
    <ItemGroup>
        <EmbeddedResource Include="SimulationPacks\Packs\*.yaml" LogicalName="Mostlylucid.BotDetection.SimulationPacks.Packs.%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Embed site profile YAML definitions.
         Mirrors the pattern above; SiteProfileLoader filters by the
         ".SiteProfiles.Profiles." substring. -->
    <ItemGroup>
        <EmbeddedResource Include="SiteProfiles\Profiles\*.yaml" LogicalName="Mostlylucid.BotDetection.SiteProfiles.Profiles.%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Embed compliance pack YAML definitions -->
    <ItemGroup>
        <EmbeddedResource Include="Compliance\CompliancePacks\*.yaml" />
    </ItemGroup>

    <!-- Embed signal overlay YAML definitions (SignalCatalog enriches reflected
         SignalKeys constants with operator constraints, value domains, and
         worked examples from these files). -->
    <ItemGroup>
        <EmbeddedResource Include="Policies\Signals\Overlays\*.yaml" />
    </ItemGroup>

    <!-- Embed seed policy rule YAML files (YamlPolicyRuleStore loads these at
         boot so the FOSS dashboard has rules to render out of the box). -->
    <ItemGroup>
        <EmbeddedResource Include="Policies\Rules\SeedRules\*.yaml" />
    </ItemGroup>

    <!-- Embed canonical template catalog YAML files (T1). YamlTemplateStore
         loads these at boot so every host has the FOSS template catalog
         available without a separate distribution step. -->
    <ItemGroup>
        <EmbeddedResource Include="Policies\Templates\Catalog\*.yaml" />
    </ItemGroup>

    <!-- Embed forward-only SQL schema patches for the SQLite policy decision
         log. SqlitePolicyDecisionLog.InitialiseSchema applies the initial
         CREATE TABLE inline then applies these patches, swallowing the
         duplicate-column error so each patch is idempotent. -->
    <ItemGroup>
        <EmbeddedResource Include="Policies\Decisions\Schema\*.sql" />
    </ItemGroup>

    <!-- Embed the Public Suffix List (publicsuffix.org). DomainNormalizer reads
         this at startup to derive eTLD+1 for cross-subdomain grouping so that
         request-scope Domain values match across www./api./m. hosts. Refresh
         by re-downloading Domains/PublicSuffixList.dat from
         https://publicsuffix.org/list/public_suffix_list.dat . -->
    <ItemGroup>
        <EmbeddedResource Include="Domains\PublicSuffixList.dat" />
    </ItemGroup>

    <!-- Include README in NuGet package (icon comes from Directory.Build.props shared root) -->
    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>

    <!-- Exclude docs folder from NuGet package -->
    <ItemGroup>
        <Content Remove="docs\**" />
    </ItemGroup>
</Project>
