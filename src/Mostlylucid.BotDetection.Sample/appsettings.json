{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BotDetection": {
    "DatabasePath": "botdetection.db",
    "BotThreshold": 0.65,
    "EnableTestMode": true,
    "TestModeSimulations": {
      "human": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0.0.0",
      "scraper": "Scrapy/2.5.0 (+https://scrapy.org)",
      "googlebot": "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)",
      "malicious": "masscan/1.0 (https://github.com/robertdavidgraham/masscan)"
    },
    "ApiKeys": {
      "dev-dashboard-cli": {
        "Name": "Remote Dashboard CLI (dev)",
        "AllowedPaths": [ "/_stylobot/**", "/stylobot/hub" ],
        "RateLimitPerMinute": 120
      }
    }
  }
}
