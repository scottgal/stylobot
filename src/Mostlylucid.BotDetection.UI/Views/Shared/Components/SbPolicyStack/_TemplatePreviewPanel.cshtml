@using Mostlylucid.BotDetection.UI.Models
@model TemplatePreviewViewModel

<div class="sb-template-preview-panel" data-template-id="@Model.TemplateId" data-scope="@Model.Scope">
    <h4 class="sb-template-preview-heading">
        Would add @Model.AddedRules.Count rule(s) at scope @Model.Scope
    </h4>

    @if (Model.Conflicts.Count > 0)
    {
        <details class="sb-template-conflict-list" open>
            <summary class="sb-template-warn">
                @Model.Conflicts.Count existing rule(s) would become shadowed by this template.
            </summary>
            <ul class="sb-template-conflict-pairs">
                @foreach (var pair in Model.Conflicts)
                {
                    <li class="sb-template-conflict-pair">
                        <span class="sb-template-conflict-template">Template adds #@pair.TemplateRule.Priority @pair.TemplateRule.ActionDisplay (@pair.TemplateRule.ModeDisplay)</span>
                        <span class="sb-template-conflict-arrow" aria-hidden="true">&darr; shadows &darr;</span>
                        <span class="sb-template-conflict-existing">Existing #@pair.ExistingRule.Priority @pair.ExistingRule.ActionDisplay (@pair.ExistingRule.ModeDisplay)</span>
                    </li>
                }
            </ul>
        </details>
    }

    @if (Model.Shadowed.Count > 0)
    {
        <details class="sb-template-conflict-list" open>
            <summary class="sb-template-warn">
                @Model.Shadowed.Count rule(s) inside this template are already shadowed by your existing stack.
            </summary>
            <ul class="sb-template-conflict-pairs">
                @foreach (var r in Model.Shadowed)
                {
                    <li class="sb-template-conflict-pair">
                        <span class="sb-template-conflict-template">Template adds #@r.Priority @r.ActionDisplay (@r.ModeDisplay)</span>
                        <span class="sb-template-conflict-arrow" aria-hidden="true">&darr; already shadowed &darr;</span>
                        <span class="sb-template-conflict-existing">Existing higher-precedence rule already wins at this scope</span>
                    </li>
                }
            </ul>
        </details>
    }

    <ul class="sb-template-preview-list">
        @foreach (var r in Model.AddedRules)
        {
            <li class="sb-template-preview-item">
                <span class="sb-template-preview-priority">#@r.Priority</span>
                <span class="sb-template-preview-action">@r.ActionDisplay</span>
                <span class="sb-template-preview-mode">(@r.ModeDisplay)</span>
                @if (!string.IsNullOrWhiteSpace(r.PredicateText))
                {
                    <span class="sb-template-preview-predicate">@r.PredicateText</span>
                }
            </li>
        }
    </ul>
</div>
