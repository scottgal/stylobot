@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@model PolicyStackRowViewModel
@{
    var modeLower = Model.Mode.ToString().ToLowerInvariant();
    var sourcePillClasses = Model.IsInherited
        ? "badge source-pill is-inherited"
        : "badge source-pill";
    var explainScope = PolicyScopeUrl.Encode(Model.SourceScope);
    var explainUrl = $"/dashboard/policystack/explain?scope={explainScope}&focusRule={Model.RuleId}";
    // C7 -- inherited rows are not reorderable from a descendant view; their
    // source pill becomes a click target that navigates to the owning scope
    // where the drag handle DOES render. PolicyScopeUrl.Encode handles the
    // round-trip; the actual dashboard route picks the scope up from
    // ?scope=<encoded>.
    var sourcePillHref = Model.IsInherited
        ? $"/dashboard/policies?scope={PolicyScopeUrl.Encode(Model.SourceScope)}"
        : null;
}
<article class="sb-policy-stack-row"
         data-rule-id="@Model.RuleId"
         data-source-pill="@Model.SourcePill"
         data-mode="@modeLower"
         data-no-hits="@(Model.HasNoHits ? "true" : "false")"
         data-template-id="@(Model.Origin?.TemplateId ?? "")"
         data-application-id="@(Model.Origin?.ApplicationId ?? "")"
         data-diverged="@(Model.IsDiverged ? "true" : "false")">
    <header class="sb-policy-stack-row-head">
        @if (sourcePillHref is not null)
        {
            <span class="@sourcePillClasses"
                  data-source="@Model.SourcePill.ToLowerInvariant()"
                  data-source-pill-href="@sourcePillHref"
                  role="link"
                  tabindex="0">@Model.SourcePill</span>
        }
        else
        {
            <span class="@sourcePillClasses"
                  data-source="@Model.SourcePill.ToLowerInvariant()">@Model.SourcePill</span>
        }
        <span class="badge mode-pill mode-@modeLower">@Model.ModePill</span>
        @await Html.PartialAsync("Components/SbPolicyStack/_PredicateChips", Model.Chips)
        <span class="verdict @Model.ActionColorClass" data-verdict="@Model.ActionColorClass">
            @(Model.IsObserveMode ? "would " : "")@Model.ActionVerdict
        </span>
        @* C7 -- drag handle. Only renders when the operator has dashboard-
           write (CanEdit) AND the rule lives at the current scope (not
           inherited). Inherited rules must be reordered from their owning
           scope; clicking the source pill walks the operator there. *@
        @if (Model.CanEdit && !Model.IsInherited)
        {
            <button type="button"
                    class="sb-policy-stack-drag-handle"
                    aria-label="Drag to reorder"
                    data-policy-stack-drag-handle
                    draggable="true">⋮⋮</button>
        }
    </header>

    <div class="sb-policy-stack-row-signals">
        <span class="triggers" title="Matched / Total evaluations in window">
            @Model.TriggerCount/@Model.TotalEvaluations
        </span>
        @if (!string.IsNullOrEmpty(Model.DistributionLine))
        {
            <span class="distribution">@Model.DistributionLine</span>
        }
        else if (Model.HasNoHits)
        {
            <span class="distribution sb-policy-stack-no-hits text-base-content/40">no hits in window</span>
        }
        @if (!string.IsNullOrEmpty(Model.LatencyLine))
        {
            <span class="latency">@Model.LatencyLine</span>
        }
        <span class="metadata text-base-content/40">@Model.MetadataLine</span>
        <button type="button"
                class="sb-policy-stack-row-explain"
                data-action="explain"
                data-rule-id="@Model.RuleId"
                hx-get="@explainUrl"
                hx-target="#sb-policy-stack-explainer"
                hx-swap="outerHTML"
                aria-label="Show rule explainer">ⓘ</button>
        @* C6 -- pencil-shaped edit button. canEdit on the row VM is the
           SAME flag the parent PolicyStackPresenter threads in from the
           call site, which itself is whatever the host wires in (the
           commercial dashboard plumbs it from the DashboardWrite policy
           backstop). The button ONLY renders when canEdit is true so a
           read-only viewer never sees the affordance. *@
        @if (Model.CanEdit)
        {
            <button type="button"
                    class="sb-policy-stack-row-edit"
                    data-action="edit"
                    data-rule-id="@Model.RuleId"
                    aria-label="Edit rule"
                    hx-get="/dashboard/policystack/edit?ruleId=@Model.RuleId"
                    hx-target="closest article"
                    hx-swap="outerHTML">&#x270e;</button>
        }
    </div>
    @if (Model.IsDiverged && Model.Origin is not null)
    {
        @* T4 Part B -- inline divergence banner. The rule was emitted by a
           template + application but its current text no longer matches
           the last materialization (the operator hand-edited it). Re-apply
           the template to drop the divergence, or detach the rule from
           the application to keep the edit. *@
        <p class="sb-policy-stack-row-diverged" data-policy-stack-diverged-banner role="note">
            <span class="sb-policy-stack-row-diverged-pill">diverged from template</span>
            <span class="sb-policy-stack-row-diverged-meta">
                originated from <code>@Model.Origin.TemplateId</code>
                via application <code>@Model.Origin.ApplicationId</code>
            </span>
        </p>
    }
</article>
