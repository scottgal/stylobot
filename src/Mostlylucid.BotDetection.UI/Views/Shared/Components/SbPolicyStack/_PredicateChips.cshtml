@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@inject FacetPillRenderer FacetRenderer
@model IReadOnlyList<PolicyStackChipViewModel>
<div class="predicate-chips sb-policy-card-chips" data-chips="@Model.Count">
    <span class="kw kw-if" aria-hidden="true">IF</span>
    @for (var i = 0; i < Model.Count; i++)
    {
        var chip = Model[i];
        if (chip.IsStructural)
        {
            <span class="kw kw-@chip.Facet.ToLowerInvariant()" aria-hidden="true">@chip.Facet</span>
        }
        else
        {
            @* Implicit AND between adjacent term chips, but skip when the
               previous chip was structural so we don't double up. *@
            if (i > 0 && !Model[i - 1].IsStructural)
            {
                <span class="kw kw-and" aria-hidden="true">AND</span>
            }
            var pill = FacetRenderer.Render(chip.Facet, chip.Op, chip.ValueText);
            <span class="sb-facet-pill @pill.CategoryClass"
                  title="@chip.Tooltip"
                  data-facet="@pill.Key"
                  data-uncatalogued="@(pill.IsUncatalogued ? "true" : "false")">
                @await Html.PartialAsync("Components/SbPolicyStack/_IntentIcons", pill.IconRef)
                <span class="sb-facet-pill-cat">@pill.CategoryLabel</span>
                <span class="sb-facet-pill-op">@pill.OperatorLabel</span>
                <span class="sb-facet-pill-val">@pill.ValueDisplay</span>
            </span>
        }
    }
</div>