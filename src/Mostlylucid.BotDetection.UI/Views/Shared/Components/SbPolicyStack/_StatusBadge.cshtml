@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Policies
@using Mostlylucid.BotDetection.UI.Services
@model PolicyStackViewModel
@{
    var ancestorHashes = string.Join(",", PolicyScopeKeys.AncestorHashes(Model.Scope));
    // StatusBadge has no rule list; the rows-url refreshes the whole badge.
    var rowsUrl = $"/dashboard/policystack/rows?scope={PolicyScopeUrl.Encode(Model.Scope)}&tab=badge";
}
<aside class="sb-policy-stack-status-badge"
       data-policy-stack-embed="status-badge"
       data-policy-stack-scope="@Model.ScopeHash"
       data-policy-stack-ancestors="@ancestorHashes"
       data-policy-stack-rows-url="@rowsUrl">
    @* B6 envelope: id matches the rows-url response so the beacon-driven swap
       targets the badge in place. *@
    <span id="sb-policy-stack-rows-@Model.ScopeHash" class="sb-policy-stack-status-inner">
        <span class="sb-policy-stack-status-count">
            @Model.TotalEffectiveRules rules effective here
        </span>
        @if (Model.LatestEditAt is { } latest)
        {
            <span class="sb-policy-stack-status-sep" aria-hidden="true">·</span>
            <span class="sb-policy-stack-status-edit">last edit @latest.ToString("u")</span>
        }
    </span>
</aside>
