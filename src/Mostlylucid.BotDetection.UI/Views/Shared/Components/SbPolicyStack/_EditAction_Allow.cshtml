@*
    Zero-field Allow action editor. Rendered into the action-editor slot by
    HTMX when the action-kind selector flips to "allow". Allow has no
    metadata to capture -- matching requests pass through untouched.
*@
<fieldset class="sb-edit-action" data-edit-action-kind="allow">
    <legend>Allow</legend>
    <p class="sb-edit-action-empty">No parameters. Matching requests pass through untouched.</p>
</fieldset>