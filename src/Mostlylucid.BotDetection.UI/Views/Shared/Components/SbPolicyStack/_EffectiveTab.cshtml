@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@inject IDashboardLinkResolver DashboardLinks
@model PolicyStackViewModel
@*
    Effective tab body. Sortable column headers render above the rule list;
    they emit data-sort-key / data-sort-dir for B6 to pick up. The actual
    hx-get wiring is deliberately NOT on the buttons -- B6 will attach it
    once the URL contract is wired through the dashboard's HTMX layer.
*@
@if (Model.Rows.Count == 0)
{
    if (Model.Filter.IsActive)
    {
        <div class="sb-policy-stack-empty" data-policy-stack-empty="true">
            No rules match the current filter.
        </div>
    }
    else
    {
        @* C12 -- zero-rules empty state: webmaster-facing CTAs to either
           pick a vetted template (switches the section-level Templates tab
           via policy-stack-tabs.js [data-action="switch-tab"] handler) or
           jump straight into the inline rule editor (B8's
           /policystack/edit/new endpoint returns a fresh _RuleCardExpand
           scaffold at this scope). *@
        <div class="sb-policy-empty" data-policy-stack-empty="true">
            <p>No manually authored rules yet at this scope.</p>
            <div class="sb-policy-empty-actions">
                <button type="button"
                        class="sb-template-use"
                        data-action="switch-tab"
                        data-target="templates">Browse templates</button>
                <a class="sb-template-preview"
                   href="@DashboardLinks.Resolve($"/policystack/edit/new?scope={PolicyScopeUrl.Encode(Model.Scope)}")">Start blank</a>
            </div>
        </div>
    }
}
else
{
    <div class="sb-policy-stack-sort-headers" role="row" data-policy-stack-sort-headers="true">
        @{
            var headers = new (PolicyStackSortKey Key, string Label)[]
            {
                (PolicyStackSortKey.Priority, "Priority"),
                (PolicyStackSortKey.Triggers, "Triggers"),
                (PolicyStackSortKey.P99Latency, "p99"),
                (PolicyStackSortKey.PercentBlocked, "% blocked"),
                (PolicyStackSortKey.LastEdited, "Edited")
            };
        }
        @foreach (var header in headers)
        {
            var isActive = Model.Sort.Key == header.Key;
            // First click on a column header sorts ascending; subsequent
            // clicks on the SAME column toggle direction. Other columns
            // always reset to ascending.
            var nextDir = isActive && Model.Sort.Direction == PolicyStackSortDir.Asc
                ? PolicyStackSortDir.Desc
                : PolicyStackSortDir.Asc;
            var nextSort = new PolicyStackSort(header.Key, nextDir);
            var indicator = isActive
                ? (Model.Sort.Direction == PolicyStackSortDir.Asc ? " ↑" : " ↓")
                : string.Empty;
            <button type="button"
                    class="sb-policy-stack-sort-header@(isActive ? " is-active" : "")"
                    data-sort-key="@nextSort.KeyToken"
                    data-sort-dir="@nextSort.DirToken"
                    aria-pressed="@(isActive ? "true" : "false")">@header.Label@indicator</button>
        }
    </div>
    @* C7 -- the encoded scope on the <ul> tells policy-stack-reorder.js
       which scope to POST when the operator drops a row. Only rules at
       this exact scope are reorderable; inherited rows render without a
       drag handle so dragging them is impossible. *@
    <ul class="sb-policy-stack-rows"
        role="list"
        data-policy-stack-reorder-scope="@PolicyScopeUrl.Encode(Model.Scope)">
        @foreach (var row in Model.Rows)
        {
            <li>
                @await Html.PartialAsync("Components/SbPolicyStack/_RuleCard", row)
            </li>
        }
    </ul>
}
