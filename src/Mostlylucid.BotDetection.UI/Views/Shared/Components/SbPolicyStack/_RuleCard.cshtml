@using Mostlylucid.BotDetection.Policies.Rules
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@inject IDashboardLinkResolver DashboardLinks
@model PolicyStackRowViewModel
@*
    A4 -- structural rewrite of the old _RuleRow.cshtml. This file is now
    the 3-band card skeleton; A5 fills in Band 2 (IF/THEN body) and A6
    fills in Band 3 (mode dot + counters + auto-promote / diverged banners).
    Band 1 (Headline) lands HERE and shows priority # + the webmaster-
    readable scope target + edit / drag affordances. The orthogonal slots
    (Method / Geo / Identity) deliberately do NOT surface in the headline --
    the inline edit-expand surface (B8) owns those.
*@
@{
    var modeLower   = Model.Mode.ToString().ToLowerInvariant();
    var editUrl     = DashboardLinks.Resolve($"/policystack/edit?ruleId={Model.RuleId}");
    var scopeTarget = PolicyScopeFormatter.ToHeadline(Model.SourceScope);
}

<article class="sb-policy-card"
         data-rule-card
         data-rule-id="@Model.RuleId"
         data-mode="@modeLower"
         data-inherited="@(Model.IsInherited ? "true" : "false")">
    <header class="sb-policy-card-head">
        <span class="sb-policy-card-priority">#@Model.Priority</span>
        <span class="sb-policy-card-target" title="@scopeTarget">@scopeTarget</span>
        <div class="sb-policy-card-actions">
            @if (Model.CanEdit && !Model.IsInherited)
            {
                <button type="button"
                        class="sb-policy-card-edit"
                        data-action="edit"
                        hx-get="@editUrl"
                        hx-target="closest article"
                        hx-swap="outerHTML"
                        aria-label="Edit rule">&#x270e;</button>
                <button type="button"
                        class="sb-policy-card-drag"
                        aria-label="Drag to reorder"
                        data-policy-stack-drag-handle
                        draggable="true">&#x22EE;&#x22EE;</button>
            }
        </div>
    </header>

    @* Band 2 (Body) -- A5 fills this in *@
    @* Band 3 (Meta) -- A6 fills this in *@
</article>