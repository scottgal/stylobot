@using Mostlylucid.BotDetection.Policies.Rules
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@inject IDashboardLinkResolver DashboardLinks
@model PolicyStackRowViewModel
@*
    A4 -- structural rewrite of the old _RuleRow.cshtml. This file is now
    the 3-band card skeleton; A5 fills in Band 2 (IF/THEN body) and A6
    fills in Band 3 (mode dot + counters + auto-promote / diverged banners).
    Band 1 (Headline) lands HERE and shows priority # + the webmaster-
    readable scope target + edit / drag affordances. The orthogonal slots
    (Method / Geo / Identity) deliberately do NOT surface in the headline --
    the inline edit-expand surface (B8) owns those.
*@
@{
    var modeLower   = Model.Mode.ToString().ToLowerInvariant();
    var editUrl     = DashboardLinks.Resolve($"/policystack/edit?ruleId={Model.RuleId}");
    var scopeTarget = PolicyScopeFormatter.ToHeadline(Model.SourceScope);
    var modeTitle   = modeLower switch
    {
        "live"     => "Live: rule is active and affecting requests.",
        "observe"  => "Observe: rule logs matches without taking action.",
        "draft"    => "Draft: rule is configured but not yet promoted.",
        "disabled" => "Disabled: rule is configured but turned off.",
        _          => "Mode: " + modeLower,
    };
    var intent      = ViewBag.PolicyIntent as PolicyIntentKind? ?? PolicyIntentKind.Observe;
    var intentLower = intent.ToString().ToLowerInvariant();
    var pill = Model.Action is null
        ? new ActionVerbFormatter.ActionPill("observe", "RULE", Model.ActionVerdict ?? "")
        : ActionVerbFormatter.ToPill(Model.Action, intent, Model.Trigger is not null);
}

<article class="sb-policy-card"
         data-rule-card
         data-rule-id="@Model.RuleId"
         data-mode="@modeLower"
         data-intent="@intentLower"
         data-inherited="@(Model.IsInherited ? "true" : "false")">
    <span class="sb-policy-card-intent" aria-hidden="true"></span>
    <header class="sb-policy-card-head">
        <span class="sb-policy-card-priority">#@Model.Priority</span>
        <span class="sb-policy-card-target" title="@scopeTarget">@scopeTarget</span>
        <div class="sb-policy-card-actions">
            @if ((Model.CanEdit || Model.ShowReadOnlyEditAffordance) && !Model.IsInherited)
            {
                @* Showcase-demo surface (ShowReadOnlyEditAffordance) renders the SAME
                   interactive editor-open control the licensed dashboard renders, not a
                   disabled stub -- a prospect must be able to OPEN the editor. The
                   editor-open GET (/policystack/edit) is anonymous-readable; only the
                   SAVE (PUT /api/v1/policies/{id}, commercial mutation API) is
                   server-refused, so exposing the open here grants no write. The drag
                   handle stays gated on CanEdit: reorder is a mutation, not an
                   editor-open, so the demo surface omits it. *@
                <button type="button"
                        class="sb-policy-card-edit"
                        data-action="edit"
                        hx-get="@editUrl"
                        hx-target="closest article"
                        hx-swap="outerHTML transition:true"
                        aria-label="Edit rule">&#x270e;</button>
                @if (Model.CanEdit)
                {
                    <button type="button"
                            class="sb-policy-card-drag"
                            aria-label="Drag to reorder"
                            data-policy-stack-drag-handle
                            draggable="true">&#x22EE;&#x22EE;</button>
                }
            }
        </div>
    </header>

    @* Band 2 (Body) -- IF / THEN sentence pair. The IF line reuses the
       existing _PredicateChips partial (now carrying sb-policy-card-chips
       so A9's stylesheet can scope chip restyling to the card without
       bleeding into other surfaces). The THEN line runs the rule's action
       through ActionVerbFormatter -- observe mode prepends "would ",
       Trigger != null appends " · hysteresis" as a marker that the full
       sustain/recover/armed payload lives in the expand surface (B8).
       Model.Action may be null on stale call-sites that constructed the
       VM before A5 added the trailing positional; fall back to the
       pre-rendered ActionVerdict so the row never blanks. *@
    <div class="sb-policy-card-body">
        <div class="sb-policy-card-if">
            <span class="sb-policy-card-keyword">IF</span>
            @await Html.PartialAsync("Components/SbPolicyStack/_PredicateChips", Model.Chips)
        </div>
        <div class="sb-policy-card-then">
            <span class="sb-policy-card-keyword">THEN</span>
            @if (Model.Action is null)
            {
                <span class="sb-policy-card-action">@Model.ActionVerdict</span>
            }
            else
            {
                <span class="sb-action-pill" data-intent="@intentLower">
                    @await Html.PartialAsync("Components/SbPolicyStack/_IntentIcons", pill.IconRef)
                    <span class="sb-action-pill-text">@pill.PillText</span>
                </span>
                @if (!string.IsNullOrEmpty(pill.DetailText))
                {
                    <span class="sb-action-pill-detail">@pill.DetailText</span>
                }
            }
        </div>
    </div>

    <footer class="sb-policy-card-meta">
        <span class="sb-policy-card-mode mode-@modeLower"
              aria-label="mode @modeLower"
              title="@modeTitle">
            <span class="sb-policy-card-mode-dot" aria-hidden="true"></span>@Model.ModePill
        </span>
        <span class="sb-policy-card-hits" title="Matched / Total evaluations in window">
            @Model.TriggerCount/@Model.TotalEvaluations hits / 5m
        </span>
        @if (!string.IsNullOrEmpty(Model.LatencyLine))
        {
            <span class="sb-policy-card-latency">@Model.LatencyLine</span>
        }
        @if (!string.IsNullOrEmpty(Model.DistributionLine))
        {
            <span class="sb-policy-card-distribution">@Model.DistributionLine</span>
        }
        @if (Model.HasNoHits)
        {
            <span class="sb-policy-card-no-hits">waiting for traffic</span>
        }
        @if (Model.AutoPromoteAt is not null)
        {
            <span class="sb-policy-card-auto-promote">
                auto-promotes to LIVE @PolicyScheduleFormatter.ToRelativeOrAbsolute(Model.AutoPromoteAt.Value)
            </span>
        }
        @if (Model.IsDiverged && Model.Origin is not null)
        {
            <span class="sb-policy-card-diverged">diverged from template <code>@Model.Origin.TemplateId</code></span>
        }
    </footer>
</article>
