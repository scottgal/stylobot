@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@inject IFacetPickerCatalog FacetCatalog
@model IReadOnlyList<FacetPickerRowViewModel>
@*
    B8 -- curated facet picker. The catalog drives the dropdown (B6
    loader); per-facet ops + value-input-type render from the catalog
    entry. The picker is structural-only in B8: rows seed from a flat
    AND-of-Terms predicate when the rule's AST projects cleanly, and
    the raw-DSL textarea below remains the canonical source of truth.

    Mixed AND/OR predicates and nested groups render an empty picker
    on purpose -- the textarea always carries the full predicate.

    No client-side add/remove yet: + AND / + OR buttons in
    _RuleCardExpand.cshtml are visible-but-inert in B8. Picker-driven
    write-through to the textarea lands in a follow-on polish.
*@
@{
    var rows = (Model is null || Model.Count == 0)
        ? Array.Empty<FacetPickerRowViewModel>()
        : Model;
    var catalog = FacetCatalog.All;
}

<div class="sb-facet-picker" data-facet-picker>
    @if (rows.Count == 0)
    {
        <p class="sb-facet-picker-empty">
            No picker rows for this rule. Use the raw textarea below to read or edit the predicate.
        </p>
    }
    else
    {
        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            var entry = FacetCatalog.FindByFacet(row.Facet);
            <div class="sb-facet-picker-row" data-row-index="@i">
                <select name="picker_facet_@i" class="sb-facet-picker-facet" disabled>
                    @foreach (var candidate in catalog)
                    {
                        <option value="@candidate.Facet" selected="@(candidate.Facet == row.Facet)">@candidate.Label</option>
                    }
                    @if (entry is null && !string.IsNullOrEmpty(row.Facet))
                    {
                        @* Row references a facet missing from the curated catalog --
                           keep it visible so the operator sees what's there. *@
                        <option value="@row.Facet" selected>@row.Facet</option>
                    }
                </select>

                <select name="picker_op_@i" class="sb-facet-picker-op" disabled>
                    @if (entry is not null && entry.Ops.Count > 0)
                    {
                        foreach (var op in entry.Ops)
                        {
                            <option value="@op" title="@OpExplain(op)" selected="@(op == row.Op)">@OpDisplay(op)</option>
                        }
                    }
                    else
                    {
                        <option value="@row.Op" title="@OpExplain(row.Op)" selected>@OpDisplay(row.Op)</option>
                    }
                </select>

                <div class="sb-facet-picker-value">
                    @if (entry?.Type == "bool")
                    {
                        <select name="picker_value_@i" disabled>
                            <option value="true"  selected="@(row.Value == "true")">true</option>
                            <option value="false" selected="@(row.Value == "false")">false</option>
                        </select>
                    }
                    else if (entry?.Type == "enum" && entry.Values.Count > 0)
                    {
                        <select name="picker_value_@i" disabled>
                            @foreach (var v in entry.Values)
                            {
                                <option value="@v" selected="@(v == row.Value)">@v</option>
                            }
                        </select>
                    }
                    else if (entry?.Type == "number" && entry.Range is not null)
                    {
                        <input type="number" name="picker_value_@i" value="@row.Value"
                               min="@entry.Range.Min" max="@entry.Range.Max" step="@entry.Range.Step"
                               disabled>
                    }
                    else if (entry?.Type == "glob")
                    {
                        <input type="text" name="picker_value_@i" value="@row.Value"
                               placeholder="/api/users/*"
                               class="sb-facet-picker-glob-input"
                               disabled>
                        <span class="sb-facet-picker-glob-hint">* = one segment, ** = any depth</span>
                    }
                    else
                    {
                        <input type="text" name="picker_value_@i" value="@row.Value" disabled>
                    }
                </div>

                <button type="button" class="sb-facet-picker-remove"
                        data-remove-row aria-label="Remove" disabled>×</button>
                @if (entry is not null && !string.IsNullOrWhiteSpace(entry.Help))
                {
                    <p class="sb-facet-picker-help">@entry.Help</p>
                }
            </div>
        }
    }
</div>

@functions {
    /// <summary>
    ///     Display text for the canonical predicate operator keys. Source of
    ///     truth for the strings is the predicate grammar (PredicateOp +
    ///     PolicyEditPresenter.OpKey); this is the operator-friendly form for
    ///     the dropdown only. Falls through to the raw key when an unknown
    ///     operator slips in from the catalog so nothing renders blank.
    /// </summary>
    static string OpDisplay(string op) => op switch
    {
        "eq"       => "=",
        "neq"      => "!=",
        "gte"      => ">=",
        "gt"       => ">",
        "lte"      => "<=",
        "lt"       => "<",
        "in"       => "is one of",
        "not_in"   => "is not one of",
        "between"  => "between",
        "matches"  => "matches",
        "contains" => "contains",
        "any_in"   => "any of",
        "all_in"   => "all of",
        _          => op,
    };

    /// <summary>Plain-English explanation surfaced via the option title=
    /// attribute so an operator can hover an op without committing.</summary>
    static string OpExplain(string op) => op switch
    {
        "eq"       => "Equal to",
        "neq"      => "Not equal to",
        "gte"      => "Greater than or equal to",
        "gt"       => "Greater than",
        "lte"      => "Less than or equal to",
        "lt"       => "Less than",
        "in"       => "Matches any value in the list",
        "not_in"   => "Matches none of the values in the list",
        "between"  => "Between two bounds (inclusive)",
        "matches"  => "Glob pattern match (* = one segment, ** = any depth)",
        "contains" => "String contains the value",
        "any_in"   => "Any of the listed values match",
        "all_in"   => "All of the listed values must match",
        _          => op,
    };
}