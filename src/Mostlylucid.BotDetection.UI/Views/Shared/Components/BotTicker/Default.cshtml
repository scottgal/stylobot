@* Bot Ticker - Real-time detection feed using SignalR + Alpine.js + HTMX.
   Hub path is resolved server-side from the configured StyloBotDashboardOptions.HubPath
   so the component connects to the real hub on every host (the hub is deliberately
   independent of the dashboard BasePath -- e.g. commercial /dashboard mount, /stylobot/hub). *@
@using Microsoft.Extensions.Options
@using Mostlylucid.BotDetection.UI.Configuration
@inject IOptions<StyloBotDashboardOptions> DashboardOpts
@{
    var cspNonce = ViewContext.HttpContext.Items["CspNonce"]?.ToString() ?? string.Empty;
    // SignalR hub path, resolved server-side from config (NOT derived from the dashboard
    // BasePath). The hub lives on the gateway and is not nested under the dashboard mount.
    var hubPath = DashboardOpts.Value.HubPath;
    // Dashboard mount base path. Threaded via ViewData["BasePath"] on hosts that mount the
    // dashboard elsewhere (commercial = /dashboard); defaults to the FOSS-standalone mount.
    // Was a literal "/_stylobot" -> 404'd the "Open Dashboard" + signature links on mounted hosts.
    var dashBase = ViewData["BasePath"]?.ToString() ?? "/_stylobot";
    // The dashboard hub is legitimately auth-gated (it protects live per-visitor detection
    // data) -- an anonymous connection completes its handshake then gets closed by the
    // server immediately after, which used to leave this widget stuck on "Connecting..."
    // forever. Interim fix: don't even attempt the socket for anonymous visitors: SSR
    // still renders correctly, it just settles straight into the idle/waiting state
    // instead of spinning on a connection that was always going to be rejected. Real fix
    // (tracked separately) is a dedicated public read-only ticker hub with no auth gate.
    var isAuthenticated = ViewContext.HttpContext.User?.Identity?.IsAuthenticated ?? false;
}

<div class="stylobot-ticker"
     x-data="botTicker(@isAuthenticated.ToString().ToLowerInvariant())"
     x-init="connect()"
     x-cloak>

    <!-- Ticker Bar -->
    <div class="ticker-bar">
        <div class="ticker-label">
            <span class="ticker-icon">R</span>
            <span>LIVE</span>
        </div>

        <!-- Scrolling detections -->
        <div class="ticker-scroll" x-ref="tickerScroll">
            <template x-for="(detection, idx) in detections" :key="detection._id || idx">
                <a class="ticker-item"
                   :href="'@dashBase/signature/' + encodeURIComponent(detection.primarySignature || '')"
                   :class="{ 'is-bot': detection.isBot, 'ticker-item-new': detection._isNew }">
                    <span class="ticker-item-icon" x-text="detection.isBot ? 'R' : 'H'"></span>
                    <span class="ticker-item-risk"
                          :class="'risk-' + (detection.riskBand || '').toLowerCase()"
                          x-text="detection.riskBand || '-'"></span>
                    <template x-if="detection.botName">
                        <span class="ticker-item-botname" x-text="detection.botName"></span>
                    </template>
                    <template x-if="detection.botType && !detection.botName">
                        <span class="ticker-item-botname" x-text="detection.botType"></span>
                    </template>
                    <span class="ticker-item-path" x-text="(detection.path || '').length > 20 ? (detection.path || '').substring(0, 17) + '...' : (detection.path || '')"></span>
                    <span class="ticker-item-prob" x-text="Math.round((detection.botProbability || 0) * 100) + '%'"></span>
                    <span class="ticker-item-time" x-text="formatTime(detection.timestamp)"></span>
                </a>
            </template>

            <!-- Empty state -->
            <template x-if="detections.length === 0 && connected">
                <span class="ticker-empty">Waiting for detections...</span>
            </template>

            <!-- Connecting state -->
            <template x-if="!connected">
                <span class="ticker-connecting">Connecting to live feed...</span>
            </template>
        </div>

        <!-- Stats summary -->
        <div class="ticker-stats" x-show="summary">
            <span class="stat-item">
                <span class="stat-label">Total:</span>
                <span class="stat-value" x-text="summary?.totalRequests || 0"></span>
            </span>
            <span class="stat-item stat-bot">
                <span class="stat-label">Bots:</span>
                <span class="stat-value" x-text="summary?.botRequests || 0"></span>
            </span>
            <span class="stat-item stat-human">
                <span class="stat-label">Humans:</span>
                <span class="stat-value" x-text="summary?.humanRequests || 0"></span>
            </span>
        </div>

        <!-- Dashboard link -->
        <a href="@dashBase" class="ticker-dashboard-link" title="Open Dashboard">
            Dashboard
        </a>
    </div>
</div>

<script nonce="@cspNonce">
var hubPath = '@Html.Raw(hubPath)';
var tickerApiBase = '@Html.Raw(dashBase)';
document.addEventListener('alpine:init', () => {
    // Normalize PascalCase API keys to camelCase
    function toCamel(obj) {
        if (Array.isArray(obj)) return obj.map(toCamel);
        if (obj !== null && typeof obj === 'object') {
            return Object.fromEntries(
                Object.entries(obj).map(([k, v]) => [k.charAt(0).toLowerCase() + k.slice(1), toCamel(v)])
            );
        }
        return obj;
    }

    let tickerId = 0;

    Alpine.data('botTicker', (isAuthenticated) => ({
        connected: false,
        detections: [],
        summary: null,
        connection: null,
        maxDetections: 20,

        async connect() {
            // The dashboard hub is auth-gated by design -- an anonymous socket would
            // complete its handshake and then get closed by the server immediately,
            // leaving the UI stuck on "Connecting..." forever for no benefit. Settle
            // straight into the idle state instead of attempting a connection that's
            // always rejected; SSR already rendered whatever the page needed.
            if (!isAuthenticated) {
                this.connected = true;
                return;
            }
            try {
                // Load SignalR if not already loaded
                if (typeof signalR === 'undefined') {
                    await this.loadSignalR();
                }

                this.connection = new signalR.HubConnectionBuilder()
                    .withUrl(hubPath)
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                    .configureLogging(signalR.LogLevel.Warning)
                    .build();

                // Beacon-only (the hub NEVER carries per-detection payloads, by
                // design): on invalidation, pull the current data through the
                // same read surface every other dashboard widget uses instead of
                // waiting on a push that was never wired up (was a silent no-op
                // -- this ticker rendered "Waiting for detections..." forever
                // regardless of real traffic).
                this.connection.on('BroadcastInvalidation', () => { this.refresh(); });

                // Connection state handlers
                this.connection.onclose(() => { this.connected = false; });
                this.connection.onreconnecting(() => { this.connected = false; });
                this.connection.onreconnected(() => { this.connected = true; this.refresh(); });

                await this.connection.start();
                this.connected = true;
                await this.refresh();

            } catch (error) {
                console.error('[BotTicker] Connection failed:', error);
                this.connected = false;
            }
        },

        async refresh() {
            try {
                const res = await fetch(
                    tickerApiBase + '/api/detections?limit=' + this.maxDetections,
                    { credentials: 'same-origin' });
                if (!res.ok) return;
                const rows = toCamel(await res.json());
                this.detections = rows.map((d) => ({
                    ...d,
                    _id: ++tickerId,
                    _isNew: false,
                    timestamp: d.timestamp ? new Date(d.timestamp) : new Date()
                }));
            } catch (error) {
                console.error('[BotTicker] Refresh failed:', error);
            }
        },

        async loadSignalR() {
            return new Promise((resolve, reject) => {
                const script = document.createElement('script');
                // Self-hosted via the FOSS UI package; the dashboard's strict CSP blocks
                // CDN origins by design.
                script.src = '/_content/Mostlylucid.BotDetection.UI/vendor/js/signalr.min.js';
                script.onload = resolve;
                script.onerror = reject;
                document.head.appendChild(script);
            });
        },

        formatTime(timestamp) {
            if (!timestamp) return '';
            const d = new Date(timestamp);
            if (isNaN(d.getTime())) return '';
            return d.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            });
        }
    }));
});
</script>
