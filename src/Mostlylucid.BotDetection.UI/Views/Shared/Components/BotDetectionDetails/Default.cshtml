@model Mostlylucid.BotDetection.UI.Models.DetectionDisplayModel

@if (!Model.HasData)
{
    <div class="bot-detection-no-data">
        <p>No bot detection data available</p>
    </div>
    return;
}

@{
    var recommendedAction = Model.BotProbability switch
    {
        >= 0.9 => ("Block",     "Very high confidence bot - immediate block recommended"),
        >= 0.7 => ("Challenge", "High confidence bot - CAPTCHA or verification recommended"),
        >= 0.5 => ("Throttle",  "Moderate bot signals - rate limiting recommended"),
        >= 0.3 => ("Monitor",   "Some bot signals - monitor behavior"),
        _      => ("Allow",     "Low bot probability - normal access")
    };
    var probPct  = (int)Math.Round(Model.BotProbability * 100);
    var verdictClass = Model.IsBot ? "is-bot" : "is-human";
    var verdictLabel = Model.IsBot ? "Bot" : "Human";
    var accent       = Model.IsBot ? "#ef4444" : "#22c55e";

    var primarySig  = Model.Signatures?.PrimarySignature;
    var ipSig       = Model.Signatures?.IpSignature;
    var uaSig       = Model.Signatures?.UaSignature;
    var clientSig   = Model.Signatures?.ClientSideSignature;
}

@{
    var cardHref = !string.IsNullOrEmpty(primarySig)
        ? $"/dashboard/signature/{Uri.EscapeDataString(primarySig)}"
        : null;
}
<div class="bot-detection-container" data-sb-widget="your-detection">
    @* Whole upper card is one anchor to /dashboard/signature/<primary> -- visitor
       clicks anywhere on the LIVE header, radar, verdict, or reasons block and
       lands on their own signature detail page. The bottom Top Bots strip is a
       sibling (not nested inside this anchor) because it contains its own row
       anchors -- nesting <a> is invalid HTML and stops the inner clicks working.
       Razor can't keep an <a> open across an if-block, so we render the open
       tag (or its <div> fallback when no signature resolved) via Html.Raw. *@
    @{
        var upperOpen = cardHref is not null
            ? $"<a href=\"{System.Web.HttpUtility.HtmlAttributeEncode(cardHref)}\" class=\"block no-underline text-base-content hover:bg-base-content/[0.04] rounded transition-colors\" title=\"Open your signature detail · {System.Web.HttpUtility.HtmlAttributeEncode(primarySig ?? string.Empty)}\">"
            : "<div>";
        var upperClose = cardHref is not null ? "</a>" : "</div>";
    }
    @Html.Raw(upperOpen)
    @* Header: LIVE pulse + verdict badge + request id + timing -- all real signal, no fluff *@
    <div class="flex items-center justify-between gap-2 mb-3">
        <div class="flex items-center gap-2">
            <span class="sb-live-dot" aria-hidden="true"></span>
            <span class="text-[10px] font-bold uppercase tracking-wider text-base-content/60">Live · Your Detection</span>
            <span class="badge badge-xs @(Model.IsBot ? "badge-error" : "badge-success")">@verdictLabel</span>
        </div>
        <div class="text-[10px] text-base-content/40 tabular-nums">
            @Model.Timestamp.ToString("HH:mm:ss") · @Model.ProcessingTimeMs.ToString("F0")ms
        </div>
    </div>

    @* Two-column body: fingerprint radar (left) + verdict/reason/pills (right) *@
    <div class="grid grid-cols-[140px_1fr] gap-4 items-center">
        <div class="text-base-content">
            @* The radar projects the visitor's behavioural-fingerprint centroid
               via FingerprintRadarProjection. Solid polygon = current shape
               (where the actor sits now, after every absorbed observation).
               Dotted polygon (when known) = archetype origin, the seed shape
               this fingerprint was allocated from. The gap between them is
               the actor's drift since allocation -- the "session effect."
               Calibrating placeholder runs only when the orchestrator
               hasn't yet assigned an IdentityFingerprintId for this
               request (genuine pre-archetype-match window). *@
            @await Html.PartialAsync("~/Views/Shared/_FingerprintShape.cshtml",
                new FingerprintShapeViewModel(Model.FingerprintShape, Model.IsBot))
        </div>

        <div class="flex flex-col gap-2 min-w-0">
            <div class="flex items-baseline gap-3">
                <div>
                    <span class="text-2xl font-black" style="color: @accent;">@(probPct)%</span>
                    <span class="text-[10px] text-base-content/50 ml-1">bot probability</span>
                </div>
                <span class="badge badge-xs sb-risk-@(Model.RiskBand.ToLowerInvariant())">@Model.RiskBand</span>
                <span class="badge badge-xs sb-action-@recommendedAction.Item1.ToLowerInvariant()">@recommendedAction.Item1</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.BotName) || !string.IsNullOrEmpty(Model.BotType))
            {
                <div class="text-[11px] text-base-content/70">
                    Identified as <strong>@(Model.BotName ?? Model.BotType)</strong>
                </div>
            }

            @if (Model.TopReasons.Any())
            {
                <ul class="text-[10px] text-base-content/55 space-y-0.5 list-none p-0 m-0">
                    @foreach (var reason in Model.TopReasons.Take(3))
                    {
                        <li class="truncate" title="@reason">· @reason</li>
                    }
                </ul>
            }

            @* Signature pills removed by design -- the whole card is clickable
               (data-href on the root container) so visitors land on their own
               primary signature detail page without us cluttering the card with
               four hash chips three of which had no dashboard surface to drill
               into. The primary hash stays available as the wrapper's title
               for copy/paste. *@
        </div>
    </div>

    @Html.Raw(upperClose)

    @* Bottom strip: top 5 bots currently being seen. Sits OUTSIDE the upper-card
       anchor so SbTopBots's own per-row anchors keep their click behaviour --
       nesting them inside the outer <a> would invalidate the HTML and break
       row clicks. *@
    <div class="mt-4 pt-3 border-t border-base-content/10">
        <sb-top-bots page-size="5" filter="bots" sort="recent" widget-id="your-detection-topbots" />
    </div>
</div>
