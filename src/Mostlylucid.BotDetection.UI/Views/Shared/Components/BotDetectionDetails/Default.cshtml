@model Mostlylucid.BotDetection.UI.Models.DetectionDisplayModel

@if (!Model.HasData)
{
    <div class="bot-detection-no-data">
        <p>No bot detection data available</p>
    </div>
    return;
}

@{
    var recommendedAction = Model.BotProbability switch
    {
        >= 0.9 => ("Block", "Very high confidence bot - immediate block recommended"),
        >= 0.7 => ("Challenge", "High confidence bot - CAPTCHA or verification recommended"),
        >= 0.5 => ("Throttle", "Moderate bot signals - rate limiting recommended"),
        >= 0.3 => ("Monitor", "Some bot signals - monitor behavior"),
        _ => ("Allow", "Low bot probability - normal access")
    };
    var detectorCount = Model.DetectorContributions?.Count ?? 0;
    var aiRan = Model.DetectorContributions?.Any(d => d.Name?.Contains("Llm") == true || d.Name?.Contains("AI") == true) ?? false;

    // Build the behavioral-fingerprint radar from per-detector contributions.
    // The fingerprint is "3 signature hashes + this shape" -- the polygon's vertices encode the
    // per-detector contribution magnitudes (clamped 0..1) projected around a circle.
    // Positive contribution (more bot-like) and negative (more human-like) both use abs magnitude;
    // the polygon fill colour shifts toward the dominant sign.
    var radarDetectors = Model.DetectorContributions?
        .Where(d => !string.IsNullOrEmpty(d.Name) && d.Contribution != 0)
        .OrderByDescending(d => Math.Abs(d.Contribution))
        .Take(8)
        .ToList() ?? new List<Mostlylucid.BotDetection.UI.Models.DetectorContributionDisplay>();

    var radarVertices = new System.Text.StringBuilder();
    var radarLabels = new System.Text.StringBuilder();
    var radarAxisLines = new System.Text.StringBuilder();
    if (radarDetectors.Count >= 3)
    {
        var n = radarDetectors.Count;
        var totalSigned = 0d;
        for (var i = 0; i < n; i++)
        {
            var d = radarDetectors[i];
            var angle = (2 * Math.PI * i / n) - (Math.PI / 2); // start at top
            var magnitude = Math.Min(1.0, Math.Abs(d.Contribution) * 2.5);
            totalSigned += d.Contribution;
            var x = 50 + Math.Cos(angle) * 35 * magnitude;
            var y = 50 + Math.Sin(angle) * 35 * magnitude;
            radarVertices.Append($"{x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} ");

            // Axis line from centre to outer edge
            var axisX = 50 + Math.Cos(angle) * 35;
            var axisY = 50 + Math.Sin(angle) * 35;
            radarAxisLines.AppendLine($"<line x1=\"50\" y1=\"50\" x2=\"{axisX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y2=\"{axisY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" stroke=\"currentColor\" stroke-width=\"0.3\" opacity=\"0.12\" />");

            // Label outside the ring
            var lx = 50 + Math.Cos(angle) * 44;
            var ly = 50 + Math.Sin(angle) * 44 + 1.5;
            var labelText = d.Name.Length <= 5 ? d.Name : d.Name.Substring(0, 5);
            radarLabels.AppendLine($"<text x=\"{lx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{ly.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" font-size=\"3.5\" text-anchor=\"middle\" fill=\"currentColor\" opacity=\"0.55\">{labelText}</text>");
        }
        // Close polygon to first point so SVG fills cleanly
        radarVertices.Length--; // trailing space
    }
    var radarPolygonPoints = radarVertices.ToString();
    var radarFillColor = Model.IsBot ? "rgba(220,38,38,0.22)" : "rgba(91,163,163,0.22)";
    var radarStrokeColor = Model.IsBot ? "#dc2626" : "#5ba3a3";
}

<div class="bot-detection-container bot-detection-compact" x-data="{ showDetails: false, showSignatures: false }">
    <!-- Compact Header with Key Metrics -->
    <div class="bot-detection-header">
        <div class="bot-detection-status @(Model.IsBot ? "is-bot" : "is-human")">
            <span class="status-icon">@(Model.IsBot ? "🤖" : "👤")</span>
            <span class="status-text">@(Model.IsBot ? "Bot" : "Human")</span>
        </div>
        <div class="bot-detection-score">
            <div class="score-label">Bot Probability</div>
            <div class="score-value">@Model.BotProbability.ToString("P0")</div>
        </div>
        <div class="bot-detection-risk">
            <div class="risk-label">Risk</div>
            <div class="risk-value risk-@Model.RiskBand.ToLower()">@Model.RiskBand</div>
        </div>
        <div class="bot-detection-recommendation">
            <div class="recommendation-label">Recommendation</div>
            <div class="recommendation-value action-@recommendedAction.Item1.ToLower()">@recommendedAction.Item1</div>
        </div>
        <div class="bot-detection-timing">
            <div class="timing-label">Fast Path</div>
            <div class="timing-value">@Model.ProcessingTimeMs.ToString("F0")ms</div>
        </div>
    </div>

    <!-- Quick Summary Bar -->
    <div class="bot-detection-summary">
        <span class="summary-item">
            <strong>@detectorCount</strong> detectors ran
        </span>
        <span class="summary-item">
            <strong>@(aiRan ? "AI" : "Heuristic")</strong> analysis
        </span>
        @if (!string.IsNullOrEmpty(Model.PolicyName))
        {
            <span class="summary-item">
                Policy: <strong>@Model.PolicyName</strong>
            </span>
        }
        @if (Model.Signatures?.FactorCount > 0)
        {
            <span class="summary-item">
                <strong>@Model.Signatures.FactorCount</strong> signature factors
            </span>
        }
    </div>

    <!-- Recommendation Explanation -->
    <div class="bot-detection-recommendation-detail">
        <span class="recommendation-reason">@recommendedAction.Item2</span>
        <span class="recommendation-bot"> | Identified: <strong>@(Model.BotName ?? Model.BotType ?? "Visitor")</strong></span>
    </div>

    <!-- Top Reasons (always visible, compact) -->
    @if (Model.TopReasons.Any())
    {
        <div class="bot-detection-reasons-compact">
            <strong>Key signals:</strong>
            @string.Join(" | ", Model.TopReasons.Take(3))
        </div>
    }

    <!-- Expandable Signatures Section -->
    @if (Model.Signatures != null && Model.Signatures.AvailableFactors.Any())
    {
        <div class="bot-detection-signatures-compact">
            <button type="button" class="toggle-btn" @@click="showSignatures = !showSignatures">
                <span x-text="showSignatures ? '▼' : '▶'"></span>
                🔐 Fingerprint (@Model.Signatures.FactorCount factors + behavioural shape) - Zero PII
            </button>
            <div x-show="showSignatures" x-collapse class="signatures-content">
                <div class="bot-detection-fingerprint-row">
                    @* Left column: per-detector behavioural-shape radar derived from contributions.
                       Each axis is a detector; the polygon distance from centre is the magnitude of
                       that detector's contribution to the final classification. *@
                    @if (radarDetectors.Count >= 3)
                    {
                        <div class="bot-detection-radar">
                            <svg viewBox="0 0 100 100" width="120" height="120" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="50" cy="50" r="35" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.18" />
                                <circle cx="50" cy="50" r="23" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.10" />
                                <circle cx="50" cy="50" r="12" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.10" />
                                @Html.Raw(radarAxisLines.ToString())
                                <polygon points="@radarPolygonPoints" fill="@radarFillColor" stroke="@radarStrokeColor" stroke-width="1.2" />
                                @Html.Raw(radarLabels.ToString())
                            </svg>
                            <div class="bot-detection-radar-caption">Behavioural shape</div>
                        </div>
                    }

                    @* Right column: HMAC factor hashes -- every one clickable through to its
                       signature-detail page on the dashboard. The path is canonical across the
                       FOSS dashboard and the marketing site (both mount at /dashboard), so we
                       can hardcode it here instead of plumbing options into the component. *@
                    <div class="factors-grid">
                        @if (!string.IsNullOrEmpty(Model.Signatures.PrimarySignature))
                        {
                            <div class="factor-compact"><span class="factor-label">Primary:</span> <a href="/dashboard/signature/@Uri.EscapeDataString(Model.Signatures.PrimarySignature)" class="signature-link"><code>@Model.Signatures.PrimarySignature</code></a></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Signatures.IpSignature))
                        {
                            <div class="factor-compact"><span class="factor-label">IP:</span> <a href="/dashboard/signature/@Uri.EscapeDataString(Model.Signatures.IpSignature)" class="signature-link"><code>@Model.Signatures.IpSignature</code></a></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Signatures.UaSignature))
                        {
                            <div class="factor-compact"><span class="factor-label">UA:</span> <a href="/dashboard/signature/@Uri.EscapeDataString(Model.Signatures.UaSignature)" class="signature-link"><code>@Model.Signatures.UaSignature</code></a></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Signatures.ClientSideSignature))
                        {
                            <div class="factor-compact"><span class="factor-label">Browser:</span> <a href="/dashboard/signature/@Uri.EscapeDataString(Model.Signatures.ClientSideSignature)" class="signature-link"><code>@Model.Signatures.ClientSideSignature</code></a></div>
                        }
                    </div>
                </div>
                <div class="privacy-note">All signatures are HMAC-SHA256 hashed. No PII stored. The behavioural shape is derived from runtime detector contributions only.</div>
            </div>
        </div>
    }

    <!-- Expandable Detector Details -->
    @if (Model.DetectorContributions?.Any() == true)
    {
        <div class="bot-detection-details-compact">
            <button type="button" class="toggle-btn" @@click="showDetails = !showDetails">
                <span x-text="showDetails ? '▼' : '▶'"></span>
                📊 Detector Details (@detectorCount detectors)
            </button>
            <div x-show="showDetails" x-collapse class="details-content">
                <div class="contributions-compact">
                    @foreach (var detector in Model.DetectorContributions.OrderByDescending(d => Math.Abs(d.Contribution)))
                    {
                        var contributionPercent = detector.Contribution * 100;
                        var contributionClass = detector.Contribution > 0 ? "positive" : "negative";
                        <div class="contribution-row">
                            <span class="detector-name-compact">@detector.Name</span>
                            <span class="contribution-value-compact @contributionClass">@contributionPercent.ToString("+0.0;-0.0;0")%</span>
                            <span class="detector-time-compact">@detector.ExecutionTimeMs.ToString("F0")ms</span>
                            @if (!string.IsNullOrEmpty(detector.Reason))
                            {
                                <span class="detector-reason-compact">@detector.Reason</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Compact Footer -->
    <div class="bot-detection-footer-compact">
        <span>ID: @Model.RequestId</span>
        <span>@Model.Timestamp.ToString("HH:mm:ss")</span>
    </div>
</div>
