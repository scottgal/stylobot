@model Mostlylucid.BotDetection.UI.Models.DetectionDisplayModel

@if (!Model.HasData)
{
    <div class="bot-detection-no-data">
        <p>No bot detection data available</p>
    </div>
    return;
}

@{
    var recommendedAction = Model.BotProbability switch
    {
        >= 0.9 => ("Block",     "Very high confidence bot - immediate block recommended"),
        >= 0.7 => ("Challenge", "High confidence bot - CAPTCHA or verification recommended"),
        >= 0.5 => ("Throttle",  "Moderate bot signals - rate limiting recommended"),
        >= 0.3 => ("Monitor",   "Some bot signals - monitor behavior"),
        _      => ("Allow",     "Low bot probability - normal access")
    };
    var probPct  = (int)Math.Round(Model.BotProbability * 100);
    var verdictClass = Model.IsBot ? "is-bot" : "is-human";
    var verdictLabel = Model.IsBot ? "Bot" : "Human";
    var accent       = Model.IsBot ? "#ef4444" : "#22c55e";

    // 12-axis clock labels match ClockProjection.Compose12Axes order, so the marketing
    // radar reads identically to the dashboard's behavioural-evolution panel.
    // Grouped quadrants: Footprint (12-2), Surface (3-5), Cadence (6-8), Signal (9-11).
    string[] clockLabels =
    [
        "Browsing","Path","Asset","Realtime","Form","API",
        "Auth","Burst","Timing","404","Scan","FP"
    ];

    // The radar projects from the visitor's persisted session vector via the
    // same chain the dashboard signature page uses. If we don't yet have a
    // 12-axis projection for this visitor, the radar stays empty -- we do
    // NOT fabricate a polygon from detector-contribution magnitudes or any
    // other ad-hoc source. Empty radar is the honest "no data yet" state.
    var axes = Model.ClockAxes is { Length: 12 } ? Model.ClockAxes : null;
    var hasRadar = axes is not null;

    var radarVertices  = new System.Text.StringBuilder();
    var radarAxisLines = new System.Text.StringBuilder();
    var radarLabelSvg  = new System.Text.StringBuilder();
    if (hasRadar)
    {
        for (var i = 0; i < 12; i++)
        {
            var angle = (2 * Math.PI * i / 12) - (Math.PI / 2); // 12 o'clock at top
            var magnitude = Math.Clamp(axes![i], 0, 1);
            var x = 50 + Math.Cos(angle) * 35 * magnitude;
            var y = 50 + Math.Sin(angle) * 35 * magnitude;
            radarVertices.Append($"{x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} ");

            var ax = 50 + Math.Cos(angle) * 35;
            var ay = 50 + Math.Sin(angle) * 35;
            radarAxisLines.AppendLine($"<line x1=\"50\" y1=\"50\" x2=\"{ax.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y2=\"{ay.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" stroke=\"currentColor\" stroke-width=\"0.3\" opacity=\"0.12\" />");

            var lx = 50 + Math.Cos(angle) * 44;
            var ly = 50 + Math.Sin(angle) * 44 + 1.2;
            radarLabelSvg.AppendLine($"<text x=\"{lx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{ly.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" font-size=\"3\" text-anchor=\"middle\" fill=\"currentColor\" opacity=\"0.5\">{clockLabels[i]}</text>");
        }
    }
    else
    {
        // Still render the axis grid + labels so the empty radar reads as a
        // calibrating display rather than a broken element.
        for (var i = 0; i < 12; i++)
        {
            var angle = (2 * Math.PI * i / 12) - (Math.PI / 2);
            var ax = 50 + Math.Cos(angle) * 35;
            var ay = 50 + Math.Sin(angle) * 35;
            radarAxisLines.AppendLine($"<line x1=\"50\" y1=\"50\" x2=\"{ax.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y2=\"{ay.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" stroke=\"currentColor\" stroke-width=\"0.3\" opacity=\"0.12\" />");
            var lx = 50 + Math.Cos(angle) * 44;
            var ly = 50 + Math.Sin(angle) * 44 + 1.2;
            radarLabelSvg.AppendLine($"<text x=\"{lx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{ly.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" font-size=\"3\" text-anchor=\"middle\" fill=\"currentColor\" opacity=\"0.5\">{clockLabels[i]}</text>");
        }
    }

    var radarFill   = Model.IsBot ? "rgba(239,68,68,0.22)" : "rgba(34,197,94,0.22)";
    var radarStroke = accent;

    var primarySig  = Model.Signatures?.PrimarySignature;
    var ipSig       = Model.Signatures?.IpSignature;
    var uaSig       = Model.Signatures?.UaSignature;
    var clientSig   = Model.Signatures?.ClientSideSignature;
}

@{
    var cardHref = !string.IsNullOrEmpty(primarySig)
        ? $"/dashboard/signature/{Uri.EscapeDataString(primarySig)}"
        : null;
}
<div class="bot-detection-container" data-sb-widget="your-detection">
    @* Whole upper card is one anchor to /dashboard/signature/<primary> -- visitor
       clicks anywhere on the LIVE header, radar, verdict, or reasons block and
       lands on their own signature detail page. The bottom Top Bots strip is a
       sibling (not nested inside this anchor) because it contains its own row
       anchors -- nesting <a> is invalid HTML and stops the inner clicks working.
       Razor can't keep an <a> open across an if-block, so we render the open
       tag (or its <div> fallback when no signature resolved) via Html.Raw. *@
    @{
        var upperOpen = cardHref is not null
            ? $"<a href=\"{System.Web.HttpUtility.HtmlAttributeEncode(cardHref)}\" class=\"block no-underline text-base-content hover:bg-base-content/[0.04] rounded transition-colors\" title=\"Open your signature detail · {System.Web.HttpUtility.HtmlAttributeEncode(primarySig ?? string.Empty)}\">"
            : "<div>";
        var upperClose = cardHref is not null ? "</a>" : "</div>";
    }
    @Html.Raw(upperOpen)
    @* Header: LIVE pulse + verdict badge + request id + timing -- all real signal, no fluff *@
    <div class="flex items-center justify-between gap-2 mb-3">
        <div class="flex items-center gap-2">
            <span class="sb-live-dot" aria-hidden="true"></span>
            <span class="text-[10px] font-bold uppercase tracking-wider text-base-content/60">Live · Your Detection</span>
            <span class="badge badge-xs @(Model.IsBot ? "badge-error" : "badge-success")">@verdictLabel</span>
        </div>
        <div class="text-[10px] text-base-content/40 tabular-nums">
            @Model.Timestamp.ToString("HH:mm:ss") · @Model.ProcessingTimeMs.ToString("F0")ms
        </div>
    </div>

    @* Two-column body: radar (left, 12-clock) + verdict/reason/pills (right) *@
    <div class="grid grid-cols-[140px_1fr] gap-4 items-center">
        <div class="text-base-content">
            @* While the canonical input is missing (live accumulator cold AND
               no persisted session yet) we show a "calibrating" placeholder
               instead of either an empty axis grid or a polygon derived from
               a different source. Drawing a polygon from RadarShape /
               detector contributions / anything else produces a shape that
               diverges from the dashboard signature-detail page, which IS a
               bug ("same fingerprint, two shapes"). Spin until the same
               input the detail page reads becomes available, then paint. *@
            @if (hasRadar)
            {
                <svg viewBox="0 0 100 100" width="140" height="140" xmlns="http://www.w3.org/2000/svg" aria-label="Behavioural fingerprint -- 12-axis clock projection">
                    <circle cx="50" cy="50" r="35" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.16" />
                    <circle cx="50" cy="50" r="23" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.10" />
                    <circle cx="50" cy="50" r="12" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.08" />
                    @Html.Raw(radarAxisLines.ToString())
                    <polygon points="@radarVertices.ToString().TrimEnd()" fill="@radarFill" stroke="@radarStroke" stroke-width="1.2" />
                    @Html.Raw(radarLabelSvg.ToString())
                </svg>
            }
            else
            {
                <div class="w-[140px] h-[140px] flex flex-col items-center justify-center gap-2 text-base-content/40"
                     aria-live="polite"
                     aria-label="Behavioural fingerprint calibrating">
                    <span class="loading loading-ring loading-md" style="color: currentColor;"></span>
                    <div class="text-[10px] uppercase tracking-wider text-center leading-tight">
                        Calibrating<br/>fingerprint
                    </div>
                </div>
            }
        </div>

        <div class="flex flex-col gap-2 min-w-0">
            <div class="flex items-baseline gap-3">
                <div>
                    <span class="text-2xl font-black" style="color: @accent;">@(probPct)%</span>
                    <span class="text-[10px] text-base-content/50 ml-1">bot probability</span>
                </div>
                <span class="badge badge-xs sb-risk-@(Model.RiskBand.ToLowerInvariant())">@Model.RiskBand</span>
                <span class="badge badge-xs sb-action-@recommendedAction.Item1.ToLowerInvariant()">@recommendedAction.Item1</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.BotName) || !string.IsNullOrEmpty(Model.BotType))
            {
                <div class="text-[11px] text-base-content/70">
                    Identified as <strong>@(Model.BotName ?? Model.BotType)</strong>
                </div>
            }

            @if (Model.TopReasons.Any())
            {
                <ul class="text-[10px] text-base-content/55 space-y-0.5 list-none p-0 m-0">
                    @foreach (var reason in Model.TopReasons.Take(3))
                    {
                        <li class="truncate" title="@reason">· @reason</li>
                    }
                </ul>
            }

            @* Signature pills removed by design -- the whole card is clickable
               (data-href on the root container) so visitors land on their own
               primary signature detail page without us cluttering the card with
               four hash chips three of which had no dashboard surface to drill
               into. The primary hash stays available as the wrapper's title
               for copy/paste. *@
        </div>
    </div>

    @Html.Raw(upperClose)

    @* Bottom strip: top 5 bots currently being seen. Sits OUTSIDE the upper-card
       anchor so SbTopBots's own per-row anchors keep their click behaviour --
       nesting them inside the outer <a> would invalidate the HTML and break
       row clicks. *@
    <div class="mt-4 pt-3 border-t border-base-content/10">
        <sb-top-bots page-size="5" filter="bots" sort="recent" widget-id="your-detection-topbots" />
    </div>
</div>
