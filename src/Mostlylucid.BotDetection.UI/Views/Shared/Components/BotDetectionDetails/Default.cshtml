@model Mostlylucid.BotDetection.UI.Models.DetectionDisplayModel
@inject Mostlylucid.BotDetection.UI.Services.IDashboardLinkResolver DashboardLinks

@if (!Model.HasData)
{
    <div class="bot-detection-no-data">
        <p>No bot detection data available</p>
    </div>
    return;
}

@{
    var recommendedAction = Model.BotProbability switch
    {
        >= 0.9 => ("Block",     "Very high confidence bot - immediate block recommended"),
        >= 0.7 => ("Challenge", "High confidence bot - CAPTCHA or verification recommended"),
        >= 0.5 => ("Throttle",  "Moderate bot signals - rate limiting recommended"),
        >= 0.3 => ("Monitor",   "Some bot signals - monitor behavior"),
        _      => ("Allow",     "Low bot probability - normal access")
    };
    var probPct  = (int)Math.Round(Model.BotProbability * 100);
    // No-plausible-defaults rule: render the percentage ONLY when there is real
    // detection data behind it. HasVerdict is set by the component whenever a real verdict is
    // present (in-flight detection OR the visitor's fingerprint) vs the unhydrated init-default
    // state -- so a fingerprint-sourced verdict on the viewer/YARP path (ProcessingTimeMs=0)
    // still shows its %, and only a truly unhydrated model shows "-". The gate lives on the
    // model so it is unit-testable (the 408c48ed regression was a view-only ProcessingTimeMs gate).
    var hasLiveData = Model.HasVerdict;
    var verdictClass = Model.IsBot ? "is-bot" : "is-human";
    var verdictLabel = Model.IsBot ? "Bot" : "Human";
    var accent       = Model.IsBot ? "#ef4444" : "#22c55e";

    var primarySig  = Model.Signatures?.PrimarySignature;
    var ipSig       = Model.Signatures?.IpSignature;
    var uaSig       = Model.Signatures?.UaSignature;
    var clientSig   = Model.Signatures?.ClientSideSignature;
}

@{
    // EntityId is the durable URL key -- it survives primary-signature rotation
    // and entity merges retroactively unify aliases (the redirect target updates
    // without breaking the URL). PrimarySig fallback covers requests where the
    // edge-headers hydrator hasn't populated EntityId yet (older gateways, or
    // a brand-new actor whose entity allocation is still flushing).
    var cardHref = !string.IsNullOrEmpty(Model.EntityId)
        ? DashboardLinks.Resolve($"/entity/{Uri.EscapeDataString(Model.EntityId)}")
        : !string.IsNullOrEmpty(primarySig)
            ? DashboardLinks.Resolve($"/signature/{Uri.EscapeDataString(primarySig)}")
            : null;
}
<div class="bot-detection-container" data-sb-widget="your-detection" x-data="{ tab: 'fp' }">
    @* Whole upper card is one anchor to /dashboard/signature/<primary> -- visitor
       clicks anywhere on the LIVE header, radar, verdict, or reasons block and
       lands on their own signature detail page. The bottom Top Bots strip is a
       sibling (not nested inside this anchor) because it contains its own row
       anchors -- nesting <a> is invalid HTML and stops the inner clicks working.
       Razor can't keep an <a> open across an if-block, so we render the open
       tag (or its <div> fallback when no signature resolved) via Html.Raw. *@
    @{
        var upperOpen = cardHref is not null
            ? $"<a href=\"{System.Web.HttpUtility.HtmlAttributeEncode(cardHref)}\" class=\"block no-underline text-base-content hover:bg-base-content/[0.04] rounded transition-colors\" title=\"Open your signature detail · {System.Web.HttpUtility.HtmlAttributeEncode(primarySig ?? string.Empty)}\">"
            : "<div>";
        var upperClose = cardHref is not null ? "</a>" : "</div>";
    }
    @* Persistent header: LIVE pulse + verdict badge + timing. Sits ABOVE the tabs so
       it stays visible on either tab -- all real signal, no fluff. *@
    <div class="flex items-center justify-between gap-2 mb-2">
        <div class="flex items-center gap-2">
            <span class="sb-live-dot" aria-hidden="true"></span>
            <span class="text-[10px] font-bold uppercase tracking-wider text-base-content/60">Live · Your Detection</span>
            <span class="badge badge-xs @(Model.IsBot ? "badge-error" : "badge-success")">@verdictLabel</span>
        </div>
        <div class="text-[10px] text-base-content/40 tabular-nums">
            @Model.Timestamp.ToString("HH:mm:ss") · @Model.ProcessingTimeMs.ToString("F0")ms
        </div>
    </div>

    @* Tab strip: Your Fingerprint (default) | Top Bots. The two were stacked before,
       which roughly doubled the card height; Alpine now renders only the active one so
       the control is compact by default. Buttons sit OUTSIDE the signature anchor so a
       tab click never navigates. Assumes Alpine, same as the component's other x- usage. *@
    <div class="flex items-center gap-1 mb-3 text-[11px]" role="tablist">
        <button type="button" role="tab" x-on:click="tab = 'fp'"
                :aria-selected="tab === 'fp'"
                :class="tab === 'fp' ? 'bg-base-content/10 font-semibold text-base-content' : 'text-base-content/50 hover:text-base-content/80'"
                class="px-2 py-1 rounded transition-colors">Your Fingerprint</button>
        <button type="button" role="tab" x-on:click="tab = 'bots'"
                :aria-selected="tab === 'bots'"
                :class="tab === 'bots' ? 'bg-base-content/10 font-semibold text-base-content' : 'text-base-content/50 hover:text-base-content/80'"
                class="px-2 py-1 rounded transition-colors">Top Bots</button>
    </div>

    @* --- Your Fingerprint tab (default) --- radar + verdict, wrapped in the signature
       anchor so the body stays clickable to the visitor's own detail page. *@
    <div x-show="tab === 'fp'">
        @Html.Raw(upperOpen)
        <div class="grid grid-cols-[140px_1fr] gap-4 items-center">
            <div class="text-base-content">
                @* Radar projects the visitor's behavioural-fingerprint centroid via
                   FingerprintRadarProjection: solid polygon = current shape, dotted (when
                   known) = archetype origin, the gap is drift since allocation. Calibrating
                   placeholder runs only pre-archetype-match. *@
                @await Html.PartialAsync("~/Views/Shared/_FingerprintShape.cshtml",
                    new FingerprintShapeViewModel(Model.FingerprintShape, Model.IsBot))
            </div>

            <div class="flex flex-col gap-2 min-w-0">
                <div class="flex items-baseline gap-3">
                    <div>
                        <span class="text-2xl font-black" style="color: @accent;">@(hasLiveData ? probPct + "%" : "-")</span>
                        <span class="text-[10px] text-base-content/50 ml-1">bot probability</span>
                    </div>
                    <span class="badge badge-xs sb-risk-@(Model.RiskBand.ToLowerInvariant())">@Model.RiskBand</span>
                    <span class="badge badge-xs sb-action-@recommendedAction.Item1.ToLowerInvariant()">@recommendedAction.Item1</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.BotName) || !string.IsNullOrEmpty(Model.BotType))
                {
                    <div class="text-[11px] text-base-content/70">
                        Identified as <strong>@(Model.BotName ?? Model.BotType)</strong>
                    </div>
                }

                @if (Model.TopReasons.Any())
                {
                    <ul class="text-[10px] text-base-content/55 space-y-0.5 list-none p-0 m-0">
                        @foreach (var reason in Model.TopReasons.Take(3))
                        {
                            <li class="truncate" title="@reason">· @reason</li>
                        }
                    </ul>
                }
            </div>
        </div>
        @Html.Raw(upperClose)
    </div>

    @* --- Top Bots tab --- inline display:none avoids a flash/layout-jump before Alpine
       inits (this bundle has no global [x-cloak] rule). SbTopBots keeps its own per-row
       anchors -- they are not nested in the signature anchor. *@
    <div x-show="tab === 'bots'" style="display: none;">
        <sb-top-bots page-size="5" filter="bots" sort="recent" widget-id="your-detection-topbots" />
    </div>
</div>
