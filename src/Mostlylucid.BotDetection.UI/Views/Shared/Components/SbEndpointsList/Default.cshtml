@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Primitives
@using Mostlylucid.BotDetection.UI.Services
@using Mostlylucid.BotDetection.UI.Helpers
@model EndpointsListModel
@{
    var bp = Model.BasePath;
    // URL builders honour every filter axis so navigating one axis preserves
    // the others. Sort + pagination changes drop back to page=1 so the new
    // ordering or filter isn't paged past its first page.
    string FilterQs(string statusOverride, string pathOverride, string audienceOverride)
        => $"status={Uri.EscapeDataString(statusOverride)}&path={Uri.EscapeDataString(pathOverride)}&audience={Uri.EscapeDataString(audienceOverride)}";
    string SortUrl(string field)
    {
        var dir = Model.SortField == field ? (Model.SortDir == "desc" ? "asc" : "desc") : "desc";
        return $"{bp}/partials/endpoints?sort={field}&dir={dir}&page=1&pageSize={Model.PageSize}&{FilterQs(Model.StatusFilter, Model.PathFilter, Model.AudienceFilter)}";
    }
    string PageUrl(int page) => $"{bp}/partials/endpoints?sort={Model.SortField}&dir={Model.SortDir}&page={page}&pageSize={Model.PageSize}&{FilterQs(Model.StatusFilter, Model.PathFilter, Model.AudienceFilter)}";
    string PageSizeUrl(int size) => $"{bp}/partials/endpoints?sort={Model.SortField}&dir={Model.SortDir}&page=1&pageSize={size}&{FilterQs(Model.StatusFilter, Model.PathFilter, Model.AudienceFilter)}";
    string StatusUrl(string bucket) => $"{bp}/partials/endpoints?sort={Model.SortField}&dir={Model.SortDir}&page=1&pageSize={Model.PageSize}&{FilterQs(bucket, Model.PathFilter, Model.AudienceFilter)}";
    string AudienceUrl(string audience) => $"{bp}/partials/endpoints?sort={Model.SortField}&dir={Model.SortDir}&page=1&pageSize={Model.PageSize}&{FilterQs(Model.StatusFilter, Model.PathFilter, audience)}";
    string SortIcon(string field) => Model.SortField == field ? (Model.SortDir == "asc" ? " \u25B2" : " \u25BC") : "";
    string ThClass(string field) => Model.SortField == field
        ? "text-base-content/70 font-bold"
        : "text-base-content/40 hover:text-base-content/60";
    string ChipClass(string bucket) => Model.StatusFilter.Equals(bucket, StringComparison.OrdinalIgnoreCase)
        ? "px-2 py-0.5 text-[10px] rounded-md font-semibold bg-primary/20 text-primary border border-primary/30"
        : "px-2 py-0.5 text-[10px] rounded-md text-base-content/60 hover:text-base-content/90 border border-base-content/15 hover:border-base-content/30 transition-colors";
    string AudienceChipClass(string audience) => Model.AudienceFilter.Equals(audience, StringComparison.OrdinalIgnoreCase)
        ? "px-2 py-0.5 text-[10px] rounded-md font-semibold bg-warning/20 text-warning border border-warning/30"
        : "px-2 py-0.5 text-[10px] rounded-md text-base-content/60 hover:text-base-content/90 border border-base-content/15 hover:border-base-content/30 transition-colors";
}
<div id="endpoints-list"
     data-sb-widget="endpoints"
     data-sb-depends="endpoints"
     data-sb-params="page=@Model.Page&sort=@Model.SortField&dir=@Model.SortDir&pageSize=@Model.PageSize"
     class="transition-colors duration-200">
    <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-1">
            <h3 class="text-sm font-bold text-base-content">Endpoints</h3>
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_HelpIcon.cshtml", "endpoints")
        </div>
        @if (Model.IsCommercial && Model.AllowEndpointPinning)
        {
            <button class="btn btn-xs btn-ghost gap-1 text-base-content/60"
                    data-action="toggle-pin-form">
                <i class="bx bx-pin text-sm"></i>Pin Endpoint
            </button>
        }
    </div>

    @* Filter bar: status-code chips + free-text path filter. Hidden on compact
       layouts (the half-width Activity card has no room for a second control
       row). Both controls drop back to page=1 so the new filter set is paged
       from the start. The path filter HTMX-debounces at 350ms so typing
       doesn't fire a request per keystroke. *@
    @if (!Model.IsCompact)
    {
        <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
            <span class="text-base-content/40 mr-1">Status</span>
            <a href="#" hx-get="@StatusUrl("all")"
               hx-target="#endpoints-list" hx-swap="outerHTML transition:true"
               class="@ChipClass("all")">All</a>
            <a href="#" hx-get="@StatusUrl("2xx")"
               hx-target="#endpoints-list" hx-swap="outerHTML transition:true"
               class="@ChipClass("2xx")">2xx</a>
            <a href="#" hx-get="@StatusUrl("3xx")"
               hx-target="#endpoints-list" hx-swap="outerHTML transition:true"
               class="@ChipClass("3xx")">3xx</a>
            <a href="#" hx-get="@StatusUrl("4xx")"
               hx-target="#endpoints-list" hx-swap="outerHTML transition:true"
               class="@ChipClass("4xx")">4xx</a>
            <a href="#" hx-get="@StatusUrl("5xx")"
               hx-target="#endpoints-list" hx-swap="outerHTML transition:true"
               class="@ChipClass("5xx")">5xx</a>

            @* Honeypot audience chip. Highlights rows whose path matches the
               static HoneypotPathDefinitions classifier (Always / Probable).
               Operators were missing the badge when IsHoneypot was always
               false; this filter + the population fix in
               GetEndpointStatsAsync make honeypot hits visible. *@
            <span class="text-base-content/30 mx-1">·</span>
            <a href="#" hx-get="@AudienceUrl("honeypot")"
               hx-target="#endpoints-list" hx-swap="outerHTML transition:true"
               class="@AudienceChipClass("honeypot")"
               title="Show only paths classified as honeypot (Always / Probable)">
                <i class="bx bx-radar text-[11px] mr-0.5"></i>Honeypot
            </a>
            @if (!Model.AudienceFilter.Equals("all", StringComparison.OrdinalIgnoreCase))
            {
                <a href="#" hx-get="@AudienceUrl("all")"
                   hx-target="#endpoints-list" hx-swap="outerHTML transition:true"
                   class="px-2 py-0.5 text-[10px] rounded-md text-base-content/60 hover:text-base-content/90 border border-base-content/15 hover:border-base-content/30 transition-colors"
                   title="Clear audience filter">Clear</a>
            }

            <span class="text-base-content/30 mx-1">·</span>
            <input type="text" name="path" value="@Model.PathFilter"
                   placeholder="filter path…"
                   class="input input-xs input-bordered w-44 font-mono"
                   hx-get="@(bp)/partials/endpoints?sort=@Model.SortField&dir=@Model.SortDir&page=1&pageSize=@Model.PageSize&status=@Uri.EscapeDataString(Model.StatusFilter)"
                   hx-target="#endpoints-list" hx-swap="outerHTML transition:true"
                   hx-trigger="keyup changed delay:350ms, search"
                   hx-include="this" />
        </div>
    }
    @if (Model.IsCommercial && Model.AllowEndpointPinning)
    {
        <div id="pin-endpoint-form" class="hidden mb-4 p-3 bg-base-200 rounded-lg">
            <form hx-post="@(bp)/api/endpoint-pins"
                  hx-target="#endpoints-list"
                  hx-swap="outerHTML"
                  hx-on::after-request="if(event.detail.successful){this.reset();document.getElementById('pin-endpoint-form').classList.add('hidden')}"
                  class="space-y-2">
                <div class="flex gap-2">
                    <select name="method" class="select select-xs select-bordered w-28 font-mono">
                        <option value="ANY">ANY</option>
                        <option value="GET">GET</option>
                        <option value="POST">POST</option>
                        <option value="PUT">PUT</option>
                        <option value="DELETE">DELETE</option>
                        <option value="PATCH">PATCH</option>
                    </select>
                    <input name="path" type="text" placeholder="/config.php"
                           class="input input-xs input-bordered flex-1 font-mono"
                           required pattern="\/.*" maxlength="500" />
                </div>
                <div class="flex items-center gap-4">
                    <label class="flex items-center gap-1.5 text-xs cursor-pointer">
                        <input type="checkbox" name="isHoneypot" value="true" class="checkbox checkbox-xs" />
                        Mark as honeypot
                    </label>
                    <input name="note" type="text" placeholder="Optional note"
                           class="input input-xs input-bordered flex-1" maxlength="200" />
                </div>
                <div class="flex gap-2 justify-end">
                    <button type="button" class="btn btn-xs btn-ghost"
                            data-action="hide-pin-form">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-xs btn-primary">
                        <i class="bx bx-pin mr-1"></i>Pin Endpoint
                    </button>
                </div>
            </form>
        </div>
    }
    @if (Model.Endpoints.Count == 0)
    {
        <div class="text-xs text-base-content/40 py-8 text-center">No endpoint analytics yet</div>
    }
    else
    {
        @* Compact mode (right column of the Activity tab) shows the panel inside a
           half-page card. Latency/Bytes/Sigs/Policy/Split don't fit there, so they
           are dropped, and `overflow-x-auto` is replaced with the tooltip-safe
           `.sb-table-scroll` wrapper so daisyUI cell tooltips can escape vertically. *@
        var compact = Model.IsCompact;
        <div class="@(compact ? "sb-table-scroll" : "overflow-x-auto") rounded-xl border" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <table class="table table-xs w-full">
                <thead>
                @* Column order follows the operator's eye:
                   Method (the verb), Path (the noun), then the three signals --
                   Bot Pressure (graphical), Threat (graphical), Hits (volume) --
                   then latency, sigs, policy, and the human/bot split bar.
                   Mirrors the Top Bots row vocabulary so an operator switching
                   between the two tables doesn't relearn columns. *@
                <tr class="text-[10px] uppercase tracking-wider">
                    <th class="py-1 @ThClass("method") cursor-pointer" hx-get="@SortUrl("method")" hx-target="#endpoints-list" hx-swap="outerHTML transition:true">Method@(Html.Raw(SortIcon("method")))</th>
                    <th class="py-1 @ThClass("path") cursor-pointer" hx-get="@SortUrl("path")" hx-target="#endpoints-list" hx-swap="outerHTML transition:true">Path@(Html.Raw(SortIcon("path")))</th>
                    <th class="py-1 text-center @ThClass("botrate") cursor-pointer" hx-get="@SortUrl("botrate")" hx-target="#endpoints-list" hx-swap="outerHTML transition:true" title="Bot pressure: bot hits as a fraction of total in the trailing window">Bot Pressure@(Html.Raw(SortIcon("botrate")))</th>
                    <th class="py-1 text-center @ThClass("threat") cursor-pointer @(compact ? "" : "hidden md:table-cell")" hx-get="@SortUrl("threat")" hx-target="#endpoints-list" hx-swap="outerHTML transition:true">Threat@(Html.Raw(SortIcon("threat")))</th>
                    <th class="py-1 text-right @ThClass("total") cursor-pointer" hx-get="@SortUrl("total")" hx-target="#endpoints-list" hx-swap="outerHTML transition:true">Hits@(Html.Raw(SortIcon("total")))</th>
                    @if (!compact)
                    {
                        <th class="py-1 text-right @ThClass("latency") cursor-pointer hidden md:table-cell whitespace-nowrap" hx-get="@SortUrl("latency")" hx-target="#endpoints-list" hx-swap="outerHTML transition:true" title="Avg / p95 ms">Latency@(Html.Raw(SortIcon("latency")))</th>
                        <th class="py-1 text-right @ThClass("bytes") cursor-pointer hidden md:table-cell" hx-get="@SortUrl("bytes")" hx-target="#endpoints-list" hx-swap="outerHTML transition:true" title="Total response bytes served (Content-Length sum)">Bytes@(Html.Raw(SortIcon("bytes")))</th>
                        <th class="py-1 text-right @ThClass("unique") cursor-pointer hidden lg:table-cell" hx-get="@SortUrl("unique")" hx-target="#endpoints-list" hx-swap="outerHTML transition:true">Sigs@(Html.Raw(SortIcon("unique")))</th>
                        <th class="py-1 hidden lg:table-cell text-base-content/40">Policy</th>
                        <th class="py-1 text-xs hidden md:table-cell" style="min-width:60px">Split</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var endpoint in Model.Endpoints)
                {
                    var humanPct = endpoint.TotalCount > 0 ? Math.Round((1.0 - endpoint.BotRate) * 100, 0) : 100;
                    // Reuse the same primitives the Top Bots row uses so the two
                    // tables read consistently. Bot Pressure -> RiskBar (5-segment
                    // probability-keyed); Threat -> filled-shield ThreatIcon
                    // driven by the avg threat score collapsed to a band.
                    // No AvgThreatBand on DashboardEndpointStats -- derive a band
                    // from AvgThreatScore so the ThreatIcon picks the right shield
                    // shape + colour. Same thresholds the detection pipeline uses
                    // to band per-request threat scores.
                    var threatBand = endpoint.AvgThreatScore switch
                    {
                        >= 0.80 => "Critical",
                        >= 0.60 => "High",
                        >= 0.40 => "Medium",
                        >= 0.20 => "Low",
                        _       => "None",
                    };
                    var pressureBar = new RiskBarModel(endpoint.BotRate, threatBand);
                    var threatIcon  = new ThreatIconModel(threatBand, endpoint.BotRate);
                    var methodColor = endpoint.Method switch
                    {
                        "GET"    => "var(--color-info,    #38bdf8)",
                        "POST"   => "var(--color-success, #22c55e)",
                        "PUT"    => "var(--color-warning, #f59e0b)",
                        "DELETE" => "var(--color-error,   #ef4444)",
                        "PATCH"  => "#c084fc",
                        _        => "rgba(148,163,184,0.7)"
                    };
                    @* Inline-detail row: HTMX-swaps the per-endpoint detail into the
                       sticky #endpoint-detail-panel that lives alongside this list
                       (see _Endpoints.cshtml). Replaces the old data-href which
                       navigated to /dashboard/endpoint as a separate full page.
                       hx-push-url keeps the URL deep-linkable (?selected=METHOD%20PATH);
                       hx-on::after-request toggles the row highlight. *@
                    <tr class="endpoint-row hover:bg-base-200/50 transition-colors cursor-pointer"
                        data-endpoint-key="@(endpoint.Method)|@(endpoint.Path)"
                        hx-get="@bp/partials/endpoint-detail?method=@Uri.EscapeDataString(endpoint.Method)&path=@Uri.EscapeDataString(endpoint.Path)"
                        hx-target="#endpoint-detail-panel"
                        hx-swap="innerHTML"
                        hx-push-url="@bp/endpoints?selected=@Uri.EscapeDataString(endpoint.Method + "|" + endpoint.Path)"
                        hx-on::before-request="document.querySelectorAll('tr.endpoint-row.is-selected').forEach(r => r.classList.remove('is-selected'));this.classList.add('is-selected')"
                        title="Show @endpoint.Method @endpoint.Path detail in panel →">
                        <td class="py-1 text-[10px] font-bold" style="color: @methodColor;">@endpoint.Method</td>
                        <td class="py-1 text-xs font-medium max-w-[280px] truncate" title="@endpoint.Path">
                            @if (endpoint.IsPinned)
                            {
                                <i class="bx bx-pin text-base-content/30 mr-0.5" title="Pinned"></i>
                            }
                            @if (endpoint.IsHoneypot)
                            {
                                <i class="bx bxs-bug text-warning mr-0.5" title="Honeypot"></i>
                            }
                            <span class="font-mono">@endpoint.Path</span>
                        </td>
                        <td class="py-1 text-center">
                            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_RiskBar.cshtml", pressureBar)
                        </td>
                        <td class="py-1 text-center @(compact ? "" : "hidden md:table-cell")">
                            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_ThreatIcon.cshtml", threatIcon)
                        </td>
                        <td class="py-1 text-right text-xs font-mono tabular-nums">@endpoint.TotalCount</td>
                        @if (!compact)
                        {
                            <td class="py-1 text-right text-xs hidden md:table-cell font-mono tabular-nums whitespace-nowrap"
                                title="min @BotDisplayHelpers.FormatProcessingTime(endpoint.MinProcessingTimeMs) · avg @BotDisplayHelpers.FormatProcessingTime(endpoint.AvgProcessingTimeMs) · p95 @BotDisplayHelpers.FormatProcessingTime(endpoint.P95ProcessingTimeMs) · max @BotDisplayHelpers.FormatProcessingTime(endpoint.MaxProcessingTimeMs)">
                                <span>@BotDisplayHelpers.FormatProcessingTime(endpoint.AvgProcessingTimeMs)</span>
                                <span class="text-base-content/40">/</span>
                                <span class="text-base-content/70">@BotDisplayHelpers.FormatProcessingTime(endpoint.P95ProcessingTimeMs)</span>
                            </td>
                            <td class="py-1 text-right text-xs font-mono tabular-nums hidden md:table-cell" title="Total response bytes served">@AnalyticsFormatting.FormatBytes(endpoint.BytesOut)</td>
                            <td class="py-1 text-right text-xs font-mono hidden lg:table-cell">@endpoint.UniqueSignatures</td>
                            <td class="py-1 hidden lg:table-cell">
                                <div class="flex items-center gap-1">
                                    @if (!string.IsNullOrEmpty(endpoint.ActivePolicyName))
                                    {
                                        <span class="text-[9px] px-1.5 py-0.5 rounded-full bg-base-300 text-base-content/60 font-medium">@endpoint.ActivePolicyName</span>
                                    }
                                    <button type="button"
                                            title="Apply policy to this endpoint"
                                            class="btn btn-ghost btn-xs p-0.5 min-h-0 h-auto"
                                            data-action="open-policy-modal"
                                            data-method="@endpoint.Method"
                                            data-path="@Uri.EscapeDataString(endpoint.Path)"
                                            data-policy="@(endpoint.ActivePolicyName ?? string.Empty)">
                                        <i class="bx bx-shield-alt text-[11px] text-base-content/30 hover:text-base-content/70"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="py-1 hidden md:table-cell" title="@humanPct% human / @(100 - humanPct)% bot">
                                <div class="flex h-2 rounded-full overflow-hidden" style="background: rgba(148,163,184,0.18); min-width:60px;">
                                    <div style="background: var(--color-success, #22c55e); width:@(humanPct)%;"></div>
                                    <div style="background: var(--color-error,   #ef4444); width:@(100 - humanPct)%;"></div>
                                </div>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_TablePagination.cshtml",
            new TablePaginationModel(
                Page: Model.Page,
                PageSize: Model.PageSize,
                TotalCount: Model.TotalCount,
                PageUrl: PageUrl,
                PageSizeUrl: PageSizeUrl,
                TargetId: "endpoints-list"))
    }
</div>
