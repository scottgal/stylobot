@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Primitives
@using Mostlylucid.BotDetection.UI.Helpers
@using Mostlylucid.BotDetection.UI.Services
@inject IFingerprintNameActionSlot NameActionSlot
@model VisitorListModel
@{
    var bp = Model.BasePath;

    // V1 (dashboard IA collapse plan): URL filters propagate through every
    // filter / sort / pagination link so an HTMX swap preserves the chips +
    // pill state. Removable chips use ?remove= semantics matching Traffic T4.
    string FilterQs(string? remove = null)
    {
        var qs = new System.Collections.Generic.List<string>();
        if (!string.IsNullOrEmpty(Model.Country) && remove != "country")
            qs.Add($"country={Uri.EscapeDataString(Model.Country)}");
        if (!string.IsNullOrEmpty(Model.BotType) && remove != "bot_type")
            qs.Add($"bot_type={Uri.EscapeDataString(Model.BotType)}");
        if (!string.IsNullOrEmpty(Model.Threat) && remove != "threat")
            qs.Add($"threat={Uri.EscapeDataString(Model.Threat)}");
        if (!string.IsNullOrEmpty(Model.FingerprintId) && remove != "fingerprint")
            qs.Add($"fingerprint={Uri.EscapeDataString(Model.FingerprintId)}");
        if (Model.Internal && remove != "internal")
            qs.Add("internal=true");
        return qs.Count == 0 ? "" : "&" + string.Join("&", qs);
    }
    var carry = FilterQs();

    string FilterUrl(string filter) => $"{bp}/partials/visitors?filter={filter}&sort={Model.SortField}&dir={Model.SortDir}&page=1&pageSize={Model.PageSize}{carry}";
    string InternalToggleUrl()
    {
        // Internal acts as a sibling toggle to the audience pills — independent
        // axis. Clicking it strips the current ?internal carry and sets the
        // opposite. Audience filter (Filter) is preserved across the toggle.
        var nextCarry = FilterQs("internal");
        var nextInternal = Model.Internal ? "" : "&internal=true";
        return $"{bp}/partials/visitors?filter={Model.Filter}&sort={Model.SortField}&dir={Model.SortDir}&page=1&pageSize={Model.PageSize}{nextCarry}{nextInternal}";
    }
    string ChipRemoveUrl(string remove) => $"{bp}/partials/visitors?filter={Model.Filter}&sort={Model.SortField}&dir={Model.SortDir}&page=1&pageSize={Model.PageSize}{FilterQs(remove)}";
    string SortUrl(string field) {
        var dir = Model.SortField == field ? (Model.SortDir == "desc" ? "asc" : "desc") : "desc";
        return $"{bp}/partials/visitors?filter={Model.Filter}&sort={field}&dir={dir}&page=1&pageSize={Model.PageSize}{carry}";
    }
    string PageUrl(int page) => $"{bp}/partials/visitors?filter={Model.Filter}&sort={Model.SortField}&dir={Model.SortDir}&page={page}&pageSize={Model.PageSize}{carry}";
    string PageSizeUrl(int size) => $"{bp}/partials/visitors?filter={Model.Filter}&sort={Model.SortField}&dir={Model.SortDir}&page=1&pageSize={size}{carry}";
    string SortIcon(string field) => Model.SortField == field ? (Model.SortDir == "asc" ? "▲" : "▼") : "";
    string SortHeaderClass(string field) => Model.SortField == field
        ? "text-base-content font-semibold cursor-pointer"
        : "text-base-content/40 hover:text-base-content/60 cursor-pointer";
    string FilterBtnClass(string f) => Model.Filter == f
        ? f switch { "bots" => "bg-error/20 text-error shadow-sm", "humans" => "bg-success/20 text-success shadow-sm", _ => "bg-base-100 shadow-sm text-base-content" }
        : "text-base-content/40 hover:text-base-content/60";
    string InternalBtnClass() => Model.Internal
        ? "bg-info/20 text-info shadow-sm"
        : "text-base-content/40 hover:text-base-content/60";

    // Parse the major version out of "Chrome/124.0.6367.91 Safari/537.36" or "curl/8.5.0" etc.
    // Falls back to empty when the UA has no recognisable major version.
    static string ExtractMajorVersion(string? ua, string? family)
    {
        if (string.IsNullOrEmpty(ua) || string.IsNullOrEmpty(family)) return "";
        var pattern = System.Text.RegularExpressions.Regex.Escape(family) + @"[/ ](\d+)";
        var m = System.Text.RegularExpressions.Regex.Match(ua, pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return m.Success ? m.Groups[1].Value : "";
    }
}
<div id="visitor-list"
     data-sb-widget="visitors"
     data-sb-depends="signature,summary"
     data-sb-params="page=@Model.Page&filter=@Model.Filter&sort=@Model.SortField&dir=@Model.SortDir&pageSize=@Model.PageSize">

    @* Filter chips (counts visible on each) *@
    <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
        <div class="flex items-center gap-1 bg-base-300/50 rounded-lg p-0.5 flex-wrap">
            <button hx-get="@FilterUrl("all")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                    class="px-3 py-1 text-xs font-medium rounded-md @FilterBtnClass("all")">
                All <span class="text-[10px] opacity-60">@Model.Counts.All</span>
            </button>
            <button hx-get="@FilterUrl("humans")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                    class="px-3 py-1 text-xs font-medium rounded-md @FilterBtnClass("humans")">
                Humans <span class="text-[10px] opacity-60">@Model.Counts.Humans</span>
            </button>
            <button hx-get="@FilterUrl("bots")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                    class="px-3 py-1 text-xs font-medium rounded-md @FilterBtnClass("bots")">
                Bots <span class="text-[10px] opacity-60">@Model.Counts.Bots</span>
            </button>
            <button hx-get="@FilterUrl("ai")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                    class="px-3 py-1 text-xs font-medium rounded-md @FilterBtnClass("ai")">
                AI <span class="text-[10px] opacity-60">@Model.Counts.Ai</span>
            </button>
            <button hx-get="@FilterUrl("tools")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                    class="px-3 py-1 text-xs font-medium rounded-md @FilterBtnClass("tools")">
                Tools <span class="text-[10px] opacity-60">@Model.Counts.Tools</span>
            </button>
            @* V1: Internal pill — toggles ?internal=true on top of the audience
               filter. Uses info colour (uncertain/neutral) per canonical
               semantics: internal traffic isn't risk-graded by itself. *@
            <button hx-get="@InternalToggleUrl()" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                    title="Toggle internal / local-network traffic"
                    class="px-3 py-1 text-xs font-medium rounded-md @InternalBtnClass()">
                Internal <span class="text-[10px] opacity-60">@Model.Counts.Internal</span>
            </button>
        </div>
        @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_HelpIcon.cshtml", "visitors")
    </div>

    @* V1: Active URL-filter chips — removable. Hidden when no URL filter is set.
       Mirrors the T4 pattern on Traffic so the operator sees what's narrowing
       the table at a glance, and can drop a single facet without rebuilding
       the URL. *@
    @if (!string.IsNullOrEmpty(Model.Country) || !string.IsNullOrEmpty(Model.BotType)
         || !string.IsNullOrEmpty(Model.Threat) || !string.IsNullOrEmpty(Model.FingerprintId)
         || Model.Internal)
    {
        <div class="flex items-center gap-1 mb-2 flex-wrap">
            @if (!string.IsNullOrEmpty(Model.Country))
            {
                <a hx-get="@ChipRemoveUrl("country")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                   class="badge badge-sm gap-1 cursor-pointer" title="Clear country filter">
                    Country: @Model.Country <span aria-hidden="true">×</span>
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.BotType))
            {
                <a hx-get="@ChipRemoveUrl("bot_type")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                   class="badge badge-sm gap-1 cursor-pointer" title="Clear bot-type filter">
                    Bot: @Model.BotType <span aria-hidden="true">×</span>
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.Threat))
            {
                <a hx-get="@ChipRemoveUrl("threat")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                   class="badge badge-sm badge-warning gap-1 cursor-pointer" title="Clear threat filter">
                    Threat ≥ @Model.Threat.TrimEnd('+') <span aria-hidden="true">×</span>
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.FingerprintId))
            {
                var fpLabel = Model.FingerprintId.Length > 12
                    ? Model.FingerprintId.Substring(0, 12) + "…"
                    : Model.FingerprintId;
                <a hx-get="@ChipRemoveUrl("fingerprint")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                   class="badge badge-sm gap-1 cursor-pointer font-mono" title="Clear fingerprint filter: @Model.FingerprintId">
                    fp: @fpLabel <span aria-hidden="true">×</span>
                </a>
            }
            @if (Model.Internal)
            {
                <a hx-get="@ChipRemoveUrl("internal")" hx-target="#visitor-list" hx-swap="outerHTML transition:true"
                   class="badge badge-sm badge-info gap-1 cursor-pointer" title="Clear Internal filter">
                    Internal <span aria-hidden="true">×</span>
                </a>
            }
        </div>
    }

    @* Visitors table. Outer .overflow-auto keeps thead frozen above the rolling tbody.
       ONE region, one swap (same fix as SbTopBots, operator P0 2026-08-09): the tbody
       used to be its own data-region, swapped independently of the widget root's
       header/counts on a SignalR beacon -- the same two-independently-timed-swaps shape
       that let Top Bots' badge and rows disagree. WidgetRenderHelpers.InjectOobAttribute
       falls back to morphing the whole first tag when no data-region marker is present,
       so removing the marker is the whole fix here too. *@
    @if (Model.IsWarming)
    {
        <div id="visitor-rows" class="flex items-center justify-center py-4">
            <span class="text-base-content/40">No data</span>
        </div>
    }
    else if (Model.Visitors.Count == 0)
    {
        <div id="visitor-rows" class="text-center text-base-content/30 py-12 text-sm">
            No visitors match this filter
        </div>
    }
    else
    {
        <div class="overflow-auto rounded-lg border border-base-300/40">
            <table class="table table-xs w-full">
                <thead class="bg-base-300/30 text-[10px] uppercase tracking-wider sticky top-0">
                    <tr>
                        <th class="py-1 w-6"></th>
                        <th class="py-1 @SortHeaderClass("name")"
                            hx-get="@SortUrl("name")" hx-target="#visitor-list" hx-swap="outerHTML transition:true">
                            Name @Html.Raw(SortIcon("name"))
                        </th>
                        @* Drift column: empty header, the badge itself carries
                           the semantics ("drifted N.NN" with tooltip). No sort
                           on this column -- the operator filters via the
                           existing Bots/Humans/AI chips, not by drift. *@
                        <th class="py-1 w-6"></th>
                        <th class="py-1 text-base-content/40">UA</th>
                        <th class="py-1 text-base-content/40">Ver</th>
                        <th class="py-1 text-base-content/40">Bot type</th>
                        <th class="py-1 text-right @SortHeaderClass("risk")"
                            hx-get="@SortUrl("risk")" hx-target="#visitor-list" hx-swap="outerHTML transition:true">
                            Risk Profile @Html.Raw(SortIcon("risk"))
                        </th>
                        <th class="py-1 text-right text-base-content/40">Prob</th>
                        <th class="py-1 text-right @SortHeaderClass("hits")"
                            hx-get="@SortUrl("hits")" hx-target="#visitor-list" hx-swap="outerHTML transition:true">
                            Hits @Html.Raw(SortIcon("hits"))
                        </th>
                        <th class="py-1 text-base-content/40">Action</th>
                        <th class="py-1 text-right @SortHeaderClass("lastSeen")"
                            hx-get="@SortUrl("lastSeen")" hx-target="#visitor-list" hx-swap="outerHTML transition:true">
                            Seen @Html.Raw(SortIcon("lastSeen"))
                        </th>
                    </tr>
                </thead>
                <tbody id="visitor-rows">
                    @foreach (var v in Model.Visitors)
                    {
                        // SINGLE canonical name path. Resolve runs custom > catalog >
                        // Arcjet UA > uap-core > country composite > honest terminal.
                        var displayName = v.BotName;
                        var probPct = (v.BotProbability * 100).ToString("F0");
                        var probClass = v.RiskBand switch { "VeryHigh" or "High" => "text-error", "Medium" or "Elevated" => "text-warning", _ => "text-success" };
                        var riskBadge = v.RiskBand switch { "VeryHigh" => "badge-error", "High" => "badge-error", "Medium" => "badge-warning", "Elevated" => "badge-warning", "Low" => "badge-success", _ => "badge-ghost" };
                        var actionClass = ActionDisplayHelper.GetBadgeCssClass(v.Action);
                        var actionLabel = ActionDisplayHelper.GetFriendlyName(v.Action);
                        var uaFamily = string.IsNullOrEmpty(v.UaFamily) ? "-" : v.UaFamily;
                        var uaVersion = ExtractMajorVersion(v.UserAgent, v.UaFamily);
                        @* Real row navigation (operator directive 2026-08-12: EVERYTHING
                           drills down — the bot name must navigate to the signature
                           detail page). The name cell wraps a real <a> (right-click /
                           cmd-click work); the row-level onclick was CSP-blocked and
                           silently dead — removed (2026-08-13 link audit). *@
                        <tr class="hover:bg-base-300/40"
                            data-href="@bp/signature/@Uri.EscapeDataString(v.PrimarySignature)">
                            <td class="py-1 w-6">
                                @if (!string.IsNullOrEmpty(v.CountryCode) && v.CountryCode.Length == 2 && v.CountryCode != "XX")
                                {
                                    <img src="/_content/Mostlylucid.BotDetection.UI/flags/@(v.CountryCode.ToLowerInvariant()).svg"
                                         alt="@v.CountryCode" class="w-4 h-3 rounded-sm" loading="lazy" />
                                }
                            </td>
                            @* Name cell: long names like "Chrome Privacy Preserving Prefetch Proxy"
                               or "Amazonbot developer.amazon.com" can run past 200px. Tailwind
                               'truncate' on a <td> in an auto-layout table does not constrain
                               an inline child, so the span used to bust the cell width and
                               overflow into the drift column. The fix is to put the truncate
                               on a block-level child whose max-width is the cell's max-width. *@
                            <td class="py-1 max-w-[200px]"
                                title="@displayName — Signature: @v.PrimarySignature">
                                <div class="flex items-center gap-1 min-w-0">
                                    <a href="@bp/signature/@Uri.EscapeDataString(v.PrimarySignature)"
                                       class="block truncate font-medium text-xs hover:underline"
                                       aria-label="@displayName — signature detail">@displayName</a>
                                    @NameActionSlot.Render(v.PrimarySignature, displayName ?? v.PrimarySignature, v.BotType, v.BotProbability)
                                </div>
                            </td>
                            <td class="py-1 w-6">
                                @* Drift badge -- gateway-projected, threshold-crossed.
                                   Partial renders nothing when IsDrifted is false, so
                                   non-drifted rows leave the cell empty. Lives next to
                                   the name column because drift is naming-adjacent
                                   context: "this identity has shifted from its origin
                                   archetype". *@
                                @if (v.DriftBadge is { } badge)
                                {
                                    @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_DriftBadge.cshtml", badge)
                                }
                            </td>
                            <td class="py-1 text-xs text-base-content/70">@uaFamily</td>
                            <td class="py-1 text-xs text-base-content/50 font-mono">@(string.IsNullOrEmpty(uaVersion) ? "-" : uaVersion)</td>
                            <td class="py-1 text-xs text-base-content/60">@(v.BotType ?? (v.IsBot ? "Bot" : "Human"))</td>
                            <td class="py-1 text-right">
                                <span class="badge badge-xs @riskBadge">@v.RiskBand</span>
                            </td>
                            <td class="py-1 text-right text-xs font-bold @probClass">@probPct%</td>
                            <td class="py-1 text-right text-xs">@v.Hits</td>
                            <td class="py-1 text-xs">
                                @if (!string.IsNullOrEmpty(v.Action))
                                {
                                    <span class="badge badge-xs @actionClass">@actionLabel</span>
                                }
                            </td>
                            <td class="py-1 text-right text-xs text-base-content/50 whitespace-nowrap">@BotDisplayHelpers.TimeAgoCompact(v.LastSeen)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_TablePagination.cshtml",
        new TablePaginationModel(
            Page: Model.Page,
            PageSize: Model.PageSize,
            TotalCount: Model.TotalCount,
            PageUrl: PageUrl,
            PageSizeUrl: PageSizeUrl,
            TargetId: "visitor-list"))
</div>
