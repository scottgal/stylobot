@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Primitives
@model ThreatsListModel
@{
    var bp = Model.BasePath;
}

<div id="threats-widget" data-sb-widget="threats" data-sb-depends="threats" data-sb-params="page=@Model.Page&pageSize=@Model.PageSize">
    <div class="card bg-base-200 transition-colors duration-200">
        <div class="card-body p-3">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-1">
                    <h3 class="text-sm font-bold text-base-content">Threat Intelligence</h3>
                    @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_HelpIcon.cshtml", "threats")
                </div>
                <div class="flex items-center gap-2">
                    <span class="badge badge-error badge-sm">@Model.Threats.Count(t => t.CveSeverity == "critical") Critical</span>
                    <span class="badge badge-warning badge-sm">@Model.Threats.Count(t => t.CveSeverity == "high") High</span>
                    <span class="badge badge-info badge-sm">@Model.Threats.Count(t => t.InHoneypot) In Honeypot</span>
                </div>
            </div>

            @if (!Model.Threats.Any())
            {
                <div class="text-center py-6 text-base-content/50">
                    <p class="text-sm">No live threat activity detected yet.</p>
                    <p class="text-xs mt-1">CVE probes and honeypot engagements will appear here.
                        Meanwhile, the threat-intel feeds we ingest are listed below.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="table table-xs table-zebra w-full">
                        <thead>
                            <tr class="text-[10px] uppercase tracking-wider">
                                <th class="py-1">Time</th>
                                <th class="py-1">CVE</th>
                                <th class="py-1">Severity</th>
                                <th class="py-1">Path</th>
                                <th class="py-1">Bot</th>
                                <th class="py-1">Threat</th>
                                <th class="py-1">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                // ONE name per fingerprint, written by FingerprintNameComposer.
                            }
                            @foreach (var threat in Model.Threats)
                            {
                                <tr class="hover:bg-base-300/40 cursor-pointer @(threat.InHoneypot ? "bg-error/5" : "")"
                                    data-href="@bp/signature/@Uri.EscapeDataString(threat.Signature)">
                                    <td class="text-xs whitespace-nowrap">@threat.Timestamp.ToString("HH:mm:ss")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(threat.CveId))
                                        {
                                            <a href="https://nvd.nist.gov/vuln/detail/@threat.CveId" target="_blank" rel="noopener"
                                               class="link link-primary text-xs font-mono">@threat.CveId</a>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-base-content/40">-</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var severityClass = threat.CveSeverity switch
                                            {
                                                "critical" => "badge-error",
                                                "high" => "badge-warning",
                                                "medium" => "badge-info",
                                                _ => "badge-ghost"
                                            };
                                        }
                                        <span class="badge @severityClass badge-xs">@(threat.CveSeverity ?? "probe")</span>
                                    </td>
                                    <td class="text-xs font-mono max-w-[200px] truncate" title="@threat.Path">@threat.Path</td>
                                    <td class="text-xs" title="@SignatureDisplayName.TitleAttr(threat.Signature)">@SignatureDisplayName.Resolve(threat.Signature, threat.BotName, threat.BotType, customLabel: null, threat.CountryCode, isBot: threat.BotProbability >= 0.5, uaFamily: null, seen: null, userAgent: threat.UserAgent)</td>
                                    <td>
                                        @{
                                            var threatClass = threat.ThreatScore switch
                                            {
                                                >= 0.8 => "text-error",
                                                >= 0.55 => "text-warning",
                                                >= 0.35 => "text-info",
                                                _ => "text-base-content/50"
                                            };
                                        }
                                        <span class="text-xs font-semibold @threatClass">@threat.ThreatScore.ToString("F2")</span>
                                    </td>
                                    <td>
                                        @if (threat.InHoneypot)
                                        {
                                            <span class="badge badge-error badge-xs gap-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-error animate-pulse"></span>
                                                Honeypot
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-ghost badge-xs">Detected</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_TablePagination.cshtml",
                    new TablePaginationModel(
                        Page: Model.Page,
                        PageSize: Model.PageSize,
                        TotalCount: Model.TotalCount,
                        PageUrl: p => $"{bp}/partials/threats?page={p}&pageSize={Model.PageSize}",
                        PageSizeUrl: s => $"{bp}/partials/threats?page=1&pageSize={s}",
                        TargetId: "threats-widget"))
            }
        </div>
    </div>

    @* Ingested threat-intel feeds always render below the live-detections list. So the
       tab shows SOMETHING even when no live threats have been detected yet -- the operator
       can see which feeds are loaded, how big each cache is, and when each one last refreshed.
       The Threats tab is the right home for both: "what we've seen" + "what we've armed". *@
    <div class="mt-4">
        <sb-threat-intel-tab />
    </div>
</div>
