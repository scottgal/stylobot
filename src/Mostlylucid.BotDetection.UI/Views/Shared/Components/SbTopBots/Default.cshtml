@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Primitives
@using Mostlylucid.BotDetection.UI.Services
@using Mostlylucid.BotDetection.UI.Helpers
@inject IFingerprintNameActionSlot NameActionSlot
@model TopBotsListModel
@{
    var bp = Model.BasePath;
    var navBp = Model.ResolvedNavBasePath;

    // URL builders. Caller-side URL construction so the partials stay pure.
    string PartialUrl(string filter, string sortField, string sortDir, int page, int pageSize) =>
        $"{bp}/partials/topbots?filter={filter}&sort={sortField}&dir={sortDir}&page={page}&pageSize={pageSize}&widgetId={Model.WidgetId}";

    string SortUrl(string field) {
        var dir = Model.SortField == field ? (Model.SortDir == "desc" ? "asc" : "desc") : "desc";
        return PartialUrl(Model.Filter, field, dir, 1, Model.PageSize);
    }
    string FilterUrl(string filter)   => PartialUrl(filter,     Model.SortField, Model.SortDir, 1,          Model.PageSize);
    string PageUrl(int page)          => PartialUrl(Model.Filter, Model.SortField, Model.SortDir, page,       Model.PageSize);
    string PageSizeUrl(int pageSize)  => PartialUrl(Model.Filter, Model.SortField, Model.SortDir, 1,          pageSize);

    string SortIcon(string field) => Model.SortField == field ? (Model.SortDir == "asc" ? " ▲" : " ▼") : "";
    string ThClass(string field) => Model.SortField == field
        ? "text-base-content/70 font-bold cursor-pointer"
        : "text-base-content/40 hover:text-base-content/60 cursor-pointer";

    var widgetRootId = Model.WidgetId + "-list";
    var dataRegionId = Model.WidgetId + "-data";

    // Filter chips. Per-bucket counts from the SignatureAggregateCache / event store.
    // "Internal" is OFF by default -- All / Bots / Humans counts EXCLUDE internal
    // traffic (BotType.Internal -> loopback / RFC1918 / docker bridge), so the
    // operator's view of Live Activity isn't drowned by StyloBot self-traffic and
    // OTel collector noise. The Internal chip surfaces it explicitly when needed.
    var chips = new[]
    {
        new FilterChip("all",      "All",      (int?)Model.Counts.All,      FilterUrl("all")),
        new FilterChip("bots",     "Bots",     (int?)Model.Counts.Bots,     FilterUrl("bots")),
        new FilterChip("humans",   "Humans",   (int?)Model.Counts.Humans,   FilterUrl("humans")),
        new FilterChip("internal", "Internal", (int?)Model.Counts.Internal, FilterUrl("internal")),
    };

    // Search box hits the same partial route; q is included via hx-include="this".
    // Keeping page=1 and current filter/sort so a search inside the active filter
    // bucket reads as expected ("search within Bots").
    var searchUrl = $"{bp}/partials/topbots?filter={Model.Filter}&sort={Model.SortField}&dir={Model.SortDir}&page=1&pageSize={Model.PageSize}&widgetId={Model.WidgetId}";

    var toolbar = new TableToolbarModel(
        TargetId: widgetRootId,
        Chips: chips,
        ActiveFilter: Model.Filter,
        ShowSearch: true,
        SearchUrl: searchUrl,
        TimeWindowOptions: null,
        ActiveTimeWindow: null,
        SearchValue: Model.Query);

    var pagination = new TablePaginationModel(
        Page: Model.Page,
        PageSize: Model.PageSize,
        TotalCount: Model.TotalCount,
        PageUrl: PageUrl,
        PageSizeUrl: PageSizeUrl,
        TargetId: widgetRootId);

    var heading = Model.WidgetId is "live-activity" or "live-visitors"
        ? "Live Activity"
        : Model.Filter == "humans" ? "Top Humans"
        : Model.Filter == "all" ? "Top Visitors"
        : "Top Bots";
}
@*
    ONE region, one swap (operator P0, 2026-08-09): the whole widget root -- chrome
    (header, toolbar, tab counts, pager) AND rows -- is rendered from one materialised
    list and swaps as a single unit, on SSR, after user-initiated actions, and on a
    SignalR beacon alike. Previously the <tbody> alone carried data-sb-data-region and
    was the only thing a beacon swapped (hx-swap-oob="innerHTML" injected by
    WidgetRenderHelpers.InjectOobAttribute) while the header/counts only updated on a
    full outerHTML swap -- two independently-timed swaps of the SAME widget, which is
    how "Bots 6" rendered above a stale single row: the count fragment updated, the
    row fragment did not, in the same paint. WidgetRenderHelpers.InjectOobAttribute
    already falls back to morphing the whole first tag when no data-sb-data-region
    marker is present (see its own doc comment), so removing the marker here is the
    whole fix -- no change needed to the shared helper. It becomes structurally
    impossible for the badge and the rows to disagree: they are one fragment now.
*@
<div id="@widgetRootId"
     data-sb-widget="@Model.WidgetId"
     data-sb-depends="signature,summary"
     data-sb-params="page=@Model.Page&sort=@Model.SortField&dir=@Model.SortDir&filter=@Model.Filter&widgetId=@Model.WidgetId&pageSize=@Model.PageSize@(string.IsNullOrEmpty(Model.Query) ? "" : "&q=" + Uri.EscapeDataString(Model.Query))"
     class="card bg-base-200 transition-colors duration-200 h-full w-full">
    <div class="card-body p-3 flex flex-col h-full">

        <!-- Chrome: heading + help -->
        <div class="flex items-center gap-1 mb-1">
            <h3 class="text-sm font-bold text-base-content">@heading</h3>
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_HelpIcon.cshtml", "top-bots")
        </div>

        <!-- Chrome: shared toolbar (filter chips) -->
        @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_TableToolbar.cshtml", toolbar)

        @* A genuine cold-cache miss (see ClustersListModel.IsWarming) -- distinct from a
           real, warmed snapshot that happens to show zero bots. *@
        @if (Model.IsWarming)
        {
            <div class="text-xs text-base-content/50 px-3 py-4 text-center">Warming up — bot activity will appear shortly.</div>
        }
        else if (Model.Bots.Count == 0)
        {
            <div id="@dataRegionId" class="flex-1 min-h-0">
                <div class="text-xs text-base-content/40 py-6 text-center">
                    @(Model.Filter == "humans" ? "No humans recorded yet" : Model.Filter == "all" ? "No visitors recorded yet" : "No bots detected yet")
                </div>
            </div>
        }
        else
        {
            <!-- Chrome: scrollable container + table chrome (thead). Only Y
                 scrolls -- horizontal scroll on Live Activity is never
                 acceptable (the user has called it out). table-fixed +
                 truncate on the NAME cell keeps row width bounded. The
                 tooltip portal moves cell tooltips to body level so the
                 daisy hover popouts still escape this Y-scrolling wrapper. -->
            <div class="overflow-y-auto overflow-x-hidden flex-1 min-h-0">
                <table class="table table-xs w-full table-fixed">
                    @* Column order follows the operator's reasoning chain:
                       flag - who (visual locator)
                       NAME - the identity
                       BOT % - "is this a bot?" -- the headline answer
                       CONF  - "how sure are we?" -- gates everything else
                       TYPE  - "what is it trying to do?" (AI / Scraper / Crawler...)
                       THREAT- "is it hitting a honeypot / CVE / known-bad shape?"
                       HITS  - volume so far
                       1h    - traffic shape over the last hour
                       SEEN  - last activity timestamp
                       BOT % and CONF are orthogonal axes that go side-by-side so
                       the operator reads "100% bot but only 30% sure" as a single
                       glance and knows the false-positive risk before acting.
                       TYPE answers what the bot wants; THREAT answers whether it's
                       hitting hostile signals. RiskBand is intentionally dropped
                       from the row -- it's a derived quantity that conflated bot
                       probability with threat severity and produced "1% bot,
                       Critical risk" misreads when the row had a benign actor on
                       a honeypot path. *@
                    @*
                        Layout note: TYPE icon is now rendered inside the NAME cell
                        (prefix before the bot-name text) and the standalone TYPE
                        column was dropped -- it was empty 7 rows out of 10 on Live
                        Activity and the column padding alone was pushing the table
                        past 100% zoom. BYTES is also dropped here because the
                        Content-Length sum is always 0/-/- for current traffic;
                        the column rendered as a dash on every row.
                        Inter-column padding tightened from default to px-1.5 so
                        eight columns fit the visitor card.
                    *@
                    @* table-fixed column budget (sum = 100%). NAME takes the slack
                       so it always truncates instead of pushing the row past the
                       container. Numeric columns (BOT%, THREAT, HITS, 1h, SEEN)
                       are clamped to their natural minimum. CONF was collapsed
                       into BOT% as opacity variation on the RiskBar primitive
                       to reclaim the column real estate. *@
                    <colgroup>
                        <col style="width:24px" />
                        <col />
                        <col style="width:60px" />
                        <col style="width:42px" />
                        <col style="width:56px" />
                        <col style="width:60px" />
                        <col style="width:60px" />
                    </colgroup>
                    <thead>
                        <tr class="text-[10px] uppercase tracking-wider">
                            <th class="py-1 px-1"></th>
                            <th class="py-1 px-1.5 @ThClass("name")"
                                hx-get="@SortUrl("name")" hx-target="#@widgetRootId" hx-swap="outerHTML transition:true">
                                Name@(Html.Raw(SortIcon("name")))
                            </th>
                            <th class="py-1 px-1.5 text-center @ThClass("probability")"
                                hx-get="@SortUrl("probability")" hx-target="#@widgetRootId" hx-swap="outerHTML transition:true"
                                title="Bot probability (5-dot segment) faded by detection confidence -- low-confidence rows visibly dim. Replaces the separate CONF column.">
                                Bot %@(Html.Raw(SortIcon("probability")))
                            </th>
                            <th class="py-1 px-1.5 text-center @ThClass("threat")"
                                hx-get="@SortUrl("threat")" hx-target="#@widgetRootId" hx-swap="outerHTML transition:true">
                                Threat@(Html.Raw(SortIcon("threat")))
                            </th>
                            <th class="py-1 px-1.5 text-right @ThClass("hits")"
                                hx-get="@SortUrl("hits")" hx-target="#@widgetRootId" hx-swap="outerHTML transition:true">
                                Hits@(Html.Raw(SortIcon("hits")))
                            </th>
                            <th class="py-1 px-1.5 text-center text-[10px] text-base-content/40" title="Hits per minute, last hour">1h</th>
                            <th class="py-1 px-1.5 text-right @ThClass("lastseen")"
                                hx-get="@SortUrl("lastseen")" hx-target="#@widgetRootId" hx-swap="outerHTML transition:true">
                                Seen@(Html.Raw(SortIcon("lastseen")))
                            </th>
                        </tr>
                    </thead>
                    @{
                        // Identity grouping (verified-bot rows collapsed to one) happens at
                        // model-build time in WidgetRenderHelpers.CollapseGroupableIdentities,
                        // so Model.Bots already comes pre-grouped and pagination matches the
                        // visible rows.
                    }
                    <!-- Row body. No longer its own OOB target -- the whole widget root morphs
                         together on a beacon (see the file-level comment). Scroll position on
                         the .overflow-auto parent is preserved because the parent element
                         identity doesn't change even when its ancestor morphs. -->
                    <tbody id="@dataRegionId">
                        @foreach (var bot in Model.Bots)
                        {
                            var riskClass = bot.RiskBand switch {
                                "VeryHigh" or "High" => "text-error",
                                "Medium" or "Elevated" => "text-warning",
                                _ => "text-success"
                            };
                            var isCustomNamed = bot.CustomBotName != null;
                            // Single canonical name path -- the matcher (FingerprintNameComposer)
                            // is the sole writer of Fingerprint.DisplayName. View renders what
                            // the store returned; empty cell IS the visible signal of an
                            // upstream pipeline bug, no decoration.
                            var displayName = bot.CustomBotName ?? bot.BotName;
                            var displayIntent = bot.BotType ?? BotDisplayHelpers.DeterministicIntent(bot.BotProbability);
                            var displayThreat = BotDisplayHelpers.ResolvedThreat(bot.ThreatBand, bot.BotProbability);
                            var threatBand = string.IsNullOrEmpty(displayThreat) ? "None" : displayThreat;
                            var isLlmNamed = bot.BotName != null || isCustomNamed;
                            var probPct = (bot.BotProbability * 100).ToString("F0");

                            // Bot-identity verification state. Source priority:
                            //   1. "Spoofed-" name prefix from VerifiedBotContributor (red `!`)
                            //   2. bot.IsVerifiedBot latched from verifiedbot.confirmed signal (green tick)
                            //   3. Otherwise any named bot or IsKnownBot=true (amber `?`)
                            //   4. Humans + un-named human-like rows -> no badge
                            var verification = (bot.BotName, bot.IsVerifiedBot, bot.IsKnownBot) switch
                            {
                                ({ } n, _, _) when n.StartsWith("Spoofed-", StringComparison.OrdinalIgnoreCase)
                                    => BotVerificationState.Spoofed,
                                (_, true, _) => BotVerificationState.Confirmed,
                                ({ } _, _, _) => BotVerificationState.Unconfirmed,
                                (null, _, true) => BotVerificationState.Unconfirmed,
                                _ => BotVerificationState.None
                            };
                            var verificationBadge = new VerificationBadgeModel(verification);

                            var intentIcon = new IntentIconModel(displayIntent);
                            var riskBar    = new RiskBarModel(bot.BotProbability, threatBand, bot.Confidence);
                            // The prominent per-row shield reflects the RISK band (RiskBand), NOT
                            // threat. On this fingerprint-derived list threat is structurally always
                            // "None" -- FingerprintRiskProjection has no per-request threat score to
                            // carry (threat is not a durable fingerprint fact) -- so a threat shield
                            // read grey for EVERY row and never reflected the row's risk. RiskBand IS
                            // derived at read (verified-good bots pin friendly -> green; confident bad
                            // -> red), so the shield now tracks "how concerning is this row". The
                            // threat shield stays where ThreatBand is genuinely computed (per-request
                            // detail views + the endpoint list's AvgThreatScore).
                            var riskBadge = new RiskBadgeModel(bot.RiskBand, bot.BotProbability);
                            // Confidence is now carried by the BOT% cell as opacity (see
                            // RiskBarModel.Confidence), so the standalone ConfidenceMeter
                            // primitive is no longer rendered on this widget. The downstream
                            // recommendation logic still consumes bot.Confidence directly.
                            var flag       = new CountryFlagModel(bot.CountryCode, bot.CountryCode);
                            var timeAgo    = new TimeAgoModel(bot.LastSeen, bot.TimeAgo);
                            @* Idiomorph keys rows by `id` -- without a stable key it falls
                               back to positional diffing and treats a reordered row
                               (sort=lastseen DESC pushes new hits to the top, shifts old
                               rows down) as "different content at this position", which
                               triggers a per-row replace and is what the operator sees
                               as flicker. Keying by signature lets morph track the row
                               across position changes and only mutate the cells whose
                               data actually shifted. *@
                            <tr id="sb-row-@(Model.WidgetId)-@bot.PrimarySignature" class="hover:bg-base-300/50 cursor-pointer transition-colors">
                                <td class="py-1 px-1 w-6">
                                    <a href="@(string.IsNullOrEmpty(bot.EntityId) ? $"{navBp}/signature/{Uri.EscapeDataString(bot.PrimarySignature)}" : $"{navBp}/entity/{Uri.EscapeDataString(bot.EntityId)}")" class="block">
                                        @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_CountryFlag.cshtml", flag)
                                    </a>
                                </td>
                                @* table-fixed allots NAME the remaining width;
                                   inline overflow-hidden + truncate on the link
                                   below keeps the cell from pushing the row past
                                   the panel. max-w-[180px] removed -- it fought
                                   the fixed-layout budget. *@
                                <td class="py-1 px-1.5 font-medium text-xs overflow-hidden" title="@displayName">
                                    <span class="flex items-center gap-1 min-w-0">
                                        @* Type icon prefixed inside the name cell so the separate
                                           TYPE column can be dropped. The icon's distinct shape
                                           still carries the actor-kind cue (spider/brain/wrench
                                           etc.) and its tooltip still surfaces the full
                                           description on hover -- one fewer column to fit. *@
                                        <span class="shrink-0">
                                            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_IntentIcon.cshtml", intentIcon)
                                        </span>
                                        <a href="@(string.IsNullOrEmpty(bot.EntityId) ? $"{navBp}/signature/{Uri.EscapeDataString(bot.PrimarySignature)}" : $"{navBp}/entity/{Uri.EscapeDataString(bot.EntityId)}")"
                                           class="hover:underline truncate @(isLlmNamed ? "" : "text-base-content/60 italic")">@displayName</a>
                                        @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_VerificationBadge.cshtml", verificationBadge)
                                        @if (isCustomNamed) {<span class="text-[9px] text-base-content/60" title="Custom label">&#9632;</span>}
                                        @NameActionSlot.Render(bot.PrimarySignature, displayName ?? bot.PrimarySignature, bot.BotType, bot.BotProbability >= 0.5)
                                    </span>
                                </td>
                                <td class="py-1 px-1.5 text-center">
                                    @* RiskBar carries both the bot-probability fill and the
                                       confidence-as-opacity, so the dedicated CONF column was
                                       dropped above. _RiskBar.cshtml floors opacity at 0.35 so
                                       a low-confidence row reads "uncertain" not "missing". *@
                                    @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_RiskBar.cshtml", riskBar)
                                </td>
                                <td class="py-1 px-1.5 text-center">
                                    @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_RiskBadge.cshtml", riskBadge)
                                </td>
                                <td class="py-1 px-1.5 text-right text-xs text-base-content/60 font-mono">@bot.HitCount</td>
                                <td class="py-1 px-1.5 text-center align-middle">
                                    @{
                                        // Bot trend is the same data plotted in both series for now;
                                        // human/bot split per signature is a follow-on that needs the
                                        // ring buffer to track is_bot per minute. Today every detection
                                        // on this signature falls in one bucket.
                                        // The sparkline stroke follows the SAME axis as the row's
                                        // shield -- now RISK, not threat -- so the trend line agrees
                                        // with the risk shield above. The SparklineModel band param is
                                        // still named ThreatBand (shared primitive), but _Sparkline's
                                        // colour switch handles the RiskBand vocabulary too (VeryHigh
                                        // -> red, Medium/Elevated -> amber, Low/VeryLow/Unknown ->
                                        // muted), so a routine indexing bot reads muted, a confident
                                        // bad actor reads red -- in lock-step with the shield.
                                        var spark = new SparklineModel(
                                            BotTrend: bot.HitTrend,
                                            HumanTrend: System.Array.Empty<int>(),
                                            WindowMinutes: 60,
                                            ThreatBand: bot.RiskBand);
                                    }
                                    @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_Sparkline.cshtml", spark)
                                </td>
                                <td class="py-1 text-right">
                                    @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_TimeAgo.cshtml", timeAgo)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Chrome: shared pagination (numbered, page-size, total) -->
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_TablePagination.cshtml", pagination)
        }
    </div>
</div>
