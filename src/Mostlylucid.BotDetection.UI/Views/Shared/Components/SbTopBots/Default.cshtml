@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@model TopBotsListModel
@{
    var bp = Model.BasePath;
    var navBp = Model.ResolvedNavBasePath;
    string SortUrl(string field) {
        var dir = Model.SortField == field ? (Model.SortDir == "desc" ? "asc" : "desc") : "desc";
        return $"{bp}/partials/topbots?sort={field}&dir={dir}&page=1&pageSize={Model.PageSize}&filter={Model.Filter}&widgetId={Model.WidgetId}";
    }
    string PageUrl(int page) => $"{bp}/partials/topbots?sort={Model.SortField}&dir={Model.SortDir}&page={page}&pageSize={Model.PageSize}&filter={Model.Filter}&widgetId={Model.WidgetId}";
    string SortIcon(string field) => Model.SortField == field ? (Model.SortDir == "asc" ? " \u25B2" : " \u25BC") : "";
    string ThClass(string field) => Model.SortField == field
        ? "text-base-content/70 font-bold"
        : "text-base-content/40 hover:text-base-content/60";

    bool HasFlag(string? code) => !string.IsNullOrEmpty(code) && code.Length == 2 && code != "XX";
    string FlagUrl(string code) => $"/_content/Mostlylucid.BotDetection.UI/flags/{code.ToLowerInvariant()}.svg";
}
<div id="@(Model.WidgetId)-list"
     data-sb-widget="@Model.WidgetId"
     data-sb-depends="signature,summary"
     data-sb-params="page=@Model.Page&sort=@Model.SortField&dir=@Model.SortDir&filter=@Model.Filter&widgetId=@Model.WidgetId&pageSize=@Model.PageSize"
     class="card bg-base-200 transition-all duration-200 h-full w-full">
    <div class="card-body p-3">
        <div class="flex items-center gap-1 mb-1">
            <h3 class="text-sm font-bold text-base-content">
                @(Model.WidgetId is "live-activity" or "live-visitors" ? "Live Activity" : Model.Filter == "humans" ? "Top Humans" : Model.Filter == "all" ? "Top Visitors" : "Top Bots")
            </h3>
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_HelpIcon.cshtml", "top-bots")
        </div>

        @if (Model.Bots.Count == 0)
        {
            <div class="text-xs text-base-content/40 py-4 text-center">
                @(Model.Filter == "humans" ? "No humans recorded yet" : Model.Filter == "all" ? "No visitors recorded yet" : "No bots detected yet")
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="table table-xs w-full">
                    <thead>
                        <tr class="text-[10px] uppercase tracking-wider">
                            <th class="py-1 w-6"></th>
                            <th class="py-1 @ThClass("name") cursor-pointer"
                                hx-get="@SortUrl("name")" hx-target="#@(Model.WidgetId)-list" hx-swap="outerHTML transition:true">
                                Name@(Html.Raw(SortIcon("name")))
                            </th>
                            <th class="py-1 text-[10px] text-base-content/40">Intent</th>
                            <th class="py-1 text-center @ThClass("threat") cursor-pointer"
                                hx-get="@SortUrl("threat")" hx-target="#@(Model.WidgetId)-list" hx-swap="outerHTML transition:true">
                                Threat@(Html.Raw(SortIcon("threat")))
                            </th>
                            <th class="py-1 text-right @ThClass("probability") cursor-pointer"
                                hx-get="@SortUrl("probability")" hx-target="#@(Model.WidgetId)-list" hx-swap="outerHTML transition:true">
                                Prob@(Html.Raw(SortIcon("probability")))
                            </th>
                            <th class="py-1 text-right @ThClass("hits") cursor-pointer"
                                hx-get="@SortUrl("hits")" hx-target="#@(Model.WidgetId)-list" hx-swap="outerHTML transition:true">
                                Hits@(Html.Raw(SortIcon("hits")))
                            </th>
                            <th class="py-1 text-right @ThClass("lastseen") cursor-pointer"
                                hx-get="@SortUrl("lastseen")" hx-target="#@(Model.WidgetId)-list" hx-swap="outerHTML transition:true">
                                Seen@(Html.Raw(SortIcon("lastseen")))
                            </th>
                        </tr>
                    </thead>
                    @{
                        // Identity grouping (verified-bot rows collapsed to one) happens at
                        // model-build time in WidgetRenderHelpers.CollapseGroupableIdentities,
                        // so Model.Bots already comes pre-grouped and pagination matches the
                        // visible rows. The view only needs to disambiguate synth + tool names
                        // that legitimately collide between distinct fingerprints (two "British
                        // Visitor"s, two curl invocations, etc). Same predicate as the helper
                        // uses so the two views stay in lockstep.
                        var seenNames = new Dictionary<string, int>(StringComparer.Ordinal);
                        static string FormatFirstSeen(DateTime utc)
                            => utc == default ? "" : $"first seen {utc.ToLocalTime():HH:mm:ss}";
                    }
                    <tbody>
                        @foreach (var bot in Model.Bots)
                        {
                            var riskClass = bot.RiskBand switch {
                                "VeryHigh" or "High" => "text-error",
                                "Medium" or "Elevated" => "text-warning",
                                _ => "text-success"
                            };
                            var isCustomNamed = bot.CustomBotName != null;
                            var baseDisplay = bot.CustomBotName
                                ?? bot.BotName
                                ?? (string.IsNullOrEmpty(bot.BotType) ? BotDisplayHelpers.DescriptiveBotName(bot) : bot.BotType);
                            var displayName = baseDisplay;
                            // Synth + tool-UA names can still collide between distinct
                            // fingerprints. Verified-identity rows are already deduped at the
                            // model-build site, so no decoration applies to them.
                            if (!Mostlylucid.BotDetection.UI.Middleware.WidgetRenderHelpers.IsGroupableIdentity(bot)
                                && seenNames.ContainsKey(baseDisplay))
                            {
                                var firstSeenMod = FormatFirstSeen(bot.FirstSeen);
                                displayName = string.IsNullOrEmpty(firstSeenMod)
                                    ? $"{baseDisplay} #{seenNames[baseDisplay] + 1}"
                                    : $"{baseDisplay} ({firstSeenMod})";
                                seenNames[baseDisplay]++;
                            }
                            else if (seenNames.ContainsKey(baseDisplay))
                            {
                                seenNames[baseDisplay]++;
                            }
                            else
                            {
                                seenNames[baseDisplay] = 1;
                            }
                            var displayIntent = bot.BotType ?? BotDisplayHelpers.DeterministicIntent(bot.BotProbability);
                            var displayThreat = BotDisplayHelpers.ResolvedThreat(bot.ThreatBand, bot.BotProbability);
                            var threatClass = displayThreat switch {
                                "Critical" => "text-error font-bold",
                                "High" => "text-error",
                                "Medium" => "text-warning",
                                _ => "text-base-content/40"
                            };
                            var isLlmNamed = bot.BotName != null || isCustomNamed;
                            var probPct = (bot.BotProbability * 100).ToString("F0");
                            <tr class="hover:bg-base-300/50 cursor-pointer transition-colors">
                                <td class="py-1 w-6">
                                    <a href="@navBp/signature/@Uri.EscapeDataString(bot.PrimarySignature)" class="block">
                                    @if (HasFlag(bot.CountryCode))
                                    {
                                        <img src="@FlagUrl(bot.CountryCode!)" alt="@bot.CountryCode" class="w-6 h-4 object-cover rounded-sm" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="text-base-content/30 text-[10px]">--</span>
                                    }
                                    </a>
                                </td>
                                <td class="py-1 font-medium text-xs truncate max-w-[140px]" title="@(bot.CustomBotName ?? bot.BotName ?? bot.PrimarySignature)">
                                    <a href="@navBp/signature/@Uri.EscapeDataString(bot.PrimarySignature)"
                                       class="hover:underline @(isLlmNamed ? "" : "text-base-content/60 italic")">@displayName</a>@if (isCustomNamed) {<span class="ml-1 text-[9px] text-primary opacity-60" title="Custom label">&#9632;</span>}
                                </td>
                                <td class="py-1">
                                    <span class="text-[10px] text-base-content/60">@displayIntent</span>
                                </td>
                                <td class="py-1 text-center">
                                    <span class="text-[10px] @threatClass">@displayThreat</span>
                                </td>
                                <td class="py-1 text-right font-bold text-xs @riskClass">@(probPct)%</td>
                                <td class="py-1 text-right text-xs text-base-content/60 font-mono">@bot.HitCount</td>
                                <td class="py-1 text-right text-[10px] text-base-content/40">@bot.TimeAgo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Custom Prev/Next footer: preserves the "N visitors · page X/Y" count line,
               which _Pagination.cshtml (designed for full-page tabs) does not render. *@
            @if (Model.TotalPages > 1)
            {
                <div class="flex items-center justify-between mt-1.5 pt-1.5 border-t border-base-300">
                    <span class="text-[10px] text-base-content/40">@Model.TotalCount @(Model.Filter == "humans" ? "humans" : Model.Filter == "all" ? "visitors" : "bots") &middot; page @Model.Page/@Model.TotalPages</span>
                    <div class="flex items-center gap-1">
                        @if (Model.Page > 1)
                        {
                            <button hx-get="@PageUrl(Model.Page - 1)" hx-target="#@(Model.WidgetId)-list" hx-swap="outerHTML transition:true"
                                    class="btn btn-xs btn-ghost">&lsaquo; Prev</button>
                        }
                        @if (Model.Page < Model.TotalPages)
                        {
                            <button hx-get="@PageUrl(Model.Page + 1)" hx-target="#@(Model.WidgetId)-list" hx-swap="outerHTML transition:true"
                                    class="btn btn-xs btn-ghost">Next &rsaquo;</button>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@* Display helpers (DescriptiveBotName / CategorizePath / CountryAdjective /
   DeterministicIntent / ResolvedThreat) live in BotDisplayHelpers. The @functions
   blocks here and in _RecentActivity.cshtml had drifted into two copies and a
   100-line reason-prefix matcher that couldn't be unit-tested from Razor. *@
