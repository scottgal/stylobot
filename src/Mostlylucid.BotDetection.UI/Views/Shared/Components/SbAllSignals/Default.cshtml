@using Mostlylucid.BotDetection.UI.ViewComponents
@model AllSignalsViewModel
@{
    var containerClass = string.IsNullOrEmpty(Model.CssClass) ? "sb-all-signals" : $"sb-all-signals {Model.CssClass}";
}
<section class="@containerClass">
    <header class="sb-all-signals__head">
        <strong>All signals for this request</strong>
        <span class="sb-all-signals__count">@Model.TotalCount key@(Model.TotalCount == 1 ? "" : "s")</span>
        <span class="sb-all-signals__verdict">risk: @Model.RiskBand (@Model.BotProbability.ToString("P0"))</span>
    </header>
    @if (Model.Groups.Count == 0)
    {
        <p class="sb-all-signals__empty">No signals on this request. The detection pipeline either has not run yet or this request skipped detection.</p>
    }
    else
    {
        foreach (var group in Model.Groups)
        {
            <details class="sb-all-signals__group" open>
                <summary><code>@group.Prefix.*</code> <span class="sb-all-signals__group-count">(@group.Rows.Count)</span></summary>
                <table class="sb-all-signals__table">
                    <thead>
                        <tr>
                            <th>Key</th>
                            <th>Value</th>
                            @if (Model.ShowDescriptions)
                            {
                                <th>Description</th>
                            }
                            <th>Source</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in group.Rows)
                        {
                            <tr>
                                <td><code title="@row.Long">@row.Key</code></td>
                                <td><code>@row.Value</code></td>
                                @if (Model.ShowDescriptions)
                                {
                                    <td class="sb-all-signals__desc">
                                        @if (!string.IsNullOrEmpty(row.Short))
                                        {
                                            <span title="@row.Long">@row.Short</span>
                                        }
                                        else
                                        {
                                            <span class="sb-all-signals__unknown">no catalog entry</span>
                                        }
                                    </td>
                                }
                                <td class="sb-all-signals__source">
                                    @if (!string.IsNullOrEmpty(row.SourceType))
                                    {
                                        <span title="@row.Short">@row.SourceType</span>
                                    }
                                    else
                                    {
                                        <span class="sb-all-signals__unknown">unknown</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        }
    }
</section>
<style>
    .sb-all-signals { font-family: -apple-system, system-ui, sans-serif; font-size: 0.85rem; margin: 1rem 0; color: #1f2937; }
    .sb-all-signals__head { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.5rem 0.75rem; background: #f3f4f6; border: 1px solid #e5e7eb; border-radius: 0.375rem 0.375rem 0 0; }
    .sb-all-signals__count { color: #6b7280; }
    .sb-all-signals__verdict { margin-left: auto; color: #374151; }
    .sb-all-signals__empty { padding: 0.75rem; background: #fff7ed; border: 1px solid #fdba74; color: #9a3412; border-radius: 0.375rem; }
    .sb-all-signals__group { border: 1px solid #e5e7eb; border-top: none; }
    .sb-all-signals__group summary { padding: 0.4rem 0.75rem; background: #f9fafb; cursor: pointer; user-select: none; font-weight: 600; }
    .sb-all-signals__group summary code { background: transparent; padding: 0; color: #2563eb; }
    .sb-all-signals__group-count { color: #6b7280; font-weight: 400; margin-left: 0.5rem; }
    .sb-all-signals__table { width: 100%; border-collapse: collapse; }
    .sb-all-signals__table th { text-align: left; padding: 0.35rem 0.75rem; background: #f9fafb; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 600; font-size: 0.78rem; }
    .sb-all-signals__table td { padding: 0.3rem 0.75rem; border-bottom: 1px solid #f3f4f6; vertical-align: top; }
    .sb-all-signals__table tr:last-child td { border-bottom: none; }
    .sb-all-signals__table code { background: #f3f4f6; padding: 0.05rem 0.3rem; border-radius: 0.2rem; font-size: 0.78rem; word-break: break-all; }
    .sb-all-signals__desc { color: #374151; font-size: 0.8rem; max-width: 32rem; }
    .sb-all-signals__source { color: #6b7280; font-size: 0.78rem; }
    .sb-all-signals__unknown { color: #9ca3af; font-style: italic; }
</style>
