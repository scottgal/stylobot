@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@using Mostlylucid.BotDetection.UI.Configuration
@using Microsoft.Extensions.DependencyInjection
@model FingerprintShapeViewModel
@inject IServiceProvider Sp
@{
    var sbDashboardOptions = Sp.GetService<StyloBotDashboardOptions>();
    var sbTooltipRegistry  = Sp.GetService<DashboardTooltipRegistry>();
    var sbTooltipsOn       = sbDashboardOptions?.EnableTooltips == true && sbTooltipRegistry != null;

    // SVG label tooltips can't go through the sb-tooltip TagHelper because the
    // labels are appended into a StringBuilder as raw <text> markup (the radar
    // axis points are computed in code, not declared as Razor elements). We
    // resolve the tooltip text inline against the same registry and wrap the
    // <text> in a <g class="tooltip tooltip-bottom" data-tip="..."> so the
    // sb-tooltip-portal.js script picks it up identically to the HTML call
    // sites — one rendering path, same registry, no string list in C#.
    string? SbSvgTooltip(string key)
    {
        if (!sbTooltipsOn) return null;
        return sbTooltipRegistry!.TryGet(key, out var t) ? t : null;
    }
}
@{
    // Render source: a FingerprintRadarShape projected by FingerprintRadarProjection
    // (Network / Locale / Headers / Tool / Transport / Session / Quality). Solid
    // polygon = current centroid; dotted polygon (when known) = archetype origin.
    // The gap between them is the visitor's drift since allocation. Calibrating
    // placeholder runs when the matcher has not yet produced a fingerprint.
    var shape         = Model.Shape;
    var hasRadar      = shape is not null && shape.CurrentBuckets.Length > 0;
    var bucketLabels  = shape?.BucketLabels ?? FingerprintRadarProjection.BucketLabels;
    var size          = Model.Size;
    var radarFill     = Model.IsBot ? "rgba(239,68,68,0.22)" : "rgba(34,197,94,0.22)";
    var accent        = Model.IsBot ? "#ef4444" : "#22c55e";

    var radarCurrent   = new System.Text.StringBuilder();
    var radarOrigin    = new System.Text.StringBuilder();
    var radarAxisLines = new System.Text.StringBuilder();
    var radarLabelSvg  = new System.Text.StringBuilder();

    var axisCount = bucketLabels.Length;
    for (var i = 0; i < axisCount; i++)
    {
        var angle = (2 * Math.PI * i / axisCount) - (Math.PI / 2); // 12 o'clock at top

        if (hasRadar)
        {
            var magnitude = Math.Clamp(shape!.CurrentBuckets[i], 0, 1);
            var x = 50 + Math.Cos(angle) * 35 * magnitude;
            var y = 50 + Math.Sin(angle) * 35 * magnitude;
            radarCurrent.Append($"{x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} ");

            if (shape.OriginBuckets is { } origin && origin.Length == axisCount)
            {
                var om = Math.Clamp(origin[i], 0, 1);
                var ox = 50 + Math.Cos(angle) * 35 * om;
                var oy = 50 + Math.Sin(angle) * 35 * om;
                radarOrigin.Append($"{ox.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{oy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} ");
            }
        }

        var ax = 50 + Math.Cos(angle) * 35;
        var ay = 50 + Math.Sin(angle) * 35;
        radarAxisLines.AppendLine($"<line x1=\"50\" y1=\"50\" x2=\"{ax.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y2=\"{ay.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" stroke=\"currentColor\" stroke-width=\"0.3\" opacity=\"0.12\" />");

        var lx = 50 + Math.Cos(angle) * 44;
        var ly = 50 + Math.Sin(angle) * 44 + 1.2;
        var label = bucketLabels[i];
        // Tooltip key is derived from the axis label so adding a new bucket only
        // requires a YAML row, never a C# table. The portal binds .tooltip[data-tip]
        // on any element including SVG <g> so this contract matches the HTML one.
        var labelKey = "radar." + label.ToLowerInvariant();
        var labelTip = SbSvgTooltip(labelKey);
        if (labelTip is not null)
        {
            // pointer-events="bounding-box" makes the entire <g> hit-testable, not
            // just the rendered glyph shapes, so hovering anywhere in the label's
            // bbox triggers mouseenter.
            radarLabelSvg.AppendLine($"<g class=\"tooltip tooltip-bottom\" data-tip=\"{System.Net.WebUtility.HtmlEncode(labelTip)}\" pointer-events=\"bounding-box\"><text x=\"{lx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{ly.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" font-size=\"3\" text-anchor=\"middle\" fill=\"currentColor\" opacity=\"0.5\">{label}</text></g>");
        }
        else
        {
            radarLabelSvg.AppendLine($"<text x=\"{lx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{ly.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}\" font-size=\"3\" text-anchor=\"middle\" fill=\"currentColor\" opacity=\"0.5\">{label}</text>");
        }
    }

    var hasOrigin = hasRadar && shape!.OriginBuckets is { Length: > 0 };
}
@if (hasRadar)
{
    <div class="flex flex-col items-center">
        <svg viewBox="0 0 100 100" width="@size" height="@size" xmlns="http://www.w3.org/2000/svg"
             aria-label="Behavioural fingerprint, @bucketLabels.Length-bucket centroid projection">
            <circle cx="50" cy="50" r="35" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.16" />
            <circle cx="50" cy="50" r="23" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.10" />
            <circle cx="50" cy="50" r="12" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.08" />
            @Html.Raw(radarAxisLines.ToString())
            @if (hasOrigin)
            {
                @* Archetype-origin overlay: dotted, lower opacity, drawn BEHIND the
                   current polygon so the current shape reads as the focused element. *@
                <polygon points="@radarOrigin.ToString().TrimEnd()"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="0.8"
                         stroke-dasharray="1.5 1.2"
                         opacity="0.45" />
            }
            <polygon points="@radarCurrent.ToString().TrimEnd()"
                     fill="@radarFill"
                     stroke="@accent"
                     stroke-width="1.2" />
            @Html.Raw(radarLabelSvg.ToString())
        </svg>
        @{
            // CATEGORICAL drift (archetype-level): origin archetype the matcher
            // anchored at vs the current-nearest archetype. Honest, qualitative
            // signal -- "this visitor used to look like Chrome, now looks like
            // headless-chrome".
            var originName    = shape!.ArchetypeName;
            var nearestName   = shape.NearestArchetypeName;
            // Suppress the categorical drift labels when the matcher's archetype
            // disagrees with the UA family we already parsed -- e.g. radar says
            // "curl -> Googlebot" on a Chrome+macOS visitor because the matcher's
            // CLIENT centroid search picked the closest available shape and
            // chrome-desktop's centroid was sized for navigation requests, not
            // XHRs. The drift banner is matcher-internal telemetry; surfacing
            // it when it contradicts ground truth (uap-core says Chrome) is
            // the same parallel-axis category error the composite-browser-mode
            // spec ruled out. The radar polygon itself still renders; only the
            // misleading "Drifted A -> B" line goes away.
            string? uaFamily = null;
            if (!string.IsNullOrWhiteSpace(Model.UserAgent))
            {
                var (parsedFamily, _) = Mostlylucid.BotDetection.Helpers.UserAgentParser.Parse(Model.UserAgent);
                if (!string.IsNullOrWhiteSpace(parsedFamily)
                    && !parsedFamily.Equals("Other", System.StringComparison.OrdinalIgnoreCase)
                    && !parsedFamily.Equals("Unknown", System.StringComparison.OrdinalIgnoreCase))
                {
                    uaFamily = parsedFamily;
                }
            }
            bool ArchetypeMatchesUaFamily(string? name)
                => name is not null && uaFamily is not null
                   && name.Contains(uaFamily, System.StringComparison.OrdinalIgnoreCase);
            var matcherAgreesWithUa = uaFamily is null
                                      || ArchetypeMatchesUaFamily(originName)
                                      || ArchetypeMatchesUaFamily(nearestName);
            var hasDrift      = matcherAgreesWithUa
                                && !string.IsNullOrEmpty(originName)
                                && !string.IsNullOrEmpty(nearestName)
                                && !string.Equals(originName, nearestName, System.StringComparison.OrdinalIgnoreCase);
            if (!matcherAgreesWithUa)
            {
                // Drop the categorical-drift labels entirely. The radar still
                // shows shape; the operator gets the rich h1 label up-top
                // ("Chrome 148.0.0 / macOS") instead of contradictory archetype
                // names that confuse more than they help.
                originName  = null;
                nearestName = null;
            }

            // QUANTITATIVE drift (adaptation-loop): cosine of live centroid vs
            // the current root_centroid. 1.0 = aligned with the reference;
            // smaller = the live shape has moved. SelfDriftLabel is the lineage
            // (archetype:... cold-start seed, or cluster:... data-driven mean
            // from a BotClusterService snapshot).
            var driftScore = shape.SelfDriftScore;
            var driftLabel = shape.SelfDriftLabel;
            var rootHistory = shape.RootHistory;

            static string ShortenSource(string? src)
            {
                if (string.IsNullOrEmpty(src)) return "";
                var colon = src.IndexOf(':');
                if (colon <= 0 || colon >= src.Length - 1) return src;
                var kind = src[..colon];
                var id   = src[(colon + 1)..];
                return kind switch
                {
                    "archetype"   => id,
                    "cluster"     => "cluster " + (id.Length > 6 ? id[..6] : id),
                    "verifiedbot" => id,
                    _             => src
                };
            }

            string FormatAge(DateTime? when)
            {
                if (when is null) return "";
                var delta = DateTime.UtcNow - when.Value;
                if (delta.TotalSeconds < 60) return "just now";
                if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m";
                if (delta.TotalHours   < 48) return $"{(int)delta.TotalHours}h";
                return $"{(int)delta.TotalDays}d";
            }
        }
        @if (!string.IsNullOrEmpty(originName) || !string.IsNullOrEmpty(nearestName))
        {
            <div class="mt-2 text-[10px] uppercase tracking-wider text-base-content/50 text-center leading-tight">
                @(hasDrift ? "Drifted" : "Closest to")
            </div>
            <div class="text-xs font-medium text-base-content/80 text-center leading-tight">
                @if (hasDrift)
                {
                    <span>@originName</span>
                    <span class="text-base-content/40 mx-1">→</span>
                    <span>@nearestName</span>
                }
                else
                {
                    <span>@(nearestName ?? originName)</span>
                }
            </div>
        }
        @if (driftScore.HasValue)
        {
            <div class="mt-2 text-[10px] uppercase tracking-wider text-base-content/50 text-center leading-tight">
                Drift vs @ShortenSource(driftLabel)
            </div>
            <div class="text-xs font-mono text-base-content/80 text-center leading-tight">
                @($"{(1.0 - driftScore.Value) * 100:F1}%")
                @if (shape.RootCentroidAt.HasValue)
                {
                    <span class="text-base-content/40 ml-1">· @FormatAge(shape.RootCentroidAt)</span>
                }
            </div>
        }
        @if (rootHistory is { Count: > 1 })
        {
            <details class="mt-2 text-[10px] text-base-content/60 leading-tight">
                <summary class="cursor-pointer text-center uppercase tracking-wider text-base-content/50">
                    Root timeline (@rootHistory.Count)
                </summary>
                <ul class="mt-1 space-y-0.5 font-mono">
                    @foreach (var entry in rootHistory)
                    {
                        var isActive = !entry.SupersededAt.HasValue;
                        <li class="flex justify-between gap-2 @(isActive ? "text-base-content/90" : "text-base-content/50")">
                            <span class="truncate">
                                @(isActive ? "● " : "○ ")@ShortenSource(entry.Source)
                                @if (entry.MemberCount > 1)
                                {
                                    <span class="text-base-content/40">·n=@entry.MemberCount</span>
                                }
                            </span>
                            <span class="shrink-0">@($"{entry.RootDistance * 100:F1}%") · @FormatAge(entry.SetAt)</span>
                        </li>
                    }
                </ul>
            </details>
        }
    </div>
}
else
{
    <div class="flex flex-col items-center justify-center gap-2 text-base-content/40"
         style="width: @(size)px; height: @(size)px;"
         aria-live="polite"
         aria-label="Behavioural fingerprint calibrating">
        <span class="loading loading-ring loading-md" style="color: currentColor;"></span>
        <div class="text-[10px] uppercase tracking-wider text-center leading-tight">
            Calibrating<br/>fingerprint
        </div>
    </div>
}
