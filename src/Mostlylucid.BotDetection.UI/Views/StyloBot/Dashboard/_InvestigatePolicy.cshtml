@using Mostlylucid.BotDetection.Actions
@using Mostlylucid.BotDetection.UI.Models
@model InvestigationViewModel
@{
    var states = (Context.Items["Policy.States"] as IReadOnlyList<PolicyState>) ?? Array.Empty<PolicyState>();
    var botTypeMap = (Context.Items["Policy.BotTypeMap"] as IDictionary<string, string>)
                     ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    var defaultPolicy = Context.Items["Policy.DefaultPolicyName"] as string;
    var observeOnly = Context.Items["Policy.ObserveOnly"] is true;

    var stateByName = states.ToDictionary(s => s.Name, StringComparer.OrdinalIgnoreCase);

    string IntentColor(PolicyIntent intent) => intent switch
    {
        PolicyIntent.Block => "#dc2626",
        PolicyIntent.RateLimit => "#2563eb",
        PolicyIntent.Throttle => "#ea580c",
        PolicyIntent.Challenge => "#7c3aed",
        PolicyIntent.Pass => "var(--sb-brand-muted)",
        _ => "var(--sb-brand-muted)"
    };

    string IntentBadge(PolicyIntent intent)
    {
        var bg = IntentColor(intent);
        return $"<span style=\"padding:0.1rem 0.45rem; border-radius:4px; background:{bg}; color:white; font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;\">{intent}</span>";
    }

    string TierBadge(string? tier)
    {
        if (string.IsNullOrEmpty(tier)) return string.Empty;
        var bg = tier switch
        {
            "nominal" => "var(--sb-signal-pos)",
            "degraded" => "var(--sb-signal-warn)",
            "critical" => "var(--sb-signal-danger)",
            _ => "var(--sb-brand-muted)"
        };
        return $"<span style=\"padding:0.1rem 0.45rem; border-radius:4px; background:{bg}; color:white; font-size:0.7rem; font-weight:600;\">{tier}</span>";
    }

    // BotType enum names in the order the user's plan calls out.
    var botTypeOrder = new[]
    {
        "MaliciousBot", "ExploitScanner", "ClickFraud",
        "AiBot", "Scraper", "Tool",
        "SearchEngine", "GoodBot", "VerifiedBot",
        "SocialMediaBot", "MonitoringBot",
        "Unknown"
    };
}

<div class="sb-policy-tab" style="display:flex; flex-direction:column; gap:1rem;">

    <div style="display:flex; gap:1rem; align-items:center; padding:0.75rem 1rem; background:var(--sb-card-bg); border:1px solid var(--sb-card-border); border-radius:8px; flex-wrap:wrap;">
        <div style="font-size:0.9rem; font-weight:600;">@states.Count action policies registered</div>
        @if (observeOnly)
        {
            <span style="display:inline-flex; align-items:center; gap:0.3rem; padding:0.25rem 0.7rem; background:var(--sb-signal-warn); color:white; border-radius:4px; font-size:0.75rem; font-weight:600;">
                Observe-only mode
            </span>
            <div style="font-size:0.75rem; color:var(--sb-brand-muted);">Every policy is shadowed through <code>logonly</code>. The numbers below show what <em>would</em> fire.</div>
        }
        else
        {
            <div style="font-size:0.75rem; color:var(--sb-brand-muted);">
                Default fallback policy: <code>@(defaultPolicy ?? "(none)")</code>. Per-BotType overrides take precedence.
            </div>
        }
    </div>

    @* Per-BotType mapping: which policy fires for each detected BotType. *@
    <div style="background:var(--sb-card-bg); border:1px solid var(--sb-card-border); border-radius:8px; padding:0.75rem 1rem;">
        <div style="font-weight:600; font-size:0.9rem; margin-bottom:0.6rem;">BotType &rarr; policy</div>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:0.5rem;">
            @foreach (var botType in botTypeOrder)
            {
                botTypeMap.TryGetValue(botType, out var mappedPolicy);
                var resolvedPolicy = mappedPolicy ?? defaultPolicy;
                PolicyState? state = null;
                if (!string.IsNullOrEmpty(resolvedPolicy)) stateByName.TryGetValue(resolvedPolicy, out state);

                <div style="display:flex; flex-direction:column; gap:0.25rem; padding:0.55rem 0.7rem; background:var(--sb-surface); border-radius:6px; border:1px solid var(--sb-card-divider);">
                    <div style="display:flex; align-items:center; gap:0.45rem; font-size:0.82rem;">
                        <span style="font-weight:600;">@botType</span>
                        @if (state is not null) { @Html.Raw(IntentBadge(state.Intent)) }
                        @if (mappedPolicy is null)
                        {
                            <span style="font-size:0.65rem; color:var(--sb-brand-muted); margin-left:auto;">(via default)</span>
                        }
                    </div>
                    <div style="display:flex; align-items:center; gap:0.45rem; font-size:0.78rem; color:var(--sb-brand-muted); font-family:monospace;">
                        @if (state is null)
                        {
                            <span style="color:var(--sb-signal-danger);">!unmapped</span>
                        }
                        else
                        {
                            <span>@state.Name</span>
                            @if (state.Intent == PolicyIntent.RateLimit
                                 && state.EffectiveParams.TryGetValue("effectiveRequestsPerMinute", out var effRpm))
                            {
                                <span style="margin-left:auto;">@effRpm req/min</span>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* Per-policy cards: full effective params for every registered policy.
       Sorted: rate-limit first (the new stuff), then by intent. *@
    <div style="background:var(--sb-card-bg); border:1px solid var(--sb-card-border); border-radius:8px; padding:0.75rem 1rem;">
        <div style="font-weight:600; font-size:0.9rem; margin-bottom:0.6rem;">Registered policies</div>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:0.6rem;">
            @foreach (var state in states.OrderBy(s => s.Intent == PolicyIntent.RateLimit ? 0
                                                     : s.Intent == PolicyIntent.Block ? 1
                                                     : s.Intent == PolicyIntent.Throttle ? 2
                                                     : s.Intent == PolicyIntent.Challenge ? 3
                                                     : 4)
                                              .ThenBy(s => s.Name, StringComparer.OrdinalIgnoreCase))
            {
                <div style="padding:0.7rem 0.85rem; background:var(--sb-surface); border-radius:6px; border:1px solid var(--sb-card-divider); display:flex; flex-direction:column; gap:0.4rem;">
                    <div style="display:flex; align-items:center; gap:0.5rem;">
                        <span style="font-weight:600; font-size:0.85rem;">@state.Name</span>
                        @Html.Raw(IntentBadge(state.Intent))
                        @if (!string.IsNullOrEmpty(state.CurrentTier))
                        {
                            <span style="margin-left:auto;">@Html.Raw(TierBadge(state.CurrentTier))</span>
                        }
                    </div>

                    @if (state.Intent == PolicyIntent.RateLimit
                         && state.EffectiveParams.TryGetValue("requestsPerMinute", out var configuredRpm)
                         && state.EffectiveParams.TryGetValue("effectiveRequestsPerMinute", out var effRpm))
                    {
                        var multiplier = state.EffectiveParams.TryGetValue("currentMultiplier", out var m)
                            ? Convert.ToDouble(m) : 1.0;
                        var dimmed = multiplier < 0.99;
                        <div style="display:flex; align-items:baseline; gap:0.4rem; font-family:monospace; font-size:0.85rem;">
                            <span style="font-weight:600; color:@(dimmed ? "var(--sb-signal-warn)" : "inherit");">@effRpm</span>
                            <span style="color:var(--sb-brand-muted);">req/min</span>
                            @if (dimmed)
                            {
                                <span style="margin-left:auto; font-size:0.72rem; color:var(--sb-brand-muted);">
                                    (@configuredRpm &times; @multiplier.ToString("F2"))
                                </span>
                            }
                        </div>
                        <div style="display:flex; gap:0.6rem; font-size:0.72rem; color:var(--sb-brand-muted); font-family:monospace;">
                            <span>burst @state.EffectiveParams["burstSize"]</span>
                            <span>key=@state.EffectiveParams["keyBy"]</span>
                            <span>over &rarr; <code>@state.EffectiveParams["overLimitAction"]</code></span>
                        </div>
                    }
                    else
                    {
                        <div style="font-family:monospace; font-size:0.75rem; color:var(--sb-brand-muted);">
                            type=@state.EffectiveParams["actionType"]
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div style="font-size:0.7rem; color:var(--sb-brand-muted); padding:0 0.25rem;">
        Per-policy state is read directly from <code>IPolicyStateProvider</code>; rate-limit numbers
        reflect the current adaptive-scaling multiplier (1.0 when origin is healthy, lower when
        upstream P95 latency or 5xx rate crosses a tier threshold).
    </div>
</div>
