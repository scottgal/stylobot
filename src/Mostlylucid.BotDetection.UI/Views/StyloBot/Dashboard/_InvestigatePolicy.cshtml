@using Mostlylucid.BotDetection.Policies.Rules
@using Mostlylucid.BotDetection.UI.Models
@model InvestigationViewModel
@*
    B9b: Investigation policy panel now collapses onto the canonical
    SbPolicyStack control. The old per-policy / per-BotType / per-rate-limit
    card layout (which read IPolicyStateProvider directly via Context.Items)
    has been superseded by the same Effective/Stack tabs every other policy
    surface uses, so an operator looking at an investigation result sees
    the SAME view of "what rule would fire" as they would on /dashboard/policies
    -- one mental model.

    Scope is derived from the investigation filter:
      - If the user picked a specific endpoint (Filter.EndpointPath set),
        use an Endpoint scope rooted on the request host.
      - Otherwise fall back to Wildcard so every effective rule surfaces;
        the filter chip carries the scope discriminator the user picked.
*@
@{
    var host = Context?.Request?.Host.Host ?? string.Empty;
    PolicyScope investigationScope;
    string? presetFilter = null;

    if (!string.IsNullOrEmpty(Model.Filter.EndpointPath) && !string.IsNullOrEmpty(host))
    {
        investigationScope = new PolicyScope.Endpoint(host, host, Model.Filter.EndpointPath);
    }
    else if (!string.IsNullOrEmpty(host))
    {
        investigationScope = new PolicyScope.Domain(host);
        // Pass the discriminator the investigation tab is scoped to so the
        // policy stack pre-filters its rule rows when the operator picked
        // a country / signature / etc. without a concrete endpoint path.
        if (!string.IsNullOrEmpty(Model.Filter.EntityType) && Model.Filter.EntityType != "all")
        {
            presetFilter = $"@scope:{Model.Filter.EntityType}";
        }
    }
    else
    {
        investigationScope = new PolicyScope.Wildcard();
    }
}
<div class="sb-policy-tab" style="display:flex; flex-direction:column; gap:1rem;">
    @await Component.InvokeAsync("SbPolicyStack", new
    {
        scope = investigationScope,
        embed = PolicyStackEmbed.Full,
        activeTab = "effective",
        aggregateWindow = (TimeSpan?)TimeSpan.FromHours(24),
        canEdit = false,
        filterExpression = presetFilter
    })
</div>
