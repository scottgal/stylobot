@using Microsoft.Extensions.Options
@using Mostlylucid.BotDetection.UI.Dashboard
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Layout
@inject IOptions<DashboardLayoutOptions> DashboardLayout
@model DashboardShellModel
@{
    // F3 dispatch: when V2Enabled and no ?legacy=1 override, render the new
    // three-group sidebar instead of the legacy one. Defaults to false in F1,
    // so this path is dormant until M1 flips it on.
    var v2 = DashboardLayout.Value.V2Enabled && Context.Request.Query["legacy"] != "1";
    if (v2)
    {
        @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_SidebarV2.cshtml", Model)
        return;
    }

    var bp = Model.BasePath;
    var active = Model.ActiveRow;
    bool isActiveRow(string area, string? sub = null) =>
        string.Equals(active.Area, area, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(active.Sub ?? "", sub ?? "", StringComparison.OrdinalIgnoreCase);

    string rowClass(bool on) => on
        ? "block px-3 py-1.5 text-xs font-semibold border-l-4 border-primary bg-base-200 text-base-content"
        : "block px-3 py-1.5 text-xs border-l-4 border-transparent text-base-content/60 hover:text-base-content hover:bg-base-200/50";
}
<nav id="sb-left-nav" class="w-56 shrink-0 bg-base-100 border-r border-base-300 sticky top-0 self-start h-screen overflow-y-auto py-3"
     aria-label="Dashboard navigation">
    @foreach (var group in FossDashboardGroups.All)
    {
        <div class="mb-3">
            <div class="px-3 pb-1 text-[10px] font-bold uppercase tracking-wider text-base-content/40">
                @group.Label
            </div>
            @foreach (var row in group.Rows)
            {
                if (row.IsHidden) { continue; }
                if (row.IsCommercialOnly && !Model.IsCommercial) { continue; }
                <a href="@bp/@row.Id" class="@rowClass(isActiveRow(row.Id))">@row.Label</a>
            }
        </div>

        if (group.Id == "policy" && Model.Packs.Count > 0)
        {
            <div class="mb-3" x-data="sbPacksNav()">
                <div class="px-3 pb-1 text-[10px] font-bold uppercase tracking-wider text-base-content/40">
                    Packs
                </div>
                @foreach (var pack in Model.Packs)
                {
                    var packActive = string.Equals(active.Area, pack.Id, StringComparison.OrdinalIgnoreCase);
                    var firstSub = pack.SubRows.Count > 0 ? pack.SubRows[0].Id : null;
                    var headerHref = firstSub is null ? $"{bp}/{pack.Id}" : $"{bp}/{pack.Id}/{firstSub}";
                    <div class="mb-1">
                        <div class="flex items-center">
                            <a href="@headerHref" class="@rowClass(packActive && active.Sub is null) flex-1">
                                <i class="@pack.Icon mr-1.5"></i>@pack.Label
                            </a>
                            <button type="button"
                                    class="px-2 text-base-content/40 hover:text-base-content"
                                    aria-label="Toggle @pack.Label sub-rows"
                                    @@click="toggle('@pack.Id')">
                                <i class="bx" :class="isOpen('@pack.Id') ? 'bx-chevron-down' : 'bx-chevron-right'"></i>
                            </button>
                        </div>
                        <div x-show="isOpen('@pack.Id')" x-cloak class="ml-3">
                            @foreach (var sub in pack.SubRows)
                            {
                                <a href="@bp/@pack.Id/@sub.Id" class="@rowClass(isActiveRow(pack.Id, sub.Id))">@sub.Label</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</nav>
<script nonce="@Model.CspNonce">
    function sbPacksNav() {
        return {
            _state: {},
            init() {
                try {
                    var keys = Object.keys(localStorage);
                    for (var i = 0; i < keys.length; i++) {
                        if (keys[i].indexOf('sb-pack-collapsed:') === 0) {
                            this._state[keys[i].substring('sb-pack-collapsed:'.length)] =
                                localStorage.getItem(keys[i]) !== '1';
                        }
                    }
                } catch (_) { /* localStorage blocked -- all open by default */ }
            },
            isOpen(packId) {
                return this._state[packId] !== false;
            },
            toggle(packId) {
                var newOpen = !this.isOpen(packId);
                this._state[packId] = newOpen;
                try { localStorage.setItem('sb-pack-collapsed:' + packId, newOpen ? '0' : '1'); }
                catch (_) {}
            },
        };
    }
</script>
