@using Mostlylucid.BotDetection.UI.Models.Primitives
@model RiskBarModel
@{
    // Graphical-only segment bar. The fill count maps to the probability (1-5
    // segments); the fill colour maps to the magnitude of that probability so
    // the bar reads even when no active threat has fired -- a freshly seen
    // Googlebot (Low/None threat) at 95% bot probability still gets a red bar,
    // because the column answers "how confident is detection that this is a
    // bot" first and "how dangerous" second (Threat owns that).
    //
    // Inline rgba/CSS variables, not Tailwind class modifiers -- bg-base-content/15
    // and friends were silently absent from the compiled tailwind.min.css bundle
    // (JIT scan didn't pick them up at build time), so the previous version
    // rendered the spans transparent and the column appeared empty.
    var p = System.Math.Clamp(Model.Probability, 0, 1);
    var filled = (int)System.Math.Ceiling(p * 5);
    var band = Model.Band ?? "None";
    var filledColor = p switch
    {
        >= 0.80 => "var(--color-error,   #ef4444)",
        >= 0.55 => "var(--color-warning, #f59e0b)",
        >= 0.30 => "var(--color-info,    #38bdf8)",
        >= 0.10 => "var(--color-success, #22c55e)",
        _       => "rgba(148, 163, 184, 0.55)"
    };
    const string emptyColor = "rgba(148, 163, 184, 0.18)";
    var pctText = (p * 100).ToString("F0") + "%";
    var title = $"{pctText} bot probability -- {band} threat band";
}
<span class="tooltip tooltip-left" data-tip="@title" title="@title">
    <span class="inline-flex items-center" style="gap:2px;" aria-label="@title">
    @for (int i = 0; i < 5; i++)
    {
        var bg = i < filled ? filledColor : emptyColor;
        <span style="background:@bg; width:14px; height:10px; border-radius:2px; display:inline-block;"></span>
    }
    </span>
</span>
