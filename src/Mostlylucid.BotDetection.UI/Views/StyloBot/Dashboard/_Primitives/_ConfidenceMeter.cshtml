@using Mostlylucid.BotDetection.UI.Models.Primitives
@model ConfidenceMeterModel
@{
    // Confidence is a 5-dot stack distinct in SHAPE from the BOT% rectangles so
    // the operator can tell which signal they're scanning even when both share
    // the gradient. Colour reads MAGNITUDE only -- "how sure is detection" --
    // never bot/human polarity. Low confidence is muted grey regardless of
    // direction so the operator never reads "safe" from a low-confidence
    // verdict; the recommendation logic upstream gates on this column.
    //
    // Inline colours via CSS variables -- the Tailwind text-* / bg-* class
    // modifiers were silently absent from the JIT-compiled bundle and the
    // previous coloured primitives all rendered white.
    var c = System.Math.Clamp(Model.Confidence, 0, 1);
    var filled = (int)System.Math.Ceiling(c * 5);
    var pct = (c * 100).ToString("F0");

    // Confidence is the ONLY axis that inverts the palette: high = green (we
    // know what to do), low = red (we don't know, the recommendation should
    // gate on this). The other three axes (BOT %, RISK, THREAT) read red-high
    // because they answer "how concerning" -- confidence answers "how sure",
    // and high sureness is the desirable state.
    var filledColor = c switch
    {
        >= 0.80 => "var(--color-success, #22c55e)",
        >= 0.55 => "var(--color-info,    #38bdf8)",
        >= 0.30 => "var(--color-warning, #f59e0b)",
        _       => "var(--color-error,   #ef4444)"
    };
    var label = c switch
    {
        >= 0.80 => "Very confident",
        >= 0.55 => "Confident",
        >= 0.30 => "Tentative",
        _       => "Uncertain"
    };
    const string emptyColor = "rgba(148,163,184,0.18)";
    var title = $"{label}: {pct}% confidence in the bot/human verdict";
}
<span class="tooltip tooltip-left before:max-w-xs" data-tip="@title">
    <span class="inline-flex items-center" style="gap:2px;" aria-label="@title">
    @for (int i = 0; i < 5; i++)
    {
        var bg = i < filled ? filledColor : emptyColor;
        <span style="background:@bg; width:8px; height:8px; border-radius:50%; display:inline-block;"></span>
    }
    </span>
</span>
