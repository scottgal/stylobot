@using Mostlylucid.BotDetection.UI.Models.Primitives
@model ThreatIconModel
@{
    // Threat is an orthogonal axis -- "is this actor hitting hostile signals
    // (honeypots, CVE probes, known-bad shapes)" -- driven STRICTLY by
    // ThreatBand, never by bot probability. A confident bot doing benign
    // crawling reads green here; a low-probability actor that hit a CVE probe
    // reads red. The two are independent and must NOT be conflated.
    //
    // Shield shape changes with severity (full / minus / x) so the gradient
    // survives colour-vision deficits. Inline `color: var(--color-...)` --
    // Tailwind text-error / text-warning / text-success class modifiers were
    // missing from the JIT-compiled bundle.
    var band = Model.Band ?? "None";
    // Effective severity: max of the explicit ThreatBand (honeypot/CVE/known-bad
    // signals) AND a coarse bucket from BotProbability. Operators read "threat"
    // as the actor's overall risk-to-the-site, not just "did this UA hit a
    // honeypot path" -- with the strict pure-ThreatBand semantics every row
    // sat muted-grey because most live bots are scrapers that have not (yet)
    // probed anything hostile. We still let an actual ThreatBand override
    // upward; bot-prob just provides a floor so a 100% bot row never looks
    // ignorable. The shield SHAPE still tracks the highest severity component
    // so colour-blind operators see the gradient via icon shape too.
    int Rank(string b) => b switch
    {
        "Critical" => 5,
        "VeryHigh" => 4,
        "High"     => 4,
        "Elevated" => 3,
        "Medium"   => 3,
        "Low"      => 1,
        _          => 0
    };
    var probRank = Model.BotProbability switch
    {
        >= 0.85 => 4,   // High-confidence bot -- red shield
        >= 0.55 => 3,   // Moderate -- amber
        >= 0.30 => 1,   // Low -- green
        _       => 0    // Below threshold -- muted
    };
    var rank = Math.Max(Rank(band), probRank);
    var (icon, color, label, tip) = rank switch
    {
        5 => ("bxs-shield-x",     "var(--color-error,   #ef4444)", "Critical",
              band == "Critical"
                ? "Active attack signals -- block immediately"
                : "Active attack signals (escalated by threat band)"),
        4 => ("bxs-shield-x",     "var(--color-error,   #ef4444)", "High",
              band is "VeryHigh" or "High"
                ? "Hostile shape detected -- challenge or throttle"
                : "High-confidence bot -- treat as risk to the site"),
        3 => ("bxs-shield-minus", "var(--color-warning, #f59e0b)", "Medium",
              band is "Elevated" or "Medium"
                ? "Suspicious shape -- monitor"
                : "Moderate-confidence bot -- monitor"),
        1 => ("bxs-shield",       "var(--color-success, #22c55e)", "Low",      "Low risk -- no hostile signals"),
        _ => ("bxs-shield",       "rgba(148, 163, 184, 0.55)",     "None",     "No hostile signals or bot evidence")
    };
}
@{ var fullTip = $"Threat: {label} -- {tip}"; }
<span class="tooltip tooltip-left before:max-w-xs before:whitespace-pre-line" data-tip="@fullTip">
    <i class="bx @icon text-lg" style="color: @color;" aria-label="Threat: @label"></i>
</span>
