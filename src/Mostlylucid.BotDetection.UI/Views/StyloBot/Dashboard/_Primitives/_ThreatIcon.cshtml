@using Mostlylucid.BotDetection.UI.Models.Primitives
@model ThreatIconModel
@{
    // Threat is an orthogonal axis -- "is this actor hitting hostile signals
    // (honeypots, CVE probes, known-bad shapes)" -- driven STRICTLY by
    // ThreatBand, never by bot probability. A confident bot doing benign
    // crawling reads green here; a low-probability actor that hit a CVE probe
    // reads red. The two are independent and must NOT be conflated.
    //
    // Shield shape changes with severity (full / minus / x) so the gradient
    // survives colour-vision deficits. Inline `color: var(--color-...)` --
    // Tailwind text-error / text-warning / text-success class modifiers were
    // missing from the JIT-compiled bundle.
    var band = Model.Band ?? "None";
    var (icon, color, label, tip) = band switch
    {
        "Critical" => ("bxs-shield-x",     "var(--color-error,   #ef4444)", "Critical", "Active attack signals -- block immediately"),
        "VeryHigh" => ("bxs-shield-x",     "var(--color-error,   #ef4444)", "Very High","Multiple high-confidence hostile signals"),
        "High"     => ("bxs-shield-minus", "var(--color-error,   #ef4444)", "High",     "Hostile shape detected -- challenge or throttle"),
        "Elevated" => ("bxs-shield-minus", "var(--color-warning, #f59e0b)", "Elevated", "Suspicious shape -- monitor"),
        "Medium"   => ("bxs-shield-minus", "var(--color-warning, #f59e0b)", "Medium",   "Some hostile-shape signals fired"),
        "Low"      => ("bxs-shield",       "var(--color-success, #22c55e)", "Low",      "No active hostile signals"),
        _          => ("bxs-shield",       "rgba(148, 163, 184, 0.55)",     "None",     "No hostile signals (honeypot, CVE, etc.) fired")
    };
}
@{ var fullTip = $"Threat: {label} -- {tip}"; }
<span class="tooltip tooltip-left before:max-w-xs before:whitespace-pre-line" data-tip="@fullTip" title="@fullTip">
    <i class="bx @icon text-lg" style="color: @color;" aria-label="Threat: @label"></i>
</span>
