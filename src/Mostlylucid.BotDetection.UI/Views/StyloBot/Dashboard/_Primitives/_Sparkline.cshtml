@using Mostlylucid.BotDetection.UI.Models.Primitives
@model SparklineModel
@{
    // Datatype micro-chart (operator directive 2026-08-13): sparklines render as
    // TYPED LIGATURES — pure text baked at SSR time, no JS/SVG/images, survives
    // restart because the source is the persisted per-minute trend. Values are
    // normalized 0-100 and downsampled to <= 20 points (Datatype's limit).
    const int MaxPoints = 20;

    var series = Model.BotTrend.Length >= Model.HumanTrend.Length ? Model.BotTrend : Model.HumanTrend;
    int botSum = 0;   foreach (var v in Model.BotTrend)   botSum   += v;
    int humanSum = 0; foreach (var v in Model.HumanTrend) humanSum += v;
    var title = $"{Model.WindowMinutes}m: {botSum:N0} bot · {humanSum:N0} human";

    int sharedMax = 1;
    foreach (var v in series) if (v > sharedMax) sharedMax = v;

    var points = new List<int>(MaxPoints);
    if (series.Length > 0)
    {
        var bucket = Math.Max(1, (int)Math.Ceiling(series.Length / (double)MaxPoints));
        for (var i = 0; i < series.Length; i += bucket)
        {
            var sum = 0; var n = 0;
            for (var j = i; j < Math.Min(i + bucket, series.Length); j++) { sum += series[j]; n++; }
            points.Add((int)Math.Round(sum / (double)n / sharedMax * 100));
        }
    }

    // Stroke colour echoes the threat shield (same banding as before): volume,
    // not danger — routine bots read muted, confident bad actors read red.
    var botStroke = Model.ThreatBand switch
    {
        "VeryHigh" or "Critical" or "High" => "var(--color-error,   #ef4444)",
        "Medium"   or "Elevated"            => "var(--color-warning, #f59e0b)",
        _                                   => "var(--color-base-content, #94a3b8)"
    };
}
<span class="datatype" role="img" aria-label="@title" title="@title"
      style="color: @botStroke; font-size: 13px; line-height: 1;">
    @if (points.Count > 1)
    {
        <text>{l:@string.Join(',', points)}</text>
    }
    else
    {
        <text>–</text>
    }
</span>
