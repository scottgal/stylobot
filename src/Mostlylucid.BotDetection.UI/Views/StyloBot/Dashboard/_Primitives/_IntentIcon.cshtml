@using Mostlylucid.BotDetection.UI.Models.Primitives
@model IntentIconModel
@{
    var intent = Model.Intent ?? "Unknown";
    var (icon, label, tip) = intent switch
    {
        "Scraper" or "Scanner"  => ("bx-spider",         "Scraper",   "Scrapes pages at scale -- credential harvest, content reuse, inventory theft"),
        "Probe"                 => ("bx-search-alt",     "Probe",     "Probes endpoints looking for vulns, leaked secrets, or open admin paths"),
        "AI" or "AiBot"         => ("bx-brain",          "AI",        "AI / LLM crawler training on your content"),
        "Tool"                  => ("bx-wrench",         "Tool",      "Generic HTTP tool / library (curl, requests, etc.)"),
        "Browser"               => ("bx-globe",          "Browser",   "Looks like a real interactive browser"),
        "Crawler"               => ("bx-network-chart",  "Crawler",   "Indexing / SEO crawler"),
        "Automated"             => ("bx-bot",            "Automated", "Headless / scripted automation -- intent unclear"),
        "MonitoringBot"         => ("bx-pulse",          "Monitor",   "Uptime / synthetic monitoring"),
        _                       => ("bx-help-circle",    intent,      "Intent could not be classified from signals")
    };
}
@* Intent is a category, not a severity. Threat is what carries the green->red color
   gradient; intent stays a neutral monochrome glyph so a "Scraper" badge doesn't
   imply higher danger than a "Browser" badge just by its colour. The shape of the
   icon and the tooltip carry the meaning. *@
<span class="tooltip tooltip-left before:max-w-xs before:whitespace-pre-line" data-tip="@label -- @tip">
    <i class="bx @icon text-base-content/70 text-base" aria-label="@label"></i>
</span>
