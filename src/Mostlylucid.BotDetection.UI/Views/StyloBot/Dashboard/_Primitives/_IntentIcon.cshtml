@using Mostlylucid.BotDetection.UI.Models.Primitives
@model IntentIconModel
@{
    // Filled (bxs-) glyphs at a larger size so a Scraper spider doesn't read as a
    // tiny scribble. Each category gets a distinct hue used as IDENTITY, not
    // severity: red Scraper / orange Probe / purple AI / blue Browser / cyan
    // Crawler / amber Automated / green Monitor / muted Unknown. Threat is the
    // column that carries the severity gradient; intent answers "what kind of
    // actor is this" and a glance across the column tells you the visitor mix.
    var intent = Model.Intent ?? "Unknown";
    var (icon, colorClass, label, tip) = intent switch
    {
        "Scraper" or "Scanner"  => ("bxs-spider",         "text-error",          "Scraper",   "Scrapes pages at scale -- credential harvest, content reuse, inventory theft"),
        "Probe"                 => ("bxs-search-alt-2",   "text-orange-400",     "Probe",     "Probes endpoints looking for vulns, leaked secrets, or open admin paths"),
        "AI" or "AiBot"         => ("bxs-brain",          "text-purple-400",     "AI",        "AI / LLM crawler training on your content"),
        "Tool"                  => ("bxs-wrench",         "text-base-content/60","Tool",      "Generic HTTP tool / library (curl, requests, etc.)"),
        "Browser"               => ("bxs-globe",          "text-info",           "Browser",   "Looks like a real interactive browser"),
        "Crawler"               => ("bxs-network-chart",  "text-cyan-400",       "Crawler",   "Indexing / SEO crawler"),
        "Automated"             => ("bxs-bot",            "text-amber-400",      "Automated", "Headless / scripted automation -- intent unclear"),
        "MonitoringBot"         => ("bxs-pulse",          "text-success",        "Monitor",   "Uptime / synthetic monitoring"),
        _                       => ("bxs-help-circle",    "text-base-content/40", intent,     "Intent could not be classified from signals")
    };
}
<span class="tooltip tooltip-left before:max-w-xs before:whitespace-pre-line" data-tip="@label -- @tip">
    <i class="bx @icon @colorClass text-lg" aria-label="@label"></i>
</span>
