@using Mostlylucid.BotDetection.UI.Models.Primitives
@model IntentIconModel
@{
    var intent = Model.Intent ?? "Unknown";
    var (icon, colorClass, label, tip) = intent switch
    {
        "Scraper" or "Scanner"  => ("bx-spider",         "text-error",          "Scraper",   "Scrapes pages at scale -- credential harvest, content reuse, inventory theft"),
        "Probe"                 => ("bx-search-alt",     "text-warning",        "Probe",     "Probes endpoints looking for vulns, leaked secrets, or open admin paths"),
        "AI" or "AiBot"         => ("bx-brain",          "text-info",           "AI",        "AI / LLM crawler training on your content"),
        "Tool"                  => ("bx-wrench",         "text-base-content/70","Tool",      "Generic HTTP tool / library (curl, requests, etc.)"),
        "Browser"               => ("bx-globe",          "text-success",        "Browser",   "Looks like a real interactive browser"),
        "Crawler"               => ("bx-network-chart",  "text-info",           "Crawler",   "Indexing / SEO crawler"),
        "Automated"             => ("bx-bot",            "text-warning",        "Automated", "Headless / scripted automation -- intent unclear"),
        "MonitoringBot"         => ("bx-pulse",          "text-success",        "Monitor",   "Uptime / synthetic monitoring"),
        _                       => ("bx-help-circle",    "text-base-content/40", intent,     "Intent could not be classified from signals")
    };
}
<span class="tooltip tooltip-left before:max-w-xs before:whitespace-pre-line" data-tip="@label -- @tip">
    <i class="bx @icon @colorClass text-base" aria-label="@label"></i>
</span>
