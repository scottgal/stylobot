@using Mostlylucid.BotDetection.UI.Models
@model DashboardShellModel
@{
    // No Layout = null. Host's _ViewStart picks the layout (the website's _Layout
    // for stylobot.net). The host owns the chrome: navbar, footer, vendor CSS/JS,
    // theme boot, CSP nonces. This view emits dashboard CONTENT only; the inline
    // CSS vars and supplemental scripts stay because they are content-specific.
    ViewData["Title"] = "StyloBot Detection Dashboard";
    var bp = Model.BasePath;
    var tab = Model.ActiveTab;
    string TabUrl(string t) => $"{bp}?tab={t}";
    string TabClass(string t) => tab == t
        ? "bg-base-100 shadow-sm text-base-content font-semibold"
        : "text-base-content/40 hover:text-base-content/60";
}
<script nonce="@Model.CspNonce">
    (function() {
        if (new URLSearchParams(window.location.search).get('embed') === '1') {
            document.addEventListener('DOMContentLoaded', function() {
                var hdr = document.getElementById('sb-brand-header');
                if (hdr) hdr.style.display = 'none';
            });
        }
        // Allow HTMX-injected partial scripts to run under this page's CSP nonce
        if (typeof htmx !== 'undefined') htmx.config.inlineScriptNonce = '@Model.CspNonce';
    })();
</script>
<style nonce="@Model.CspNonce">
    [x-cloak] { display: none !important; }
    :root, [data-theme] {
        --sb-surface:      var(--color-base-200);
        --sb-card-bg:      var(--color-base-100);
        --sb-card-border:  color-mix(in oklch, var(--color-base-content) 15%, transparent);
        --sb-card-divider: color-mix(in oklch, var(--color-base-content) 8%, transparent);
        --sb-card-subtle:  var(--color-base-300);
        --sb-brand-muted:  color-mix(in oklch, var(--color-base-content) 55%, transparent);
        --sb-brand-strong: var(--color-base-content);
        --sb-accent:       var(--color-accent);
        --sb-accent-alt:   var(--color-primary);
        --sb-accent-strong:var(--color-success);
        --sb-signal-pos:   var(--color-success);
        --sb-signal-warn:  var(--color-warning);
        --sb-signal-danger:var(--color-error);
    }
    .sb-link { color: var(--sb-accent); text-decoration: none; }
    .sb-link:hover { text-decoration: underline; }
    .sb-connected { background: var(--sb-signal-pos); }
    .sb-disconnected { background: var(--sb-signal-danger); }
    .sb-connecting { background: var(--sb-signal-warn); animation: pulse 1.5s infinite; }
    @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    /* DaisyUI's .modal renders display:grid covering the viewport at z-index 999
       even when the <dialog> has no [open] attribute. Forcing display:none on
       a closed dialog removes the click-intercept layer entirely. */
    dialog.modal:not([open]) { display: none !important; }
</style>

@* Pre-launch / release banners are a host concern (marketing site copy), not a
   FOSS dashboard concern. Hosts that want a banner render their own at the top
   of their _Layout; embedding the FOSS dashboard never doubles it. The
   RenderShell option survives for hosts that want to suppress chrome the
   middleware injects elsewhere; it no longer drives a banner here. *@

<!-- Main content -->
<main class="max-w-7xl mx-auto px-2 py-4">

        <!-- Compact metric strip + Your Detection pill (single row, ~48px instead of ~360px).
             The old two-column grid (sb-summary-stats card + license/your-detection card) ate the
             top third of the dashboard before the operator saw any actual data. The metric strip
             below carries the same numbers in one line; the map+graph below the tab nav are the
             real headline of this page. -->
        @{
            var yd = Model.YourDetection;
            var ydRiskClass = yd.RiskBand is "VeryHigh" or "High" ? "text-error"
                : yd.RiskBand is "Medium" or "Elevated" ? "text-warning" : "text-success";
            var ydProbPct = (yd.BotProbability * 100).ToString("F1");
            var summary = Model.Summary.Summary;
            var totalReq = summary.TotalRequests;
            var botReq = summary.BotRequests;
            var humanReq = summary.HumanRequests;
            var uncertain = summary.UncertainRequests;
            var uniqueSigs = summary.UniqueSignatures;
            var botPctStrip = totalReq > 0 ? (double)botReq / totalReq * 100 : 0;
            var botPctClass = botPctStrip > 50 ? "text-error" : botPctStrip > 20 ? "text-warning" : "text-success";
        }
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1 px-3 py-2 mb-3 rounded-lg border text-xs"
             style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <span class="flex items-baseline gap-1">
                <span class="font-bold text-base-content">@totalReq.ToString("N0")</span>
                <span class="text-base-content/50 text-[10px]">req</span>
            </span>
            <span class="flex items-baseline gap-1">
                <span class="font-bold @botPctClass">@botPctStrip.ToString("F1")%</span>
                <span class="text-base-content/50 text-[10px]">bot</span>
            </span>
            <span class="flex items-baseline gap-1 text-base-content/70">
                <span class="text-error">@botReq.ToString("N0")</span>
                <span class="text-base-content/30">/</span>
                <span class="text-success">@humanReq.ToString("N0")</span>
                <span class="text-base-content/50 text-[10px]">bot / human</span>
            </span>
            <span class="flex items-baseline gap-1">
                <span class="font-bold">@uniqueSigs.ToString("N0")</span>
                <span class="text-base-content/50 text-[10px]">signatures</span>
            </span>
            @if (uncertain > 0)
            {
                <span class="flex items-baseline gap-1 text-base-content/50">
                    <span class="font-bold">@uncertain.ToString("N0")</span>
                    <span class="text-[10px]">uncertain</span>
                </span>
            }

            @* Your detection pill, right-aligned. Whole pill clicks through to the user's signature page. *@
            <span class="ml-auto flex items-center gap-1.5">
                @if (yd.HasData)
                {
                    <span class="text-[10px] text-base-content/40 uppercase tracking-wider">You:</span>
                    @if (yd.IsBot) { <span class="badge badge-xs badge-error">Bot</span> }
                    else { <span class="badge badge-xs badge-success">Human</span> }
                    <span class="text-[11px] font-bold @ydRiskClass">@ydProbPct%</span>
                    <span class="text-[10px] text-base-content/50">@yd.RiskBand</span>
                    @if (!string.IsNullOrEmpty(yd.Signature))
                    {
                        <a href="@yd.BasePath/signature/@Uri.EscapeDataString(yd.Signature)" class="text-[10px] text-base-content/40 hover:text-base-content/70 underline">view →</a>
                    }
                }
                else
                {
                    <span class="text-[10px] text-base-content/40">Detection pending…</span>
                }
            </span>
        </div>

        @if (Model.License.Status != LicenseStatusKind.Unconfigured)
        {
            <!-- Commercial license card on its own compact row -->
            <div class="mb-3">
                @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_LicenseCard.cshtml", Model.License)
            </div>
        }

        @* Commercial-only: full Your Detection partial below the strip (gives operators the
           expanded detector trace they expect on commercial dashboards). FOSS gets the compact
           pill inside the strip above and nothing else. *@
        @if (Model.License.Status != LicenseStatusKind.Unconfigured)
        {
            <div class="mb-3">
                @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_YourDetection.cshtml", Model.YourDetection)
            </div>
        }

        <!-- Tab navigation. Consolidated from 15 → 9 user-visible top-level tabs:
             - Identities folded into Visitors (sub-filter pill inside)
             - Threat Intel folded into Threats (sub-filter "Detected" / "Feed")
             - Clusters surfaces as a tab inside Activity (deferred) -- removed for now to fit one row
             - User Agents folded into Visitors (sub-filter)
             - Static Routes tab removed; ASP.NET pack still contributes its own Routes via
               Model.MonitoringPacks below, so hosts that load the pack see it dynamically.
        -->
        <div class="flex items-center gap-1 my-4 bg-base-300/50 rounded-lg p-0.5 w-fit flex-wrap">
            <a href="@TabUrl("overview")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("overview")">Overview</a>
            <a href="@TabUrl("activity")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("activity")">Activity</a>
            <a href="@TabUrl("visitors")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("visitors")">Visitors</a>
            <a href="@TabUrl("countries")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("countries")">Countries</a>
            <a href="@TabUrl("endpoints")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("endpoints")">Endpoints</a>
            <a href="@TabUrl("sessions")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("sessions")">Sessions</a>
            <a href="@TabUrl("threats")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("threats")">Threats</a>
            @foreach (var pack in Model.MonitoringPacks)
            {
                <a href="@TabUrl(pack.Id)" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass(pack.Id)">@pack.TabName</a>
            }
            @if (Model.IsCommercial)
            {
                <a href="@TabUrl("compliance")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("compliance")">Compliance</a>
                <a href="@TabUrl("configuration")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("configuration")">Configuration</a>
                <a href="@TabUrl("investigate")" class="px-3 py-1.5 text-xs font-medium rounded-md transition-all @TabClass("investigate")">Investigate</a>
            }
        </div>

        @* StatusStrip belongs on the configuration surface only -- it's noise on every
           other tab (Pack/Detection/Services/Guardians/Tunnels are setup signals, not
           operator situational awareness). *@
        @if (tab == "configuration" && Model.StatusStrip is not null)
        {
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_StatusStrip.cshtml", Model.StatusStrip)
        }

        @if (tab == "overview")
        {
            var highRiskEndpoints = Model.Endpoints.Endpoints.Count(e => e.BotRate > 0.5 && e.TotalCount >= 5);
            var botPct = Model.Summary.Summary.BotPercentage;
            var activeBotCount = Model.TopBots.TotalCount;

            @if (highRiskEndpoints > 0 || botPct > 30 || activeBotCount > 0)
            {
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2.5 mb-4 rounded-xl text-xs"
                     style="background: color-mix(in oklab, var(--sb-signal-danger) 10%, var(--sb-card-bg)); border: 1px solid color-mix(in oklab, var(--sb-signal-danger) 25%, transparent);">
                    <i class="bx bx-shield-x text-error text-base shrink-0"></i>
                    @if (highRiskEndpoints > 0)
                    {
                        <a href="@TabUrl("endpoints")" class="hover:underline"><span class="font-bold text-error">@highRiskEndpoints</span> endpoint@(highRiskEndpoints != 1 ? "s" : "") under high bot pressure</a>
                        <span class="text-base-content/20">|</span>
                    }
                    @if (activeBotCount > 0)
                    {
                        <a href="@TabUrl("visitors")?filter=bots" class="hover:underline"><span class="font-bold">@activeBotCount</span> bot signature@(activeBotCount != 1 ? "s" : "") active</a>
                    }
                    @if (botPct > 10)
                    {
                        <span class="text-base-content/20">|</span>
                        <a href="@TabUrl("activity")" class="hover:underline @(botPct > 30 ? "text-error font-bold" : "")">@botPct.ToString("F0")% bot traffic</a>
                    }
                    <a href="@TabUrl("threats")" class="ml-auto text-base-content/50 hover:text-base-content">Threats →</a>
                </div>
            }

            @* Overview header row: two equal columns. World map lives on the Countries tab
               only -- it ate too much space here without delivering operator value. *@
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-stretch">

                <!-- LEFT: Traffic Over Time, half-page width. -->
                <div class="rounded-xl border overflow-hidden flex flex-col" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                    <div class="flex items-center justify-between px-3 py-1.5 border-b" style="border-color: var(--sb-card-divider);">
                        <div class="flex items-center gap-1">
                            <span class="text-[10px] font-semibold text-base-content/70">TRAFFIC OVER TIME</span>
                            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_HelpIcon.cshtml", "traffic-chart")
                        </div>
                        <div id="time-chart-windows" class="flex items-center gap-0.5 bg-base-300/50 rounded-md p-0.5"
                             data-active="1h">
                            <button type="button" data-window="15m" data-bucket="60"
                                    class="px-2 py-0.5 text-[10px] font-medium rounded-md text-base-content/40 hover:text-base-content/70">15m</button>
                            <button type="button" data-window="1h" data-bucket="60"
                                    class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-primary text-primary-content shadow ring-1 ring-primary/40">1h</button>
                            <button type="button" data-window="6h" data-bucket="300"
                                    class="px-2 py-0.5 text-[10px] font-medium rounded-md text-base-content/40 hover:text-base-content/70">6h</button>
                            <button type="button" data-window="24h" data-bucket="1800"
                                    class="px-2 py-0.5 text-[10px] font-medium rounded-md text-base-content/40 hover:text-base-content/70">24h</button>
                        </div>
                    </div>
                    <div class="p-2 flex-1">
                        <div id="time-chart" style="height: 100%; min-height: 240px;"></div>
                    </div>
                </div>

                <!-- RIGHT: Live Activity, half-page width with shared toolbar + pagination. -->
                <div class="flex">
                    <sb-top-bots filter="all" sort="lastseen" page-size="10" widget-id="live-activity" />
                </div>
            </div>

            <!-- BELOW THE CHARTS: full-width endpoints list. Each row links to the endpoint
                 detail page (not the endpoints tab) so the operator drills into the rich
                 detail panel directly. -->
            <div class="mt-4 rounded-xl border overflow-hidden" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <div class="flex items-center justify-between px-3 py-1.5 border-b" style="border-color: var(--sb-card-divider);">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-semibold text-base-content/70">ENDPOINTS BY BOT PRESSURE</span>
                        <span class="text-[9px] px-1 py-0.5 rounded bg-error/20 text-error font-medium">LIVE</span>
                    </div>
                    <a href="@TabUrl("endpoints")" class="text-[9px] text-base-content/40 hover:text-base-content/60">All endpoints →</a>
                </div>
                @* SSR-first: server-renders the endpoints data on initial paint and registers a
                   data-sb-widget so the SignalR coordinator OOB-swaps fresh data when 'endpoints'
                   invalidations fire. No hx-trigger="every Xs" polling; no "Loading..." flash. *@
                <sb-endpoints-list sort="botrate" dir="desc" page-size="10" exclude-static="true" />
            </div>
        }
        else if (tab == "activity")
        {
            <!-- Full activity view: the same sb-top-bots widget the overview uses, sized up
                 to 25 rows and rendered as the "live-activity" variant. Replaces the older
                 _RecentActivity partial whose paging + filtering quietly stopped working and
                 whose row count drifted downward over time. Same widget id ("live-activity")
                 means the data-sb-depends wiring already SignalR-refreshes correctly. -->
            <!-- 50/50 split. Both panels own half the page width; left fills its half
                 (page-size="25" gives Live Activity the room it needs), right does NOT
                 horizontally scroll (compact=true on the endpoints partial drops the
                 wide columns so everything fits inside the column). -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-stretch">
                <div class="h-full min-w-0">
                    <sb-top-bots filter="all" sort="lastseen" page-size="25" widget-id="live-activity" />
                </div>
                <div class="h-full min-w-0">
                    <!-- Match the DaisyUI card chrome the sb-top-bots component renders so both
                         panels look identical (same background, same padding, same header weight). -->
                    <div class="card bg-base-200 transition-all duration-200 h-full w-full">
                        <div class="card-body p-3 overflow-hidden flex flex-col">
                            <div class="flex items-center gap-1 mb-1">
                                <h3 class="text-sm font-bold text-base-content">Active Endpoints</h3>
                                <span class="text-[9px] px-1 py-0.5 rounded bg-error/20 text-error font-medium">LIVE</span>
                                <a href="@TabUrl("endpoints")" class="ml-auto text-[10px] text-base-content/40 hover:text-base-content/60">All endpoints →</a>
                            </div>
                            @* SSR-first endpoints widget; SignalR-driven OOB updates via data-sb-widget. *@
                            <sb-endpoints-list sort="total" dir="desc" page-size="15" exclude-static="true" compact="true" />
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (tab == "visitors")
        {
            <sb-visitor-list />
        }
        else if (tab == "countries")
        {
            <!-- Country map + table -->
            <div class="rounded-xl border overflow-hidden mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <div class="flex items-center justify-between px-3 py-1.5 border-b" style="border-color: var(--sb-card-divider);">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-semibold text-base-content/70">GLOBAL THREAT MAP</span>
                        <span class="text-[9px] px-1 py-0.5 rounded status-badge-danger font-medium">LIVE</span>
                    </div>
                </div>
                <div id="countries-map" class="relative" style="height: 440px;"></div>
            </div>
            <sb-countries-list />
        }
        else if (tab == "endpoints")
        {
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
                <div class="lg:col-span-3">
                    <sb-endpoints-list />
                </div>
                <div class="lg:col-span-2">
                    <div id="endpoint-detail-panel"
                         class="rounded-xl border sticky top-4"
                         style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                        <div class="p-4 text-xs text-base-content/40 text-center py-12">
                            Click an endpoint to inspect traffic mix, top bots, and recent requests
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (tab == "sessions")
        {
            <sb-sessions-list />
        }
        else if (tab == "identities")
        {
            <sb-identities-list />
        }
        else if (tab == "clusters")
        {
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_ClustersList.cshtml", Model.Clusters)
        }
        else if (tab == "threats")
        {
            <sb-threats-list />
        }
        else if (tab == "threat-intel")
        {
            <sb-threat-intel-tab />
        }
        else if (tab == "useragents")
        {
            <sb-useragents-list />
        }
        else if (tab == "routes")
        {
            <sb-routes-tab />
        }
        else if (Model.MonitoringPacks.FirstOrDefault(p => p.Id == tab) is { } activePack)
        {
            <sb-metrics-tab pack-id="@activePack.Id" />
        }
        else if (tab == "compliance" && Model.Compliance is not null)
        {
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_ComplianceTab.cshtml", Model.Compliance)
        }
        else if (tab == "configuration" && Model.Configuration is not null)
        {
            ViewBag.CspNonce = Model.CspNonce;
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_ConfigurationEditor.cshtml", Model.Configuration)
        }
        else if (tab == "investigate" && Model.Investigation is not null)
        {
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Investigate.cshtml", Model.Investigation)
        }

    </main>

    <!-- Policy modal: FOSS config snippet (globally available, triggered from endpoint rows and detail panel) -->
    <dialog id="sb-policy-modal" class="modal">
        <div class="modal-box max-w-2xl" style="background: var(--sb-card-bg); border: 1px solid var(--sb-card-border);">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h3 class="font-bold text-sm">Apply Bot Policy</h3>
                    <div class="text-xs text-base-content/50 mt-1 flex items-center gap-1.5">
                        <span class="font-mono text-[10px] px-1.5 py-0.5 rounded font-bold" style="background: var(--sb-card-subtle); color: var(--sb-brand-strong);" id="pm-method">GET</span>
                        <span class="font-mono text-xs truncate max-w-[380px]" id="pm-path">/path</span>
                    </div>
                </div>
                <form method="dialog">
                    <button class="btn btn-ghost btn-xs btn-circle"><i class="bx bx-x text-base"></i></button>
                </form>
            </div>

            <div class="flex flex-wrap gap-3 mb-4">
                <div class="flex-1 min-w-[200px]">
                    <label class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wider mb-1 block">Policy</label>
                    <select id="pm-policy" class="select select-sm select-bordered w-full">
                        <option value="block">block - HTTP 403 Forbidden</option>
                        <option value="throttle-stealth">throttle-stealth - Silent delay</option>
                        <option value="challenge">challenge - CAPTCHA / proof-of-work</option>
                        <option value="redirect-honeypot">redirect-honeypot - Trap redirect</option>
                        <option value="logonly">logonly - Shadow mode (no action)</option>
                    </select>
                </div>
                <div>
                    <label class="text-[10px] font-semibold text-base-content/60 uppercase tracking-wider mb-1 block">Block Threshold</label>
                    <select id="pm-threshold" class="select select-sm select-bordered">
                        <option value="0.5">50% - Aggressive</option>
                        <option value="0.7" selected>70% - Standard</option>
                        <option value="0.85">85% - Conservative</option>
                        <option value="0.95">95% - High confidence only</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-0 mb-3 text-xs bg-base-300 rounded-lg p-0.5 w-fit" id="pm-tabs">
                <button type="button" data-snippet-tab="attribute" class="px-3 py-1 rounded-md text-xs font-medium transition-all bg-base-100 shadow-sm">C# Attribute</button>
                <button type="button" data-snippet-tab="appsettings" class="px-3 py-1 rounded-md text-xs font-medium transition-all text-base-content/50 hover:text-base-content/70">appsettings.json</button>
            </div>

            <div id="pm-snippet-attribute">
                <pre id="pm-code-attribute" class="text-[11px] leading-relaxed rounded-lg p-3 overflow-x-auto" style="background: var(--sb-surface); border: 1px solid var(--sb-card-divider);"></pre>
            </div>
            <div id="pm-snippet-appsettings" style="display:none">
                <pre id="pm-code-appsettings" class="text-[11px] leading-relaxed rounded-lg p-3 overflow-x-auto" style="background: var(--sb-surface); border: 1px solid var(--sb-card-divider);"></pre>
            </div>

            <div class="flex items-center justify-between mt-3 pt-3 border-t border-base-300/40">
                <span class="text-[10px] text-base-content/40">
                    <i class="bx bx-info-circle mr-0.5"></i>FOSS: restart required after config changes
                </span>
                <button type="button" data-action="copy-policy-snippet" class="btn btn-sm btn-ghost gap-1.5">
                    <i class="bx bx-copy text-sm"></i>Copy
                </button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>

    <!-- Footer with version -->
    <footer class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between text-xs" style="color: var(--sb-brand-muted);">
        <span>StyloBot &mdash; Zero-PII Bot Detection</span>
        @if (!string.IsNullOrEmpty(Model.Version))
        {
            <span>v@(Model.Version)</span>
        }
    </footer>

    <sb-live-updates show-status="false" />

    <!-- World Threat Map + Time Series Chart initialization -->
    <script nonce="@Model.CspNonce">
    (function() {
        'use strict';
        var BASE = '@Html.Raw(bp)';

        // ── World Threat Map ─────────────────────────────────────────────
        function initMap(containerId) {
            var el = document.getElementById(containerId);
            if (!el || typeof jsVectorMap === 'undefined') return;

            // Resolve theme variables once at construction. daisyui exposes its palette as
            // CSS custom properties on :root -- pulling them here means the map adopts the
            // active theme's accent on first paint instead of the old dead-grey defaults.
            // (Re-theming on data-theme change is a follow-up: jsvectormap doesn't expose a
            // public setRegionStyle API and re-instantiating costs the active series state.)
            function themeVar(name, fallback) {
                var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
                return v || fallback;
            }
            var mapBase   = themeVar('--color-base-300', '#1e3a5f');
            var mapStroke = themeVar('--color-base-content', '#3b82f6');
            var mapHover  = themeVar('--color-primary', '#3b82f6');

            var map = new jsVectorMap({
                selector: '#' + containerId,
                map: 'world_merc',
                zoomOnScroll: true,
                zoomButtons: false,
                showTooltip: true,
                backgroundColor: 'transparent',
                regionStyle: {
                    initial:  { fill: mapBase,   stroke: mapStroke, strokeWidth: 0.5, fillOpacity: 0.55 },
                    hover:    { fill: mapHover,  fillOpacity: 0.75 },
                    selected: { fill: mapHover,  fillOpacity: 0.9 }
                },
                series: {
                    regions: [{
                        attribute: 'fill',
                        // Vivid traffic-density gradient: low traffic = teal, mid = amber, high = red.
                        // Stays theme-independent so the heatmap reads consistently across light/dark.
                        scale: { low: '#22d3ee', mid: '#f59e0b', high: '#ef4444' },
                        values: {},
                        min: 0, max: 1,
                        normalizeFunction: 'polynomial'
                    }]
                },
                onRegionTooltipShow: function(e, tooltip, code) {
                    var vals = map.series.regions[0]?.values;
                    if (!vals) return;
                    var rate = vals[code];
                    if (rate !== undefined) {
                        var span = document.createElement('span');
                        span.textContent = ' - Bot rate: ' + (rate * 100).toFixed(0) + '%';
                        tooltip.selector.appendChild(span);
                    }
                }
            });

            function refreshMap() {
                fetch(BASE + '/api/countries')
                    .then(function(r) { return r.json(); })
                    .then(function(countries) {
                        if (!countries || countries.length === 0) return;
                        var vals = {};
                        countries.forEach(function(c) {
                            if (c.countryCode) vals[c.countryCode] = c.botRate || 0;
                        });
                        map.series.regions[0].setValues(vals);
                    })
                    .catch(function() {});
            }

            refreshMap();
            setInterval(refreshMap, 30000);
            return map;
        }

        initMap('command-map');
        initMap('countries-map');

        // ── Traffic Over Time Chart ──────────────────────────────────────
        function initTimeChart() {
            var el = document.getElementById('time-chart');
            if (!el || typeof ApexCharts === 'undefined') return;

            // Window selector lives in the card header; default is whatever the markup
            // has marked as active (1h on first paint).
            var windowsEl = document.getElementById('time-chart-windows');
            function activeWindow() {
                if (!windowsEl) return { window: '1h', bucket: 60, ms: 3600000 };
                var key = windowsEl.getAttribute('data-active') || '1h';
                var btn = windowsEl.querySelector('button[data-window="' + key + '"]') || windowsEl.querySelector('button[data-window="1h"]');
                var bucket = parseInt(btn.getAttribute('data-bucket'), 10) || 60;
                var msMap = { '15m': 900000, '1h': 3600000, '6h': 21600000, '24h': 86400000 };
                return { window: key, bucket: bucket, ms: msMap[key] || 3600000 };
            }

            // Remember which series the operator has clicked off in the legend so
            // chart.updateSeries (called every 15s + on every pill click) doesn't
            // silently bring hidden series back. Default ApexCharts legend behaviour
            // toggles visibility on click but does NOT persist across data updates.
            var hiddenSeries = new Set();

            var chart = new ApexCharts(el, {
                chart: {
                    // Line, not area. The previous area fill closed the path back to the
                    // baseline at both extents -- with sparse data it looked like a
                    // filled mountain rather than a trend line.
                    // height: '100%' makes ApexCharts size to the parent (.flex-1 column),
                    // so the chart fills the available column height instead of stopping
                    // at a fixed 200px and leaving white space below.
                    type: 'line', height: '100%', toolbar: { show: false },
                    background: 'transparent', fontFamily: 'inherit', foreColor: '#888',
                    animations: { enabled: true, easing: 'easeinout', speed: 500 },
                    events: {
                        legendClick: function(chartCtx, seriesIndex, config) {
                            var name = config.config.series[seriesIndex] && config.config.series[seriesIndex].name;
                            if (!name) return;
                            if (hiddenSeries.has(name)) hiddenSeries.delete(name);
                            else hiddenSeries.add(name);
                        }
                    }
                },
                stroke: { curve: 'straight', width: 2 },
                markers: { size: 0, hover: { sizeOffset: 3 } },
                // No fill block: on a 'line' chart ApexCharts threads `fill.opacity`
                // through into the stroke's rgba alpha, so setting opacity:0 makes the
                // lines invisible (verified live -- paths rendered with rgba(...,0)).
                colors: ['#2dd4bf', '#ef4444'],
                series: [{ name: 'Human', data: [] }, { name: 'Bot', data: [] }],
                xaxis: {
                    type: 'datetime',
                    labels: { style: { fontSize: '10px' }, datetimeUTC: false },
                    axisBorder: { show: false }, axisTicks: { show: false }
                },
                yaxis: { labels: { style: { fontSize: '10px' } }, min: 0, forceNiceScale: true },
                grid: { borderColor: '#333', strokeDashArray: 3, padding: { left: 8, right: 8, top: 0, bottom: 0 } },
                legend: { show: true, position: 'top', fontSize: '10px', markers: { size: 4 } },
                tooltip: { theme: 'dark', x: { format: 'HH:mm' } },
                dataLabels: { enabled: false }
            });
            chart.render();

            function refreshChart() {
                var w = activeWindow();
                var end = new Date();
                var start = new Date(end.getTime() - w.ms);
                var url = BASE + '/api/timeseries'
                    + '?start=' + encodeURIComponent(start.toISOString())
                    + '&end=' + encodeURIComponent(end.toISOString())
                    + '&bucket=' + w.bucket;
                fetch(url)
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (!Array.isArray(data)) return;
                        var humans = [], bots = [];
                        data.forEach(function(pt) {
                            var ts = new Date(pt.timestamp).getTime();
                            humans.push({ x: ts, y: pt.humanCount || 0 });
                            bots.push({ x: ts, y: pt.botCount || 0 });
                        });
                        chart.updateOptions({
                            xaxis: { min: start.getTime(), max: end.getTime() }
                        }, false, false);
                        chart.updateSeries([
                            { name: 'Human', data: humans },
                            { name: 'Bot', data: bots }
                        ]);
                        // Re-apply the operator's legend toggles -- updateSeries shows
                        // all series by default. Without this every 15s tick (and every
                        // pill click) silently un-hides whatever the user clicked off.
                        hiddenSeries.forEach(function(name) { chart.hideSeries(name); });
                    })
                    .catch(function() {});
            }

            // Pill clicks switch the active window and refresh immediately.
            if (windowsEl) {
                windowsEl.addEventListener('click', function(e) {
                    var btn = e.target.closest('button[data-window]');
                    if (!btn) return;
                    var key = btn.getAttribute('data-window');
                    windowsEl.setAttribute('data-active', key);
                    Array.prototype.forEach.call(windowsEl.querySelectorAll('button'), function(b) {
                        var on = b === btn;
                        b.className = on
                            ? 'px-2 py-0.5 text-[10px] font-bold rounded-md bg-primary text-primary-content shadow ring-1 ring-primary/40'
                            : 'px-2 py-0.5 text-[10px] font-medium rounded-md text-base-content/40 hover:text-base-content/70';
                    });
                    refreshChart();
                });
            }

            refreshChart();
            setInterval(refreshChart, 15000);
        }

        initTimeChart();
    })();
    </script>

    <!-- Policy modal JS (available globally for HTMX-loaded endpoint rows) -->
    <script nonce="@Model.CspNonce">
    (function() {
        'use strict';

        var _pmActiveTab = 'attribute';

        window.sbOpenPolicyModal = function(event, method, path, currentPolicy) {
            if (event) event.stopPropagation();
            var modal = document.getElementById('sb-policy-modal');
            if (!modal) return;

            var decodedPath = decodeURIComponent(path);
            var decodedMethod = decodeURIComponent(method);

            document.getElementById('pm-method').textContent = decodedMethod;
            document.getElementById('pm-path').textContent = decodedPath;
            modal.dataset.path = decodedPath;
            modal.dataset.method = decodedMethod;

            if (currentPolicy) {
                var sel = document.getElementById('pm-policy');
                for (var i = 0; i < sel.options.length; i++) {
                    if (sel.options[i].value === currentPolicy) { sel.selectedIndex = i; break; }
                }
            }

            sbUpdatePolicySnippet();
            modal.showModal();
        };

        window.sbUpdatePolicySnippet = function() {
            var modal = document.getElementById('sb-policy-modal');
            if (!modal) return;

            var path = modal.dataset.path || '/your/endpoint';
            var method = (modal.dataset.method || 'GET');
            var policy = document.getElementById('pm-policy').value;
            var threshold = document.getElementById('pm-threshold').value;
            var mt = method.charAt(0).toUpperCase() + method.slice(1).toLowerCase();

            var attrCode = [
                '// Controller action:',
                '[BotPolicy(ActionPolicy = "' + policy + '", BlockThreshold = ' + threshold + ')]',
                '[Http' + mt + '("' + path + '")]',
                'public IActionResult YourAction() { ... }',
                '',
                '// Minimal API:',
                'app.Map' + mt + '("' + path + '", handler)',
                '   .BotPolicy("' + policy + '", blockThreshold: ' + threshold + ');'
            ].join('\n');

            var settingsCode = [
                '{',
                '  "BotDetection": {',
                '    "DefaultActionPolicyName": "' + policy + '",',
                '    "BotThreshold": ' + threshold,
                '  }',
                '}',
                '',
                '// Sets the GLOBAL default policy (all endpoints).',
                '// Restart required. For per-endpoint control use [BotPolicy].'
            ].join('\n');

            var codeAttr = document.getElementById('pm-code-attribute');
            var codeSettings = document.getElementById('pm-code-appsettings');
            if (codeAttr) codeAttr.textContent = attrCode;
            if (codeSettings) codeSettings.textContent = settingsCode;
        };

        window.sbShowSnippetTab = function(tabName) {
            _pmActiveTab = tabName;
            var tabs = document.querySelectorAll('#pm-tabs button');
            tabs.forEach(function(t, i) {
                var isActive = (i === 0 && tabName === 'attribute') || (i === 1 && tabName === 'appsettings');
                t.className = isActive
                    ? 'px-3 py-1 rounded-md text-xs font-medium transition-all bg-base-100 shadow-sm'
                    : 'px-3 py-1 rounded-md text-xs font-medium transition-all text-base-content/50 hover:text-base-content/70';
            });
            var attrDiv = document.getElementById('pm-snippet-attribute');
            var appDiv  = document.getElementById('pm-snippet-appsettings');
            if (attrDiv) attrDiv.style.display = tabName === 'attribute' ? '' : 'none';
            if (appDiv)  appDiv.style.display  = tabName === 'appsettings' ? '' : 'none';
        };

        window.sbCopyPolicySnippet = function(btn) {
            var elId = _pmActiveTab === 'attribute' ? 'pm-code-attribute' : 'pm-code-appsettings';
            var codeEl = document.getElementById(elId);
            if (!codeEl) return;
            var text = codeEl.textContent;

            function flashBtn(ok) {
                if (!btn) return;
                var icon = btn.querySelector('i');
                if (icon) icon.className = ok ? 'bx bx-check text-sm text-success' : 'bx bx-copy text-sm';
                setTimeout(function() { if (icon) icon.className = 'bx bx-copy text-sm'; }, 1500);
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function() { flashBtn(true); }).catch(function() { sbFbCopy(codeEl); flashBtn(true); });
            } else {
                sbFbCopy(codeEl); flashBtn(true);
            }
        };

        function sbFbCopy(el) {
            var r = document.createRange();
            r.selectNode(el);
            window.getSelection().removeAllRanges();
            window.getSelection().addRange(r);
            try { document.execCommand('copy'); } catch(e) {}
            window.getSelection().removeAllRanges();
        }

        document.addEventListener('click', function(e) {
            var btn = e.target.closest('[data-action]');
            if (!btn) return;
            var action = btn.dataset.action;
            if (action === 'toggle-pin-form') {
                e.stopPropagation();
                var form = document.getElementById('pin-endpoint-form');
                if (form) form.classList.toggle('hidden');
            } else if (action === 'hide-pin-form') {
                e.stopPropagation();
                var form = document.getElementById('pin-endpoint-form');
                if (form) form.classList.add('hidden');
            } else if (action === 'open-policy-modal') {
                sbOpenPolicyModal(e, btn.dataset.method, btn.dataset.path, btn.dataset.policy);
            } else if (action === 'copy-policy-snippet') {
                sbCopyPolicySnippet(btn);
            } else if (action === 'close-help-panel') {
                var panel = document.getElementById('help-panel');
                if (panel) panel.remove();
            } else if (action === 'navigate') {
                window.location = btn.dataset.href;
            } else if (action === 'toggle-detail-row') {
                var next = btn.nextElementSibling;
                if (next) next.style.display = next.style.display === 'none' ? 'table-row' : 'none';
            }
        });

        document.addEventListener('click', function(e) {
            var btn = e.target.closest('[data-snippet-tab]');
            if (!btn) return;
            sbShowSnippetTab(btn.dataset.snippetTab);
        });

        document.addEventListener('change', function(e) {
            if (e.target.id === 'pm-policy' || e.target.id === 'pm-threshold') {
                sbUpdatePolicySnippet();
            }
        });
    })();
    </script>