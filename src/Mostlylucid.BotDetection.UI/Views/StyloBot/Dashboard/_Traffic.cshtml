@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Extensions.Options
@using Mostlylucid.BotDetection.UI.Dashboard
@using Mostlylucid.BotDetection.UI.Dashboard.Composition
@using Mostlylucid.BotDetection.UI.Dashboard.Materialization
@using Mostlylucid.BotDetection.UI.Middleware
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Layout
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@using Mostlylucid.BotDetection.UI.Services
@model DashboardShellModel
@inject IOptions<DashboardLayoutOptions> LayoutOpts
@inject IOptions<ThreatsOptions> ThreatsOpts
@inject IDashboardContentCache ContentCache
@inject IDashboardPageManifestSource Manifests

@*
    M2 Traffic row partial. The row registry hands every row a
    DashboardShellModel; this partial owns the shell -> TrafficPageModel
    projection so the Traffic landing view (Traffic/Index.cshtml) keeps its
    typed @model contract while still rendering inside the dashboard chrome
    served by ServeDashboardPageAsync.

    DATA SOURCE (post p99=10s bimodal-tail fix): IDashboardContentCache, NOT
    IDashboardEventStore. This partial used to @inject IDashboardEventStore and
    call GetSummaryAsync / GetTopBotsAsync (x2, current + prior) /
    GetCountryStatsAsync / GetEndpointStatsAsync / GetTimeSeriesAsync directly,
    IN THE VIEW, on every render. On the website deployment topology
    IDashboardEventStore = RemoteDashboardEventStore, so every one of those was
    a live cross-service REST round-trip on the request thread -- for every
    single dashboard page view (this row is the default "traffic" row, so it
    renders on every un-warmed hit AND, since ServeDashboardPageAsync's
    "traffic" switch case never distinguishes ?partial=1 / HX-Request, on every
    SignalR-triggered swap too). That is what produced the bimodal p99 (fast
    when the OS/HTTP connection pool was warm, ~10s when it wasn't).
    ServeDashboardPageAsync ALREADY composes this exact bundle immediately
    before rendering this partial (same "dashboard.traffic" manifest, same
    BuildVisitorsPageWindow(Context) window) and stashes it in
    HttpContext.Items["sb.dashboard.pageresult"] -- the same convention every
    other dashboard widget (SbSummaryStatsViewComponent, SbCountriesListViewComponent,
    SbEndpointsListViewComponent, SbTopBotsViewComponent, SbVisitorListViewComponent)
    already reads from. So the current-period slice below reads THAT first
    (zero extra work -- no second cache call) and only falls back to its own
    ContentCache.GetCurrentAsync read (still cache-only, never a live store
    call, never compute-on-request per DashboardContentCache's own contract)
    when the shell's own compose degraded and didn't stash it. The prior-period
    comparison window is new: it goes through the SAME content cache with a
    second, disjoint (manifest, window) envelope ("dashboard.traffic.prior"),
    identical in shape to TrafficController.Index's own prior-window read --
    the tick materializer warms it the same way it warms any other live
    envelope, so this is a genuine cache read, never a synchronous compute.
*@
@{
    var query = Context!.Request.Query;
    string? Nullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;
    var opts = LayoutOpts.Value;
    var filters = new TrafficFilters(
        Country: Nullable(query["country"].FirstOrDefault()),
        BotType: Nullable(query["bot_type"].FirstOrDefault()),
        Window:  string.IsNullOrWhiteSpace(query["window"].FirstOrDefault())
                 ? FormatWindow(opts.DefaultTimeWindowMinutes)
                 : query["window"].FirstOrDefault()!,
        Threat:  Nullable(query["threat"].FirstOrDefault()));

    int ParseWindow(string window) => window switch
    {
        "15m"            => 15,
        "60m" or "1h"    => 60,
        "6h"             => 6 * 60,
        "12h"            => 12 * 60,
        "24h" or "1d"    => 24 * 60,
        "7d"             => 7 * 24 * 60,
        "30d"            => 30 * 24 * 60,
        _                => 60,
    };

    // Canonical window token from configured default minutes, so the label +
    // bucket sizer see "24h" (not a raw "1440m" that falls back to wide buckets).
    string FormatWindow(int minutes) => minutes switch
    {
        15            => "15m",
        60            => "1h",
        360           => "6h",
        720           => "12h",
        1440          => "24h",
        7 * 24 * 60   => "7d",
        30 * 24 * 60  => "30d",
        _             => "24h",
    };

    var minutes = ParseWindow(filters.Window);
    var now = DateTime.UtcNow;
    var startTime = now.AddMinutes(-minutes);
    var topN = opts.TrafficCardTopN;

    // Real hits-per-period bucket width, scaled to the window (shared with the
    // MVC TrafficController path so the two never drift).
    var bucketSize = HitsPerPeriodChartletBuilder.BucketSizeForWindow(filters.Window);

    // Current window: prefer the bundle ServeDashboardPageAsync ALREADY composed
    // for this exact request (same "dashboard.traffic" manifest + the same
    // BuildVisitorsPageWindow(Context) window) and stashed in HttpContext.Items --
    // the same convention every other dashboard widget reads from. Only falls
    // back to a direct content-cache read (still cache-only; DashboardContentCache
    // never computes on the request thread, see its own GetCurrentAsync contract)
    // when the shell's own compose degraded and didn't stash a "good enough"
    // bundle (see ServeDashboardPageAsync's own comment on that check).
    var page = Context!.Items["sb.dashboard.pageresult"] as DashboardPageResult;
    if (page is null)
    {
        var trafficManifest = Manifests.For("dashboard.traffic");
        if (trafficManifest is not null)
        {
            try
            {
                page = await ContentCache.GetCurrentAsync(
                    trafficManifest,
                    StyloBotDashboardMiddleware.BuildVisitorsPageWindow(Context),
                    Context.RequestAborted);
            }
            catch
            {
                // Degrade to the Warming rendering below -- never fail the page for a
                // dead cache dependency (adapts the old per-call try/catch's INTENT --
                // "one dead endpoint doesn't blank the whole page" -- to a cache read,
                // which can now only throw on a genuine bug/DI failure, not a network hop).
                page = null;
            }
        }
    }

    // IsWarming distinguishes "no snapshot has ever been composed for this
    // window yet" from "the window genuinely has zero traffic" -- the same
    // distinction DashboardPageResult.Warming exists to carry. A null page
    // (missing manifest / a caught exception above) renders the same warming
    // state rather than crashing or silently showing an all-zero page.
    // ALSO check TimeBuckets specifically (not just the coarse envelope flag):
    // that branch has its own heavier cold path (full-retention backfill) and
    // can independently be null even when page.IsWarming reports the rest of
    // the envelope as warm -- same fix as TrafficController.cs (9df6d314).
    var isWarming = page is null || page.IsWarming || page.TimeBuckets is null;
    var summary = page?.Summary;
    var topBots = page?.BotAggregate ?? new List<DashboardTopBotEntry>();
    var countriesData = (IReadOnlyList<DashboardCountryStats>)(page?.Geo ?? new List<DashboardCountryStats>());
    var endpointsData = (IReadOnlyList<DashboardEndpointStats>)(page?.Endpoints ?? new List<DashboardEndpointStats>());
    // The hits-per-period chart is a REAL durable time series from the event
    // store (Postgres on the gateway), composed as part of the same bundle --
    // survives restart, spans the retention window.
    var hitsSeriesRaw = page?.TimeBuckets ?? new List<DashboardTimeSeriesPoint>();

    // Prior window (period-over-period comparison): a genuinely separate
    // (manifest, window) envelope -- there is no shell-level fetch to reuse
    // here, so this is a new, but still cache-only, read. Identical shape to
    // TrafficController.Index's own prior-window read (same synthetic
    // "dashboard.traffic.prior" manifest of summary + top-bots only) so the
    // tick materializer treats it as just another live envelope to keep warm.
    DashboardSummary? priorSummary = null;
    var priorBots = new List<DashboardTopBotEntry>();
    try
    {
        var priorManifest = new DashboardPageManifest(
            "dashboard.traffic.prior", new[] { "summary", "top-bots" });
        var priorWindow = new DashboardPageWindow(
            StartTime: startTime.AddMinutes(-minutes),
            EndTime: startTime,
            AudienceFilter: "all",
            ProbMin: null,
            Domains: null,
            TopN: 500,
            BucketMinutes: (int)bucketSize.TotalMinutes);
        var priorPage = await ContentCache.GetCurrentAsync(priorManifest, priorWindow, Context.RequestAborted);
        priorSummary = priorPage.Summary;
        priorBots = priorPage.BotAggregate?.ToList() ?? new List<DashboardTopBotEntry>();
    }
    catch
    {
        // Defensive only (matches the old Safe* behaviour's intent): a failed
        // prior-window compose degrades to "no comparison" (0% deltas), never
        // fails the whole page.
    }

    // Project to the shared ProjectedVisitor shape — same helper Visitors page
    // uses, so all post-filter semantics (country / bot_type / threat) match
    // exactly. Applied AFTER the audience pill so chip + pill compose.
    var (visitors, _, _) = WidgetRenderHelpers.ProjectAsVisitors(
        topBots, filter: "all", sortField: "hits", sortDir: "desc",
        page: 1, pageSize: 500,
        country: filters.Country, botType: filters.BotType, threat: filters.Threat);

    // Real hits-per-period series: floor each durable store point onto the
    // window's bucket grid (gap-filled), rather than dumping each visitor's
    // whole hit count into its LastSeen bucket. Shared with TrafficController.
    var timeseries = HitsPerPeriodChartletBuilder.BuildSeries(hitsSeriesRaw, startTime, now, bucketSize);

    // BotFamilies sub-stack (feeds the currently-unrendered _TimeseriesBars)
    // stays keyed to the SAME real bucket axis so its arrays align with the
    // chart's length; it buckets by visitor LastSeen for the family split.
    var bucketCount = timeseries.Buckets.Count;
    var gridStart = bucketCount > 0 ? timeseries.Buckets[0] : startTime;
    int BucketIndex(DateTime lastSeen)
    {
        if (bucketCount == 0) return -1;
        var idx = (int)((lastSeen.Ticks - gridStart.Ticks) / bucketSize.Ticks);
        return idx < 0 || idx >= bucketCount ? -1 : idx;
    }

    // Counter strip: prefer DashboardSummary (per-detection-row sums over the
    // window — same number the page header shows). Falls back to summing the
    // top-bots projection when the summary call returned null.
    (int Total, int Humans, int Bots) SumBots(IReadOnlyList<DashboardTopBotEntry> rows)
    {
        var t = 0; var h = 0; var b = 0;
        foreach (var v in rows)
        {
            t += v.HitCount;
            if (v.BotProbability >= 0.8) b += v.HitCount;
            else if (v.BotProbability < 0.3) h += v.HitCount;
        }
        return (t, h, b);
    }
    double PctDelta(int cur, int prior)
    {
        if (prior == 0) return cur == 0 ? 0d : 100d;
        return (cur - prior) / (double)prior * 100d;
    }
    var (curTotal, curHumans, curBots) = summary is null
        ? SumBots(topBots)
        : (summary.TotalRequests, summary.HumanRequests, summary.BotRequests);
    var (prTotal, prHumans, prBots) = priorSummary is null
        ? SumBots(priorBots)
        : (priorSummary.TotalRequests, priorSummary.HumanRequests, priorSummary.BotRequests);
    var counters = new TrafficCounters(
        Total: curTotal,
        Humans: curHumans,
        Bots: curBots,
        BotShare: curBots / (double)Math.Max(1, curTotal),
        TotalDelta: curTotal - prTotal,
        HumansDelta: curHumans - prHumans,
        BotsDelta: curBots - prBots,
        TotalDeltaPct: PctDelta(curTotal, prTotal),
        HumansDeltaPct: PctDelta(curHumans, prHumans),
        BotsDeltaPct: PctDelta(curBots, prBots),
        // Distinct-fingerprint counts (period-scoped) for the headline "how many
        // actors" number; requests above remain the "how much traffic" secondary.
        // Fall back to request counts when no summary (topBots-only path) so the
        // headline degrades to the old behaviour rather than showing 0.
        TotalFingerprints: summary?.UniqueSignatures ?? curTotal,
        HumanFingerprints: summary?.HumanFingerprints ?? curHumans,
        BotFingerprints: summary?.BotFingerprints ?? curBots);

    // Bot-family series feeding the bar chart's bot sub-stack. Top-5 by hits;
    // everything else folds into a trailing "Other bots" slot painted neutral
    // grey so it visually recedes from the named families.
    var botRows = visitors.Where(v => v.BotProbability >= 0.8).ToList();
    BotFamilySeries botFamilies;
    if (botRows.Count == 0)
    {
        botFamilies = new BotFamilySeries(Array.Empty<string>(), Array.Empty<IReadOnlyList<int>>());
    }
    else
    {
        var byFamily = botRows
            .GroupBy(v => string.IsNullOrWhiteSpace(v.BotType) ? "Unknown bot" : v.BotType!)
            .Select(g => (Family: g.Key, Hits: g.Sum(v => v.Hits), Members: g.ToList()))
            .OrderByDescending(g => g.Hits)
            .ToList();
        const int famTopN = 5;
        var topFams = byFamily.Take(famTopN).ToList();
        var restFams = byFamily.Skip(famTopN).ToList();
        var famNames = topFams.Select(t => t.Family).ToList();
        var famSeries = new List<IReadOnlyList<int>>(topFams.Count + (restFams.Count > 0 ? 1 : 0));
        int[] BucketFamily(IReadOnlyList<ProjectedVisitor> rows)
        {
            var arr = new int[bucketCount];
            foreach (var v in rows)
            {
                var idx = BucketIndex(v.LastSeen);
                if (idx < 0) continue;
                arr[idx] += v.Hits;
            }
            return arr;
        }
        foreach (var (_, _, members) in topFams) famSeries.Add(BucketFamily(members));
        if (restFams.Count > 0)
        {
            famNames.Add("Other bots");
            famSeries.Add(BucketFamily(restFams.SelectMany(r => r.Members).ToList()));
        }
        botFamilies = new BotFamilySeries(famNames, famSeries);
    }

    // Breakdown cards. Countries + endpoints come from their dedicated
    // event-store endpoints (per-detection-row aggregation, not the LFU's
    // running-total view). Bot types + visitors + threats come from the
    // window-bounded top-bots projection.
    var countries = countriesData
        .Where(r => !string.IsNullOrEmpty(r.CountryCode))
        .OrderByDescending(r => r.TotalCount)
        .Take(topN)
        .Select(r => new CountryRow(
            CountryCode: r.CountryCode,
            Hits: r.TotalCount,
            BotShare: r.TotalCount > 0 ? r.BotCount / (double)r.TotalCount : 0d))
        .ToList();
    var botTypes = visitors
        .Where(v => v.IsBot && !string.IsNullOrEmpty(v.BotType))
        .GroupBy(v => v.BotType!)
        .Select(g => new BotTypeRow(g.Key, g.Sum(v => v.Hits)))
        .OrderByDescending(r => r.Hits)
        .Take(topN)
        .ToList();
    var endpoints = endpointsData
        .Where(r => !string.IsNullOrEmpty(r.Path))
        .OrderByDescending(r => r.TotalCount)
        .Take(topN)
        .Select(r => new EndpointRow(
            Method: string.IsNullOrEmpty(r.Method) ? string.Empty : r.Method,
            Path: r.Path,
            Hits: r.TotalCount,
            BotShare: r.BotRate))
        .ToList();
    var topVisitors = visitors.Take(topN).ToList();
    // Threats panel inclusion is delegated to ThreatsFilter so the test in
    // Mostlylucid.BotDetection.Test/Dashboard/ThreatsFilterTests can pin the
    // band-priority + probability-floor semantics. Before Task A4 this LINQ
    // filtered to ThreatBand in {Medium, High, Critical} only, which after
    // #178 ripped the parasitic header source matched only Internal pings —
    // 11k+ classified-bot rows (Scraper / Tool / Unknown / "None" band)
    // never surfaced. ThreatsFilter now ORs in BotProbability >= floor.
    var threats = ThreatsFilter
        .Apply(visitors, ThreatsOpts.Value ?? new ThreatsOptions())
        .Select(v => new ThreatRow(
            v.PrimarySignature,
            v.BotName ?? string.Empty,
            v.ThreatBand ?? "None",
            v.LastSeen))
        .ToList();

    var pageModel = new TrafficPageModel(
        Filters: filters,
        Counters: counters,
        Timeseries: timeseries,
        BotFamilies: botFamilies,
        Countries: countries,
        BotTypes: botTypes,
        TopEndpoints: endpoints,
        TopVisitors: topVisitors,
        Threats: threats,
        IsWarming: isWarming,
        BasePath: Model.BasePath,
        YourDetection: Model.YourDetection);
}
@await Html.PartialAsync("~/Views/StyloBot/Dashboard/Traffic/Index.cshtml", pageModel)
