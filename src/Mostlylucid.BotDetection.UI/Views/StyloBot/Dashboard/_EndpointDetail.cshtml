@using Mostlylucid.BotDetection.Policies.Rules
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@using System.Text.Json
@model EndpointDetailModel
@{
    // When the host's _ViewStart picks up this view (IsStandalonePage=true), let it
    // wrap us in its _Layout. When we're being rendered as an HTMX-swap fragment
    // (IsStandalonePage=false), Layout = null so we emit body markup only.
    if (!Model.IsStandalonePage) { Layout = null; }
    else { ViewData["Title"] = $"{Model.Method} {Model.Path} -- StyloBot endpoint detail"; }
    var bp = Model.BasePath;
    var navBp = Model.ResolvedNavBasePath;
    var chartId = "ep-radar-" + Guid.NewGuid().ToString("N")[..8];
    bool HasRadar = Model.Found && (Model.BotProfile != null || Model.HumanProfile != null || Model.OverallProfile != null);

    string ProfileJson(EndpointBehavioralProfile? p)
    {
        if (p == null) return "null";
        return JsonSerializer.Serialize(new[]
        {
            Math.Round(p.Probability, 1),
            Math.Round(p.Confidence, 1),
            Math.Round(p.ThreatScore, 1),
            Math.Round(p.BlockRate, 1),
            Math.Round(p.ErrorRate, 1),
            Math.Round(p.LatencyScore, 1)
        });
    }

    bool HasFlag(string? code) => !string.IsNullOrEmpty(code) && code.Length == 2 && code != "XX";
    string FlagUrl(string code) => $"/_content/Mostlylucid.BotDetection.UI/flags/{code.ToLowerInvariant()}.svg";

    string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 5) return "now";
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h";
        return $"{(int)span.TotalDays}d";
    }
}
@if (Model.IsStandalonePage)
{
    <div class="max-w-7xl mx-auto px-4 py-1.5 text-[10px] text-base-content/40 flex items-center justify-between">
        <div>
            <a href="@navBp" data-action="smart-back" class="hover:text-base-content/70">&larr; Dashboard</a>
            <span class="mx-1">/</span>
            <span class="text-base-content/60">Endpoint Detail</span>
        </div>
        <a href="@navBp?tab=endpoints" class="hover:text-base-content/70">All endpoints &rarr;</a>
    </div>
}
<div class="p-4 max-w-5xl mx-auto" data-endpoint-detail>
    @if (!Model.Found)
    {
        <div class="text-xs text-base-content/40 text-center py-8">Endpoint detail not found</div>
    }
    else
    {
        @* Hero strip: method + path on the left, big bot rate % on the right. *@
        <div class="flex items-start justify-between gap-3 pb-3 border-b border-base-300/40">
            <div class="min-w-0">
                <div class="flex items-center gap-2">
                    <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-base-300/60 font-semibold">@Model.Method</span>
                    @if (!string.IsNullOrEmpty(Model.PolicyName))
                    {
                        <span class="badge badge-sm badge-ghost font-mono text-[10px]">@Model.PolicyName</span>
                    }
                    @if (Model.IsHoneypot)
                    {
                        <span class="badge badge-xs badge-error">honeypot</span>
                    }
                    @if (Model.IsPinned)
                    {
                        <span class="badge badge-xs badge-info gap-1"><i class="bx bx-pin"></i>pinned</span>
                    }
                </div>
                <div class="text-sm font-bold break-all mt-1" title="@Model.Path">@Model.Path</div>
            </div>
            <div class="text-right shrink-0">
                <div class="text-2xl font-bold @(Model.BotRate >= 0.5 ? "text-error" : Model.BotRate >= 0.25 ? "text-warning" : "text-success")">@((Model.BotRate * 100).ToString("F0"))%</div>
                <div class="text-[10px] text-base-content/40">bot rate</div>
            </div>
        </div>

        @* Bot vs Human split bar -- visual proportion of the two traffic classes. *@
        @if (Model.TotalCount > 0)
        {
            var humanPct = 100.0 * Model.HumanCount / Model.TotalCount;
            var botPct = 100.0 * Model.BotCount / Model.TotalCount;
            <div class="mt-3">
                <div class="flex h-1.5 rounded overflow-hidden bg-base-300">
                    <div class="bg-success" style="width: @humanPct.ToString("F1")%"></div>
                    <div class="bg-error" style="width: @botPct.ToString("F1")%"></div>
                </div>
                <div class="flex items-center justify-between mt-1 text-[10px] text-base-content/50">
                    <span><span class="inline-block w-1.5 h-1.5 rounded-full bg-success mr-1"></span>@Model.HumanCount humans</span>
                    <span class="font-mono">@Model.TotalCount total · @Model.UniqueSignatures sigs</span>
                    <span>@Model.BotCount bots <span class="inline-block w-1.5 h-1.5 rounded-full bg-error ml-1"></span></span>
                </div>
            </div>
        }

        @* Response times -- min / avg / p95 / max in a single strip. The user explicitly
           asked for endpoint response-time stats; data already flows from
           DashboardEndpointDetail through to the view. *@
        <div class="mt-3 pt-3 border-t border-base-300/40">
            <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-2">Response times</div>
            <div class="grid grid-cols-4 gap-2 text-center">
                <div>
                    <div class="text-sm font-bold font-mono">@BotDisplayHelpers.FormatProcessingTime(Model.MinProcessingTimeMs)</div>
                    <div class="text-[9px] text-base-content/40 uppercase tracking-wide">Min</div>
                </div>
                <div>
                    <div class="text-sm font-bold font-mono">@BotDisplayHelpers.FormatProcessingTime(Model.AvgProcessingTimeMs)</div>
                    <div class="text-[9px] text-base-content/40 uppercase tracking-wide">Avg</div>
                </div>
                <div>
                    <div class="text-sm font-bold font-mono @(Model.P95ProcessingTimeMs >= 500 ? "text-warning" : "")">@BotDisplayHelpers.FormatProcessingTime(Model.P95ProcessingTimeMs)</div>
                    <div class="text-[9px] text-base-content/40 uppercase tracking-wide">P95</div>
                </div>
                <div>
                    <div class="text-sm font-bold font-mono @(Model.MaxProcessingTimeMs >= 1000 ? "text-error" : "")">@BotDisplayHelpers.FormatProcessingTime(Model.MaxProcessingTimeMs)</div>
                    <div class="text-[9px] text-base-content/40 uppercase tracking-wide">Max</div>
                </div>
            </div>
        </div>

        @* Behavioural profile radar -- bot vs human vs all on the same axes. Preserved
           from the previous panel; it's the single most information-dense element here. *@
        @if (HasRadar)
        {
            <div class="mt-3 pt-3 border-t border-base-300/40">
                <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-1">Behavioural Profile</div>
                <div id="@chartId" style="height: 200px;"></div>
                <div class="flex items-center justify-center gap-4 mt-1 text-[10px] text-base-content/50">
                    @if (Model.BotProfile != null) { <span><span class="inline-block w-2 h-2 rounded-full bg-error mr-1"></span>Bot (@Model.BotProfile.SampleCount)</span> }
                    @if (Model.HumanProfile != null) { <span><span class="inline-block w-2 h-2 rounded-full bg-success mr-1"></span>Human (@Model.HumanProfile.SampleCount)</span> }
                    @if (Model.OverallProfile != null) { <span><span class="inline-block w-2 h-2 rounded-full bg-info mr-1"></span>All</span> }
                </div>
            </div>
            <script nonce="@Model.CspNonce">
            setTimeout(function() {
                var el = document.getElementById('@chartId');
                if (!el || typeof ApexCharts === 'undefined') return;

                var botData     = @Html.Raw(ProfileJson(Model.BotProfile));
                var humanData   = @Html.Raw(ProfileJson(Model.HumanProfile));
                var overallData = @Html.Raw(ProfileJson(Model.OverallProfile));

                var series = [];
                function breakUniform(arr) {
                    if (!arr) return arr;
                    var allSame = arr.every(function(v) { return v === arr[0]; });
                    if (allSame) { var out = arr.slice(); out[0] = Math.min(100, out[0] + 0.1); return out; }
                    return arr;
                }
                if (botData)     series.push({ name: 'Bot',   data: breakUniform(botData) });
                if (humanData)   series.push({ name: 'Human', data: breakUniform(humanData) });
                if (overallData) series.push({ name: 'All',   data: breakUniform(overallData) });

                // 'sb-light' is not a theme value; _ThemeBoot toggles the 'dark'
                // class on <html> for every non-light theme. That's the canonical
                // check, so the chart paints visible colors against a white card.
                var isDark = document.documentElement.classList.contains('dark');
                var labelColor = isDark ? 'rgba(255,255,255,0.35)' : 'rgba(0,0,0,0.35)';

                new ApexCharts(el, {
                    chart: { type: 'radar', height: 200, toolbar: { show: false }, animations: { enabled: false }, background: 'transparent' },
                    series: series,
                    colors: ['#f87272', '#36d399', '#38bdf8'],
                    xaxis: { categories: ['Probability', 'Confidence', 'Threat', 'Block %', 'Error %', 'Latency'] },
                    yaxis: { show: false, min: 0, max: 100 },
                    fill: { opacity: 0.15 },
                    stroke: { width: 2 },
                    markers: { size: 3 },
                    legend: { show: false },
                    plotOptions: { radar: { polygons: { strokeColors: labelColor, connectorColors: labelColor, fill: { colors: ['transparent'] } } } },
                    dataLabels: { enabled: false },
                    theme: { mode: isDark ? 'dark' : 'light' }
                }).render();
            }, 50);
            </script>
        }

        @* Most regular visitors. The user explicitly asked for this -- which signatures
           hit this endpoint most. Click any row to drill into its signature detail. *@
        @if (Model.TopBots.Count > 0)
        {
            <div class="mt-3 pt-3 border-t border-base-300/40">
                <div class="flex items-center justify-between mb-1">
                    <div class="text-[10px] uppercase tracking-wider text-base-content/40">Most regular visitors</div>
                    <div class="text-[9px] text-base-content/30">click to drill in</div>
                </div>
                <table class="table table-xs w-full">
                    <thead>
                        <tr class="text-[10px] uppercase tracking-wider text-base-content/40">
                            <th class="py-1 w-5"></th>
                            <th class="py-1">Visitor</th>
                            <th class="py-1 text-right">Prob</th>
                            <th class="py-1 text-right">Hits</th>
                            <th class="py-1 text-right">Seen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var seenNames = new Dictionary<string, int>(StringComparer.Ordinal);
                        }
                        @foreach (var bot in Model.TopBots.Take(10))
                        {
                            var probPct = (bot.BotProbability * 100).ToString("F0");
                            var probClass = bot.RiskBand switch {
                                "VeryHigh" or "High" => "text-error",
                                "Medium" or "Elevated" => "text-warning",
                                _ => "text-success"
                            };
                            var visitorName = SignatureDisplayName.Resolve(bot.PrimarySignature, bot.BotName, bot.BotType, bot.CustomBotName, bot.CountryCode, isBot: true, uaFamily: bot.UaFamily, seen: seenNames, userAgent: bot.UserAgent);
                            <tr class="hover:bg-base-300/40">
                                <td class="py-1 w-5">
                                    @if (HasFlag(bot.CountryCode))
                                    {
                                        <img src="@FlagUrl(bot.CountryCode!)" alt="@bot.CountryCode" class="w-4 h-3 rounded-sm" loading="lazy" />
                                    }
                                </td>
                                <td class="py-1 truncate max-w-[180px]" title="@visitorName">
                                    <a href="@navBp/signature/@Uri.EscapeDataString(bot.PrimarySignature)"
                                       class="text-xs hover:underline">@visitorName</a>
                                </td>
                                <td class="py-1 text-right text-xs font-bold @probClass">@(probPct)%</td>
                                <td class="py-1 text-right text-xs font-mono">@bot.HitCount</td>
                                <td class="py-1 text-right text-[10px] text-base-content/40">@TimeAgo(bot.LastSeen)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* Country distribution + risk band distribution as side-by-side compact lists. *@
        @if (Model.TopCountries.Any() || Model.RiskBands.Any())
        {
            var totalForBars = Math.Max(1, Model.TotalCount);
            <div class="mt-3 pt-3 border-t border-base-300/40 grid grid-cols-2 gap-4">
                @if (Model.TopCountries.Any())
                {
                    <div>
                        <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-1">Countries</div>
                        @foreach (var kvp in Model.TopCountries.OrderByDescending(x => x.Value).Take(5))
                        {
                            var pct = 100.0 * kvp.Value / totalForBars;
                            <div class="flex items-center gap-2 py-0.5">
                                @if (HasFlag(kvp.Key))
                                {
                                    <img src="@FlagUrl(kvp.Key)" alt="@kvp.Key" class="w-4 h-3 rounded-sm shrink-0" loading="lazy" />
                                }
                                else
                                {
                                    <span class="w-4 h-3 text-[8px] text-base-content/30">--</span>
                                }
                                <span class="text-[10px] font-mono w-6">@kvp.Key</span>
                                <div class="flex-1 h-1 bg-base-300 rounded">
                                    <div class="h-full bg-info rounded" style="width: @pct.ToString("F1")%"></div>
                                </div>
                                <span class="text-[10px] font-mono text-base-content/50 w-10 text-right">@kvp.Value</span>
                            </div>
                        }
                    </div>
                }

                @if (Model.RiskBands.Any())
                {
                    <div>
                        <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-1">Risk Profile bands</div>
                        @foreach (var kvp in Model.RiskBands.OrderByDescending(x => x.Value).Take(5))
                        {
                            var pct = 100.0 * kvp.Value / totalForBars;
                            var rbColor = kvp.Key switch {
                                "VeryHigh" or "High" => "bg-error",
                                "Medium" or "Elevated" => "bg-warning",
                                "Low" => "bg-success",
                                _ => "bg-base-content/30"
                            };
                            <div class="flex items-center gap-2 py-0.5">
                                <span class="text-[10px] font-mono w-14 truncate">@kvp.Key</span>
                                <div class="flex-1 h-1 bg-base-300 rounded">
                                    <div class="h-full @rbColor rounded" style="width: @pct.ToString("F1")%"></div>
                                </div>
                                <span class="text-[10px] font-mono text-base-content/50 w-10 text-right">@kvp.Value</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* Recent detections timeline -- last N requests with status + verdict so the
           operator can scrub through actual traffic that hit this endpoint. *@
        @if (Model.RecentDetections.Count > 0)
        {
            <div class="mt-3 pt-3 border-t border-base-300/40">
                <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-1">Recent activity</div>
                <div class="max-h-48 overflow-y-auto">
                    <table class="table table-xs w-full">
                        <tbody>
                            @foreach (var det in Model.RecentDetections.Take(15))
                            {
                                var verdictColor = det.IsBot ? "text-error" : "text-success";
                                var statusColor = det.StatusCode switch {
                                    >= 500 => "text-error",
                                    >= 400 => "text-warning",
                                    >= 300 => "text-info",
                                    _ => "text-base-content/50"
                                };
                                <tr>
                                    <td class="py-0.5 text-[10px] text-base-content/40 font-mono w-12">@TimeAgo(det.Timestamp)</td>
                                    <td class="py-0.5 text-[10px] font-mono w-10 @verdictColor">@(det.IsBot ? "BOT" : "HUM")</td>
                                    <td class="py-0.5 text-[10px] font-mono w-10 @statusColor">@(det.StatusCode == 0 ? "--" : det.StatusCode.ToString())</td>
                                    <td class="py-0.5 text-[10px] font-mono">@((det.BotProbability * 100).ToString("F0"))%</td>
                                    <td class="py-0.5 text-[10px] text-base-content/50 text-right">@BotDisplayHelpers.FormatProcessingTime(det.ProcessingTimeMs)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Protection -- policy + monitoring-pack coverage + pin / honeypot controls. *@
        <div class="mt-3 pt-3 border-t border-base-300/40">
            <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-2">Protection</div>

            <div class="flex items-center gap-2 mb-3 text-xs">
                <span class="text-base-content/60">Policy</span>
                @if (!string.IsNullOrEmpty(Model.PolicyName))
                {
                    <span class="badge badge-sm badge-ghost font-mono">@Model.PolicyName</span>
                }
                else
                {
                    <span class="text-base-content/30">default</span>
                }
                <span class="text-base-content/40 ml-auto text-[10px]">Avg threat: @Model.AvgThreatScore.ToString("F1")</span>
            </div>

            @if (Model.PackCoverage.Count > 0)
            {
                <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-1">Reaction packs</div>
                <div class="space-y-1">
                    @foreach (var pack in Model.PackCoverage)
                    {
                        var levelBadge = pack.CurrentLevel == 0 ? "badge-ghost"
                            : pack.CurrentLevel >= 3 ? "badge-error"
                            : pack.CurrentLevel == 2 ? "badge-warning"
                            : "badge-info";
                        <div class="flex items-center justify-between py-1 text-xs">
                            <span class="font-mono text-base-content/70 truncate max-w-[140px]" title="@pack.PackName">@pack.PackName</span>
                            <div class="flex items-center gap-1 shrink-0">
                                <span class="badge badge-xs badge-ghost">@pack.Scope</span>
                                <span class="badge badge-xs @levelBadge">
                                    @if (pack.CurrentLevel == 0)
                                    {
                                        <text>inactive</text>
                                    }
                                    else
                                    {
                                        <text>L@(pack.CurrentLevel)</text>
                                        if (!string.IsNullOrEmpty(pack.CurrentPolicy))
                                        {
                                            <text>: @pack.CurrentPolicy</text>
                                        }
                                    }
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.IsPinned && Model.PinId.HasValue)
            {
                <div class="mt-3 flex items-center justify-between">
                    <div class="flex items-center gap-1 text-xs text-base-content/50">
                        <i class="bx bx-pin"></i>
                        <span>Pinned</span>
                        @if (Model.IsHoneypot)
                        {
                            <span class="badge badge-xs badge-error ml-1">honeypot</span>
                        }
                    </div>
                    @if (Model.IsCommercial)
                    {
                        <button class="btn btn-xs btn-ghost text-error/60 hover:text-error"
                                hx-delete="@(Model.BasePath)/api/endpoint-pins/@Model.PinId"
                                hx-confirm="Remove pin for @Model.Path?"
                                hx-target="closest [data-endpoint-detail]"
                                hx-swap="outerHTML">
                            <i class="bx bx-unlink text-sm"></i>Unpin
                        </button>
                    }
                </div>
            }
        </div>

        @* B8a: Effective policy stack for this endpoint scope. Domain falls
           back to the request host when the model doesn't carry one (the
           detail page only resolves the verb + path; the rule scope on
           the matcher side uses Host + PathTemplate). Wildcard fallback
           keeps the panel rendering even on hosts where Request.Host is
           empty (TestServer with no base address, etc.) so the section
           never disappears silently. *@
        {
            var policyHost = Context?.Request?.Host.Host ?? string.Empty;
            var pathTemplate = $"{Model.Method} {Model.Path}";
            PolicyScope endpointScope = string.IsNullOrEmpty(policyHost)
                ? PolicyScope.Wildcard()
                : PolicyScope.Endpoint(policyHost, policyHost, pathTemplate);
            <div class="mt-3 pt-3 border-t border-base-300/40 dashboard-endpoint-policy" data-endpoint="@pathTemplate">
                <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-2">Effective policy stack</div>
                @await Component.InvokeAsync("SbPolicyStack", new
                {
                    scope = endpointScope,
                    embed = PolicyStackEmbed.Full,
                    activeTab = "effective",
                    aggregateWindow = (TimeSpan?)TimeSpan.FromHours(24),
                    canEdit = false
                })
            </div>
        }
    }
</div>
