@using Mostlylucid.BotDetection.Identity
@using Mostlylucid.BotDetection.UI.Services
@using Mostlylucid.BotDetection.UI.Helpers
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Primitives
@model ProjectedVisitor
@{
    var basePath = ViewData["BasePath"]?.ToString() ?? "/_stylobot";
    var riskClass = Model.RiskBand switch {
        "VeryHigh" => "text-error",
        "High" => "text-error",
        "Medium" or "Elevated" => "text-warning",
        _ => "text-success"
    };
    // Resolver-owned single source: given ?? llm ?? induced. View renders
    // whatever the resolver picked; the slot-hint badges below indicate
    // which slot won and whether other slots disagree.
    var displayName = Model.BotName;
    // 2026-06-26 drift signifier: when the fingerprint's name changed within
    // the recent window (default 7d), show the previous name next to the
    // current one. Operator scans the visitor list and sees at a glance
    // which fingerprints have shifted presentation. Spec
    //   docs/superpowers/specs/2026-06-26-fingerprint-name-projection-restore.md
    var priorBotName = Model.PriorBotName;
    var showWasPill = !string.IsNullOrEmpty(priorBotName)
        && !string.Equals(priorBotName, displayName, StringComparison.Ordinal)
        && Model.BotNameUpdatedAt is { } updatedAt
        && (DateTime.UtcNow - updatedAt) < TimeSpan.FromDays(7);
    var probPct = (Model.BotProbability * 100).ToString("F0");
    var confPct = (Model.Confidence * 100).ToString("F0");
    var actionClass = ActionDisplayHelper.GetBadgeCssClass(Model.Action);
    var friendlyAction = ActionDisplayHelper.GetFriendlyName(Model.Action);
    var threatClass = Model.ThreatBand switch {
        "Critical" or "High" => "bg-error/20 text-error",
        "Medium" => "bg-warning/20 text-warning",
        _ => ""
    };
}
<a href="@basePath/signature/@Uri.EscapeDataString(Model.PrimarySignature)"
   class="card bg-base-200 hover:bg-base-300 transition-colors duration-200 cursor-pointer group"
   id="visitor-@Model.PrimarySignature.GetHashCode().ToString("x8")">
    <div class="card-body p-3 gap-1">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 min-w-0">
                @* Operator name slot. The .fp-name wrapper is the HTMX swap
                   target for the commercial inline editor (spec §7) -- pencil
                   GET replaces this whole span with _GivenNameInlineEditor,
                   Save POST swaps it back. The pencil button is server-rendered
                   unconditionally when a FingerprintId is present; the GET it
                   triggers is gated on license + demo mode at the endpoint, so
                   unlicensed hosts simply 402/403 and the pencil reverts the
                   row (no client-side license check needed). Hidden by default
                   via opacity-0; .group on the parent <a> reveals it on hover. *@
                @* data-fp-id marks the swap target for the HR2 SignalR
                   `fingerprint:dirty` beacon. The sb-live-updates coordinator
                   finds every matching .fp-name[data-fp-id="..."] on the page
                   and HTMX-swaps it from the commercial /given-name/read
                   fragment when a rename lands on this or a peer gateway. *@
                <span class="fp-name inline-flex items-center gap-2 min-w-0"
                      data-fp-id="@Model.FingerprintId">
                    <span class="text-sm font-bold truncate max-w-[180px]">@displayName</span>
                    @if (!string.IsNullOrEmpty(Model.FingerprintId))
                    {
                        <button type="button"
                                class="opacity-0 group-hover:opacity-100 transition text-base-content/40 hover:text-base-content"
                                hx-get="@($"/api/v1/commercial/fingerprints/{Uri.EscapeDataString(Model.FingerprintId)}/given-name/edit")"
                                hx-target="closest .fp-name"
                                hx-swap="outerHTML"
                                onclick="event.preventDefault();event.stopPropagation();"
                                aria-label="Edit name"
                                data-testid="given-name-edit">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-3 h-3">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                        </button>
                    }
                </span>
                @if (showWasPill)
                {
                    <span class="badge badge-xs badge-ghost italic text-base-content/50"
                          title="@($"Renamed from {priorBotName}. The fingerprint's observed signals have shifted; click through to the signature detail view for the per-snapshot diff.")">
                        was: @priorBotName
                    </span>
                }
                @* Operator-pinned indicator. Shown alongside whatever is currently displaying;
                   when the displayed slot IS Given the pin is implicit so we skip the badge. *@
                @if (!string.IsNullOrEmpty(Model.GivenName) && Model.DisplayedSlot != FingerprintNameKind.Given)
                {
                    <span class="badge badge-xs badge-ghost" title="Pinned: @Model.GivenName">📌</span>
                }
                @* Drift hint: the LLM picked a name, but the matcher's induced
                   slot has since diverged from it. Surface the divergence so an
                   operator can spot stale LLM characterisations at a glance. *@
                @if (Model.DisplayedSlot == FingerprintNameKind.Llm
                     && !string.IsNullOrEmpty(Model.InducedName)
                     && !string.Equals(Model.InducedName, Model.LlmName, StringComparison.Ordinal))
                {
                    <span class="badge badge-xs badge-ghost text-base-content/40 italic"
                          title="Signals now read: @Model.InducedName">drift</span>
                }
                @{
                    var (vBadge, vBadgeClass) = Model.BotProbability switch
                    {
                        >= 0.8 => ("Bot", "badge-error"),
                        >= 0.5 => ("Suspicious", "badge-warning"),
                        >= 0.3 => ("Uncertain", "badge-info"),
                        _ => ("Human", "badge-success")
                    };
                }
                <span class="badge badge-sm @vBadgeClass">@vBadge</span>
                @await Html.PartialAsync(
                    "~/Views/StyloBot/Dashboard/_Primitives/_GroupChip.cshtml",
                    new GroupChipModel(Model.GroupKey, Model.GroupMemberCount))
            </div>
            <span class="text-xs text-base-content/40">@Model.TimeAgo</span>
        </div>
        <div class="flex items-center gap-3 text-xs flex-wrap">
            <span>Hits: <strong>@Model.Hits</strong></span>
            <span class="font-bold @riskClass">@(probPct)%</span>
            <span class="@riskClass">@Model.RiskBand</span>
            @if (!string.IsNullOrEmpty(Model.Protocol))
            {
                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-base-300 text-base-content/60">@Model.Protocol</span>
            }
            @if (!string.IsNullOrEmpty(Model.Action) && Model.Action != "Allow")
            {
                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold @actionClass">@friendlyAction</span>
            }
            @if (!string.IsNullOrEmpty(Model.BotType))
            {
                <span class="text-base-content/50">@Model.BotType</span>
            }
            @if (!string.IsNullOrEmpty(Model.ThreatBand) && Model.ThreatBand != "None")
            {
                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold @threatClass">@Model.ThreatBand</span>
            }
        </div>
    </div>
</a>
