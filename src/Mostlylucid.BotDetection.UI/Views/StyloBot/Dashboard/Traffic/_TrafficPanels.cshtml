@using Mostlylucid.BotDetection.UI.Dashboard
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@using Mostlylucid.BotDetection.UI.Services.Dashboard
@using Microsoft.Extensions.Options
@using Mostlylucid.BotDetection.UI.Configuration
@using System.Text.Json
@model TrafficPageModel
@inject DashboardContributionRegistry Contributions
@inject IOptions<DashboardMaterializerOptions> MaterializerOptions
@*
    Side panels partial. Rendered three ways:
      1. Inlined by _Body.cshtml on the initial SSR pass (single render, no
         duplicate markup -- per feedback_centralised_change_detection).
      2. Returned standalone when sb-chartlet's Drill issues an HX-Request GET
         back to the controller with bot_type=<family>; the swap replaces the
         #traffic-panels container in place, leaving chart + counters intact.
      3. Returned as part of _Body.cshtml on the SignalR-driven full-page
         refresh (?partial=1).
    The wrapper id "traffic-panels" matches HitsPerPeriodChartletBuilder's
    ChartletDrill.PanelTarget; sb-chartlet.js targets it via hx-target on the
    bar click.

    C4 + C5: By-country and By-bot-type cards switched to sb-chartlet
    HorizontalBar variants (one bar per country / bot type). The bar click
    drills via the controller's country / bot_type filters -- same swap
    target as the headline stacked bar, so the side-panel set re-renders in
    place when the user picks a slice.
*@
@{
    var showMap = MaterializerOptions.Value.CountryWidgetStyle == "map";
    var showBySource = MaterializerOptions.Value.SourceBreakdownExcludeInternal;

    // For bar chart variants
    var countryChart = CountryChartletBuilder.Build(Model.Countries);
    var botTypeChart = BotTypeChartletBuilder.Build(Model.BotTypes);

    // For map and by-source variants
    var countriesJson = JsonSerializer.Serialize(
        Model.Countries.Select(c => new
        {
            code = c.CountryCode,
            totalCount = c.Hits,
            botRate = c.BotShare,
            label = c.CountryCode
        }));

    var sources = Model.BotTypes
        .Where(b => !string.Equals(b.BotType, "Internal", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(b => b.Hits)
        .ToList();
    var sourceTotal = sources.Sum(b => b.Hits);
    var internalHits = Model.BotTypes
        .Where(b => string.Equals(b.BotType, "Internal", StringComparison.OrdinalIgnoreCase))
        .Sum(b => b.Hits);

    // Absence-of-knowledge vs knowledge-of-absence: an empty list because the content
    // cache hasn't composed this envelope yet (cold read, materializer hasn't warmed it)
    // must render "warming", not "no data" -- the same fix already applied to shellWarming
    // widgets. _TopVisitorsCard/_ThreatsCard take a plain list as their model, so this
    // rides the parent's ViewData (Razor partials inherit it automatically, same mechanism
    // BasePath already uses below) rather than needing a wrapper type.
    ViewData["IsWarming"] = Model.IsWarming;
    ViewData["BasePath"] = Model.BasePath;
}
@*
    Beacon contract (sb-live-updates.js): this container is ONE widget to the
    content-ready refresh. It carries data-sb-widget + data-sb-depends (the surface
    kinds the four panels render: countries for the map, signature for by-source /
    top-visitors, threats for the threats card) + data-sb-params (the page's current
    filters, so a beacon refresh re-renders the SAME filtered view). SbWidgetBatchMiddleware
    renders "traffic-panels" from the warm page bundle through TrafficPanelsProjector —
    the identical projection used by the SSR first paint (_Traffic.cshtml) — and the OOB
    swap replaces this whole grid, so all four panels warm-replace together the moment the
    content-ready ping arrives. Before this, the four panels had no beacon contract at all:
    a cold-miss first paint showed "Warming up" and nothing ever replaced it.
*@
<div id="traffic-panels" class="sb-widget-grid"
     data-sb-widget="traffic-panels"
     data-sb-depends="countries,signature,threats"
     data-sb-params="window=@Uri.EscapeDataString(Model.Filters.Window)&country=@Uri.EscapeDataString(Model.Filters.Country ?? "")&bot_type=@Uri.EscapeDataString(Model.Filters.BotType ?? "")&threat=@Uri.EscapeDataString(Model.Filters.Threat ?? "")">
    @if (showMap)
    {
        <sb-widget width="third" height="tall" heading="Traffic by country">
            @if (Model.Countries.Count == 0 && Model.IsWarming)
            {
                <div class="h-full min-h-[96px] flex items-center justify-center"><span class="loading loading-spinner loading-sm text-base-content/40"></span></div>
            }
            else if (Model.Countries.Count == 0)
            {
                <div class="text-center text-base-content/30 py-12 text-sm">No location data in this window</div>
            }
            else
            {
                <div id="countries-map" data-countries="@countriesJson" style="width:100%;height:100%;min-height:17rem;"></div>
            }
        </sb-widget>
    }
    else
    {
        <sb-widget width="third" height="tall" heading="By country"
                   warming-when="@Model.IsWarming"
                   empty-when="@(Model.Countries.Count == 0)" empty-text="No data in this window">
            <vc:sb-chartlet model="countryChart" />
        </sb-widget>
    }

    @if (showBySource)
    {
        <sb-widget width="third" height="tall" heading="By source">
            @if (sources.Count == 0 && Model.IsWarming)
            {
                <div class="h-full min-h-[96px] flex items-center justify-center"><span class="loading loading-spinner loading-sm text-base-content/40"></span></div>
            }
            else if (sources.Count == 0)
            {
                <div class="text-center text-base-content/30 py-12 text-sm">No external traffic in this window</div>
            }
            else
            {
                <div class="space-y-2 pt-1">
                    @foreach (var bt in sources.Take(10))
                    {
                        var pct = sourceTotal > 0 ? bt.Hits * 100.0 / sourceTotal : 0;
                        <a href="@Model.BasePath/visitors?bot_type=@Uri.EscapeDataString(bt.BotType)"
                           class="block group no-underline" title="@bt.BotType — @bt.Hits.ToString("N0") hits">
                            <div class="flex items-baseline justify-between text-xs mb-1">
                                <span class="font-medium text-base-content/80 group-hover:text-base-content truncate">@bt.BotType</span>
                                <span class="tabular-nums text-base-content/70 shrink-0 ml-2">
                                    @bt.Hits.ToString("N0")<span class="text-base-content/35"> · @pct.ToString("F0")%</span>
                                </span>
                            </div>
                            <div class="h-2 rounded-full bg-base-300/60 overflow-hidden">
                                <div class="h-full rounded-full bg-base-content/40 group-hover:bg-base-content/60 transition-colors"
                                     style="width:@pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </a>
                    }
                </div>
                @if (internalHits > 0)
                {
                    <div class="mt-2 pt-2 border-t border-base-content/10 text-[11px] text-base-content/40">
                        + @internalHits.ToString("N0") internal hits (health probes / loopback), excluded
                    </div>
                }
            }
        </sb-widget>
    }
    else
    {
        <sb-widget width="third" height="tall" heading="By bot type"
                   warming-when="@Model.IsWarming"
                   empty-when="@(Model.BotTypes.Count == 0)" empty-text="No data in this window">
            <vc:sb-chartlet model="botTypeChart" />
        </sb-widget>
    }
    @* self-carding partials: wrap in a tier cell so the grid bounds their height.
       _TopEndpointsCard is GONE from here — the unified full-width endpoints
       control in _Body.cshtml absorbed it (feedback_never_two_sources_of_truth:
       the endpoint dataset now has ONE surface on this tab, not two). *@
    <div class="sb-w-third sb-h-tall">
        @await Html.PartialAsync("/Views/StyloBot/Dashboard/Traffic/_TopVisitorsCard.cshtml",  Model.TopVisitors)
    </div>
    <div class="sb-w-third sb-h-tall">
        @await Html.PartialAsync("/Views/StyloBot/Dashboard/Traffic/_ThreatsCard.cshtml",      Model.Threats)
    </div>

    @* pack widgets (ASP.NET Pack, OTel Mesh) — bounded to a tier so a long meter
       list scrolls in place instead of running down the whole page *@
    @foreach (var c in Contributions.For(DashboardContributionSlot.TrafficCard))
    {
        <div class="sb-w-third sb-h-tall">
            <div class="card bg-base-100 border border-base-300">
                <div class="card-body p-3">
                    <div class="text-xs text-base-content/40 mb-1">@c.ContributionName</div>
                    @await Component.InvokeAsync(c.ViewComponentName)
                </div>
            </div>
        </div>
    }

    @* Empty affordance slot for commercial pack-contribution widgets.
        Commercial code plugs pack features into this slot from the commercial side (DI).
        FOSS renders this slot host only; no feature logic lives here. *@
    <div id="pack-contribution-slot" class="sb-w-third sb-h-tall">
        @* Commercial pack widgets render here *@
    </div>
</div>
