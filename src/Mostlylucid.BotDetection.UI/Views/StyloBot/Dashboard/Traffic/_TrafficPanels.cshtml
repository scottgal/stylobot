@using Mostlylucid.BotDetection.UI.Dashboard
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@using Mostlylucid.BotDetection.UI.Services.Dashboard
@model TrafficPageModel
@inject DashboardContributionRegistry Contributions
@*
    Side panels partial. Rendered three ways:
      1. Inlined by _Body.cshtml on the initial SSR pass (single render, no
         duplicate markup -- per feedback_centralised_change_detection).
      2. Returned standalone when sb-chartlet's Drill issues an HX-Request GET
         back to the controller with bot_type=<family>; the swap replaces the
         #traffic-panels container in place, leaving chart + counters intact.
      3. Returned as part of _Body.cshtml on the SignalR-driven full-page
         refresh (?partial=1).
    The wrapper id "traffic-panels" matches HitsPerPeriodChartletBuilder's
    ChartletDrill.PanelTarget; sb-chartlet.js targets it via hx-target on the
    bar click.

    C4 + C5: By-country and By-bot-type cards switched to sb-chartlet
    HorizontalBar variants (one bar per country / bot type). The bar click
    drills via the controller's country / bot_type filters -- same swap
    target as the headline stacked bar, so the side-panel set re-renders in
    place when the user picks a slice.
*@
@{
    var countryChart = CountryChartletBuilder.Build(Model.Countries);
    var botTypeChart = BotTypeChartletBuilder.Build(Model.BotTypes);
}
<div id="traffic-panels" class="sb-widget-grid">
    <sb-widget width="third" height="tall" heading="By country"
               empty-when="@(Model.Countries.Count == 0)" empty-text="No data in this window">
        <vc:sb-chartlet model="countryChart" />
    </sb-widget>
    <sb-widget width="third" height="tall" heading="By bot type"
               empty-when="@(Model.BotTypes.Count == 0)" empty-text="No data in this window">
        <vc:sb-chartlet model="botTypeChart" />
    </sb-widget>
    @* self-carding partials: wrap in a tier cell so the grid bounds their height *@
    <div class="sb-w-third sb-h-tall">
        @await Html.PartialAsync("/Views/StyloBot/Dashboard/Traffic/_TopEndpointsCard.cshtml", Model.TopEndpoints)
    </div>
    <div class="sb-w-third sb-h-tall">
        @await Html.PartialAsync("/Views/StyloBot/Dashboard/Traffic/_TopVisitorsCard.cshtml",  Model.TopVisitors)
    </div>
    <div class="sb-w-third sb-h-tall">
        @await Html.PartialAsync("/Views/StyloBot/Dashboard/Traffic/_ThreatsCard.cshtml",      Model.Threats)
    </div>

    @* pack widgets (ASP.NET Pack, OTel Mesh) — bounded to a tier so a long meter
       list scrolls in place instead of running down the whole page *@
    @foreach (var c in Contributions.For(DashboardContributionSlot.TrafficCard))
    {
        <div class="sb-w-third sb-h-tall">
            <div class="card bg-base-100 border border-base-300">
                <div class="card-body p-3">
                    <div class="text-xs text-base-content/40 mb-1">@c.ContributionName</div>
                    @await Component.InvokeAsync(c.ViewComponentName)
                </div>
            </div>
        </div>
    }

    @* Empty affordance slot for commercial pack-contribution widgets.
        Commercial code plugs pack features into this slot from the commercial side (DI).
        FOSS renders this slot host only; no feature logic lives here. *@
    <div id="pack-contribution-slot" class="sb-w-third sb-h-tall">
        @* Commercial pack widgets render here *@
    </div>
</div>
