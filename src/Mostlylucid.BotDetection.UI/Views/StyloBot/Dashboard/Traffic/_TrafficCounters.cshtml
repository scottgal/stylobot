@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model TrafficCounters
@{
    // Muted, non-editorializing deltas: glyph + magnitude + "vs prior". The
    // operator reads the number themselves — coloring "humans dropped" red or
    // "bots up" amber implies a value judgement that depends on the customer's
    // posture (a shadow-mode operator wants bots up; an enforcing operator
    // wants them down). Stays neutral.
    string DeltaText(int delta, double pct)
    {
        if (delta == 0) return "no change vs prior";
        var sign = delta > 0 ? "↑" : "↓";
        // Magnitude > 999% reads as "new traffic" rather than a real ratio.
        var mag = Math.Abs(pct) >= 1000d
            ? "new"
            : $"{Math.Abs(pct):F0}%";
        return $"{sign} {mag} vs prior";
    }

    var humanShare = 1d - Model.BotShare;
}
@*
    Counter strip rendered above the chart. Four tiles: Total / Humans / Bots /
    Bot pressure. The Bot pressure tile shows the bot share of the current
    window (same data as the Bots tile expressed as a percentage) so the
    operator can answer "how much of what I'm looking at is bot traffic?" at
    a glance — that's the question that drives the "where did my traffic go"
    panic when StyloBot starts blocking.
*@
@*
    Headline number is DISTINCT FINGERPRINTS ("how many actors") — one human
    browsing generates many request rows, so counting rows massively overstates
    "humans". Requests ("how much traffic") are the secondary line. Both shown,
    analytics-package style.
*@
<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-3">
            <div class="text-xs text-base-content/50 uppercase tracking-wide">Visitors</div>
            <div class="text-2xl font-bold">@Model.TotalFingerprints.ToString("N0")</div>
            <div class="text-xs text-base-content/50">@Model.Total.ToString("N0") requests</div>
            <div class="text-xs text-base-content/40">@DeltaText(Model.TotalDelta, Model.TotalDeltaPct)</div>
        </div>
    </div>
    <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-3">
            <div class="text-xs text-success uppercase tracking-wide">Humans</div>
            <div class="text-2xl font-bold">@Model.HumanFingerprints.ToString("N0")</div>
            <div class="text-xs text-base-content/50">@Model.Humans.ToString("N0") requests &middot; @humanShare.ToString("P0")</div>
            <div class="text-xs text-base-content/40">@DeltaText(Model.HumansDelta, Model.HumansDeltaPct)</div>
        </div>
    </div>
    <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-3">
            <div class="text-xs text-error uppercase tracking-wide">Bots</div>
            <div class="text-2xl font-bold">@Model.BotFingerprints.ToString("N0")</div>
            <div class="text-xs text-base-content/50">@Model.Bots.ToString("N0") requests &middot; @Model.BotShare.ToString("P0")</div>
            <div class="text-xs text-base-content/40">@DeltaText(Model.BotsDelta, Model.BotsDeltaPct)</div>
        </div>
    </div>
    <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-3">
            <div class="text-xs text-base-content/50 uppercase tracking-wide">Bot pressure</div>
            <div class="text-2xl font-bold">@Model.BotShare.ToString("P0")</div>
            <div class="text-xs text-base-content/50">of requests this window</div>
        </div>
    </div>
</div>
