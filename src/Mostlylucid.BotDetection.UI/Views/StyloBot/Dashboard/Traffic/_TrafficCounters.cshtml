@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model TrafficCounters
@{
    var c = Model;
    // ONE unit: requests. The old strip mixed distinct-fingerprint counts with a
    // request share ("HUMAN 0 0% · 0"), which read as three numbers in two units.
    //
    // Endpoint/summary aggregates keep a BINARY split (bot vs not-bot); there is no
    // per-endpoint uncertain count, so the complement is labelled "Human / unknown"
    // and includes requests with no bot verdict. It is never "safe" and never a
    // confirmed human classification.
    var notBot = Math.Max(0, c.Total - c.Bots);
    var botSharePct = c.Total > 0 ? c.Bots * 100.0 / c.Total : 0d;
    var shareText = botSharePct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture) + "%";

    // Cold-stash counters never paint zeros: a warming page renders dashes and the
    // beacon fills them on the next swap. Same convention the panel cards use.
    var warming = ViewData["IsWarming"] as bool? == true;
    // Terminal state: the bounded first-paint wait gave up (data feed unavailable).
    var degraded = Mostlylucid.BotDetection.UI.Dashboard.DashboardWarmingSignal.IsDegraded(Context);
}
@*
    Compact request summary: three numbers, one unit, no period deltas.
    Layout and type are SELF-CONTAINED (sb-count-* rules in sb-components.css) rather
    than utility classes, so the shared component keeps its approved shape on hosts
    where the consumer's Tailwind/daisyUI bundle is absent or partial.
*@
<div class="sb-traffic-summary">
    @if (degraded)
    {
        <p class="sb-count-meta">Data feed unavailable — retrying on next tick</p>
    }
    else
    {
        <div class="sb-count-row">
            <div class="sb-count">
                <span class="sb-count-label">Requests</span>
                <span class="sb-count-value">@(warming ? "—" : c.Total.ToString("N0"))</span>
                <span class="sb-count-meta">in this range</span>
            </div>
            <div class="sb-count">
                <span class="sb-count-label">Bot</span>
                <span class="sb-count-value sb-audience-bot">@(warming ? "—" : c.Bots.ToString("N0"))</span>
                <span class="sb-count-meta">@(warming ? "" : shareText + " of requests")</span>
            </div>
            <div class="sb-count">
                <span class="sb-count-label">Human / unknown</span>
                <span class="sb-count-value sb-audience-notbot">@(warming ? "—" : notBot.ToString("N0"))</span>
                <span class="sb-count-meta">includes requests not identified as bots</span>
            </div>
        </div>
    }
</div>
