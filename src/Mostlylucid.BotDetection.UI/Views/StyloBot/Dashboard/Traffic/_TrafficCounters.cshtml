@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model TrafficPageModel
@{
    var c = Model.Counters;
    var humanShare = 1d - c.BotShare;

    // Top bots BY NAME, from the same visitor set (no new store / aggregator):
    // group the bot visitors by their resolved name, rank by hits. This is the
    // high-value info that used to sit below the fold in the panels.
    var topBots = Model.TopVisitors
        .Where(v => v.IsBot)
        .GroupBy(v => !string.IsNullOrWhiteSpace(v.BotName) ? v.BotName!
                    : (!string.IsNullOrWhiteSpace(v.BotType) ? v.BotType! : "Unknown bot"))
        .Select(g => new { Name = g.Key, Hits = g.Sum(v => v.Hits), Fps = g.Count() })
        .OrderByDescending(g => g.Hits)
        .Take(6)
        .ToList();

    string DeltaText(int delta, double pct)
    {
        if (delta == 0) return "no change vs prior";
        var sign = delta > 0 ? "↑" : "↓";
        var mag = Math.Abs(pct) >= 1000d ? "new" : $"{Math.Abs(pct):F0}%";
        return $"{sign} {mag} vs prior";
    }
}
@*
    Two purposeful blocks replacing the old four-tile strip (Visitors / Humans /
    Bots / Bot pressure). Headline numbers are DISTINCT FINGERPRINTS ("how many
    actors"); requests are the secondary line. Bot pressure is now the inline
    share bar, and the top bots (by name) are lifted above the fold.
*@
<div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
    @* Block 1 — visitor split: humans vs bots (all visitors = fingerprints) *@
    <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-3">
            <div class="flex items-baseline justify-between mb-2">
                <span class="text-xs text-base-content/50 uppercase tracking-wide">Visitors</span>
                <span class="text-sm font-semibold">
                    @c.TotalFingerprints.ToString("N0")
                    <span class="text-xs font-normal text-base-content/40">· @c.Total.ToString("N0") requests</span>
                </span>
            </div>
            @* bot-share bar (replaces the standalone Bot pressure tile) *@
            <div class="flex h-2 rounded overflow-hidden bg-base-300 mb-2" title="@c.BotShare.ToString("P0") bot pressure">
                <div class="bg-success" style="width:@((humanShare * 100).ToString("F1"))%"></div>
                <div class="bg-error" style="width:@((c.BotShare * 100).ToString("F1"))%"></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <div class="text-success text-[10px] uppercase tracking-wide">Humans</div>
                    <div class="text-2xl font-bold leading-tight">@c.HumanFingerprints.ToString("N0")</div>
                    <div class="text-[10px] text-base-content/50">@c.Humans.ToString("N0") requests · @humanShare.ToString("P0")</div>
                    <div class="text-[10px] text-base-content/40">@DeltaText(c.HumansDelta, c.HumansDeltaPct)</div>
                </div>
                <div>
                    <div class="text-error text-[10px] uppercase tracking-wide">Bots</div>
                    <div class="text-2xl font-bold leading-tight">@c.BotFingerprints.ToString("N0")</div>
                    <div class="text-[10px] text-base-content/50">@c.Bots.ToString("N0") requests · @c.BotShare.ToString("P0")</div>
                    <div class="text-[10px] text-base-content/40">@DeltaText(c.BotsDelta, c.BotsDeltaPct)</div>
                </div>
            </div>
        </div>
    </div>

    @* Block 2 — top bots by name (lifted above the fold) *@
    <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-3">
            <div class="text-xs text-base-content/50 uppercase tracking-wide mb-2">Top bots</div>
            @if (topBots.Count == 0)
            {
                <div class="text-sm text-base-content/40">No bots in this window.</div>
            }
            else
            {
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1">
                    @foreach (var b in topBots)
                    {
                        <li class="flex items-center justify-between text-sm gap-2 min-w-0">
                            <span class="truncate" title="@b.Name (@b.Fps.ToString("N0") fingerprints)">@b.Name</span>
                            <span class="text-base-content/60 tabular-nums shrink-0">@b.Hits.ToString("N0")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>