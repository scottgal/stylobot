@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model TrafficCounters
@{
    var c = Model;
    var humanShare = 1d - c.BotShare;

    string DeltaText(int delta, double pct)
    {
        if (delta == 0) return "0";
        var sign = delta > 0 ? "↑" : "↓";
        var mag = Math.Abs(pct) >= 1000d ? "new" : $"{Math.Abs(pct):F0}%";
        return $"{sign}{mag}";
    }
}
@*
    Compact visitors bar. Replaces the old full-height VISITORS card — the split
    is one line so the volume chart can sit in the prime top-left slot. Headline
    numbers are DISTINCT FINGERPRINTS ("how many actors"); requests are secondary.
    Counts come from TrafficCounters (the durable projection), the single source —
    NOT the dashboard summary strip, which drifted from these by a few requests.
*@
<div class="card bg-base-100 border border-base-300">
    <div class="card-body p-2.5 flex-row flex-wrap items-center gap-x-6 gap-y-2">
        <span class="flex items-baseline gap-1.5">
            <span class="text-[10px] uppercase tracking-wide text-base-content/50">Visitors</span>
            <span class="text-lg font-bold leading-none">@c.TotalFingerprints.ToString("N0")</span>
            <span class="text-[10px] text-base-content/40">· @c.Total.ToString("N0") req</span>
        </span>

        <span class="flex items-baseline gap-1.5" title="@c.Humans.ToString("N0") human requests">
            <span class="text-[10px] uppercase tracking-wide text-success">Human</span>
            <span class="text-lg font-bold text-success leading-none">@c.HumanFingerprints.ToString("N0")</span>
            <span class="text-[10px] text-base-content/40">@humanShare.ToString("P0") · @DeltaText(c.HumansDelta, c.HumansDeltaPct)</span>
        </span>

        <span class="flex items-baseline gap-1.5" title="@c.Bots.ToString("N0") bot requests">
            <span class="text-[10px] uppercase tracking-wide text-error">Bot</span>
            <span class="text-lg font-bold text-error leading-none">@c.BotFingerprints.ToString("N0")</span>
            <span class="text-[10px] text-base-content/40">@c.BotShare.ToString("P0") · @DeltaText(c.BotsDelta, c.BotsDeltaPct)</span>
        </span>

        @* Inline bot-pressure bar, takes the remaining width. *@
        <span class="flex items-center gap-2 flex-1 min-w-[140px]">
            <span class="flex h-2 flex-1 rounded overflow-hidden bg-base-300" title="@c.BotShare.ToString("P0") bot pressure">
                <span class="bg-success" style="width:@((humanShare * 100).ToString("F1"))%"></span>
                <span class="bg-error" style="width:@((c.BotShare * 100).ToString("F1"))%"></span>
            </span>
        </span>
    </div>
</div>