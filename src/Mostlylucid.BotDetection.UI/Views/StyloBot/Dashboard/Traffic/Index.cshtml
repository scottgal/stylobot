@using Microsoft.Extensions.Options
@using Mostlylucid.BotDetection.UI.Configuration
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model TrafficPageModel
@inject IOptions<StyloBotDashboardOptions> DashboardOpts
@{
    ViewData["Title"] = "Traffic";

    // CSP nonce + hub path mirror how Dashboard/Index.cshtml resolves them on
    // the legacy view; carrying the nonce + hubPath through here means the
    // Traffic page wires SignalR with the same contract (per
    // feedback_ssr_signalr_pattern -- first paint SSR, updates via the
    // invalidation beacon + HTMX OOB / outerHTML swap).
    var hubPath = DashboardOpts.Value.HubPath;
    string cspNonce;
    if (Context.Items.TryGetValue("CspNonce", out var nonceObj) && nonceObj is string existing && existing.Length > 0)
    {
        cspNonce = existing;
    }
    else
    {
        cspNonce = Convert.ToBase64String(System.Security.Cryptography.RandomNumberGenerator.GetBytes(16));
        Context.Items["CspNonce"] = cspNonce;
    }
}

@*
    T1 — Traffic landing page shell. The inner body (header, counters, chart,
    breakdown cards) lives in _Body.cshtml so the SSR pass and the
    SignalR-driven HTMX swap render the same DOM from one template (per
    feedback_centralised_change_detection). The wrapper here only owns the
    one-time SignalR plumbing.
*@
<section class="space-y-4">
    @await Html.PartialAsync("/Views/StyloBot/Dashboard/Traffic/_Body.cshtml", Model)
</section>

@* SbLiveUpdates emits sb-tooltip-portal.js + sb-live-updates.js. The latter
   binds the dashboard's SignalR hub and re-broadcasts invalidation beacons
   onto the DOM as `sb:signature-update` / `sb:summary-update` events that
   the `hx-trigger` on #sb-traffic-body listens for. show-status="false" keeps
   the connection chip out of the Traffic header (the dashboard navbar owns
   the chip). *@

@* SignalR client + invalidation -> DOM-event bridge. Same shape the legacy
   _SignatureDetail.cshtml uses, narrowed to fire HTMX events on the body
   instead of a hard window.location.reload(). *@
<script src="/_content/Mostlylucid.BotDetection.UI/vendor/js/signalr.min.js" nonce="@cspNonce"></script>
<script nonce="@cspNonce">
(function() {
    if (typeof signalR === 'undefined') return;
    var hubPath = '@Html.Raw(hubPath)';
    var conn = new signalR.HubConnectionBuilder()
        .withUrl(hubPath)
        .withAutomaticReconnect([0, 2000, 5000, 10000])
        .build();

    function fireRefresh(eventName) {
        // HTMX's hx-trigger="X from:body" listens for native CustomEvents on
        // document.body. The Traffic body container swaps itself via
        // outerHTML, so re-firing this event after the swap re-binds via
        // HTMX's standard re-init on the new subtree.
        try {
            document.body.dispatchEvent(new CustomEvent(eventName, { bubbles: true }));
        } catch (e) { console.debug('Traffic live-update dispatch failed:', e); }
    }

    conn.on('invalidated', function(keys) {
        if (!keys || !Array.isArray(keys)) return;
        for (var i = 0; i < keys.length; i++) {
            var k = keys[i];
            if (k === 'summary' || k === 'signature' || k === 'signatures') {
                fireRefresh('sb:summary-update');
                return;
            }
        }
        // Any other invalidation key (specific signature ids etc.) still
        // freshens the panel -- the page is window-scoped, not signature-scoped.
        fireRefresh('sb:signature-update');
    });

    conn.start().catch(function(err) {
        console.debug('SignalR connection failed for Traffic page:', err);
    });
})();
</script>
