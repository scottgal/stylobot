@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@using Mostlylucid.BotDetection.UI.Services.Dashboard
@model TrafficPageModel
@inject DashboardContributionRegistry Contributions
@{
    ViewData["Title"] = "Traffic";
    var basePath = ViewData["BasePath"]?.ToString() ?? "/dashboard";
}

@*
    T1 — Traffic landing page shell. The card layout is final; the chart fill is
    T2, the five breakdown cards are T3, the filter chips are T4. Pack-registered
    contributions fan out below the core cards via the TrafficCard slot.
*@
<section class="space-y-4">
    <header class="flex items-center justify-between">
        <h2 class="text-lg font-semibold">Traffic</h2>
        @* T4 adds window switcher + active filter chips here *@
    </header>

    @* Timeseries chart — stacked area (Human/Suspicious/Bot) off Model.Timeseries. *@
    <div class="card bg-base-100 border border-base-300">
        <div class="card-body p-3">
            <div class="text-sm text-base-content/60 mb-2">Hits per minute (last @Model.Filters.Window)</div>
            @await Html.PartialAsync("Traffic/_TimeseriesChart", Model.Timeseries)
        </div>
    </div>

    @* Breakdown cards — T3 fills the five core cards *@
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        @await Html.PartialAsync("Traffic/_ByCountryCard",    Model.Countries)
        @await Html.PartialAsync("Traffic/_ByBotTypeCard",    Model.BotTypes)
        @await Html.PartialAsync("Traffic/_TopEndpointsCard", Model.TopEndpoints)
        @await Html.PartialAsync("Traffic/_TopVisitorsCard",  Model.TopVisitors)
        @await Html.PartialAsync("Traffic/_ThreatsCard",      Model.Threats)

        @* Pack contribution slots — graceful absence when no packs registered. *@
        @foreach (var c in Contributions.For(DashboardContributionSlot.TrafficCard))
        {
            <div class="card bg-base-100 border border-base-300">
                <div class="card-body p-3">
                    <div class="text-xs text-base-content/40 mb-1">@c.ContributionName</div>
                    @await Component.InvokeAsync(c.ViewComponentName)
                </div>
            </div>
        }
    </div>
</section>
