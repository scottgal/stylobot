@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model TrafficPageModel
@{
    // Swap wrapper only: the composition lives in _TrafficLanding.cshtml so the
    // commercial host overlay can render the SAME landing markup and still add
    // its policy surface inside the swapped region, instead of forking the page.
    // The window is deliberately NOT baked into the refresh URL: the period
    // selector owns ?window= via its cookie, and a baked value would make the
    // swapped body ignore the operator's current selection.
    string RefreshUrl()
    {
        var qs = System.Web.HttpUtility.ParseQueryString(Context.Request.QueryString.Value ?? "");
        qs.Remove("window");
        qs["partial"] = "1";
        return Context.Request.Path + "?" + qs;
    }
}
<div id="sb-traffic-body"
     hx-get="@RefreshUrl()"
     hx-trigger="sb:signature-update from:body, sb:summary-update from:body"
     hx-target="this"
     hx-swap="outerHTML"
     class="space-y-3">
    @await Html.PartialAsync("~/Views/StyloBot/Dashboard/Traffic/_TrafficLanding.cshtml", Model)
</div>
