@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model IReadOnlyList<CountryRow>
@*
    T3 — By-country breakdown card. Each row is a hit-count + bot-share % link
    that re-filters the Traffic page by country (spec §8 drilldown).
*@
<div class="card bg-base-100 border border-base-300">
    <div class="card-body p-3">
        <div class="text-sm font-semibold mb-2">By country</div>
        @if (Model.Count == 0)
        {
            <div class="text-xs text-base-content/40 py-4 text-center">no data in this window</div>
        }
        else
        {
            <ul class="text-xs space-y-1">
                @foreach (var row in Model)
                {
                    var rawCode = row.CountryCode ?? "XX";
                    var code = rawCode.ToLowerInvariant();
                    var hasFlag = !string.IsNullOrEmpty(row.CountryCode)
                                  && rawCode.Length == 2
                                  && !rawCode.Equals("XX", StringComparison.OrdinalIgnoreCase);
                    <li>
                        <a href="/dashboard/traffic?country=@Uri.EscapeDataString(rawCode)"
                           class="flex items-center justify-between hover:bg-base-200 rounded px-1 py-0.5">
                            <span class="flex items-center gap-1.5 min-w-0">
                                @if (hasFlag)
                                {
                                    <img src="/_content/Mostlylucid.BotDetection.UI/flags/@(code).svg"
                                         alt="@row.CountryCode"
                                         class="h-3 w-4 flex-none object-cover rounded-sm"
                                         loading="lazy"
                                         onerror="this.style.display='none'" />
                                }
                                <span class="truncate">@row.CountryCode</span>
                            </span>
                            <span class="flex items-center gap-2 text-base-content/60">
                                <span>@row.Hits</span>
                                <span class="text-base-content/40">@(((int)(row.BotShare * 100)))% bot</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
