@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model IReadOnlyList<EndpointRow>
@{
    // Configurable mount point — never hardcode /dashboard.
    var basePath = ViewData["BasePath"]?.ToString() ?? "/dashboard";
}
@*
    T3 — Top-endpoints breakdown card. Row click drills into the per-endpoint
    detail view (spec §8). Method badge is badge-ghost across the board today
    — everything is GET per T1's controller note — but the slot is here so
    POST/PUT/DELETE can colour-code later without re-shaping the partial.

    U4: each row now carries an inline perf summary — p95 latency (ms) and a
    combined 4xx + 5xx error percentage — sourced from the same
    DashboardEndpointStats projection the load-shed baseline reads. Rows whose
    hit count is below DashboardLayoutOptions.TopEndpointsMinSamplesForPerf
    render a dash placeholder so brand-new paths / cold-start windows do not
    show misleading numbers. Error % colours follow the canonical risk-band
    semantics (>= 5% = high / risk-veryhigh, 1–5% = elevated / risk-elevated,
    < 1% = neutral) per project_dashboard_color_semantics.
*@
@{
    string ErrColour(double rate) =>
        rate >= 0.05 ? "var(--sb-color-risk-veryhigh)"
        : rate >= 0.01 ? "var(--sb-color-risk-elevated)"
        : "";
    // Si2 (endpoint-IA unification): {basePath}/endpoint/{method}/{path}, the same
    // chrome-wrapped detail route SbEndpointsList rows now link to. The old target
    // (a Site-scoped MVC endpoint-detail action) resolved to nothing under
    // RenderPage=true (the FOSS default): no matching sub-row was registered in
    // FossDashboardGroups, so DashboardRowRegistry.Resolve returned null and
    // Index.cshtml rendered "Unknown dashboard section." Segments are individually
    // escaped (never the "/" separators) matching StyloBotDashboardMiddleware's
    // manual route split.
    string EndpointHref(string method, string path)
    {
        var encodedPath = string.Join("/", path.Split('/').Select(seg => Uri.EscapeDataString(seg)));
        return $"{basePath}/endpoint/{Uri.EscapeDataString(method)}{encodedPath}";
    }
}
<div class="card bg-base-100 border border-base-300">
    <div class="card-body p-3">
        <div class="text-sm font-semibold mb-2">Top endpoints</div>
        @if (Model.Count == 0)
        {
            <div class="text-xs text-base-content/40 py-4 text-center">no data in this window</div>
        }
        else
        {
            <ul class="text-xs space-y-1">
                @foreach (var row in Model)
                {
                    var p95Display = row.HasPerf && row.P95Ms > 0
                        ? $"{Math.Round(row.P95Ms)}ms"
                        : "—";
                    var errDisplay = row.HasPerf
                        ? $"{Math.Round(row.ErrorRate * 100)}%"
                        : "—";
                    var errStyle = row.HasPerf ? ErrColour(row.ErrorRate) : "";
                    <li>
                        <a href="@EndpointHref(row.Method, row.Path)"
                           class="flex items-center gap-2 hover:bg-base-200 rounded px-1 py-0.5">
                            <span class="badge badge-ghost badge-xs flex-none">@row.Method</span>
                            <span class="truncate flex-1 min-w-0 font-mono text-[11px]" title="@row.Path">@row.Path</span>
                            <span class="text-base-content/60 tabular-nums w-10 text-right" title="hits">@row.Hits</span>
                            <span class="tabular-nums w-12 text-right text-base-content/70"
                                  title="95th-percentile processing time">@p95Display</span>
                            <span class="tabular-nums w-10 text-right"
                                  style="@(string.IsNullOrEmpty(errStyle) ? "" : $"color: {errStyle};")"
                                  title="4xx + 5xx error rate">@errDisplay</span>
                            <span class="text-base-content/40 tabular-nums w-10 text-right"
                                  title="bot share">@(((int)(row.BotShare * 100)))%</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
