@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model IReadOnlyList<EndpointRow>
@*
    T3 — Top-endpoints breakdown card. Row click drills into the per-endpoint
    detail view (spec §8). Method badge is badge-ghost across the board today
    — everything is GET per T1's controller note — but the slot is here so
    POST/PUT/DELETE can colour-code later without re-shaping the partial.
*@
<div class="card bg-base-100 border border-base-300">
    <div class="card-body p-3">
        <div class="text-sm font-semibold mb-2">Top endpoints</div>
        @if (Model.Count == 0)
        {
            <div class="text-xs text-base-content/40 py-4 text-center">no data in this window</div>
        }
        else
        {
            <ul class="text-xs space-y-1">
                @foreach (var row in Model)
                {
                    <li>
                        <a href="/dashboard/site/endpoint?path=@Uri.EscapeDataString(row.Path)&method=@Uri.EscapeDataString(row.Method)"
                           class="flex items-center gap-2 hover:bg-base-200 rounded px-1 py-0.5">
                            <span class="badge badge-ghost badge-xs flex-none">@row.Method</span>
                            <span class="truncate flex-1 min-w-0 font-mono text-[11px]" title="@row.Path">@row.Path</span>
                            <span class="text-base-content/60 tabular-nums">@row.Hits</span>
                            <span class="text-base-content/40 tabular-nums w-10 text-right">@(((int)(row.BotShare * 100)))%</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
