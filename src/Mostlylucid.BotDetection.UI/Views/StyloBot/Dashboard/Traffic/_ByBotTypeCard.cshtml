@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model IReadOnlyList<BotTypeRow>
@*
    T3 — By-bot-type breakdown card. Row click filters Visitors by bot type
    (spec §8). Mini bar gives a rough relative-volume cue against the card's
    own top-row max so the relative ranking is obvious at a glance.
*@
@{
    var max = Model.Count > 0 ? Model.Max(r => r.Hits) : 1;
    if (max <= 0) max = 1;
}
<div class="card bg-base-100 border border-base-300">
    <div class="card-body p-3">
        <div class="text-sm font-semibold mb-2">By bot type</div>
        @if (Model.Count == 0)
        {
            <div class="text-xs text-base-content/40 py-4 text-center">no data in this window</div>
        }
        else
        {
            <ul class="text-xs space-y-1">
                @foreach (var row in Model)
                {
                    var pct = (int)Math.Round(row.Hits * 100.0 / max);
                    <li>
                        <a href="/dashboard/visitors?bot_type=@Uri.EscapeDataString(row.BotType)"
                           class="flex items-center gap-2 hover:bg-base-200 rounded px-1 py-0.5">
                            <span class="truncate flex-1 min-w-0">@row.BotType</span>
                            <span class="relative h-1.5 w-16 bg-base-300 rounded flex-none overflow-hidden">
                                <span class="absolute inset-y-0 left-0 bg-primary/60" style="width:@(pct)%"></span>
                            </span>
                            <span class="text-base-content/60 tabular-nums w-10 text-right">@row.Hits</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
