@using Mostlylucid.BotDetection.UI.Controllers
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@model Mostlylucid.BotDetection.UI.Models.DashboardShellModel
@{
    // The middleware registry supplies DashboardShellModel to row partials. Bridge
    // that shell model into the canonical Visitors landing view so middleware-owned
    // /dashboard/visitors renders the same counters, list, shapes, and map as the
    // MVC page instead of silently selecting the legacy list-only wrapper.
    var summary = Model.Summary.Summary;
    var counters = new TrafficCounters(
        Total: summary.TotalRequests,
        Humans: summary.HumanRequests,
        Bots: summary.BotRequests,
        BotShare: summary.TotalRequests > 0 ? summary.BotRequests / (double)summary.TotalRequests : 0,
        TotalDelta: 0,
        HumansDelta: 0,
        BotsDelta: 0,
        TotalDeltaPct: 0,
        HumansDeltaPct: 0,
        BotsDeltaPct: 0,
        TotalFingerprints: summary.UniqueSignatures,
        HumanFingerprints: summary.HumanFingerprints,
        BotFingerprints: summary.BotFingerprints);
    var query = Context!.Request.Query;
    string? Nullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;
    var pageModel = new VisitorsPageModel(
        Filter: Nullable(query["filter"].FirstOrDefault()) ?? "all",
        Country: Nullable(query["country"].FirstOrDefault()),
        BotType: Nullable(query["bot_type"].FirstOrDefault()),
        Threat: Nullable(query["threat"].FirstOrDefault()),
        FingerprintId: Nullable(query["fingerprint"].FirstOrDefault()),
        Internal: query["internal"].FirstOrDefault() == "true",
        BasePath: Model.BasePath,
        Counters: counters,
        Countries: Model.Countries.Countries);
}
@await Html.PartialAsync("/Views/StyloBot/Dashboard/Visitors/Index.cshtml", pageModel)
