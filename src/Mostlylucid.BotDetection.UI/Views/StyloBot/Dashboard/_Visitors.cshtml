@using Mostlylucid.BotDetection.UI.Controllers
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@using Mostlylucid.BotDetection.UI.Services
@model Mostlylucid.BotDetection.UI.Models.DashboardShellModel
@inject IDashboardEventStore EventStore
@{
    // The middleware registry supplies DashboardShellModel to row partials. Bridge
    // that shell model into the canonical Visitors landing view so middleware-owned
    // /dashboard/visitors renders the same counters, list, shapes, and map as the
    // MVC page instead of silently selecting the legacy list-only wrapper.
    var query = Context!.Request.Query;
    string? Nullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;
    var country = Nullable(query["country"].FirstOrDefault());
    var botType = Nullable(query["bot_type"].FirstOrDefault());
    var threat = Nullable(query["threat"].FirstOrDefault());

    // The summary row's PRIMARY numbers (_TrafficCounters renders TotalFingerprints/
    // HumanFingerprints/BotFingerprints as the big VISITORS/HUMAN/BOT figures --
    // Total/Humans/Bots only feed the secondary "req" line + tooltips) must come
    // from the authoritative visitor-segment aggregate (same source
    // VisitorsController.Index() uses, and the same one SbVisitorList's tab pills
    // use) -- Model.Summary.Summary is a DIFFERENT count (request volume, not
    // distinct visitors) and doesn't match, which is what "counts are still wrong"
    // meant even once this view started rendering and the tabs were already fixed.
    var now = DateTime.UtcNow;
    var start = now.AddHours(-24);
    var summary = Model.Summary.Summary;
    TrafficCounters counters;
    try
    {
        var segmentCounts = await EventStore.GetVisitorSegmentCountsAsync(
            start, now, country: country, botType: botType, threat: threat)
            ?? throw new InvalidOperationException("GetVisitorSegmentCountsAsync returned null");
        counters = new TrafficCounters(
            Total: summary.TotalRequests,
            Humans: summary.HumanRequests,
            Bots: summary.BotRequests,
            BotShare: segmentCounts.All > 0 ? segmentCounts.Bots / (double)segmentCounts.All : 0,
            TotalDelta: 0, HumansDelta: 0, BotsDelta: 0,
            TotalDeltaPct: 0, HumansDeltaPct: 0, BotsDeltaPct: 0,
            TotalFingerprints: segmentCounts.All,
            HumanFingerprints: segmentCounts.Humans,
            BotFingerprints: segmentCounts.Bots);
    }
    catch
    {
        // Graceful degradation: fall back to the general summary for everything if
        // the authoritative segment aggregate is unavailable.
        counters = new TrafficCounters(
            Total: summary.TotalRequests,
            Humans: summary.HumanRequests,
            Bots: summary.BotRequests,
            BotShare: summary.TotalRequests > 0 ? summary.BotRequests / (double)summary.TotalRequests : 0,
            TotalDelta: 0, HumansDelta: 0, BotsDelta: 0,
            TotalDeltaPct: 0, HumansDeltaPct: 0, BotsDeltaPct: 0,
            TotalFingerprints: summary.UniqueSignatures,
            HumanFingerprints: summary.HumanFingerprints,
            BotFingerprints: summary.BotFingerprints);
    }

    var pageModel = new VisitorsPageModel(
        Filter: Nullable(query["filter"].FirstOrDefault()) ?? "all",
        Country: country,
        BotType: botType,
        Threat: threat,
        FingerprintId: Nullable(query["fingerprint"].FirstOrDefault()),
        Internal: query["internal"].FirstOrDefault() == "true",
        BasePath: Model.BasePath,
        Counters: counters,
        Countries: Model.Countries.Countries);
}
@await Html.PartialAsync("/Views/StyloBot/Dashboard/Visitors/Index.cshtml", pageModel)
