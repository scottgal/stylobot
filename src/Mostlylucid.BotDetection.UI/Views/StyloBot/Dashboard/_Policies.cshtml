@using Microsoft.Extensions.DependencyInjection
@using Mostlylucid.BotDetection.Policies.Rules
@using Mostlylucid.BotDetection.Policies.Templates
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@model Mostlylucid.BotDetection.UI.Models.DashboardShellModel
@*
    /dashboard/policies surface. Decode the scope from the URL (?scope=)
    so deep-links round-trip; default to Wildcard for the bare URL.

    The filter / sort tokens ride the same query string the SbPolicyStack
    rows-url builds, so a refresh of /dashboard/policies?scope=...&policystack-filter=...
    re-renders with the same view the user left.

    T4 Part B: above the SbPolicyStack we render a template-grouped view
    of the same effective rules so an operator sees rules under the
    template that emitted them. Hand-authored rules collect into a
    trailing "Manually authored" group. SbPolicyStack stays below as the
    detailed editor surface so the change is purely additive.
*@
@{
    var scopeParam = Context.Request.Query["scope"].ToString();
    var scope = PolicyScopeUrl.Decode(scopeParam);
    var filter = Context.Request.Query["policystack-filter"].ToString();
    var sortKey = Context.Request.Query["policystack-sort"].ToString();
    var sortDir = Context.Request.Query["policystack-dir"].ToString();

    // Pull the same presenter + registry the SbPolicyStack uses so the
    // grouped view shows the same rule set the editor surface does. The
    // registry is optional in DI; when absent the group headers fall
    // back to the bare template id.
    var presenter = Context.RequestServices.GetService<PolicyStackPresenter>();
    var registry = Context.RequestServices.GetService<TemplateRegistry>();

    IReadOnlyList<PolicyStackTemplateGroupViewModel> templateGroups =
        Array.Empty<PolicyStackTemplateGroupViewModel>();
    if (presenter is not null)
    {
        var vm = await presenter.BuildAsync(
            scope: scope,
            embed: PolicyStackEmbed.EffectiveOnly,
            activeTab: "effective",
            aggregateWindow: TimeSpan.FromHours(24),
            canEdit: false,
            filter: string.IsNullOrWhiteSpace(filter) ? null : PolicyStackFilter.Parse(filter),
            sort: PolicyStackSort.Parse(
                string.IsNullOrWhiteSpace(sortKey) ? null : sortKey,
                string.IsNullOrWhiteSpace(sortDir) ? null : sortDir),
            ct: Context.RequestAborted);
        templateGroups = PolicyTemplateGrouping.Group(vm.Rows, registry);
    }
}
<section class="dashboard-policies">
    @* Config-baseline layer -- the BotTypeActionPolicies + DefaultActionPolicyName enforcement
       that this page never showed, so a config-default throttle stops being invisible. Rendered
       above the rule stack (the always-enforced base layer). canEdit is left unset so the
       registered IPolicyCanEditPolicy decides: FOSS read-only, commercial editable.
       IConfigBaselineProvider is registered in BOTH modes -- the local composer on a detection host,
       the remote reader (reads the gateway's baseline) on a thin-client dashboard. It is absent only
       on an API-only host with no baseline to serve, where the section correctly skips rather than
       rendering a fabricated empty one (same optional-DI pattern as the pack contribution slots). *@
    @if (Context?.RequestServices?.GetService(typeof(Mostlylucid.BotDetection.UI.Services.IConfigBaselineProvider)) is not null)
    {
        @await Component.InvokeAsync("SbConfigBaseline")
    }
    @if (templateGroups.Count > 0)
    {
        <div class="sb-policy-stack-template-groups" data-policy-stack-template-groups>
            @foreach (var group in templateGroups)
            {
                @await Html.PartialAsync("Components/SbPolicyStack/_TemplateGroup", group)
            }
        </div>
    }
    @* F3 -- The T4 template-grouped block above already renders every
       effective rule (materialized templates first, then the "Manually
       authored" tail). SbPolicyStack stays on the page for its filter bar
       / aggregate strip / explainer surface and its SignalR row swap
       envelope -- but rendering its own Effective tab here would print
       the same rules a second time, which is the bug staging surfaced.
       hideRuleList = true suppresses just the rule list; the rest of
       the component still renders. The flag defaults to false everywhere
       else so the other 9 SbPolicyStack call sites are unchanged. *@
    @* canEdit is left unset so the registered IPolicyCanEditPolicy decides
       against the current ClaimsPrincipal. FOSS default is read-only; the
       commercial overlay flips it on for paid + dashboard-write users. *@
    @await Component.InvokeAsync("SbPolicyStack", new
    {
        scope = scope,
        embed = PolicyStackEmbed.Full,
        activeTab = "effective",
        aggregateWindow = (TimeSpan?)TimeSpan.FromHours(24),
        filterExpression = string.IsNullOrWhiteSpace(filter) ? null : filter,
        sortKey = string.IsNullOrWhiteSpace(sortKey) ? null : sortKey,
        sortDir = string.IsNullOrWhiteSpace(sortDir) ? null : sortDir,
        hideRuleList = templateGroups.Count > 0
    })
</section>
