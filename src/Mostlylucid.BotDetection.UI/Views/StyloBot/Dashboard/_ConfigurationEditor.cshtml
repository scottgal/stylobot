@using Mostlylucid.BotDetection.UI.Models
@model ConfigurationEditorModel
@{
    var bp = Model.BasePath;
}

@* Commercial config editor: load from control plane via HTMX when available. Untouched
   on purpose - this is a separate code path that delegates the whole editor surface
   to a remote control plane. The FOSS view-only surface below replaces the dead
   Monaco-from-CDN editor that used to live here. *@
@if (!string.IsNullOrEmpty(Model.ControlPlaneUrl) && Model.IsCommercialLicensed)
{
    <div class="flex items-center gap-1 mb-1">
        <h3 class="text-sm font-bold text-base-content">Configuration</h3>
        @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_HelpIcon.cshtml", "configuration")
    </div>
    <div id="commercial-config-editor"
         data-sb-widget="configuration"
         hx-get="@(Model.ControlPlaneUrl)/config-editor/overview"
         hx-trigger="load"
         hx-swap="innerHTML"
         class="min-h-[400px]">
        <div class="flex items-center justify-center py-12 text-base-content/40">
            <span class="loading loading-spinner loading-md mr-2"></span>
            Loading config editor from control plane...
        </div>
    </div>
    return;
}

@* FOSS: read-only, server-rendered, server-highlighted. Left rail lists effective-
   config sections and detectors. Right panel shows YAML or JSON for the active
   item, fetched as an HTMX fragment. Zero CDN dependencies; works under the
   strict dashboard CSP (script-src 'self'). *@
<div id="config-viewer"
     data-sb-widget="configuration"
     class="grid grid-cols-12 gap-4">

    <div class="col-span-12 flex items-center justify-between mb-1">
        <div class="flex items-center gap-1">
            <h3 class="text-sm font-bold text-base-content">Configuration</h3>
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_HelpIcon.cshtml", "configuration")
            <span class="text-[10px] text-base-content/50 ml-2">read-only · live values</span>
        </div>
        <a href="@bp/api/config/effective?download=1"
           download="stylobot-effective-config.json"
           class="text-[11px] px-2 py-1 rounded font-semibold inline-flex items-center gap-1"
           style="background: var(--sb-accent); color: #ffffff;"
           title="Download the full effective BotDetectionOptions as JSON. Secrets are masked.">
            <i class="bx bx-download"></i> Download full config
        </a>
    </div>

    <!-- LEFT: section + detector list -->
    <aside class="col-span-12 md:col-span-3 rounded-xl border overflow-hidden"
           style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">

        <div class="px-3 py-1.5 border-b flex items-center justify-between" style="border-color: var(--sb-card-divider);">
            <span class="text-[10px] font-semibold text-base-content/70 uppercase tracking-wide">Effective config</span>
            <span class="text-[9px] text-base-content/40">@Model.Sections.Count</span>
        </div>
        <ul id="config-section-list" class="max-h-[280px] overflow-y-auto text-sm divide-y" style="border-color: var(--sb-card-divider);">
            @foreach (var sec in Model.Sections)
            {
                <li>
                    <button type="button"
                            class="sb-config-item w-full text-left px-3 py-2 hover:bg-base-200/50 cursor-pointer"
                            data-config-kind="section"
                            data-config-id="@sec.Id"
                            data-config-label="@sec.DisplayName"
                            hx-get="@bp/api/config/section/@(Uri.EscapeDataString(sec.Id))?format=html"
                            hx-target="#config-body"
                            hx-swap="innerHTML"
                            hx-trigger="click"
                            title="@sec.TypeName">
                        <span class="text-sm">@sec.DisplayName</span>
                    </button>
                </li>
            }
        </ul>

        <div class="px-3 py-1.5 border-y flex items-center justify-between" style="border-color: var(--sb-card-divider);">
            <span class="text-[10px] font-semibold text-base-content/70 uppercase tracking-wide">Detectors</span>
            <span class="text-[9px] text-base-content/40">@Model.Detectors.Count</span>
        </div>
        <ul id="config-detector-list" class="max-h-[440px] overflow-y-auto text-sm divide-y" style="border-color: var(--sb-card-divider);">
            @foreach (var det in Model.Detectors)
            {
                <li>
                    <button type="button"
                            class="sb-config-item w-full text-left px-3 py-2 hover:bg-base-200/50 cursor-pointer flex items-center justify-between gap-2"
                            data-config-kind="detector"
                            data-config-id="@det.Slug"
                            data-config-label="@det.Slug"
                            hx-get="@bp/api/config/manifests/@(Uri.EscapeDataString(det.Slug))?format=html&view=yaml"
                            hx-target="#config-body"
                            hx-swap="innerHTML"
                            hx-trigger="click"
                            title="@det.Description">
                        <span class="truncate">
                            <span class="font-mono text-xs text-base-content/60">@det.Slug</span>
                        </span>
                        @if (det.HasOverride)
                        {
                            <span class="text-[9px] px-1 py-0.5 rounded font-medium"
                                  style="background: var(--sb-signal-warn); color: #1a0e00;"
                                  title="Override file present in stylobot-config/detectors/">
                                OVERRIDE
                            </span>
                        }
                    </button>
                </li>
            }
        </ul>
    </aside>

    <!-- CENTRE: viewer pane -->
    <section class="col-span-12 md:col-span-9 rounded-xl border overflow-hidden flex flex-col"
             style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">

        <!-- toolbar -->
        <div class="flex items-center justify-between gap-2 px-3 py-1.5 border-b" style="border-color: var(--sb-card-divider);">
            <div class="flex items-center gap-2">
                <span class="text-[10px] font-semibold text-base-content/70 uppercase tracking-wide">View</span>
                <div class="inline-flex rounded border overflow-hidden" style="border-color: var(--sb-card-divider);">
                    <button id="config-view-yaml" type="button" disabled
                            class="sb-config-view px-2 py-0.5 text-[11px] font-semibold disabled:opacity-40"
                            data-view="yaml">YAML</button>
                    <button id="config-view-json" type="button" disabled
                            class="sb-config-view px-2 py-0.5 text-[11px] font-semibold border-l disabled:opacity-40"
                            style="border-color: var(--sb-card-divider);"
                            data-view="json">JSON</button>
                </div>
            </div>
        </div>

        <!-- body: highlighted fragment lands here -->
        <div id="config-body" class="flex-1 min-h-[640px] overflow-auto">
            <div class="flex items-center justify-center h-full text-sm text-base-content/40 select-none px-4 text-center">
                Pick a section or detector on the left to view its effective configuration.
            </div>
        </div>
    </section>
</div>

<style nonce="@ViewBag.CspNonce">
    /* Token palette for the server-side syntax highlighter. Keyed off the existing
       --sb-* palette so dark and light themes match the rest of the dashboard
       without us having to re-pick colours. */
    .sb-config-fragment { padding: 0.5rem 0.75rem 1rem; }
    .sb-config-path {
        font: 600 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--sb-brand-muted, #888);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.25rem 0 0.5rem;
    }
    .sb-config-pre {
        margin: 0;
        padding: 0.75rem 1rem;
        background: var(--sb-bg-elevated, #0d0d0d);
        border: 1px solid var(--sb-card-divider, #2a2a2a);
        border-radius: 0.5rem;
        overflow-x: auto;
        font: 12px/1.55 ui-monospace, SFMono-Regular, Menlo, "Cascadia Code", monospace;
        color: var(--sb-text, #d8d8d8);
    }
    .sb-config-code { color: inherit; background: transparent; }
    .tok-key      { color: var(--sb-accent, #66c2ff); }
    .tok-str      { color: var(--sb-signal-positive, #9ee493); }
    .tok-num      { color: var(--sb-signal-warn, #f5c178); }
    .tok-bool     { color: #c792ea; font-weight: 600; }
    .tok-punct    { color: var(--sb-brand-muted, #888); }
    .tok-comment  { color: var(--sb-text-muted, #6a6a6a); font-style: italic; }

    .sb-config-item.is-active {
        background: var(--sb-card-divider, rgba(255,255,255,0.06));
    }
    .sb-config-view.is-active {
        background: var(--sb-accent, #66c2ff);
        color: #0a0a0a;
    }
</style>

<script nonce="@ViewBag.CspNonce">
(function() {
    // ---- state ----
    const bp = @Json.Serialize(bp);
    let activeKind = null;   // "section" | "detector"
    let activeId = null;
    let activeView = "yaml"; // "yaml" | "json"

    const yamlBtn = document.getElementById('config-view-yaml');
    const jsonBtn = document.getElementById('config-view-json');
    const body    = document.getElementById('config-body');

    function highlightActiveItem() {
        document.querySelectorAll('.sb-config-item').forEach(b => {
            b.classList.toggle('is-active',
                b.dataset.configKind === activeKind && b.dataset.configId === activeId);
        });
    }

    function syncViewToolbar() {
        // YAML/JSON toolbar reflects the rules:
        //   - sections: JSON only (YAML disabled - sections aren't manifests).
        //   - detectors: both, default YAML.
        if (activeKind === "detector") {
            yamlBtn.disabled = false;
            jsonBtn.disabled = false;
        } else if (activeKind === "section") {
            yamlBtn.disabled = true;
            jsonBtn.disabled = false;
            activeView = "json";
        } else {
            yamlBtn.disabled = true;
            jsonBtn.disabled = true;
        }
        yamlBtn.classList.toggle('is-active', activeView === 'yaml' && !yamlBtn.disabled);
        jsonBtn.classList.toggle('is-active', activeView === 'json' && !jsonBtn.disabled);
    }

    function fragmentUrl(kind, id, view) {
        if (kind === "section") {
            return `${bp}/api/config/section/${encodeURIComponent(id)}?format=html`;
        }
        return `${bp}/api/config/manifests/${encodeURIComponent(id)}?format=html&view=${encodeURIComponent(view)}`;
    }

    // Capture clicks on list items so we can track which one is active and which
    // view toggle to enable. HTMX still handles the fetch + swap.
    document.addEventListener('click', (e) => {
        const item = e.target.closest('.sb-config-item');
        if (item) {
            activeKind = item.dataset.configKind;
            activeId   = item.dataset.configId;
            if (activeKind === "section") activeView = "json";
            else if (activeView !== "yaml" && activeView !== "json") activeView = "yaml";
            highlightActiveItem();
            syncViewToolbar();
            return;
        }
        const viewBtn = e.target.closest('.sb-config-view');
        if (viewBtn && !viewBtn.disabled && activeKind) {
            const v = viewBtn.dataset.view;
            if (v === activeView) return;
            activeView = v;
            syncViewToolbar();
            // Issue the swap ourselves since the URL is computed from current state,
            // not a static hx-get on the toggle buttons.
            window.htmx?.ajax('GET', fragmentUrl(activeKind, activeId, activeView), {
                target: '#config-body',
                swap: 'innerHTML'
            });
        }
    });

    syncViewToolbar();
})();
</script>
