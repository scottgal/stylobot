@using Mostlylucid.BotDetection.Policies.Rules
@using Mostlylucid.BotDetection.Policies.Signals
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Helpers
@using Mostlylucid.BotDetection.UI.Services
@* ISignalCatalog: signal-key -> human label/description lookup. Without
   the inject, the Signal Intelligence panel rendered raw keys
   (fastpath.ip.score) as both visible text AND tooltip body, which was
   the user-visible "tooltips are still tokens" regression. The catalog
   is registered unconditionally by AddBotDetectionUI; resolve via
   GetService so the view fails open (no inject -> tooltips fall back to
   the raw key, same as today) instead of throwing on a host that
   somehow lost the registration. *@
@inject IServiceProvider _services
@inject IFingerprintNameActionSlot NameActionSlot
@inject ISignaturePolicyActionSlot PolicyActionSlot
@model SignatureDetailModel
@{
    // No Layout = null here. The host's _ViewStart picks the layout (the website's
    // _Layout for stylo.bot). The host is responsible for the chrome: navbar,
    // dashboard tab strip, footer, vendor CSS/JS, theme boot, CSP nonces. This view
    // emits content only. Previously this file set Layout = null and hand-wrapped
    // itself in <!DOCTYPE>...<html><head>...</head><body> + its own _StylobotNavbar
    // call -- three copies of the same chrome stacked (one from website _Layout,
    // one from here, plus the breadcrumb/title), and the host could never customise
    // it.
    // Single source of truth: the name written by FingerprintNameComposer.Compose
    // on the gateway, persisted to Fingerprint.DisplayName, broadcast as
    // DashboardDetectionEvent.BotName, propagated into Model.BotName by the cache.
    // Single source: matcher (FingerprintNameComposer) writes Fingerprint.DisplayName;
    // every reader projects it as Model.BotName. View renders it directly --
    // empty cell IS the visible signal of an upstream pipeline bug.
    var signatureDisplayName = Model.Found ? Model.BotName : null;
    ViewData["Title"] = signatureDisplayName ?? "Not Found";
    var bp = Model.BasePath;
    var navBp = Model.ResolvedNavBasePath;

    // The header is a triplet: NAME · UA · TRUST. Name is LLM-renameable / archetype-
    // driven and can be wrong; the UA chip is the raw claim (Chrome 119 / macOS,
    // Googlebot/2.1 / Linux); the trust badge is the verifiedbot.confirmed/spoofed
    // signal. Operator always reads the ground truth next to the inference.
    var uaPretty = "";
    if (!string.IsNullOrEmpty(Model.UaFamily))
    {
        uaPretty = Model.UaFamily!;
        if (!string.IsNullOrEmpty(Model.UaVersion)) uaPretty += " " + Model.UaVersion;
        if (!string.IsNullOrEmpty(Model.UaOs)) uaPretty += " / " + Model.UaOs;
    }

    var (trustText, trustClass, trustTooltip) = Model.UaTrustState switch
    {
        "verified"   => ("verified",   "bg-success/20 text-success border-success/30",
                         $"UA claim verified ({Model.UaTrustMethod ?? "rDNS"})"),
        "spoofed"    => ("UA spoofed", "bg-error/20 text-error border-error/40",
                         $"UA claims a known bot but verification failed ({Model.UaTrustMethod ?? "rDNS"})"),
        "unverified" => ("unverified", "bg-base-300/40 text-base-content/60 border-base-300",
                         $"Verification attempted but inconclusive ({Model.UaTrustMethod ?? "no method"})"),
        _            => ("",           "", "")
    };
    bool HasFlag(string? code) => !string.IsNullOrEmpty(code) && code.Length == 2 && code != "XX";
    string FlagUrl(string code) => $"/_content/Mostlylucid.BotDetection.UI/flags/{code.ToLowerInvariant()}.svg";

    string RiskColor(string? risk) => risk switch
    {
        "VeryHigh" => "text-error",
        "High" => "text-error",
        "Elevated" => "text-warning",
        "Medium" => "text-warning",
        _ => "text-success"
    };

    string ActionColor(string? action) => ActionDisplayHelper.GetCssClass(action);

    string ThreatColor(string? band) => band switch
    {
        "Critical" => "text-error",
        "High" => "text-error",
        "Elevated" => "text-warning",
        "Low" => "text-success",
        _ => "text-base-content/50"
    };

    string ThreatBgColor(string? band) => band switch
    {
        "Critical" => "bg-error/20 text-error border-error/30",
        "High" => "bg-error/15 text-error border-error/20",
        "Elevated" => "bg-warning/15 text-warning border-warning/20",
        "Low" => "bg-success/15 text-success border-success/20",
        _ => "bg-base-300 text-base-content/60 border-base-content/10"
    };

    var timeAgo = Model.LastSeen == default ? "unknown" : FormatTimeAgo(DateTime.UtcNow - Model.LastSeen);
    string FormatTimeAgo(TimeSpan span)
    {
        if (span.TotalSeconds < 5) return "now";
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s ago";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h {span.Minutes}m ago";
        return $"{(int)span.TotalDays}d ago";
    }
}
<div class="max-w-7xl mx-auto px-4 py-1.5 text-[10px] text-base-content/40">
    <a href="@navBp" class="hover:text-base-content/70">&larr; Dashboard</a>
    <span class="mx-1">/</span>
    <span class="text-base-content/60">Signature Detail</span>
</div>

@* This view now renders INSIDE Index.cshtml's own <main> (see
   DashboardShellModel.SignatureDetailContent) so real navigation comes from the
   shared drawer/sidebar shell every other dashboard page uses -- not a
   hand-rolled tab strip. The former strip here mirrored Index.cshtml's PRE-V2
   tabs (Overview/Activity/Visitors/Countries/Endpoints/Sessions/Threats/
   Investigate), which the V2 IA migration deleted from Index.cshtml itself
   (FossDashboardGroups.cs) without anyone removing this stale mirror, so it
   silently became the "old legacy shell" bug report. Plain <div>, not <main> --
   nesting <main> inside Index.cshtml's own <main> is invalid HTML. *@
<div class="max-w-7xl mx-auto px-4 py-4" data-testid="sb-signature-detail" data-signature-id="@Model.SignatureId">

@if (!Model.Found)
{
    <div class="rounded-xl border p-8 text-center" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
        <h2 class="text-lg font-bold text-base-content/70 mb-2">Signature Not Found</h2>
        <p class="text-sm text-base-content/50 mb-4">The signature <code class="text-xs bg-base-300 px-1 py-0.5 rounded">@Model.SignatureId</code> was not found in the cache.</p>
        <p class="text-xs text-base-content/40">It may have been evicted or the system may have restarted.</p>
        <a href="@navBp" class="btn btn-sm btn-ghost mt-4">&larr; Back to Dashboard</a>
    </div>
}
else
{
    @* Breadcrumb already rendered above the <main>, under the shared navbar.
       The inner one duplicated it ("Dashboard / Signature Detail" showed twice). *@

    <!-- Header -->
    @* `group` on the wrapper so the pencil's `opacity-0 group-hover:opacity-100`
       reveal works on the heading the same way it does on the visitor card.
       Without it the pencil would only appear once the operator hovered the
       pencil itself, defeating the affordance. *@
    <div class="flex items-center gap-3 mb-2 flex-wrap group">
        @if (HasFlag(Model.CountryCode))
        {
            <img src="@FlagUrl(Model.CountryCode!)" alt="@Model.CountryCode" class="w-6 h-4 object-cover rounded-sm" />
        }
        @* Operator-name slot. Same .fp-name wrapper + pencil pattern as
           _VisitorCard so the commercial inline editor (ED4 §7) swaps this
           span on Save and reverts on Cancel. FingerprintId is plumbed into
           the model from StyloBotDashboardMiddleware via
           IFingerprintReader.LookupFingerprintIdAsync; null when the
           signature is unbound or the reader is absent (remote-mode dashboard)
           so the heading degrades to the bare h1 without the affordance. *@
        @* data-fp-id is the swap target for the HR2 `fingerprint:dirty` SignalR
           beacon (see _VisitorCard for the equivalent annotation). *@
        <span class="fp-name inline-flex items-center gap-2"
              data-fp-id="@Model.FingerprintId">
            <h1 class="text-lg font-bold text-base-content" title="Signature: @Model.SignatureId">@signatureDisplayName</h1>
            @if (!string.IsNullOrEmpty(Model.FingerprintId))
            {
                <button type="button"
                        class="opacity-0 group-hover:opacity-100 transition text-base-content/40 hover:text-base-content"
                        hx-get="@($"/api/v1/commercial/fingerprints/{Uri.EscapeDataString(Model.FingerprintId)}/given-name/edit")"
                        hx-target="closest .fp-name"
                        hx-swap="outerHTML"
                        aria-label="Edit name"
                        data-testid="given-name-edit">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                </button>
            }
            @NameActionSlot.Render(Model.SignatureId, signatureDisplayName ?? Model.SignatureId, Model.BotType, Model.IsBot)
        </span>
        @* Operator "correct decision" control (commercial). Lazy-loads the correction
           editor fragment from the gateway; under FOSS the endpoint returns 402 and the
           swap leaves this empty span, so nothing renders. Same degrade-clean pattern as
           the effective-policy panel and the given-name editor above. *@
        @if (!string.IsNullOrEmpty(Model.FingerprintId))
        {
            <span class="fp-correction inline-flex items-center"
                  hx-get="@($"/api/v1/commercial/fingerprints/{Uri.EscapeDataString(Model.FingerprintId)}/correction/edit")"
                  hx-trigger="load"
                  hx-swap="outerHTML"></span>
        }
        @if (!string.IsNullOrEmpty(uaPretty))
        {
            <span class="text-base-content/40">·</span>
            <span class="text-sm font-medium text-base-content/80" title="@Model.UserAgent">@uaPretty</span>
        }
        @if (!string.IsNullOrEmpty(trustText))
        {
            <span class="text-[10px] px-1.5 py-0.5 rounded font-semibold border @trustClass" title="@trustTooltip">@trustText</span>
        }
        @* Gateway-projected drift badge (plan task 19). Renders only when
           Model.DriftBadge is non-null AND its IsDrifted flag is true; the
           partial returns early otherwise. Sits inside the header flex so
           SignalR-driven OOB swaps of this surface refresh the badge with
           the rest of the identity summary -- one beacon, one re-render. *@
        @if (Model.DriftBadge is { } headerBadge)
        {
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_Primitives/_DriftBadge.cshtml", headerBadge)
        }
        @{
            var (badgeText, badgeBg) = Model.BotProbability switch
            {
                >= 0.8 => ("Bot", "bg-error/20 text-error"),
                >= 0.5 => ("Suspicious", "bg-warning/20 text-warning"),
                >= 0.3 => ("Uncertain", "bg-info/20 text-info"),
                _ => ("Human", "bg-success/20 text-success")
            };
        }
        <span class="text-[10px] px-1.5 py-0.5 rounded font-semibold @badgeBg" sb-tooltip="header.bot_badge">@badgeText</span>
    </div>

    <!-- Intent & Threat (KEY info) -->
    <div class="flex items-center gap-3 mb-4 flex-wrap">
        @if (!string.IsNullOrEmpty(Model.BotType))
        {
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border @ThreatBgColor(Model.ThreatBand)" sb-tooltip="header.bot_type">
                <span class="text-xs font-bold">@Model.BotType</span>
                @if (!string.IsNullOrEmpty(Model.ThreatBand) && Model.ThreatBand != "None")
                {
                    <span class="text-[10px] opacity-70">@Model.ThreatBand threat</span>
                }
            </div>
        }
        @if (Model.ThreatScore.HasValue && Model.ThreatScore.Value > 0)
        {
            <div class="flex items-center gap-1.5 text-xs" sb-tooltip="header.threat_score">
                <span class="text-base-content/50">Threat Score:</span>
                <span class="font-bold @ThreatColor(Model.ThreatBand)">@($"{Model.ThreatScore.Value:F3}")</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Action))
        {
            <div class="flex items-center gap-1.5 text-xs" sb-tooltip="header.policy">
                <span class="text-base-content/50">Policy:</span>
                <span class="font-bold @ActionColor(Model.Action)">@ActionDisplayHelper.GetFriendlyName(Model.Action)</span>
            </div>
        }
        @* Commercial policy-action block (Allow/Block/Throttle/Transform). FOSS default
           (EmptySignaturePolicyActionSlot) renders nothing, so this is always safe to call --
           the commercial host's real implementation is what makes it visible. *@
        @PolicyActionSlot.Render(Model.SignatureId, Model.Action, Model.BotType, Model.IsBot)
    </div>

    @* Fingerprint Profile — the page's identity card (TLS/protocol/consistency/headless/
       datacenter read-out), placed directly under the header triplet so the operator sees
       WHO this is before the verdict/signals detail (operator direction 2026-08-03: profile
       bar must be at the top of the page; was previously mid-page beside the radar). *@
    <div class="rounded-xl border p-4 mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
        <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">
            <i class="bx bx-fingerprint text-sm" style="color: var(--sb-accent);"></i>
            Fingerprint Profile
        </h3>
        @{
            // Helper to find a detector contribution by name fragment
            SignatureDetectorEntry? FindDetector(params string[] names) =>
                Model.DetectorContributions.FirstOrDefault(d => names.Any(n => d.Name.Contains(n, StringComparison.OrdinalIgnoreCase)));

            // Helper to get signal value by category+key or flat key
            string? Signal(string category, string key) =>
                Model.SignalCategories.TryGetValue(category, out var cat) && cat.TryGetValue(key, out var v) ? v : null;

            // Derive fingerprint fields from detector contributions + signals
            var fingerprintDetector = FindDetector("ClientFingerprint", "Fingerprint", "JA3", "TLS");
            var headlessDetector = FindDetector("Headless", "SecurityTool", "Playwright", "Selenium", "Puppeteer");
            var datacenterDetector = FindDetector("IpReputation", "Datacenter", "ASN", "Hosting");
            var consistencyDetector = FindDetector("Consistency", "HttpHeader", "Header", "Inconsistency");
            var uaDetector = FindDetector("UserAgent", "UA");

            // Read the REAL captured signal keys. HTTP protocol lives under
            // "request.protocol" (EnrichProtocol), TLS under "tls.version"/"tls.cipher"
            // (Kestrel handshake), JA3/JA4 under "ja3.hash"/"ja4.hash" (raw ClientHello
            // capture). A null value means "not captured in this deployment", rendered
            // honestly as "Unavailable" rather than a bare "-".
            var tlsVersion     = Signal("tls", "version") ?? Signal("tls", "Version");
            var tlsCipher      = Signal("tls", "cipher");
            var httpProtocol   = Model.Protocol ?? Signal("request", "protocol")
                                 ?? Signal("http", "protocol") ?? Signal("h2", "protocol") ?? Signal("h3", "protocol");
            var ja3Fingerprint = Signal("ja3", "hash") ?? Signal("ja4", "hash") ?? Signal("tls", "client");
            var tcpOsHint      = Signal("tcp", "os_hint") ?? Signal("tcp", "os");
            var uaConsistency  = Signal("ua", "consistency");

            const string Unavail = "Unavailable";
            string Show(string? v) => string.IsNullOrWhiteSpace(v) ? Unavail : v!;
            string AvailColor(string? v) => string.IsNullOrWhiteSpace(v) ? "text-base-content/40" : "text-info";
            // Qualitative consistency from a detector -- never the raw contribution
            // number (that was the old mis-map). High deviation = Flagged.
            string Qual(SignatureDetectorEntry? det) => det == null ? Unavail :
                Math.Abs(det.Contribution) >= 0.3 ? "Flagged" :
                Math.Abs(det.Contribution) >= 0.1 ? "Suspect" : "Consistent";
            string QualColor(SignatureDetectorEntry? det) => det == null ? "text-base-content/40" :
                Math.Abs(det.Contribution) >= 0.3 ? "text-error" :
                Math.Abs(det.Contribution) >= 0.1 ? "text-warning" : "text-success";

            string? FpValue(SignatureDetectorEntry? det) => det == null ? null :
                Math.Abs(det.Contribution) >= 0.1 ? $"{(det.Contribution >= 0 ? "+" : "")}{det.Contribution:F2}" : "Low";

            string FpColor(SignatureDetectorEntry? det) => det == null ? "text-base-content/40" :
                Math.Abs(det.Contribution) >= 0.3 ? "text-error" :
                Math.Abs(det.Contribution) >= 0.1 ? "text-warning" : "text-success";

            // The tooltip text for each item lives in
            // Definitions/Tooltips/dashboard-tooltips.yaml under fp.* keys; the
            // view references the key only (per feedback_no_word_lists). The
            // SbTooltipTagHelper resolves the key against DashboardTooltipRegistry
            // at render time and only emits markup when EnableTooltips is true.
            var fpItems = new (string Label, string Icon, string Value, string Color, string TooltipKey)[] {
                ("TLS Version", "bx-lock-alt", Show(tlsVersion), AvailColor(tlsVersion), "fp.tls_version"),
                ("HTTP Protocol", "bx-globe", Show(httpProtocol), AvailColor(httpProtocol), "fp.http_protocol"),
                ("Protocol Client", "bx-transfer", Show(ja3Fingerprint ?? tlsCipher), AvailColor(ja3Fingerprint ?? tlsCipher), "fp.protocol_client"),
                ("TCP OS Hint", "bx-chip", Show(tcpOsHint), AvailColor(tcpOsHint), "fp.tcp_os_hint"),
                ("Fingerprint Integrity", "bx-shield", fingerprintDetector != null ? Qual(fingerprintDetector) : (tlsVersion != null ? "Consistent" : Unavail), QualColor(fingerprintDetector), "fp.fingerprint_integrity"),
                ("UA Consistency", "bx-badge-check", uaConsistency ?? Qual(uaDetector), uaConsistency != null ? "text-info" : QualColor(uaDetector), "fp.ua_consistency"),
                ("Headless Indicator", "bx-bot", headlessDetector != null ? (FpValue(headlessDetector) ?? "Detected") : "Clean", headlessDetector != null ? FpColor(headlessDetector) : "text-success", "fp.headless_indicator"),
                ("Datacenter IP", "bx-server", datacenterDetector != null ? (FpValue(datacenterDetector) ?? "Detected") : "Clean", datacenterDetector != null ? FpColor(datacenterDetector) : "text-success", "fp.datacenter_ip")
            };
        }
        @* Inner profile grid: 1 col on narrow, 2 cols once room exists. The card is now
           full-width (moved under the header), so two columns is comfortable at sm+. *@
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            @foreach (var (label, icon, value, color, tooltipKey) in fpItems)
            {
                <div class="flex items-center gap-2 rounded-lg border px-2 py-1.5" sb-tooltip="@tooltipKey" style="border-color: var(--sb-card-divider);">
                    <i class="bx @icon text-sm" style="color: var(--sb-accent);"></i>
                    <div>
                        <div class="text-[10px] text-base-content/50">@label</div>
                        <div class="text-xs font-mono @color">@value</div>
                    </div>
                </div>
            }
        </div>
        @if (Model.DetectorContributions.Count == 0 && !Model.SignalCategories.Any())
        {
            @* NOT an empty state: a fingerprint is constructed FROM signal data, so zero
               detector/signal data on a rendered fingerprint is always a data-plumbing bug.
               Render it loud (error callout), never as a quiet "no data" note that reads
               like a legitimate absence (operator direction 2026-08-03). *@
            <div class="mt-2 rounded-lg border p-2 text-xs text-error"
                 style="border-color: var(--sb-card-divider); background: var(--sb-card-bg);"
                 role="alert">
                Detector signal data missing — this is a pipeline bug, not an empty signature.
            </div>
        }
    </div>

    @* VERDICT: the probability/confidence/risk tiles + the analysis prose + the signed
       per-detector signals used to be three separate cards competing for attention
       (a bare stats grid, then an Analysis card and a Detection Signals card two
       screens down next to each other). One verdict section, one read: numbers on
       top, why underneath, signals last. Detector Contributions (the full per-detector
       table further down) stays separate -- that's the detailed breakdown, a
       different altitude from this summary. *@
    <div class="rounded-xl border p-4 mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3 mb-4">
            <div class="rounded-lg border p-3" sb-tooltip="stat.probability" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <div class="text-[10px] font-semibold text-base-content/50 uppercase">Probability</div>
                <div class="text-lg font-bold @(Model.BotProbability >= 0.7 ? "text-error" : Model.BotProbability >= 0.4 ? "text-warning" : "text-success")">@($"{Model.BotProbability:P0}")</div>
            </div>
            <div class="rounded-lg border p-3" sb-tooltip="stat.confidence" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <div class="text-[10px] font-semibold text-base-content/50 uppercase">Confidence</div>
                <div class="text-lg font-bold text-base-content">@($"{Model.Confidence:P0}")</div>
            </div>
            <div class="rounded-lg border p-3" sb-tooltip="stat.risk_profile" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <div class="text-[10px] font-semibold text-base-content/50 uppercase">Risk Profile</div>
                <div class="text-lg font-bold @RiskColor(Model.RiskBand)">@(Model.RiskBand ?? "Unknown")</div>
                @if (!string.IsNullOrEmpty(Model.RiskJustification))
                {
                    <div class="text-[10px] text-base-content/50 mt-1 leading-tight">@Model.RiskJustification</div>
                }
            </div>
            <div class="rounded-lg border p-3" sb-tooltip="stat.threat" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <div class="text-[10px] font-semibold text-base-content/50 uppercase">Threat</div>
                <div class="text-lg font-bold @ThreatColor(Model.ThreatBand)">@(Model.ThreatBand ?? "None")</div>
            </div>
            <div class="rounded-lg border p-3" sb-tooltip="stat.hit_count" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <div class="text-[10px] font-semibold text-base-content/50 uppercase">Hit Count</div>
                <div class="text-lg font-bold text-base-content">@Model.HitCount.ToString("N0")</div>
            </div>
            <div class="rounded-lg border p-3" sb-tooltip="stat.last_seen" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <div class="text-[10px] font-semibold text-base-content/50 uppercase">Last Seen</div>
                <div class="text-lg font-bold text-base-content">@timeAgo</div>
            </div>
        </div>

        <div class="mb-3">
            <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">Analysis</h3>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-sm text-base-content/80 mb-2">@Model.Description</p>
            }
            @if (!string.IsNullOrEmpty(Model.Narrative))
            {
                <p class="text-xs text-base-content/50 italic">@Model.Narrative</p>
            }
            @if (string.IsNullOrEmpty(Model.Description) && string.IsNullOrEmpty(Model.Narrative))
            {
                <p class="text-xs text-base-content/40 italic">No analysis available yet.</p>
            }
        </div>

        <div>
            <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">Detection Signals</h3>
            @* Prefer the real signed per-detector data (DashboardDetectorContribution.
               ConfidenceDelta -- centroid/belief-delta pipeline output, not a rules
               lookup) so the operator sees WHICH WAY each signal pushed the verdict,
               not just a flat reason string. The full Model.DetectorContributions
               list is the FULL breakdown (the separate Detector Contributions table
               below); the shared _DetectionReasons partial caps it to a concise
               verdict-level summary -- same partial + same cap the YOUR DETECTION
               widget uses, so the two surfaces render identically. *@
            @{
                var signedReasons = Model.DetectorContributions
                    .Select(det => new DetectionReasonEntry(
                        string.IsNullOrEmpty(det.Reason) ? det.Name.Replace("Contributor", "", StringComparison.Ordinal) : det.Reason,
                        det.ConfidenceDelta,
                        det.Contribution))
                    .ToList();
            }
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/_DetectionReasons.cshtml",
                new DetectionReasonsModel(signedReasons, Model.TopReasons))
        </div>
    </div>

    @* Behavioural fingerprint shape: 7-bucket centroid radar (Network / Locale /
       Headers / Tool / Transport / Session / Quality). Same FingerprintRadarProjection
       the home card uses, so the polygons read identically on both surfaces for the
       same signature. Null FingerprintShape => calibrating placeholder (the matcher
       has not yet mapped this signature to a fingerprint).
       Full tilde-path -- RazorViewRenderer does not inject /Views/StyloBot/Dashboard/
       into the partial search list; same pattern other dashboard partials use.
       The Fingerprint Profile card that used to share this row moved to the top of
       the page (operator direction 2026-08-03), so the radar stands alone. *@
    <div class="mb-4">
        <div class="rounded-xl border p-4 flex items-center justify-center"
             style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            @await Html.PartialAsync("~/Views/Shared/_FingerprintShape.cshtml",
                new FingerprintShapeViewModel(Model.FingerprintShape, Model.IsBot, 240, Model.UserAgent))
        </div>
    </div>

    @* "Looks like" -- nearest centroid neighbours by vec0 KNN, computed per page
       load (the answer drifts with the population). Most useful when the visitor's
       own archetype is Unknown / generic, but we always render the panel when the
       lookup returns hits so operators get a consistent point of reference. *@
    @if (Model.LooksLike.Count > 0)
    {
        <div class="rounded-xl border p-4 mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">
                <i class="bx bx-search-alt-2 text-sm" style="color: var(--sb-accent);"></i>
                Looks like
                <span class="text-[10px] font-normal text-base-content/40 normal-case ml-1">
                    closest known fingerprints by centroid distance (recomputed per request)
                </span>
            </h3>
            <ul class="text-xs space-y-1 list-none p-0 m-0">
                @foreach (var n in Model.LooksLike)
                {
                    var label = !string.IsNullOrEmpty(n.DisplayName)
                        ? n.DisplayName
                        : (!string.IsNullOrEmpty(n.InferredClientType) ? n.InferredClientType : "Unnamed fingerprint");
                    <li class="flex items-center justify-between gap-3 py-1 border-b border-base-content/5 last:border-b-0">
                        @* No drill-through link yet: there is no per-fingerprint-id UI
                           page (only the Identities tab list), and synthesising a route
                           here would 404. If a dedicated fingerprint detail page lands
                           later this becomes an anchor. The fingerprint_id is exposed
                           via data-fp-id on the row so operators can grab it via
                           DevTools copy-paste without the title= attribute the portal
                           would strip on bind. *@
                        <span class="truncate text-base-content/85" sb-tooltip="lookslike.row" data-fp-id="@n.FingerprintId">
                            @label
                            @if (!string.IsNullOrEmpty(n.InferredClientType) && !string.Equals(label, n.InferredClientType, StringComparison.Ordinal))
                            {
                                <span class="text-[10px] text-base-content/40 ml-1">(@n.InferredClientType)</span>
                            }
                            @* NearestFingerprint carries no bot-type/verdict field -- unlike
                               the other 4 slot sites, this data genuinely isn't available
                               here without an extra lookup, so botType/isBot go through as
                               unknown (null/false) rather than a real classification. *@
                            @NameActionSlot.Render(n.FingerprintId, label, null, false)
                        </span>
                        <span class="tabular-nums text-base-content/55 text-[10px] whitespace-nowrap" sb-tooltip="lookslike.distance">
                            d = @n.Distance.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)
                        </span>
                    </li>
                }
            </ul>
        </div>
    }

    @* Browser Modes -- composite-spec step 7. One row per persisted
       fingerprint_modes entry. Same browser, different modes: a real Chrome
       user emits navigation on page load, xhr on /api/*, sub-resource on
       /static/*, signalr-negotiate on /hub/negotiate. Replaces the legacy
       "Drifted Chrome Desktop → Chrome XHR" misnomer that conflated multi-
       mode evolution with identity drift. The panel hides itself when the
       fingerprint has no mode rows (cold post-deploy or remote-mode host
       without an IFingerprintBrowserModeStore in DI). *@
    @if (Model.BrowserModes.Count > 0)
    {
        <div class="rounded-xl border p-4 mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2 flex items-center gap-1">
                <i class="bx bx-layer text-sm" style="color: var(--sb-accent);"></i>
                Browser modes
                <span class="text-[10px] font-normal text-base-content/40 normal-case ml-1">
                    same browser, different modes. One row per persisted mode
                </span>
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-xs">
                    <thead class="text-[10px] uppercase text-base-content/40">
                        <tr>
                            <th class="text-left py-1 pr-2">Mode</th>
                            <th class="text-right py-1 px-2 tabular-nums" sb-tooltip="modes.observations">Observations</th>
                            <th class="text-right py-1 px-2 tabular-nums" sb-tooltip="modes.maturity">Maturity</th>
                            <th class="text-left py-1 px-2"
                                title="L2 distance from this identity's rolled-up centroid; top slots are the largest per-slot deltas. Replaces the deleted Nearest archetype column.">
                                Shift from baseline
                            </th>
                            <th class="text-right py-1 pl-2 whitespace-nowrap">Last seen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.BrowserModes)
                        {
                            <tr class="border-b border-base-content/5 last:border-b-0">
                                <td class="py-1 pr-2 font-mono text-[11px]" sb-tooltip="modes.id">@m.ModeId</td>
                                <td class="py-1 px-2 text-right tabular-nums text-base-content/85">@m.ObservationCount</td>
                                <td class="py-1 px-2 text-right tabular-nums text-base-content/85">@m.CentroidMaturity</td>
                                <td class="py-1 px-2 text-[11px]">
                                    @if (m.Shift is { } shift)
                                    {
                                        <span class="tabular-nums text-base-content/85">@shift.Magnitude.ToString("F2")</span>
                                        if (shift.TopSlotLabels.Count > 0)
                                        {
                                            <span class="text-base-content/50 ml-1">(@string.Join(", ", shift.TopSlotLabels))</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-base-content/40">—</span>
                                    }
                                </td>
                                <td class="py-1 pl-2 text-right text-[11px] text-base-content/50 tabular-nums whitespace-nowrap">@m.LastSeen.ToString("HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @{
                var modeCount = Model.BrowserModes.Count;
                var totalObs = Model.BrowserModes.Sum(m => m.ObservationCount);
            }
            <div class="text-[10px] text-base-content/40 mt-2">
                @modeCount mode@(modeCount == 1 ? "" : "s") across @totalObs observation@(totalObs == 1 ? "" : "s"). See <a class="underline decoration-dotted" href="https://github.com/scottgal/stylobot/blob/main/docs/architecture/composite-browser-mode-fingerprints.md" target="_blank" rel="noopener">composite browser-mode fingerprints</a>.
            </div>
        </div>
    }

    <!-- Periodicity heatmap: 7×24 day-of-week × hour-of-day hit counts over the
         trailing 30 days, aggregated from the requests table. Renders nothing
         when there's no data yet (short-lived signature, first-touch visitor). -->
    @if (Model.PeriodicityHeatmap is { HasData: true } heatmap)
    {
        var dayLabels = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
        <details class="rounded-xl border mb-4" open style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <summary class="p-4 cursor-pointer text-xs font-semibold text-base-content/70 uppercase">
                <i class="bx bx-grid-alt text-sm" style="color: var(--sb-accent);"></i>
                When does this signature hit? <span class="text-base-content/40 font-normal">(@heatmap.TotalHits hits over @heatmap.WindowDays days, all times UTC)</span>
            </summary>
            <div class="p-4 pt-0">
                <div class="overflow-x-auto">
                    <table class="text-[10px] border-collapse" style="font-family: ui-monospace, monospace;">
                        <thead>
                            <tr class="text-base-content/40">
                                <th class="pr-2 text-right font-normal">UTC</th>
                                @for (var h = 0; h < 24; h++)
                                {
                                    <th class="px-0.5 font-normal" style="width: 14px;">@(h % 6 == 0 ? h.ToString("00") : "")</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var d = 0; d < 7; d++)
                            {
                                <tr>
                                    <td class="pr-2 text-right text-base-content/50">@dayLabels[d]</td>
                                    @for (var h = 0; h < 24; h++)
                                    {
                                        var count = heatmap.Grid[d, h];
                                        var intensity = heatmap.MaxCellValue == 0 ? 0.0 : (double)count / heatmap.MaxCellValue;
                                        var bg = count == 0
                                            ? "var(--sb-card-bg)"
                                            : $"color-mix(in oklab, var(--sb-accent) {(int)(intensity * 90 + 10)}%, transparent)";
                                        @* Per-cell data is dynamic (day + hour + count) so the data-tip is
                                           composed inline. The portal binds .tooltip[data-tip] and shows
                                           the styled bubble on hover — same single rendering path the
                                           rest of the page uses. *@
                                        var cellTip = $"{dayLabels[d]} {h:00}:00 UTC, {count} hits";
                                        <td class="border tooltip tooltip-bottom" style="width: 14px; height: 14px; background: @bg; border-color: var(--sb-card-divider);" data-tip="@cellTip"></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 flex items-center gap-2 text-[10px] text-base-content/40">
                    <span sb-tooltip="periodicity.legend">Less</span>
                    @for (var step = 0; step < 5; step++)
                    {
                        var pct = (int)(step * 22 + 10);
                        <span style="display:inline-block; width:14px; height:14px; background: color-mix(in oklab, var(--sb-accent) @(pct)%, transparent); border: 1px solid var(--sb-card-divider);"></span>
                    }
                    <span sb-tooltip="periodicity.legend">More</span>
                    <span class="ml-3" sb-tooltip="periodicity.peak">Peak cell: @heatmap.MaxCellValue hits</span>
                </div>
            </div>
        </details>
    }

    @* Endpoints Visited.
       When per-signature endpoint stats are available (SQLite path), render the
       richer table: hits + p95 + bot rate + risk band + status mix per endpoint.
       When the store returned empty (remote-mode adapter, signature has no
       persisted detections yet, or query failure), fall back to the historical
       Paths list so the panel never disappears for a known visitor. The header
       count and the "endpoint.col.*" tooltip keys cover both shapes. *@
    @if (Model.EndpointStats.Count > 0)
    {
        <details class="rounded-xl border mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <summary class="p-4 cursor-pointer text-xs font-semibold text-base-content/70 uppercase">
                <i class="bx bx-link text-sm" style="color: var(--sb-accent);"></i>
                Endpoints Visited <span class="text-base-content/40 font-normal">(@Model.EndpointStats.Count)</span>
                <span class="text-[10px] font-normal text-base-content/40 ml-2">Click to expand</span>
            </summary>
            <div class="p-4 pt-0">
                <div class="overflow-x-auto">
                    <table class="table table-xs w-full">
                        <thead>
                            <tr class="text-[10px] uppercase tracking-wider text-base-content/40">
                                <th class="py-1 text-left"      sb-tooltip="endpoint.col.path">Path</th>
                                <th class="py-1 text-left"      sb-tooltip="endpoint.col.method">Method</th>
                                <th class="py-1 text-right"     sb-tooltip="endpoint.col.hits">Hits</th>
                                <th class="py-1 text-right"     sb-tooltip="endpoint.col.avg_ms">Avg ms</th>
                                <th class="py-1 text-right"     sb-tooltip="endpoint.col.p95_ms">P95 ms</th>
                                <th class="py-1 text-right"     sb-tooltip="endpoint.col.max_ms">Max ms</th>
                                <th class="py-1 text-right"     sb-tooltip="endpoint.col.bot_rate">Bot %</th>
                                <th class="py-1 text-left"      sb-tooltip="endpoint.col.risk">Risk</th>
                                <th class="py-1 text-left"      sb-tooltip="endpoint.col.action">Action</th>
                                <th class="py-1 text-right"     sb-tooltip="endpoint.col.status_mix">2xx/4xx/5xx</th>
                                <th class="py-1 text-right"     sb-tooltip="endpoint.col.last_seen">Last seen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.EndpointStats)
                            {
                                var shortPath = e.Path.Length > 60 ? e.Path[..60] + "…" : e.Path;
                                var botPct = (int)Math.Round(e.BotRate * 100);
                                var lastAgo = e.LastSeen == default ? "" : FormatTimeAgo(DateTime.UtcNow - e.LastSeen);
                                <tr class="hover:bg-base-200/50">
                                    <td class="py-1 text-xs font-mono text-base-content/80 max-w-[28ch] truncate" title="@e.Path">@shortPath</td>
                                    <td class="py-1 text-[10px] font-mono text-base-content/60 uppercase">@e.Method</td>
                                    <td class="py-1 text-right text-xs tabular-nums text-base-content/90">@e.HitCount.ToString("N0")</td>
                                    <td class="py-1 text-right text-xs tabular-nums text-base-content/70">@AnalyticsFormatting.FormatMs(e.AvgProcessingTimeMs)</td>
                                    <td class="py-1 text-right text-xs tabular-nums text-base-content/70">@AnalyticsFormatting.FormatMs(e.P95ProcessingTimeMs)</td>
                                    <td class="py-1 text-right text-xs tabular-nums text-base-content/50">@AnalyticsFormatting.FormatMs(e.MaxProcessingTimeMs)</td>
                                    <td class="py-1 text-right text-xs tabular-nums @(botPct >= 70 ? "text-error" : botPct >= 30 ? "text-warning" : "text-success")">@botPct%</td>
                                    <td class="py-1 text-xs @RiskColor(e.DominantRiskBand)">@(e.DominantRiskBand ?? "-")</td>
                                    <td class="py-1 text-xs @ActionColor(e.DominantAction)">@(e.DominantAction ?? "-")</td>
                                    <td class="py-1 text-right text-[10px] tabular-nums font-mono text-base-content/60">
                                        <span class="text-success">@e.Status2xx</span>/<span class="text-warning">@e.Status4xx</span>/<span class="text-error">@e.Status5xx</span>
                                    </td>
                                    <td class="py-1 text-right text-[10px] text-base-content/50">@lastAgo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>
    }
    else if (Model.Paths.Count > 0)
    {
        @* Fallback: the in-memory visitor cache has paths but the store query
           returned no rows (e.g. remote-mode dashboard, fresh signature whose
           detections haven't persisted yet). Show the simple list rather than
           hiding the panel entirely. *@
        <details class="rounded-xl border mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <summary class="p-4 cursor-pointer text-xs font-semibold text-base-content/70 uppercase">
                <i class="bx bx-link text-sm" style="color: var(--sb-accent);"></i>
                Endpoints Visited <span class="text-base-content/40 font-normal">(@Model.Paths.Count)</span>
                <span class="text-[10px] font-normal text-base-content/40 ml-2">Click to expand · stats unavailable</span>
            </summary>
            <div class="p-4 pt-0">
                <div class="overflow-x-auto">
                    <table class="table table-xs w-full">
                        <thead>
                            <tr class="text-[10px] uppercase tracking-wider text-base-content/40">
                                <th class="py-1">#</th>
                                <th class="py-1" sb-tooltip="endpoint.col.path">Path</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Paths.Count; i++)
                            {
                                <tr class="hover:bg-base-200/50">
                                    <td class="py-1 text-[10px] text-base-content/30 font-mono">@(i + 1)</td>
                                    <td class="py-1 text-xs font-mono text-base-content/70">@Model.Paths[i]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>
    }

    <!-- Raw Requests (collapsed) -->
    @if (Model.RecentDetections.Count > 0)
    {
        <details class="rounded-xl border mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <summary class="p-4 cursor-pointer text-xs font-semibold text-base-content/70 uppercase">
                <i class="bx bx-list-ul text-sm" style="color: var(--sb-accent);"></i>
                Raw Requests <span class="text-base-content/40 font-normal">(@Model.RecentDetections.Count)</span>
                <span class="text-[10px] font-normal text-base-content/40 ml-2">Click to expand</span>
            </summary>
            <div class="p-4 pt-0">
                <div class="overflow-x-auto">
                    <table class="table table-xs w-full">
                        <thead>
                            <tr class="text-[10px] uppercase tracking-wider text-base-content/40">
                                <th class="py-1"              sb-tooltip="raw.col.time">Time</th>
                                <th class="py-1"              sb-tooltip="raw.col.method">Method</th>
                                <th class="py-1"              sb-tooltip="raw.col.path">Path</th>
                                <th class="py-1 text-center"  sb-tooltip="raw.col.status">Status</th>
                                <th class="py-1 text-right"   sb-tooltip="raw.col.prob">Prob</th>
                                <th class="py-1 text-right"   sb-tooltip="raw.col.conf">Conf</th>
                                <th class="py-1"              sb-tooltip="raw.col.risk">Risk Profile</th>
                                <th class="py-1"              sb-tooltip="raw.col.action">Action</th>
                                <th class="py-1 text-right"   sb-tooltip="raw.col.time_ms">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.RecentDetections)
                            {
                                var is404 = d.StatusCode == 404;
                                var statusClass = d.StatusCode >= 400 ? "text-error font-bold" : d.StatusCode >= 300 ? "text-warning" : "text-success";
                                <tr class="hover:bg-base-200/50 @(is404 ? "bg-error/5" : "")">
                                    <td class="py-1 text-[10px] text-base-content/50 whitespace-nowrap">@d.Timestamp.ToString("HH:mm:ss")</td>
                                    <td class="py-1 text-[10px] font-mono text-base-content/50">@d.Method</td>
                                    <td class="py-1 text-xs font-mono text-base-content/70 max-w-[250px] truncate">@d.Path</td>
                                    <td class="py-1 text-center text-xs @statusClass">@(d.StatusCode > 0 ? d.StatusCode.ToString() : "-")</td>
                                    <td class="py-1 text-right text-xs @(d.BotProbability >= 0.7 ? "text-error" : d.BotProbability >= 0.4 ? "text-warning" : "text-success")">@($"{d.BotProbability:P0}")</td>
                                    <td class="py-1 text-right text-xs text-base-content/60">@($"{d.Confidence:P0}")</td>
                                    <td class="py-1 text-[10px] @RiskColor(d.RiskBand)">@d.RiskBand</td>
                                    <td class="py-1 text-[10px] @ActionColor(d.Action)">@ActionDisplayHelper.GetFriendlyName(d.Action)</td>
                                    <td class="py-1 text-right text-[10px] text-base-content/40 font-mono">@($"{d.ProcessingTimeMs:F1}")ms</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </details>
    }

    <!-- Charts: Bot Probability & Confidence History + Processing Time -->
    @if (Model.BotProbabilityHistory.Count > 1)
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
            <div class="rounded-xl border p-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">Bot Probability & Confidence History</h3>
                <div id="prob-conf-chart" style="height: 200px;"></div>
                <script type="application/json" id="prob-conf-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { probability = Model.BotProbabilityHistory, confidence = Model.ConfidenceHistory }))</script>
            </div>
            <div class="rounded-xl border p-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2" title="Time spent inside the StyloBot detection pipeline per request. This is the additional latency StyloBot adds on top of your upstream app's response time.">StyloBot Detection Overhead (ms)</h3>
                <div id="proc-time-chart" style="height: 200px;"></div>
                <script type="application/json" id="proc-time-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProcessingTimeHistory))</script>
            </div>
        </div>
    }

    @* User Agent -- promoted from the metadata footer's hover-only title= attribute
       (where it was effectively invisible) to a primary visible block above Analysis
       so an operator can always read the raw UA string this signature was identified
       from. Monospaced + word-break-all so long enterprise UAs wrap cleanly inside
       the card rather than blowing the row width out. The select-all class is on the
       <code> so a triple-click copies the full string without the label. *@
    @if (!string.IsNullOrEmpty(Model.UserAgent))
    {
        <div class="rounded-xl border p-4 mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">
                <i class="bx bx-user-circle text-sm" style="color: var(--sb-accent);"></i>
                User Agent
            </h3>
            <code class="block text-xs font-mono text-base-content/80 break-all select-all"
                  style="font-family: ui-monospace, monospace;"
                  data-testid="sb-signature-user-agent">@Model.UserAgent</code>
        </div>
    }

    <!-- Detector Contributions -->
    @if (Model.DetectorContributions.Count > 0)
    {
        <div class="rounded-xl border p-4 mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-3">
                Detector Contributions
                <span class="text-base-content/40 font-normal">(@Model.DetectorContributions.Count detectors)</span>
            </h3>
            <div class="overflow-x-auto">
                <table class="table table-xs w-full">
                    <thead>
                        <tr class="text-[10px] uppercase tracking-wider text-base-content/40">
                            <th class="py-1 text-left">Detector</th>
                            <th class="py-1 text-right">Confidence Delta</th>
                            <th class="py-1 text-right">Timing (ms)</th>
                            @if (Model.TunerEnabled)
                            {
                                <th class="py-1 text-center">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var det in Model.DetectorContributions)
                        {
                            var deltaSign = det.ConfidenceDelta >= 0 ? "+" : "";
                            var deltaColor = det.ConfidenceDelta > 0 ? "text-error" : "text-success";
                            var timingDisplay = det.ExecutionTimeMs > 0
                                ? $"{det.ExecutionTimeMs:F1}"
                                : "-";
                            var detectorLabel = det.Name.Replace("Contributor", "", StringComparison.Ordinal);
                            <tr class="hover:bg-base-200/50">
                                <td class="py-1.5">
                                    <div class="text-xs font-medium text-base-content/80 truncate max-w-[220px]" title="@det.Name">@detectorLabel</div>
                                    @if (!string.IsNullOrEmpty(det.Reason))
                                    {
                                        <div class="text-[10px] text-base-content/40 italic">@det.Reason</div>
                                    }
                                </td>
                                <td class="py-1.5 text-right text-[10px] font-mono @deltaColor">@($"{deltaSign}{det.ConfidenceDelta:F3}")</td>
                                <td class="py-1.5 text-right text-[10px] font-mono text-base-content/50">@timingDisplay</td>
                                @if (Model.TunerEnabled)
                                {
                                    <td class="py-1.5 text-center">
                                        <a href="/tuner/new?domain=@Uri.EscapeDataString(Model.SignatureId)&triggerType=DetectorFired&detector=@Uri.EscapeDataString(det.Name)"
                                           class="btn btn-xs btn-ghost text-[10px]"
                                           title="Create a Tuner session to analyse and adjust @detectorLabel thresholds">
                                            Tune
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Signal Intelligence -->
    @if (Model.SignalCategories.Count > 0)
    {
        @* Format raw signal string values so tiny floats don't render with 300 leading
           zeros (the C# double ToString() default for 3.5e-35 etc). We only re-format
           when the string is unambiguously a number; non-numeric strings ("True",
           "Apple", "HTTP/2") pass through unchanged. *@
        string FormatSignalValue(string? raw)
        {
            if (string.IsNullOrEmpty(raw)) return "";
            if (!double.TryParse(raw, System.Globalization.NumberStyles.Float | System.Globalization.NumberStyles.AllowExponent,
                                 System.Globalization.CultureInfo.InvariantCulture, out var d))
                return raw;
            var abs = Math.Abs(d);
            if (abs == 0) return "0";
            if (abs < 1e-3) return "<0.001"; // anything sub-millisignal is operator noise
            if (abs >= 1000) return d.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
            if (abs >= 1)    return d.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
            return d.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        }
        // Resolve once per render -- the catalog snapshot is immutable for
        // the life of the process, so no per-row lookup cost on the
        // ISignalCatalog side beyond a dictionary read.
        var signalCatalog = _services.GetService(typeof(ISignalCatalog)) as ISignalCatalog;
        <div class="rounded-xl border p-4 mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">Signal Intelligence</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var cat in Model.SignalCategories.OrderBy(c => c.Key))
                {
                    <div>
                        <h4 class="text-[10px] font-semibold text-base-content/50 uppercase mb-1" style="color: var(--sb-accent);">@cat.Key</h4>
                        <div class="space-y-0.5">
                            @foreach (var signal in cat.Value)
                            {
                                @* Resolve the human label/description from the catalog so the
                                   tooltip body says "IP reputation score from the fast-path
                                   lookup" instead of repeating the raw key "fastpath.ip.score"
                                   that's already visible in the same row. Fail-open: when the
                                   catalog has no entry for this key (commercial pack added it
                                   without a SignalKeys constant + XML doc), the tooltip falls
                                   back to the key string -- same as the pre-fix behaviour. *@
                                var desc = signalCatalog?.TryGet(signal.Key);
                                var tip = !string.IsNullOrEmpty(desc?.Long)
                                    ? desc!.Long
                                    : (!string.IsNullOrEmpty(desc?.Short) ? desc!.Short : signal.Key);
                                <div class="flex items-start gap-2 text-[10px]">
                                    <span class="text-base-content/40 font-mono min-w-[80px] truncate" title="@tip">@signal.Key</span>
                                    <span class="text-base-content/70 break-all" title="@signal.Value">@FormatSignalValue(signal.Value)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.ThreatScore.HasValue)
    {
        <div class="rounded-xl border p-4 mb-4" style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">Threat Assessment</h3>
            <div class="flex items-center gap-4">
                @if (!string.IsNullOrEmpty(Model.BotType))
                {
                    <div>
                        <span class="text-sm text-base-content/50">Intent:</span>
                        <span class="text-sm font-bold text-base-content">@Model.BotType</span>
                    </div>
                }
                <div>
                    <span class="text-sm text-base-content/50">Score:</span>
                    <span class="text-sm font-bold @ThreatColor(Model.ThreatBand)">@($"{Model.ThreatScore:F3}")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ThreatBand))
                {
                    <div>
                        <span class="text-sm text-base-content/50">Band:</span>
                        <span class="text-sm font-bold @ThreatColor(Model.ThreatBand)">@Model.ThreatBand</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Action))
                {
                    <div>
                        <span class="text-sm text-base-content/50">Policy:</span>
                        <span class="text-sm font-bold @ActionColor(Model.Action)">@ActionDisplayHelper.GetFriendlyName(Model.Action)</span>
                    </div>
                }
            </div>
        </div>
    }

    @* B8b: Policies applied to this signature. Scope is the most-recent
       endpoint the signature touched -- pulled from RecentDetections (the
       canonical per-request feed surfaced on this page) and the request
       host. The fingerprint id is locked into the explainer so the decision
       trace below replays the actual rules that fired for THIS visitor,
       not an arbitrary picker target. Renders nothing when we have no
       request rows AND no host context (a known-empty visitor card --
       SbPolicyStack's own empty-state would still claim space). *@
    {
        var mostRecent = Model.RecentDetections.FirstOrDefault();
        var sigHost = Context?.Request?.Host.Host ?? string.Empty;
        var sigPath = mostRecent?.Path;
        var sigMethod = mostRecent?.Method;
        PolicyScope? sigScope = null;
        if (!string.IsNullOrEmpty(sigHost) && !string.IsNullOrEmpty(sigPath))
        {
            var sigTemplate = string.IsNullOrEmpty(sigMethod) ? sigPath : $"{sigMethod} {sigPath}";
            sigScope = PolicyScope.Endpoint(sigHost, sigHost, sigTemplate);
        }
        else if (!string.IsNullOrEmpty(sigHost))
        {
            sigScope = PolicyScope.Domain(sigHost);
        }
        if (sigScope is not null)
        {
            <section class="dashboard-signature-policy rounded-xl border p-4 mb-4"
                     style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">
                    <i class="bx bx-shield-quarter text-sm" style="color: var(--sb-accent);"></i>
                    Policy applied
                </h3>
                @* Compact indicator: shows "N rules effective here" with link
                   into the policy editor. Full rule editor lives on
                   /dashboard/policies; signature detail just needs a one-line
                   "this is what applies" badge, not the rule list. *@
                @await Component.InvokeAsync("SbPolicyStack", new
                {
                    scope = sigScope,
                    embed = PolicyStackEmbed.StatusBadge,
                    aggregateWindow = (TimeSpan?)TimeSpan.FromHours(24)
                })
            </section>
        }
    }

    @* Hit history -- V2 of the dashboard IA collapse plan absorbs the
       standalone Sessions page as a per-visitor panel on the detail view.
       Scoped renders pass primarySignature so SbSessionsListViewComponent
       takes the ISessionStore.GetSessionsAsync(signature) path instead of
       the global GetRecentSessionsAsync, and the partial hides its
       bot/human pills + duplicate heading because the wrapper card here
       already labels the section. *@
    <section class="rounded-xl border p-4 mb-4"
             style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
        <h3 class="text-xs font-semibold text-base-content/70 uppercase mb-2">
            <i class="bx bx-history text-sm" style="color: var(--sb-accent);"></i>
            Hit history
        </h3>
        @await Component.InvokeAsync("SbSessionsList", new {
            primarySignature = Model.SignatureId
        })
    </section>

    @* Pack contribution slot: any IDashboardContribution registered for
       VisitorDetailSection renders here. No-op when no pack is loaded
       (graceful absence per feedback_remote_mode_optional_di). Each pack's
       view component receives the fingerprintId so it can scope its own
       data. We resolve the registry inline via the service provider --
       remote-mode dashboard hosts may not have it registered so a hard
       @inject would 500 the page. *@
    {
        var contributions = Context?.RequestServices?
            .GetService(typeof(Mostlylucid.BotDetection.UI.Services.Dashboard.DashboardContributionRegistry))
            as Mostlylucid.BotDetection.UI.Services.Dashboard.DashboardContributionRegistry;
        var visitorContribs = contributions?.For(
            Mostlylucid.BotDetection.UI.Services.Dashboard.DashboardContributionSlot.VisitorDetailSection);
        if (visitorContribs is { Count: > 0 })
        {
            @* Locked slot-arg contract (edit- effective-policy VC): fingerprintId +
               botType + botName + domain, matched by name so a contribution reads only
               the keys it needs and ignores the rest (backward-compatible with any other
               contribution on this slot). Without botType + domain the panel resolves the
               GLOBAL default instead of scoping to this signature. domain is not on the
               model; it is the request host -- the site this detail page is being viewed
               for -- which is exactly the per-domain scope the panel needs. Built as a C#
               local (not a multi-line implicit expression) so it is unambiguous Razor. *@
            foreach (var c in visitorContribs)
            {
                var slotArgs = new
                {
                    fingerprintId = Model.FingerprintId,
                    botType = Model.BotType,
                    botName = Model.BotName,
                    domain = Context?.Request.Host.Host
                };
                <section class="rounded-xl border p-4 mb-4"
                         style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                    <div class="text-[10px] uppercase tracking-wider text-base-content/40 mb-1">@c.ContributionName</div>
                    @await Component.InvokeAsync(c.ViewComponentName, slotArgs)
                </section>
            }
        }
    }

    <!-- Metadata footer -->
    <div class="text-[10px] text-base-content/30 mt-4 flex flex-wrap items-center gap-2">
        <span>Signature:</span>
        <code class="bg-base-300/50 px-1.5 py-0.5 rounded select-all">@Model.SignatureId</code>
        <span class="text-base-content/20">|</span>
        <span>Processing: @AnalyticsFormatting.FormatMs(Model.ProcessingTimeMs)</span>
        @if (!string.IsNullOrEmpty(Model.CountryCode) && Model.CountryCode != "XX")
        {
            <span class="text-base-content/20">|</span>
            <span>Country: @Model.CountryCode</span>
