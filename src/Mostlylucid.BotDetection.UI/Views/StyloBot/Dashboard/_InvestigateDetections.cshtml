@using Mostlylucid.BotDetection.UI.Services
@model Mostlylucid.BotDetection.UI.Models.InvestigationViewModel
@{
    var bp = Model.BasePath;
    var f = Model.Filter;
}

@*
    Cloudflare-style detection feed. Replaces the table-with-inline-CSS layout
    (which used lower-case band matches "high"/"medium"/"low" that never lit up
    against the canonical "VeryHigh"/"High"/"Medium"/"Low" titlecase). Now uses
    BotDisplayHelpers for icon + colour so the band visual matches the rest of
    the dashboard, and detail row is an Alpine-toggled expansion underneath the
    same card (no second <tr>).
*@

<div class="sb-investigate-detections flex flex-col gap-2">
    @foreach (var d in Model.Result.Detections)
    {
        var methodIcon = BotDisplayHelpers.IconForHttpMethod(d.Method);
        var methodColor = BotDisplayHelpers.ColorForHttpMethod(d.Method);
        var riskColor = BotDisplayHelpers.ColorForRiskBand(d.RiskBand);
        var riskBars = Math.Max(1, BotDisplayHelpers.RiskSeverity(d.RiskBand));
        var actionIcon = BotDisplayHelpers.IconForAction(d.Action);
        var actionColor = BotDisplayHelpers.ColorForAction(d.Action);
        var botLabel = d.BotName ?? d.BotType ?? "--";
        var botIcon = BotDisplayHelpers.IconForBotType(d.BotType);
        var hasDetail = (d.DetectorContributions?.Any() == true)
                     || (d.ImportantSignals?.Any() == true)
                     || !string.IsNullOrEmpty(d.Description);

        <div class="card bg-base-200 border border-base-300" x-data="{ open: false }">
            <div class="card-body p-3 gap-2 cursor-pointer" @@click="open = !open">
                <!-- ROW 1: timestamp | method+path | action | bot identity -->
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-[10px] text-base-content/50 tabular-nums whitespace-nowrap" title="@d.Timestamp.ToString("o")">
                        @d.Timestamp.ToString("HH:mm:ss")
                    </span>
                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wider @methodColor">
                        <i class="@methodIcon" aria-hidden="true"></i>@d.Method
                    </span>
                    <span class="font-mono text-xs truncate text-base-content/80" title="@d.Path">@d.Path</span>
                    <span class="ml-auto inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wider @actionColor" title="Action: @d.Action">
                        <i class="@actionIcon" aria-hidden="true"></i>@d.Action
                    </span>
                </div>

                <!-- ROW 2: risk bars | bot identity -->
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-0.5" title="Risk Profile: @d.RiskBand">
                        @for (var i = 0; i < 5; i++)
                        {
                            var filled = i < riskBars;
                            <span class="inline-block w-1 rounded-sm @(filled ? riskColor : "text-base-content/15")"
                                  style="height: @((i + 2) * 2)px; background: currentColor;"></span>
                        }
                        <span class="text-[10px] font-semibold uppercase tracking-wider @riskColor ml-1">@d.RiskBand</span>
                    </div>
                    <div class="flex items-center gap-1 ml-auto min-w-0">
                        <i class="@botIcon text-sm text-base-content/60" aria-hidden="true"></i>
                        <span class="text-xs text-base-content/70 truncate" title="@botLabel">@botLabel</span>
                    </div>
                    @if (hasDetail)
                    {
                        <i class="bx bx-chevron-down text-base-content/40 transition-transform"
                           :class="open && 'rotate-180'" aria-hidden="true"></i>
                    }
                </div>
            </div>

            @if (hasDetail)
            {
                <div x-show="open" x-cloak class="border-t border-base-300 p-3 bg-base-100 text-xs flex flex-col gap-2">
                    @if (d.DetectorContributions?.Any() == true)
                    {
                        <div>
                            <div class="font-semibold text-[10px] uppercase tracking-wider text-base-content/50 mb-1">Detector contributions</div>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var (name, contrib) in d.DetectorContributions)
                                {
                                    <span class="badge badge-sm badge-ghost gap-1">
                                        <span class="font-semibold">@name</span>
                                        <span class="tabular-nums">@contrib.Contribution.ToString("P0")</span>
                                        @if (!string.IsNullOrEmpty(contrib.Reason))
                                        {
                                            <span class="text-base-content/50 italic">@contrib.Reason</span>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    }
                    @if (d.ImportantSignals?.Any() == true)
                    {
                        <div>
                            <div class="font-semibold text-[10px] uppercase tracking-wider text-base-content/50 mb-1">Signals</div>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var (key, val) in d.ImportantSignals)
                                {
                                    <span class="badge badge-sm badge-outline font-mono">@key=@val</span>
                                }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(d.Description))
                    {
                        <p class="text-base-content/60">@d.Description</p>
                    }
                </div>
            }
        </div>
    }
    @if (!Model.Result.Detections.Any())
    {
        <p class="text-center text-sm text-base-content/40 py-8">
            <i class="bx bx-radar text-2xl block mb-2 opacity-50"></i>
            No detections in this result set.
        </p>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="flex justify-center gap-1 py-4 flex-wrap">
        @for (var p = 1; p <= Math.Min(Model.TotalPages, 10); p++)
        {
            <button hx-get="@bp/investigate/tab/detections?type=@f.EntityType&value=@f.EntityValue&start=@f.Start?.ToString("o")&end=@f.End?.ToString("o")&offset=@((p-1) * f.Limit)"
                    hx-target="#investigate-tab-content"
                    hx-swap="innerHTML transition:true"
                    class="btn btn-xs @(p == Model.CurrentPage ? "btn-primary" : "btn-ghost")">
                @p
            </button>
        }
    </div>
}
