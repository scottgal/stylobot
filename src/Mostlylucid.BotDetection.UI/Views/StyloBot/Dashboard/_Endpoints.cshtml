@using Mostlylucid.BotDetection.Policies.Rules
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@inject IDashboardLinkResolver DashboardLinks
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model Mostlylucid.BotDetection.UI.Models.DashboardShellModel
@{
    var bp = Model.BasePath;
    @* B8a: derive a wildcard-or-host-scoped policy stack for the page.
       The endpoint rows below drill into _EndpointDetail.cshtml which now
       carries its own per-endpoint SbPolicyStack; this top-of-page panel
       is the "policies effective across every endpoint on this host" view
       so the operator can see the inheritance chain before drilling. *@
    var host = Context?.Request?.Host.Host ?? string.Empty;
    PolicyScope pageScope = string.IsNullOrEmpty(host)
        ? PolicyScope.Wildcard()
        : PolicyScope.Domain(host);
    var policyRowsUrl = DashboardLinks.Resolve($"/policystack/rows?scope={PolicyScopeUrl.Encode(pageScope)}&tab=effective");
    var showcaseDemo = PolicyEditAffordanceResolver.IsShowcaseDemo(Configuration);
}
<section data-dashboard-page="site" @(showcaseDemo ? "data-showcase-readonly=true" : "")>
    @if (showcaseDemo)
    {
        <aside class="sb-showcase-readonly-notice mb-4" data-showcase-readonly data-control-readonly="true" role="note">
            <span>Showcase demo: site changes are read-only.</span>
            <button type="button" class="btn btn-sm" disabled data-showcase-readonly-control
                    aria-label="Pin endpoint unavailable in demo mode"
                    title="Demo mode: editing is read-only">Pin endpoint</button>
        </aside>
    }
<div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
    <div class="lg:col-span-3">
        <sb-endpoints-list />
        @* Lazy-loaded host-scoped policy stack. <details>/hx-get pattern lets
           operators open it without paying the render cost up-front. The
           sibling marker classes are what the integration smoke tests grep
           for. *@
        <details class="dashboard-endpoint-policy mt-4" data-endpoint="@host">
            <summary class="cursor-pointer text-xs font-semibold text-base-content/60 hover:text-base-content/80 py-2 px-3 rounded-lg border"
                     style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
                Show effective policy stack for this site
            </summary>
            <div class="lazy-policy-stack mt-2"
                 hx-get="@policyRowsUrl"
                 hx-trigger="toggle once from:closest details[open]"
                 hx-swap="innerHTML"
                 hx-target="this">
                <em class="text-xs text-base-content/40">Loading policy…</em>
            </div>
        </details>
    </div>
    <div class="lg:col-span-2">
        <div id="endpoint-detail-panel"
             class="rounded-xl border sticky top-4"
             style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            <div class="p-4 text-xs text-base-content/40 text-center py-12">
                Click an endpoint to inspect traffic mix, top bots, and recent requests
            </div>
        </div>
    </div>
</div>
</section>

@* Deep-link handler: when /dashboard/endpoints?selected=METHOD|PATH loads
   (from a row-click hx-push-url or a redirect off the retired
   /dashboard/signature/<id> page) find the matching row by data-endpoint-key
   and trigger it. HTMX swaps the detail into #endpoint-detail-panel exactly
   as if the user had clicked. Done on the first 'sb:endpoints-list-ready'
   event so the table is in the DOM, with a setTimeout fallback for the
   first paint. *@
<script>
    (function () {
        function trySelect() {
            try {
                var params = new URLSearchParams(window.location.search);
                var selected = params.get('selected');
                if (!selected) return false;
                var row = document.querySelector(
                    'tr.endpoint-row[data-endpoint-key="' +
                    selected.replace(/"/g, '\\"') + '"]'
                );
                if (!row || typeof htmx === 'undefined') return false;
                htmx.trigger(row, 'click');
                if (row.scrollIntoView) {
                    row.scrollIntoView({ block: 'center', behavior: 'smooth' });
                }
                return true;
            } catch (e) { return false; }
        }
        if (!trySelect()) {
            // Endpoints list may load via HTMX after first paint; retry once.
            setTimeout(trySelect, 400);
            setTimeout(trySelect, 1200);
        }
    })();
</script>
