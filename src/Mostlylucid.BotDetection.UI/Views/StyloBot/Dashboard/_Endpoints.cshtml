@using Mostlylucid.BotDetection.Policies.Rules
@using Mostlylucid.BotDetection.UI.Dashboard
@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Models.Dashboard.Traffic
@using Mostlylucid.BotDetection.UI.Services
@inject IDashboardLinkResolver DashboardLinks
@inject IDashboardEventStore EventStore
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model Mostlylucid.BotDetection.UI.Models.DashboardShellModel
@{
    var bp = Model.BasePath;
    @* B8a: derive a wildcard-or-host-scoped policy stack for the page.
       The endpoint rows below drill into _EndpointDetail.cshtml which now
       carries its own per-endpoint SbPolicyStack; this top-of-page panel
       is the "policies effective across every endpoint on this host" view
       so the operator can see the inheritance chain before drilling. *@
    var host = Context?.Request?.Host.Host ?? string.Empty;
    PolicyScope pageScope = string.IsNullOrEmpty(host)
        ? PolicyScope.Wildcard()
        : PolicyScope.Domain(host);
    var policyRowsUrl = DashboardLinks.Resolve($"/policystack/rows?scope={PolicyScopeUrl.Encode(pageScope)}&tab=effective");
    var showcaseDemo = PolicyEditAffordanceResolver.IsShowcaseDemo(Configuration);

    // Si2 (endpoint-IA unification), task 1: URL-bound filters read straight off the
    // request so a direct load of /dashboard/site?method=POST&mode=api&status=5xx is
    // already filtered on first paint -- not just after the operator clicks a chip
    // inside an already-rendered (unfiltered) list. Mirrors how the interactive
    // partials/endpoints handler (ServeEndpointsPartialAsync) reads the same query
    // keys for the hx-get follow-up requests.
    var q = Context?.Request?.Query;
    string? QueryOrNull(string key) => q?[key].FirstOrDefault() is { Length: > 0 } v ? v : null;

    // Umami-style analytics assembly (operator directive 2026-08-11): summary cards +
    // bot-vs-human series above the endpoints control. Same window resolution as the
    // component's parameter-driven reads (?window= or the 24h dashboard default) so all
    // three surfaces agree. Existing widgets only — no new ones.
    var analyticsWindow = QueryOrNull("window") ?? "24h";
    var analyticsEnd = DateTime.UtcNow;
    var analyticsSpan = analyticsWindow switch
    {
        "15m" => TimeSpan.FromMinutes(15),
        "60m" or "1h" => TimeSpan.FromHours(1),
        "6h" => TimeSpan.FromHours(6),
        "12h" => TimeSpan.FromHours(12),
        "7d" => TimeSpan.FromDays(7),
        "30d" => TimeSpan.FromDays(30),
        _ => TimeSpan.FromHours(24),
    };
    var analyticsStart = analyticsEnd - analyticsSpan;
    TrafficTimeseries timeseries;
    try
    {
        var bucket = HitsPerPeriodChartletBuilder.BucketSizeForWindow(analyticsWindow);
        var points = await EventStore.GetTimeSeriesAsync(
            analyticsStart, analyticsEnd, bucket, audienceFilter: null, domains: null);
        timeseries = HitsPerPeriodChartletBuilder.BuildSeries(points, analyticsStart, analyticsEnd, bucket);
    }
    catch
    {
        timeseries = new TrafficTimeseries([], [], [], []);
    }
}
@* sb:summary-update listener (commercial scope bar): the commercial range/domain
   bar posts via hx-post and the controller replies HX-Trigger: sb:summary-update.
   The middleware's IsPartialSwapRequest branch serves ONLY this row's content for
   that hx-get, and DashboardScopeBaselineMiddleware rewrites ?window= from the new
   cookie before the FOSS middleware runs — so the swapped content reflects the new
   window without a full page reload (same mechanism as Traffic's #sb-traffic-body). *@
<section data-dashboard-page="site"
         id="sb-site-body"
         hx-get="@(Context.Request.Path + Context.Request.QueryString)"
         hx-trigger="sb:summary-update from:body"
         hx-target="this"
         hx-swap="outerHTML" @(showcaseDemo ? "data-showcase-readonly=true" : "")>
    @if (showcaseDemo)
    {
        @* Showcase-demo surface renders the SAME interactive control the licensed
           dashboard renders (data-action="toggle-pin-form" reveals the pin form,
           client-side), not a disabled stub -- a prospect must be able to OPEN it.
           The pin SAVE (POST /api/endpoint-pins) is a commercial-gated write and
           stays server-refused, so revealing the form here grants no write. *@
        <aside class="sb-showcase-readonly-notice mb-4" data-showcase-readonly data-control-readonly="true" role="note">
            <span>Showcase demo: explore the controls. Saving requires a licensed dashboard.</span>
            <button type="button" class="btn btn-sm" data-action="toggle-pin-form" data-showcase-readonly-control
                    aria-label="Pin endpoint">Pin endpoint</button>
        </aside>
    }
@* Si2 (endpoint-IA unification), task 4: single-column host for the canonical
   SbEndpointsList control. The right-hand #endpoint-detail-panel sticky column
   and its accompanying deep-link <script> (which re-triggered an htmx click
   against ?selected=METHOD|PATH on load) are retired now that a row click is a
   real navigation to {basePath}/endpoint/{method}/{path} -- the browser's own
   back/forward + address bar are the deep-link mechanism, no client-side
   re-triggering needed. *@
<div class="grid grid-cols-1 gap-4">
    @* Umami-style per-site analytics (operator directive 2026-08-11): summary cards +
       bot-vs-human series, then the endpoints control. Existing widgets only. *@
    <sb-summary-stats range="@analyticsWindow" />
    <div class="card bg-base-100">
        <div class="card-body p-4">
            <h2 class="text-sm font-semibold mb-2">Traffic &mdash; bot vs human over time</h2>
            @await Html.PartialAsync("~/Views/StyloBot/Dashboard/Traffic/_TimeseriesChart.cshtml", timeseries)
        </div>
    </div>

    @* Range drives SbEndpointsList's parameter-driven branch (the same feed the Traffic
       page's control takes — the middleware-seeded first-paint reader / windowed store
       read) instead of the cache/legacy branch that rendered "Warming up" on a cold
       SWR key (2026-08-11 P0). Defaults to the dashboard's 24h window when ?window=
       is absent, matching BuildVisitorsPageWindow's default so the seeded bundle and
       the requested window agree. *@
    <sb-endpoints-list path="@QueryOrNull("path")"
                       method="@QueryOrNull("method")"
                       mode="@QueryOrNull("mode")"
                       status="@QueryOrNull("status")"
                       threat="@QueryOrNull("threat")"
                       bot-pressure="@QueryOrNull("bot_pressure")"
                       range="@(QueryOrNull("window") ?? "24h")" />
    @* Lazy-loaded host-scoped policy stack. <details>/hx-get pattern lets
       operators open it without paying the render cost up-front. The
       sibling marker classes are what the integration smoke tests grep
       for. *@
    <details class="dashboard-endpoint-policy mt-4" data-endpoint="@host">
        <summary class="cursor-pointer text-xs font-semibold text-base-content/60 hover:text-base-content/80 py-2 px-3 rounded-lg border"
                 style="border-color: var(--sb-card-border); background: var(--sb-card-bg);">
            Show effective policy stack for this site
        </summary>
        <div class="lazy-policy-stack mt-2"
             hx-get="@policyRowsUrl"
             hx-trigger="toggle once from:closest details[open]"
             hx-swap="innerHTML"
             hx-target="this">
            <em class="text-xs text-base-content/40">Loading policy…</em>
        </div>
    </details>
</div>
</section>
