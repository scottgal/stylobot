@using Microsoft.Extensions.DependencyInjection
@using Mostlylucid.BotDetection.PrometheusPack.Telemetry
@model DashboardShellModel
@{
    // /dashboard/insights -- global meter inventory vm (B1).
    //
    // Mini-grafana index: one row per published meter, with a small sparkline
    // column driven by the window selector. Filter strip is a plain
    // <form method="get"> so SSR-only renders the same surface regardless of
    // whether HTMX is loaded (per feedback_ssr_signalr_pattern).
    //
    // The vm model is built per-request via InsightsPageBuilder; both the
    // builder and IMeterStream resolve as optional services so a host that
    // never called AddPrometheusPack (and has no meter source) gets a friendly
    // "telemetry not configured" stub instead of a DI throw.
    var basePath = Model.BasePath;
    var meterStream = Context.RequestServices.GetService<IMeterStream>();
    var builder = Context.RequestServices.GetService<InsightsPageBuilder>();

    var q = Context.Request.Query;
    string? Get(string key)
    {
        var v = q[key].ToString();
        return string.IsNullOrWhiteSpace(v) ? null : v;
    }
    int? GetInt(string key)
    {
        var v = q[key].ToString();
        return int.TryParse(v, out var n) ? n : null;
    }

    InsightsPageViewModel? vm = null;
    if (meterStream is not null && builder is not null)
    {
        vm = await builder.BuildAsync(
            meterStream,
            kind:       Get("kind"),
            @namespace: Get("namespace"),
            query:      Get("q"),
            sort:       Get("sort"),
            window:     Get("window"),
            buckets:    GetInt("buckets"),
            ct:         Context.RequestAborted);
    }

    string FacetHref(string param, string? value, bool selected)
    {
        var pairs = q.Where(p => !string.Equals(p.Key, param, StringComparison.OrdinalIgnoreCase))
                     .Select(p => $"{Uri.EscapeDataString(p.Key)}={Uri.EscapeDataString(p.Value.ToString())}")
                     .ToList();
        // A "selected" chip clears the filter on click; an unselected chip sets it.
        if (!selected && !string.IsNullOrEmpty(value))
            pairs.Add($"{Uri.EscapeDataString(param)}={Uri.EscapeDataString(value)}");
        var qs = pairs.Count == 0 ? "" : "?" + string.Join('&', pairs);
        return $"{basePath}/insights{qs}";
    }
}

<section class="sb-insights space-y-4" data-insights-vm>
    @* Page header: title + subtitle in the same card-shell pattern the rest of
       the dashboard uses. Spans full width so the filter band slots in below. *@
    <div class="card bg-base-100 shadow-sm rounded-xl border border-base-300">
        <div class="card-body p-4 md:p-6">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
                <div>
                    <h2 class="card-title text-lg">Insights</h2>
                    <p class="text-sm text-base-content/70 mt-1">
                        Every meter the gateway is currently publishing.
                    </p>
                </div>
                @if (vm is not null)
                {
                    <div class="text-xs text-base-content/60">
                        <span class="badge badge-ghost badge-sm">@vm.FilteredMeterCount of @vm.TotalMeterCount meters</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (vm is null)
    {
        <div class="card bg-base-100 shadow-sm rounded-xl border border-base-300">
            <div class="card-body p-6 text-center">
                <i class="bx bx-info-circle text-2xl text-base-content/40 mx-auto mb-2"></i>
                <p class="text-sm text-base-content/70">
                    Telemetry source is not configured on this host. Add
                    <code class="px-1 py-0.5 rounded bg-base-200 text-xs">AddPrometheusPack(...)</code>
                    to enable the meter inventory.
                </p>
            </div>
        </div>
    }
    else
    {
        var f = vm.Filters;
        @* Filter strip wrapped in a card. Each axis (search/kind/namespace/window/sort)
           is a labeled mini-block; the submit row pins to the right. *@
        <form method="get" action="@basePath/insights"
              class="card bg-base-100 shadow-sm rounded-xl border border-base-300 sb-insights__filters">
            <div class="card-body p-4 md:p-5">
                <div class="flex flex-wrap items-end gap-4">

                    <label class="flex flex-col gap-1 flex-1 min-w-[200px]">
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-base-content/60">Search</span>
                        <input type="text"
                               name="q"
                               value="@(f.Query ?? "")"
                               placeholder="Filter by name substring..."
                               class="input input-bordered input-sm w-full"
                               autocomplete="off"
                               data-insights-q />
                    </label>

                    <div class="flex flex-col gap-1">
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-base-content/60">Kind</span>
                        <div class="flex flex-wrap gap-1" data-insights-kinds>
                            @foreach (var facet in vm.KindFacets)
                            {
                                var href = FacetHref("kind", facet.Value, facet.Selected);
                                var cls = facet.Selected
                                    ? "badge badge-sm badge-primary gap-1"
                                    : "badge badge-sm badge-ghost gap-1";
                                <a href="@href" class="@cls" data-insights-chip="kind" data-value="@facet.Value">
                                    @facet.Label
                                    <span class="opacity-60">@facet.Count</span>
                                </a>
                            }
                        </div>
                    </div>

                    @if (vm.NamespaceFacets.Count > 0)
                    {
                        <div class="flex flex-col gap-1">
                            <span class="text-[11px] font-semibold uppercase tracking-wider text-base-content/60">Namespace</span>
                            <div class="flex flex-wrap gap-1" data-insights-namespaces>
                                @foreach (var facet in vm.NamespaceFacets)
                                {
                                    var href = FacetHref("namespace", facet.Value, facet.Selected);
                                    var cls = facet.Selected
                                        ? "badge badge-sm badge-primary gap-1"
                                        : "badge badge-sm badge-ghost gap-1";
                                    <a href="@href" class="@cls" data-insights-chip="namespace" data-value="@facet.Value">
                                        @facet.Label
                                        <span class="opacity-60">@facet.Count</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <div class="flex flex-col gap-1">
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-base-content/60">Window</span>
                        <div class="join">
                            @foreach (var win in new[] { "5m", "15m", "1h" })
                            {
                                var winSelected = string.Equals(win, f.Window, StringComparison.OrdinalIgnoreCase);
                                var btnCls = winSelected ? "join-item btn btn-xs btn-primary" : "join-item btn btn-xs";
                                <button type="submit"
                                        name="window"
                                        value="@win"
                                        class="@btnCls"
                                        data-insights-window="@win">@win</button>
                            }
                        </div>
                    </div>

                    <label class="flex flex-col gap-1">
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-base-content/60">Sort</span>
                        <select name="sort" class="select select-bordered select-sm" onchange="this.form.submit()" data-insights-sort>
                            <option value="name"         selected="@(f.Sort == "name")">Name</option>
                            <option value="kind"         selected="@(f.Sort == "kind")">Kind</option>
                            <option value="current_desc" selected="@(f.Sort == "current_desc")">Current (high to low)</option>
                            <option value="current_asc"  selected="@(f.Sort == "current_asc")">Current (low to high)</option>
                        </select>
                    </label>

                    @* Persist non-active fields across submissions so a window-button submit
                       doesn't blow away the user's namespace / kind selection. The chip
                       anchors above already round-trip via their own hrefs; the form keeps
                       the typed query, the sort dropdown choice, and the buckets value. *@
                    @if (!string.IsNullOrEmpty(f.Kind))
                    {
                        <input type="hidden" name="kind" value="@f.Kind" />
                    }
                    @if (!string.IsNullOrEmpty(f.Namespace))
                    {
                        <input type="hidden" name="namespace" value="@f.Namespace" />
                    }
                    <input type="hidden" name="buckets" value="@f.Buckets" />

                    <div class="flex gap-2 ml-auto">
                        <button type="submit" class="btn btn-primary btn-sm" data-insights-apply>Apply</button>
                        <a href="@basePath/insights" class="btn btn-ghost btn-sm">Reset</a>
                    </div>
                </div>
            </div>
        </form>

        @* Meter table -- wrapped in a card with overflow-x-auto so wide rows
           scroll instead of pushing the page. SbMeterTable carries its own
           empty-state when Rows.Count == 0. *@
        <div class="card bg-base-100 shadow-sm rounded-xl border border-base-300">
            <div class="card-body p-4 md:p-5">
                <div class="overflow-x-auto">
                    @await Component.InvokeAsync("SbMeterTable", new { model = vm.Table })
                </div>
            </div>
        </div>

        <footer class="text-xs text-base-content/60 text-right">
            @vm.FilteredMeterCount of @vm.TotalMeterCount meters
        </footer>
    }
</section>
