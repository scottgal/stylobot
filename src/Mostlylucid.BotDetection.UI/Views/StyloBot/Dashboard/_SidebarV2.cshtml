@using Mostlylucid.BotDetection.UI.Models
@using Mostlylucid.BotDetection.UI.Services
@model DashboardShellModel
@inject INavVisibilityPolicy NavVisibility
@{
    var bp = Model.BasePath;
    var currentPath = Context.Request.Path.Value ?? string.Empty;

    bool IsActivePath(string suffix)
    {
        var prefix = bp.TrimEnd('/') + "/" + suffix.TrimStart('/');
        return currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    }

    string rowClass(bool on) => on
        ? "block px-3 py-1.5 text-xs font-semibold border-l-4 border-primary bg-base-200 text-base-content"
        : "block px-3 py-1.5 text-xs border-l-4 border-transparent text-base-content/60 hover:text-base-content hover:bg-base-200/50";
}
<nav id="sb-left-nav" class="w-56 shrink-0 bg-base-100 border-r border-base-300 sticky top-0 self-start h-screen overflow-y-auto py-3"
     aria-label="Dashboard navigation">

    @* One primary entry: Traffic is the dashboard. Everything else is a deeper
       surface and lives under Advanced, which stays a real, labelled, keyboard-
       operable group rather than a second competing nav. Deep URLs are unchanged. *@
    <div class="mb-1">
        @if (NavVisibility.IsVisible("traffic", Model.IsPrivilegedViewer))
        {
            <a href="@bp/traffic" class="@rowClass(IsActivePath("traffic"))">Traffic</a>
        }
    </div>

    <details class="sb-nav-advanced">
        <summary class="px-3 py-1.5 text-xs font-semibold text-base-content/60 hover:text-base-content cursor-pointer">
            Advanced
        </summary>
        <div class="mt-1">
            @if (NavVisibility.IsVisible("visitors", Model.IsPrivilegedViewer))
            {
                <a href="@bp/visitors" class="@rowClass(IsActivePath("visitors"))">Visitors</a>
            }
            @if (NavVisibility.IsVisible("site", Model.IsPrivilegedViewer))
            {
                <a href="@bp/site" class="@rowClass(IsActivePath("site"))">Site and endpoints</a>
            }

            @* Packs: every registered IDashboardPack with its sub-nav. Rendered
               statically (no client state) so the group works without script. *@
            @foreach (var pack in Model.Packs)
            {
                if (!NavVisibility.IsVisible(pack.Id, Model.IsPrivilegedViewer)) { continue; }
                var packActive = IsActivePath(pack.Id);
                var firstSub = pack.SubRows.Count > 0 ? pack.SubRows[0].Id : null;
                var headerHref = firstSub is null ? $"{bp}/{pack.Id}" : $"{bp}/{pack.Id}/{firstSub}";
                <a href="@headerHref" class="@rowClass(packActive)"><i class="@pack.Icon mr-1.5"></i>@pack.Label</a>
                foreach (var sub in pack.SubRows)
                {
                    if (!NavVisibility.IsVisible($"{pack.Id}/{sub.Id}", Model.IsPrivilegedViewer)) { continue; }
                    <a href="@bp/@pack.Id/@sub.Id" class="@rowClass(IsActivePath($"{pack.Id}/{sub.Id}")) pl-7">@sub.Label</a>
                }
            }

            @if (NavVisibility.IsVisible("policies", Model.IsPrivilegedViewer))
            {
                <a href="@bp/policies" class="@rowClass(IsActivePath("policies"))">Policies</a>
            }
            @if (NavVisibility.IsVisible("configuration", Model.IsPrivilegedViewer))
            {
                <a href="@bp/configuration" class="@rowClass(IsActivePath("configuration"))">Configuration</a>
            }
            @if (NavVisibility.IsVisible("compliance", Model.IsPrivilegedViewer))
            {
                <a href="@bp/compliance" class="@rowClass(IsActivePath("compliance"))">Compliance</a>
            }
        </div>
    </details>
</nav>
