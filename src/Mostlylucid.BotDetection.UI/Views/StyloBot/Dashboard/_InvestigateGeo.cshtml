@using Mostlylucid.BotDetection.UI.Services
@model Mostlylucid.BotDetection.UI.Models.InvestigationViewModel
@{
    string FlagUrl(string code) => $"/_content/Mostlylucid.BotDetection.UI/flags/{code.ToLowerInvariant()}.svg";
}

@*
    Cloudflare-style geo cards: flag + demonym + bot:human ratio strip so the
    bot share reads visually instead of as "27 bots / 14 human" text math.
    Risk-band severity bars stay consistent with the other Investigate panels.
*@

<div class="sb-investigate-geo grid gap-2"
     style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
    @foreach (var c in Model.Result.CountryBreakdown)
    {
        // Two-letter country CODE, not the adjective ("US", not "American").
        // Dashboard-wide convention: codes everywhere user-visible, no demonyms.
        var demonym = c.CountryCode?.ToUpperInvariant() ?? "??";
        var humanCount = Math.Max(0, c.Count - c.BotCount);
        var botPct = c.Count > 0 ? (int)Math.Round(100.0 * c.BotCount / c.Count) : 0;
        var riskColor = BotDisplayHelpers.ColorForRiskBand(c.DominantRiskBand);
        var riskBars = Math.Max(1, BotDisplayHelpers.RiskSeverity(c.DominantRiskBand));

        <div class="card bg-base-200 border border-base-300 hover:border-primary/40 transition-colors cursor-pointer"
             hx-get="@Model.BasePath/investigate?type=country&value=@c.CountryCode"
             hx-target="#investigate-view"
             hx-swap="outerHTML transition:true">
            <div class="card-body p-3 gap-2">
                <!-- ROW 1: flag + demonym + total count -->
                <div class="flex items-center gap-2 min-w-0">
                    <img src="@FlagUrl(c.CountryCode)" alt="@c.CountryCode" class="w-5 h-4 rounded-sm flex-shrink-0" loading="lazy" />
                    <span class="font-semibold text-sm truncate" title="@c.CountryCode">@demonym</span>
                    <span class="ml-auto text-sm font-bold tabular-nums" title="@c.Count detections">@c.Count</span>
                </div>

                <!-- ROW 2: bot:human ratio bar -->
                <div class="flex items-center gap-2" title="@c.BotCount bots / @humanCount human">
                    <div class="flex-1 h-1.5 bg-base-content/10 rounded-full overflow-hidden flex">
                        <div class="h-full bg-error" style="width: @botPct%"></div>
                        <div class="h-full bg-success" style="width: @(100 - botPct)%"></div>
                    </div>
                    <span class="text-[10px] tabular-nums text-base-content/60 w-10 text-right">@botPct% bot</span>
                </div>

                <!-- ROW 3: risk severity (only when we have a band) -->
                @if (!string.IsNullOrEmpty(c.DominantRiskBand))
                {
                    <div class="flex items-center gap-0.5" title="Risk Profile: @c.DominantRiskBand">
                        @for (var i = 0; i < 5; i++)
                        {
                            var filled = i < riskBars;
                            <span class="inline-block w-1 rounded-sm @(filled ? riskColor : "text-base-content/15")"
                                  style="height: @((i + 2) * 2)px; background: currentColor;"></span>
                        }
                        <span class="text-[10px] font-semibold uppercase tracking-wider @riskColor ml-1">@c.DominantRiskBand</span>
                    </div>
                }
            </div>
        </div>
    }
    @if (!Model.Result.CountryBreakdown.Any())
    {
        <p class="col-span-full text-center text-sm text-base-content/40 py-8">
            <i class="bx bx-world text-2xl block mb-2 opacity-50"></i>
            No country data in this result set.
        </p>
    }
</div>
