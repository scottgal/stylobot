@using Mostlylucid.BotDetection.UI.Models
@model LicenseCardModel
@*
    FOSS license card = small upsell link only. FOSS builds have no license
    concept (moved to Stylobot.Commercial.Licensing); this partial just points
    to the pricing page so operators know a paid tier exists. Commercial ships
    its own partial view that shadows this one via view-location precedence
    and renders the full status card.
*@
<div class="rounded-lg border border-base-300 bg-base-100 px-4 py-3 text-sm text-base-content/70 flex items-center justify-between">
    <span class="opacity-70">FOSS build — all detectors active.</span>
    <a href="@Model.UpsellUrl" target="_blank" rel="noopener" class="link link-primary link-hover text-xs">
        @Model.UpsellLabel →
    </a>
</div>