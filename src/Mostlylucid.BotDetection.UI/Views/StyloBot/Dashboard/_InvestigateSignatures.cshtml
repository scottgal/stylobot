@using Mostlylucid.BotDetection.UI.Services
@model Mostlylucid.BotDetection.UI.Models.InvestigationViewModel

@*
    Cloudflare-style consolidated signature row (stage 1).
    Icons + colour replace text-heavy badges; horizontal probability bar replaces the raw
    "high/medium/low" label; a single threat icon replaces the small text pill. Sparkline
    column (HitCount history) lands in stage 2 once the per-signature time series is plumbed
    into SignatureSummary -- placeholder dot for now so the layout reads correctly.
*@

<div class="sb-investigate-signatures grid gap-2"
     style="grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));">
    @foreach (var sig in Model.Result.Signatures)
    {
        var displayName = sig.BotName ?? (sig.PrimarySignature?.Length > 16
            ? sig.PrimarySignature[..16] + "…"
            : sig.PrimarySignature) ?? "(unknown)";
        var typeIcon = BotDisplayHelpers.IconForBotType(sig.BotType);
        var categoryClass = BotDisplayHelpers.CategoryBadgeClass(sig.BotType);
        var riskColor = BotDisplayHelpers.ColorForRiskBand(sig.RiskBand);
        var riskSev = BotDisplayHelpers.RiskSeverity(sig.RiskBand);
        var riskBars = Math.Max(1, riskSev);
        var lastSeen = BotDisplayHelpers.TimeAgoCompact(sig.LastSeen);
        var hitsText = sig.HitCount >= 1000 ? $"{sig.HitCount / 1000.0:F1}k" : sig.HitCount.ToString();

        <div class="card bg-base-200 border border-base-300 hover:border-primary/40 transition-colors cursor-pointer"
             hx-get="@Model.BasePath/investigate?type=signature&value=@sig.PrimarySignature"
             hx-target="#investigate-view"
             hx-swap="outerHTML transition:true">
            <div class="card-body p-3 gap-2">
                <!-- ROW 1: identity (icon + name + verified tick) | category | last seen -->
                <div class="flex items-center gap-2 min-w-0">
                    <i class="@typeIcon text-base text-base-content/70" aria-hidden="true"></i>
                    <span class="font-semibold text-sm truncate" title="@(sig.BotName ?? sig.PrimarySignature)">@displayName</span>
                    @if (sig.IsKnownBot)
                    {
                        <i class="bx bxs-check-shield text-success text-sm" title="Verified known bot"></i>
                    }
                    @if (!string.IsNullOrEmpty(sig.BotType))
                    {
                        <span class="text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded @categoryClass">
                            @sig.BotType
                        </span>
                    }
                    <span class="ml-auto text-[10px] text-base-content/40 whitespace-nowrap">@lastSeen</span>
                </div>

                <!-- ROW 2: risk severity (icon bars) | hit count | sparkline placeholder -->
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-0.5" title="Risk: @sig.RiskBand">
                        @for (var i = 0; i < 5; i++)
                        {
                            var filled = i < riskBars;
                            <span class="inline-block w-1 rounded-sm @(filled ? riskColor : "text-base-content/15")"
                                  style="height: @((i + 2) * 2)px; background: currentColor;"></span>
                        }
                        <span class="text-[10px] font-semibold uppercase tracking-wider @riskColor ml-1">@sig.RiskBand</span>
                    </div>
                    <div class="flex items-baseline gap-1 ml-auto" title="@sig.HitCount detections">
                        <span class="text-sm font-bold text-base-content tabular-nums">@hitsText</span>
                        <span class="text-[10px] text-base-content/40">hits</span>
                    </div>
                    <!-- Sparkline placeholder (stage 2 will plumb HitHistory through SignatureSummary).
                         A flat dot keeps the column reserved so stage 2 lands without a layout shift. -->
                    <div class="w-16 h-4 flex items-center justify-center" aria-hidden="true">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-content/20"></span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(sig.UaFamily))
                {
                    <!-- ROW 3 (optional): UA family as small footer, only when it adds info -->
                    <div class="text-[10px] text-base-content/50 truncate" title="@sig.UaFamily">
                        <i class="bx bx-laptop align-middle"></i> @sig.UaFamily
                    </div>
                }
            </div>
        </div>
    }
    @if (!Model.Result.Signatures.Any())
    {
        <p class="col-span-full text-center text-sm text-base-content/40 py-8">
            <i class="bx bx-search text-2xl block mb-2 opacity-50"></i>
            No distinct signatures in this result set.
        </p>
    }
</div>
