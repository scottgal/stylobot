@using Mostlylucid.BotDetection.UI.Services
@model Mostlylucid.BotDetection.UI.Models.InvestigationViewModel
@inject SignatureAggregateCache AggregateCache

@*
    Cloudflare-style consolidated signature row (stage 1 + stage 2).

    Stage 1: icons + colour replace text-heavy badges; horizontal risk-severity bars
    replace the raw "high/medium/low" label; verified tick + category pill carry the
    classification at-a-glance.

    Stage 2: inline SVG sparkline rendered from SignatureAggregateCache.GetSparkline
    for each row -- the cache already holds a per-signature rolling bot-probability
    history, so the temporal series surfaces here without a new data path or new DB
    query. The cache is injected at render time; misses fall through to the placeholder
    dot so the column never shifts the layout while data warms.
*@

@functions {
    // Render a sparkline polyline from a series of values in [0,1].
    // Inline so a missing cache entry doesn't cost a partial render -- caller passes
    // null when the series is unavailable.
    string SparklinePoints(IReadOnlyList<double> values, int width, int height)
    {
        if (values == null || values.Count < 2) return string.Empty;
        var minVal = double.MaxValue;
        var maxVal = double.MinValue;
        foreach (var v in values) { if (v < minVal) minVal = v; if (v > maxVal) maxVal = v; }
        var range = maxVal - minVal;
        if (range <= 0) range = 1; // flat line - keep it centred
        var step = values.Count == 1 ? 0d : (double)width / (values.Count - 1);
        var pts = new System.Text.StringBuilder();
        for (var i = 0; i < values.Count; i++)
        {
            var x = i * step;
            var y = height - ((values[i] - minVal) / range) * height;
            if (i > 0) pts.Append(' ');
            pts.Append($"{x:F1},{y:F1}");
        }
        return pts.ToString();
    }
}

<div class="sb-investigate-signatures grid gap-2"
     style="grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));">
    @foreach (var sig in Model.Result.Signatures)
    {
        var displayName = SignatureDisplayName.Resolve(
            sig.PrimarySignature,
            sig.BotName,
            sig.BotType,
            customLabel: null,
            countryCode: null,
            isBot: sig.IsKnownBot,
            uaFamily: sig.UaFamily,
            seen: null,
            userAgent: null);
        var typeIcon = BotDisplayHelpers.IconForBotType(sig.BotType);
        var categoryClass = BotDisplayHelpers.CategoryBadgeClass(sig.BotType);
        var riskColor = BotDisplayHelpers.ColorForRiskBand(sig.RiskBand);
        var riskSev = BotDisplayHelpers.RiskSeverity(sig.RiskBand);
        var riskBars = Math.Max(1, riskSev);
        var lastSeen = BotDisplayHelpers.TimeAgoCompact(sig.LastSeen);
        var hitsText = sig.HitCount >= 1000 ? $"{sig.HitCount / 1000.0:F1}k" : sig.HitCount.ToString();

        <div class="card bg-base-200 border border-base-300 hover:border-primary/40 transition-colors cursor-pointer"
             hx-get="@Model.BasePath/investigate?type=signature&value=@sig.PrimarySignature"
             hx-target="#investigate-view"
             hx-swap="outerHTML transition:true">
            <div class="card-body p-3 gap-2">
                <!-- ROW 1: identity (icon + name + verified tick) | category | last seen -->
                <div class="flex items-center gap-2 min-w-0">
                    <i class="@typeIcon text-base text-base-content/70" aria-hidden="true"></i>
                    <span class="font-semibold text-sm truncate" title="@(sig.BotName ?? sig.PrimarySignature)">@displayName</span>
                    @if (sig.IsKnownBot)
                    {
                        <i class="bx bxs-check-shield text-success text-sm" title="Verified known bot"></i>
                    }
                    @if (!string.IsNullOrEmpty(sig.BotType))
                    {
                        <span class="text-[10px] uppercase tracking-wider font-semibold px-1.5 py-0.5 rounded @categoryClass">
                            @sig.BotType
                        </span>
                    }
                    <span class="ml-auto text-[10px] text-base-content/40 whitespace-nowrap">@lastSeen</span>
                </div>

                <!-- ROW 2: risk severity (icon bars) | hit count | sparkline placeholder -->
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-0.5" title="Risk Profile: @sig.RiskBand">
                        @for (var i = 0; i < 5; i++)
                        {
                            var filled = i < riskBars;
                            <span class="inline-block w-1 rounded-sm @(filled ? riskColor : "text-base-content/15")"
                                  style="height: @((i + 2) * 2)px; background: currentColor;"></span>
                        }
                        <span class="text-[10px] font-semibold uppercase tracking-wider @riskColor ml-1">@sig.RiskBand</span>
                    </div>
                    <div class="flex items-baseline gap-1 ml-auto" title="@sig.HitCount detections">
                        <span class="text-sm font-bold text-base-content tabular-nums">@hitsText</span>
                        <span class="text-[10px] text-base-content/40">hits</span>
                    </div>
                    <!-- Sparkline: per-signature bot-probability series from SignatureAggregateCache.
                         Rendered inline so we never block on a sparkline data fetch -- if the cache
                         has no series for this signature (warmup-cold) we drop a placeholder dot. -->
                    @{
                        var sparkValues = AggregateCache?.GetSparkline(sig.PrimarySignature);
                        var sparkPoints = sparkValues != null ? SparklinePoints(sparkValues, 56, 14) : null;
                        var sparkColor = sig.RiskBand switch
                        {
                            "VeryHigh" or "Critical" or "High" => "var(--sb-signal-danger, #ef4444)",
                            "Elevated" or "Medium"             => "var(--sb-signal-warn, #f59e0b)",
                            _                                   => "var(--sb-signal-pos, #22c55e)"
                        };
                    }
                    <div class="w-16 h-4 flex items-center justify-center" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(sparkPoints))
                        {
                            <svg viewBox="0 0 56 14" width="56" height="14" xmlns="http://www.w3.org/2000/svg" class="overflow-visible">
                                <polyline points="@sparkPoints" fill="none" stroke="@sparkColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                        else
                        {
                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-base-content/20"></span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(sig.UaFamily))
                {
                    <!-- ROW 3 (optional): UA family as small footer, only when it adds info -->
                    <div class="text-[10px] text-base-content/50 truncate" title="@sig.UaFamily">
                        <i class="bx bx-laptop align-middle"></i> @sig.UaFamily
                    </div>
                }
            </div>
        </div>
    }
    @if (!Model.Result.Signatures.Any())
    {
        <p class="col-span-full text-center text-sm text-base-content/40 py-8">
            <i class="bx bx-search text-2xl block mb-2 opacity-50"></i>
            No distinct signatures in this result set.
        </p>
    }
</div>