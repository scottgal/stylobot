@using Mostlylucid.BotDetection.UI.Controllers
@using Mostlylucid.BotDetection.UI.Models
@using System.Text.Json
@model VisitorsPageModel
@{
    ViewData["Title"] = "Visitors";
}

@{
    // The period selector owns ?window= (scope-bar cookie -> baseline middleware);
    // strip any baked window so the swap target follows the CURRENT selection.
    string RefreshHref()
    {
        var qs = System.Web.HttpUtility.ParseQueryString(Context.Request.QueryString.Value ?? "");
        qs.Remove("window");
        return Context.Request.Path + (qs.Count == 0 ? "" : "?" + qs.ToString());
    }
}

@*
    Visitors overview page — repurposed components:
    1. Top: accurate summary row (_TrafficCounters) — full width
    2. Below: two-column grid
       - LEFT: visitor list (SbVisitorList) with filters
       - RIGHT: stacked with signature shapes + world map

    sb:summary-update listener (commercial scope bar): the commercial range/domain
    bar posts via hx-post and the controller replies HX-Trigger: sb:summary-update.
    The middleware's IsPartialSwapRequest branch serves ONLY this row's content for
    that hx-get (the same P0-fix mechanism #sb-traffic-body uses), and the
    DashboardScopeBaselineMiddleware rewrites ?window= from the new cookie before
    the FOSS middleware runs — so the swapped content reflects the new window
    without a full page reload. Explicit ?window= in the URL (local pills) still
    wins, matching the baseline middleware's documented precedence.
*@
<section class="space-y-4"
         id="sb-visitors-body"
         hx-get="@RefreshHref()"
         hx-trigger="sb:summary-update from:body"
         hx-target="this"
         hx-swap="outerHTML">
    <header class="flex items-center justify-between flex-wrap gap-2">
        <h2 class="text-lg font-semibold">Visitors</h2>
    </header>

    @* Row 1: Accurate summary *@
    @if (Model.Counters is not null)
    {
        @await Html.PartialAsync("/Views/StyloBot/Dashboard/Traffic/_TrafficCounters.cshtml", Model.Counters)
    }

    @* Row 2: Two-column layout *@
    <div class="grid grid-cols-3 gap-4">
        @* LEFT: Visitor list (2/3 width) *@
        <div class="col-span-2">
            @await Component.InvokeAsync("SbVisitorList", new {
                filter      = Model.Filter,
                country     = Model.Country,
                botType     = Model.BotType,
                threat      = Model.Threat,
                fingerprintId = Model.FingerprintId,
                @internal   = Model.Internal
            })
        </div>

        @* RIGHT: Signature shapes + world map (1/3 width, stacked) *@
        <div class="space-y-4">
            @* Representative bot/human shapes use the canonical Your Detection
               renderer so this overview cannot drift back to bespoke triangles. *@
            <div class="card bg-base-100 border border-base-300">
                <div class="card-body p-3">
                    <div class="text-xs font-bold text-base-content mb-2">Signature Patterns</div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <div class="text-[9px] text-center text-base-content/60">Bot</div>
                            @await Html.PartialAsync("/Views/StyloBot/Dashboard/_YourDetection.cshtml",
                                new YourDetectionModel {
                                    HasData = true, IsBot = true, BotProbability = 0.95,
                                    Confidence = 0.9, RiskBand = "High", ThreatScore = 80,
                                    BasePath = "/dashboard", UaFamily = "Representative bot",
                                    ClockAxes = new[] { 0.9, 0.8, 0.7, 0.85, 0.75, 0.9, 0.8, 0.7, 0.85, 0.9, 0.8, 0.75 },
                                    Compact = true
                                })
                        </div>
                        <div>
                            <div class="text-[9px] text-center text-base-content/60">Human</div>
                            @await Html.PartialAsync("/Views/StyloBot/Dashboard/_YourDetection.cshtml",
                                new YourDetectionModel {
                                    HasData = true, IsBot = false, BotProbability = 0.08,
                                    Confidence = 0.92, RiskBand = "Low", ThreatScore = 5,
                                    BasePath = "/dashboard", UaFamily = "Representative browser",
                                    ClockAxes = new[] { 0.25, 0.35, 0.65, 0.2, 0.4, 0.15, 0.3, 0.25, 0.45, 0.1, 0.15, 0.5 },
                                    Compact = true
                                })
                        </div>
                    </div>
                </div>
            </div>

            @* World map (reused from Traffic/_TrafficPanels) *@
            @if (Model.Countries is not null && Model.Countries.Count > 0)
            {
                <div class="card bg-base-100 border border-base-300">
                    <div class="card-body p-3">
                        <div class="text-xs font-bold text-base-content mb-2">By Country</div>
                        @{
                            var countriesJson = JsonSerializer.Serialize(
                                Model.Countries.Select(c => new
                                {
                                    countryCode = c.CountryCode,
                                    hits = c.TotalCount,
                                    botRate = c.BotRate
                                }));
                        }
                        <div id="countries-map-visitors" data-countries="@countriesJson" style="width:100%;height:140px;"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@* The map init script MUST be a plain inline <script>, not @section Scripts --
   this view is always rendered as a nested Html.PartialAsync (via _Visitors.cshtml
   -> Visitors/Index.cshtml, itself invoked from the row-registry dispatch in the
   outer Index.cshtml shell), never as a top-level View() result. @section content
   only emits when a Layout explicitly calls RenderSectionAsync for it; nothing in
   this partial chain does, so the section was silently dropping the whole script --
   the div rendered with real data but jsVectorMap was never initialized against it. *@
<script nonce="@(Context.Items["CspNonce"] as string ?? "")">
    (function() {
        'use strict';
        // F1b (2026-08-19): the world-merc registration can MISS the final
        // jsVectorMap instance — a load-order race (the defer'd asset registers
        // on an earlier instance; verified live: addMap works on the final
        // instance but world_merc is absent → 'map not loaded'). Ensure the map
        // data is registered on THIS instance before constructing: fetch + eval
        // the vendored asset once (idempotent addMap; the dashboard CSP permits
        // unsafe-eval). The libs are loaded by the time init runs, so this only
        // re-registers the data on the live instance.
        var worldMercReady = null;
        function ensureWorldMerc() {
            if (worldMercReady) return worldMercReady;
            worldMercReady = fetch('/_content/Mostlylucid.BotDetection.UI/vendor/js/world-merc.js')
                .then(function (r) { return r.text(); })
                .then(function (code) { (0, eval)(code); });
            return worldMercReady;
        }

        function initMapFromData(containerId) {
            var el = document.getElementById(containerId);
            if (!el || typeof jsVectorMap === 'undefined') return;

            function themeVar(name, fallback) {
                var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
                return v || fallback;
            }
            var mapBase   = themeVar('--color-base-300', '#1e3a5f');
            var mapStroke = themeVar('--color-base-content', '#3b82f6');
            var mapHover  = themeVar('--color-primary', '#3b82f6');

            var countriesJson = el.getAttribute('data-countries');
            var countries = [];
            try {
                countries = JSON.parse(countriesJson || '[]');
            } catch (e) {}

            var vals = {};
            countries.forEach(function(c) {
                if (c.countryCode) vals[c.countryCode] = c.botRate || 0;
            });

            var map = new jsVectorMap({
                selector: '#' + containerId,
                map: 'world_merc',
                zoomOnScroll: true,
                zoomButtons: false,
                showTooltip: true,
                backgroundColor: 'transparent',
                regionStyle: {
                    initial:  { fill: mapBase,   stroke: mapStroke, strokeWidth: 0.5, fillOpacity: 0.55 },
                    hover:    { fill: mapHover,  fillOpacity: 0.75 },
                    selected: { fill: mapHover,  fillOpacity: 0.9 }
                },
                series: {
                    regions: [{
                        attribute: 'fill',
                        scale: { low: '#22d3ee', mid: '#f59e0b', high: '#ef4444' },
                        values: vals,
                        min: 0, max: 1,
                        normalizeFunction: 'polynomial'
                    }]
                },
                onRegionTooltipShow: function(e, tooltip, code) {
                    var regionVals = map.series.regions[0]?.values;
                    if (!regionVals) return;
                    var rate = regionVals[code];
                    if (rate !== undefined) {
                        var span = document.createElement('span');
                        span.textContent = ' - Bot rate: ' + (rate * 100).toFixed(0) + '%';
                        tooltip.selector.appendChild(span);
                    }
                }
            });
            return map;
        }

        // F1 (uxreview 2026-08-19): init on DOMContentLoaded — the site layout
        // loads jsvectormap with defer, so at inline-script parse time
        // jsVectorMap is still undefined and the silent guard above bailed
        // (the map never rendered). Defer scripts run BEFORE DOMContentLoaded,
        // so this closes the race.
        function initWhenReady() {
            var run = function () {
                ensureWorldMerc().then(function () {
                    initMapFromData('countries-map-visitors');
                }).catch(function () {
                    // The asset fetch failed (offline / blocked): fall back to the
                    // plain init — the libs' own registration may still have landed.
                    initMapFromData('countries-map-visitors');
                });
            };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', run);
            } else {
                run();
            }
        }
        initWhenReady();
    })();
</script>
