@using Mostlylucid.BotDetection.UI.Services
@model Mostlylucid.BotDetection.UI.Models.InvestigationViewModel

@*
    Cloudflare-style endpoint cards: method icon + path-category icon replace the
    bare text table. Risk-band rendered as a 5-bar severity meter (same pattern as
    _InvestigateSignatures), bot-probability shown as a thin horizontal bar so the
    "how bot-y" reads at a glance instead of forcing the eye to parse "37%".

    EndpointStat has no time-series field today, so no sparkline here -- when we
    add a per-endpoint rolling-probability buffer this is where it slots in.
*@

<div class="sb-investigate-endpoints grid gap-2"
     style="grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));">
    @foreach (var ep in Model.Result.EndpointStats)
    {
        var category = BotDisplayHelpers.CategorizePath(ep.Path);
        var catIcon = BotDisplayHelpers.IconForPathCategory(category);
        var methodIcon = BotDisplayHelpers.IconForHttpMethod(ep.Method);
        var methodColor = BotDisplayHelpers.ColorForHttpMethod(ep.Method);
        var band = ep.DominantRiskBand;
        var riskColor = BotDisplayHelpers.ColorForRiskBand(band);
        var riskBars = Math.Max(1, BotDisplayHelpers.RiskSeverity(band));
        var probPct = (int)Math.Round(ep.AvgBotProbability * 100);
        var probColor = ep.AvgBotProbability >= 0.75 ? "bg-error"
                      : ep.AvgBotProbability >= 0.50 ? "bg-warning"
                      : ep.AvgBotProbability >= 0.25 ? "bg-info"
                      : "bg-success";
        var countText = ep.Count >= 1000 ? $"{ep.Count / 1000.0:F1}k" : ep.Count.ToString();

        <div class="card bg-base-200 border border-base-300 hover:border-primary/40 transition-colors cursor-pointer"
             hx-get="@Model.BasePath/investigate?type=path&value=@ep.Path"
             hx-target="#investigate-view"
             hx-swap="outerHTML transition:true">
            <div class="card-body p-3 gap-2">
                <!-- ROW 1: method pill + path-category icon + path + hit count -->
                <div class="flex items-center gap-2 min-w-0">
                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wider @methodColor"
                          title="@ep.Method">
                        <i class="@methodIcon" aria-hidden="true"></i>@ep.Method
                    </span>
                    <i class="@catIcon text-base text-base-content/60" title="@category" aria-hidden="true"></i>
                    <span class="font-mono text-xs truncate text-base-content/80" title="@ep.Path">@ep.Path</span>
                    <span class="ml-auto text-sm font-bold tabular-nums" title="@ep.Count hits">@countText</span>
                </div>

                <!-- ROW 2: risk severity bars + bot-probability strip -->
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-0.5" title="Risk Profile: @(band ?? "Unknown")">
                        @for (var i = 0; i < 5; i++)
                        {
                            var filled = i < riskBars;
                            <span class="inline-block w-1 rounded-sm @(filled ? riskColor : "text-base-content/15")"
                                  style="height: @((i + 2) * 2)px; background: currentColor;"></span>
                        }
                        <span class="text-[10px] font-semibold uppercase tracking-wider @riskColor ml-1">@(band ?? "--")</span>
                    </div>
                    <div class="flex items-center gap-1 ml-auto min-w-0" title="Avg bot probability @probPct%">
                        <div class="w-20 h-1.5 bg-base-content/10 rounded-full overflow-hidden">
                            <div class="h-full @probColor" style="width: @probPct%"></div>
                        </div>
                        <span class="text-[10px] tabular-nums text-base-content/60 w-8 text-right">@probPct%</span>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Result.EndpointStats.Any())
    {
        <p class="col-span-full text-center text-sm text-base-content/40 py-8">
            <i class="bx bx-globe text-2xl block mb-2 opacity-50"></i>
            No endpoint traffic in this result set.
        </p>
    }
</div>
