@inherits RazorSlice<Mostlylucid.BotDetection.UI.Notifications.PasswordResetModel>
<!DOCTYPE html>
<html><body style="font-family:system-ui;color:#222;line-height:1.5;max-width:560px;margin:0 auto;padding:24px">
    <h2>Reset your @Model.SiteName password</h2>
    <p>Hi @Model.DisplayName,</p>
    <p>We received a password reset request. The link below is valid for @(Model.ValidFor.TotalHours >= 1 ? $"{Model.ValidFor.TotalHours:F0} hours" : $"{Model.ValidFor.TotalMinutes:F0} minutes"):</p>
    <p><a href="@Model.ResetUrl" style="display:inline-block;padding:10px 16px;background:#06c;color:#fff;text-decoration:none;border-radius:4px">Reset password</a></p>
    <p style="word-break:break-all;color:#555">@Model.ResetUrl</p>
    <hr style="margin:24px 0;border:none;border-top:1px solid #ddd">
    <p style="font-size:12px;color:#999">If you didn't request this, ignore this email and your password stays unchanged.</p>
</body></html>
