@inherits RazorSlice<Mostlylucid.BotDetection.UI.Notifications.MfaCodeModel>
<!DOCTYPE html>
<html><body style="font-family:system-ui;color:#222;line-height:1.5;max-width:560px;margin:0 auto;padding:24px">
    <h2>Your @Model.SiteName verification code</h2>
    <p>Hi @Model.DisplayName,</p>
    <p>Enter this code to sign in (valid for @(Model.ValidFor.TotalHours >= 1 ? $"{Model.ValidFor.TotalHours:F0} hours" : $"{Model.ValidFor.TotalMinutes:F0} minutes")):</p>
    <p style="font-size:32px;font-family:ui-monospace,monospace;letter-spacing:6px;background:#f4f4f4;padding:12px 16px;border-radius:6px;text-align:center">@Model.Code</p>
    <hr style="margin:24px 0;border:none;border-top:1px solid #ddd">
    <p style="font-size:12px;color:#999">If this wasn't you, change your password immediately and contact support.</p>
</body></html>
