<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <IsPackable>true</IsPackable>
        <EnableDefaultContentItems>false</EnableDefaultContentItems>

        <!-- Package metadata -->
        <PackageId>Mostlylucid.BotDetection.UI</PackageId>
        <MinVerTagPrefix>botdetection-v</MinVerTagPrefix>
        <Authors>Mostlylucid</Authors>
        <Description>Real-time bot detection dashboard with SignalR and DaisyUI. Includes sb-badge, sb-confidence, sb-gate, sb-honeypot, sb-human, sb-risk, sb-signal, and sb-summary Tag Helpers plus View Components for embedding detection results in ASP.NET Core views.</Description>
        <PackageTags>bot-detection;ui;dashboard;signalr;daisyui;taghelper;viewcomponent;aspnetcore;security</PackageTags>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mostlylucid.BotDetection\Mostlylucid.BotDetection.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.OpenApi\Mostlylucid.BotDetection.OpenApi.csproj" />
        <!-- IMeterStream + MeterCatalogEntry + MeterTimeSeries: source data for the
             /dashboard/insights global page (B1) and per-pack hub pages (B2-B5). The
             dashboard UI consumes the read surface only; PrometheusPack owns the data
             plane (Local + Remote stream implementations) and never references UI back. -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.PrometheusPack\Mostlylucid.BotDetection.PrometheusPack.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fluid.Core" Version="2.31.0" />
        <PackageReference Include="MailKit" Version="4.17.0" />
        <PackageReference Include="Markdig" Version="1.3.2" />
        <PackageReference Include="Mostlylucid.Notify" Version="0.1.1" />
        <PackageReference Include="mostlylucid.ephemeral" Version="2.9.1" />
        <PackageReference Include="RazorSlices" Version="0.11.1" />
        <PackageReference Include="MinVer" Version="7.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Help\*.md" />
        <!-- Dashboard tooltip inventory. Per feedback_no_word_lists the text lives in
             YAML, not C#. DashboardTooltipRegistry loads this at startup. -->
        <EmbeddedResource Include="Definitions\Tooltips\*.yaml" />
        <!-- UI persistence schemas. Loaded at startup via UiSchemaLoader; same
             pattern as the core lib's Data\Schema\*.sql convention. -->
        <EmbeddedResource Include="Data\Schema\*.sql" />
    </ItemGroup>

    <PropertyGroup>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Static web assets (CSS, JS) for package consumption -->
    <ItemGroup>
        <!-- Include wwwroot files as static web assets for Razor Class Library.
             EnableDefaultContentItems=false means Update has nothing to match; must use Include. -->
        <Content Include="wwwroot\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <!-- Ensure Razor views are compiled.
         TargetPath is set explicitly because when this project is loaded via a symlinked path
         (e.g. from a commercial worktree that references it through a filesystem symlink), the
         MSBuild AssignTargetPath task cannot correctly compute the relative path from the symlink
         directory to the canonical file path and falls back to a filename-only TargetPath. The
         Razor SDK source generator then uses that flat TargetPath to build the hint name for the
         generated .g.cs file, causing all _ViewImports.cshtml files to produce the same hint name
         (_ViewImports_cshtml.g.cs) and triggering a CS8785 collision. An explicit TargetPath
         forces the correct relative path regardless of how the project is loaded.
         The "Views\" prefix is prepended explicitly because %(RecursiveDir) only contains the
         sub-path relative to the glob root ("Views\"), not the root folder itself. -->
    <ItemGroup>
        <Content Include="$(MSBuildProjectDirectory)\Views\**\*.cshtml">
            <TargetPath>Views\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        </Content>
    </ItemGroup>

    <!-- Notifications: include as Content so the Razor SDK compiles them; RazorSlices source-generator emits the proxy types.
         TargetPath must include the full path from the project root so the source generator derives
         the correct namespace (Notifications.Slices.*).  %(RecursiveDir) only gives the sub-path
         relative to the glob root ("Notifications\"), so we prepend "Notifications\" explicitly.
         Item identity is set to an absolute symlink-based path ($(MSBuildProjectDirectory)) to
         ensure the editorconfig section header and AdditionalText.Path both use the same path
         (symlink path), which allows the RazorSlices source generator to match GenerateRazorSlice
         metadata to the correct files when the project is loaded via a symlink. -->
    <ItemGroup>
        <UpToDateCheckInput Include="Notifications\**\*.cshtml" />
        <Content Include="$(MSBuildProjectDirectory)\Notifications\**\*.cshtml">
            <TargetPath>Notifications\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
        </Content>
    </ItemGroup>

    <!-- Package icon -->
    <ItemGroup>
        <None Include=".\icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
    </ItemGroup>

    <!-- Expose internals to the test project -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Mostlylucid.BotDetection.Test</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Mostlylucid.BotDetection.Benchmarks</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Exclude examples from compilation -->
    <ItemGroup>
        <Compile Remove="Examples\**\*.cs" />
        <None Include="Examples\**\*.cs" />
    </ItemGroup>


    <!-- Resolve the canonical (symlink-dereferenced) project directory so the RazorSlices
         source generator can compute correct relative paths for proxy-type namespaces.
         MSBuildProjectDirectory stays as the symlink path when the project is loaded via a
         symlink, but %(FullPath) on an item resolves through symlinks to the canonical path.
         We patch the generated editorconfig AFTER it is written to append a second
         build_property.MSBuildProjectDirectory entry with the canonical path.
         The Roslyn editorconfig parser uses last-write-wins for duplicate global properties. -->
    <ItemGroup>
        <_CsProjMarker Include="$(MSBuildProjectFullPath)" />
    </ItemGroup>
    <Target Name="_PatchEditorConfigProjectDir" AfterTargets="GenerateMSBuildEditorConfigFile">
        <PropertyGroup>
            <_CanonicalProjectDir>$([System.IO.Path]::GetDirectoryName(%(_CsProjMarker.FullPath)))</_CanonicalProjectDir>
        </PropertyGroup>
        <WriteLinesToFile File="$(GeneratedMSBuildEditorConfigFile)" Lines="build_property.MSBuildProjectDirectory = $(_CanonicalProjectDir)" Overwrite="false" Condition="'$(_CanonicalProjectDir)' != '' AND '$(_CanonicalProjectDir)' != '$(MSBuildProjectDirectory)'" />
        <Message Text="Patching editorconfig MSBuildProjectDirectory: $(MSBuildProjectDirectory) -&gt; $(_CanonicalProjectDir)" Importance="High" Condition="'$(_CanonicalProjectDir)' != '' AND '$(_CanonicalProjectDir)' != '$(MSBuildProjectDirectory)'" />
    </Target>

    <!-- Tailwind CSS build: compile on dotnet build if node_modules exists -->
    <Target Name="BuildTailwindCSS" BeforeTargets="Build" Condition="Exists('node_modules')">
        <Exec Command="npx @tailwindcss/cli -i ./wwwroot/css/tailwind-input.css -o ./wwwroot/vendor/css/tailwind.min.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>

    <!-- Exclude node_modules and package-lock from packaging -->
    <ItemGroup>
        <Content Remove="node_modules\**" />
        <None Remove="node_modules\**" />
    </ItemGroup>


</Project>
