<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>

        <!-- Package metadata -->
        <PackageId>Mostlylucid.BotDetection.PrometheusPack</PackageId>
        <MinVerTagPrefix>botdetection-prometheuspack-v</MinVerTagPrefix>
        <Authors>Mostlylucid</Authors>
        <Description>Meter ingest + summary surface for the Stylobot FOSS dashboard. Ships IMeterStream + LocalMeterStream (MeterListener) + RemoteMeterStream (Prometheus text scrape) + the shared LFU MeterSummaryAtom storage, plus the dashboard's meter-health tile (IPackHealthSummaryProvider seam). Read-only data plane; signal-emission hook for blackboard adapters. No write surfaces. Optional add-on pack -- the dashboard UI does not depend on it.</Description>
        <PackageTags>bot-detection;metrics;prometheus;telemetry;observability;dashboard</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="MeterCatalogs\*.yaml" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mostlylucid.BotDetection\Mostlylucid.BotDetection.csproj" />
        <!-- The pack OWNS its dashboard widget surface (meter-health tile +
             freshness contributor): it plugs into the UI's IPackHealthSummaryProvider
             and DashboardFreshnessBeacon seams. UI does NOT reference this pack.
             Prometheus is an optional add-on, not a hard dependency. -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.UI\Mostlylucid.BotDetection.UI.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Expose internals to the test project -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Mostlylucid.BotDetection.Test</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>