{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "Mostlylucid.BotDetection": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp.ReverseProxy": "Information",
        "Mostlylucid.BotDetection": "Information"
      }
    }
  },
  "Gateway": {
    "HttpPort": 8080,
    "AdminBasePath": "/admin",
    "LogLevel": "Information"
  },
  "StyloBot": {
    "Dashboard": {
      "Admin": {
        "_doc": "POST /stylobot/admin/reload and /stylobot/admin/restart for operator config workflows. Off by default. To enable: set Enabled=true and Token to a long random string (or use env vars STYLOBOT_ADMIN_ENABLED=true and STYLOBOT_ADMIN_TOKEN=<secret>). Callers must send Authorization: Bearer <token>; rejected requests are logged with the source IP. See docs/admin-endpoints.md.",
        "Enabled": false,
        "Token": "",
        "BasePath": "/stylobot/admin"
      }
    }
  },
  "Database": {
    "Provider": "None"
  },
  "BotDetection": {
    "VerifiedCrawlerFastPath": {
      "MarketingHosts": [],
      "ExcludedPathPrefixes": ["/admin", "/api", "/dashboard", "/account"]
    },
    "BotThreshold": 0.7,
    "BlockDetectedBots": false,
    "DefaultActionPolicyName": "throttle-stealth",
    "EnableUserAgentDetection": true,
    "EnableHeaderAnalysis": true,
    "EnableIpDetection": true,
    "EnableBehavioralAnalysis": true,
    "LogDetailedReasons": true,
    "LogAllRequests": true,

    "AiDetection": {
      "Provider": "Heuristic",
      "TimeoutMs": 2000,
      "Heuristic": {
        "Enabled": true,
        "LoadLearnedWeights": true,
        "EnableWeightLearning": true
      }
    },

    "ResponseHeaders": {
      "Enabled": true,
      "HeaderPrefix": "X-Bot-",
      "IncludePolicyName": true,
      "IncludeConfidence": true,
      "IncludeDetectors": false,
      "IncludeProcessingTime": true,
      "IncludeBotName": true
    },

    "SecurityTools": {
      "Enabled": true,
      "BlockSecurityTools": true,
      "LogDetections": true
    },

    "Policies": {
      "default": {
        "Description": "Gateway default - full detection surface. Mirrors DetectionPolicy.Default code static; new detectors must be added here AND there. See DetectorRegistrationCoverageTests for the lock.",
        "FastPath": [
          "FastPathReputation", "UserAgent", "Header", "Ip", "SecurityTool",
          "Behavioral", "AdvancedBehavioral", "ClientSide", "CacheBehavior",
          "Inconsistency", "VersionAge", "Heuristic", "HeuristicLate", "ReputationBias",
          "Geo", "GeoClient",
          "HoneypotLink", "ThreatIntel",
          "VerifiedBotInline",
          "AiScraper", "Haxxor", "FediverseDomain",
          "TlsFingerprint", "TcpIpFingerprint", "Http2Fingerprint", "Http3Fingerprint",
          "MultiLayerCorrelation",
          "BehavioralWaveform", "SessionVector", "Periodicity", "ReactivePattern",
          "ClaimedIdentity",
          "TransportProtocol", "Intent", "StreamAbuse",
          "CveProbe", "HeaderCorrelation", "EndpointHistory",
          "ChallengeVerification", "FingerprintApproval"
        ],
        "SlowPath": [],
        "AiPath": [],
        "UseFastPath": true,
        "EscalateToAi": false,
        "EarlyExitThreshold": 0.85,
        "ImmediateBlockThreshold": 0.95
      },
      "demo": {
        "Description": "DEMO MODE - All fast detectors + advanced fingerprinting + heuristic learning",
        "FastPath": [
          "FastPathReputation",
          "HoneypotLink",
          "UserAgent",
          "Header",
          "Ip",
          "SecurityTool",
          "ProjectHoneypot",
          "CacheBehavior",
          "Behavioral",
          "AdvancedBehavioral",
          "ClientSide",
          "ResponseBehavior",
          "Inconsistency",
          "VersionAge",
          "ReputationBias",
          "Heuristic",
          "TlsFingerprint",
          "TcpIpFingerprint",
          "Http2Fingerprint",
          "MultiLayerCorrelation",
          "BehavioralWaveform",
          "Periodicity",
          "SessionVector",
          "ReactivePattern",
          "ClaimedIdentity"
        ],
        "SlowPath": [],
        "AiPath": [],
        "UseFastPath": true,
        "EscalateToAi": false,
        "BypassTriggerConditions": true,
        "Tags": ["demo", "all-detectors", "learning-enabled", "full-fingerprinting"]
      }
    },
    "PathPolicies": {
      "/*": "default"
    },

    "BotTypeActionPolicies": {
      "MaliciousBot":   "block-hard",
      "ExploitScanner": "block-hard",
      "ClickFraud":     "block-hard",
      "Tool":           "throttle-tools",
      "Scraper":        "throttle-aggressive",
      "AiBot":          "rate-limit-ai",
      "SearchEngine":   "rate-limit-search",
      "GoodBot":        "rate-limit-search",
      "VerifiedBot":    "rate-limit-search",
      "SocialMediaBot": "rate-limit-social",
      "MonitoringBot":  "rate-limit-monitoring"
    },

    "DetectionPolicies": {
      "Enabled": true,
      "Rules": [
        {
          "Name": "BlockConfirmedMalicious",
          "Types": ["MaliciousBot", "ExploitScanner", "ClickFraud"],
          "Action": "block-hard",
          "Reason": "Confirmed-bad actor: reputation latch, honeypot hit, hostile cluster, or known exploit scanner. Surfaces from SignatureRiskVerdictComposer.HostilePinFired (FOSS) via the AggregatedEvidence override added in DetectionLedgerExtensions."
        },
        {
          "Name": "BlockCriticalThreat",
          "Threats": ["Critical"],
          "Action": "block-hard",
          "Reason": "Threat band hit Critical via raw threat score or hostile-pin. Catches HostilePinFired sigs whose BotType isn't explicitly in the malicious set above."
        },
        {
          "Name": "ai-bot-docs-markdown",
          "Path": "/docs/*",
          "Types": ["AiBot"],
          "Confidence": ">= 0.85",
          "Action": "extract-markdown",
          "Reason": "AI scrapers (GPTBot et al, BotType=AiBot) hitting /docs paths get clean Markdown; saves them parsing chrome."
        },
        {
          "Name": "search-engine-docs-cache",
          "Path": "/docs/*",
          "Types": ["SearchEngine"],
          "Action": "content-cache",
          "Reason": "Search crawlers may be served a bounded, ephemeral HTML cache hit during repeat crawls; a miss forwards upstream and refreshes the local entry."
        },
        {
          "Name": "social-docs-headers",
          "Path": "/docs/*",
          "Types": ["SocialMediaBot"],
          "Action": "extract-headers",
          "Reason": "Social-preview crawlers keep the HTML but get extraction metadata headers."
        }
      ]
    }
  },

  "StyloExtract": {
    "DefaultProfile": "RagFull",
    "Actions": {
      "content-cache": {
        "TransformedContentCache": {
          "Enabled": true,
          "MaxEntries": 128,
          "MaxEntryBytes": 262144,
          "MaxTotalBytes": 33554432,
          "SlidingExpiration": "00:02:00",
          "AbsoluteExpiration": "00:15:00",
          "VersionSalt": "gateway-content-v1",
          "AllowedQueryKeys": []
        }
      },
      "extract-markdown": {
        "Profile": "RagFull",
        "EnableQueryOverride": true,
        "QueryParamName": "markdown",
        "QueryParamValue": "true",
        "TransformedContentCache": {
          "Enabled": true,
          "MaxEntries": 128,
          "MaxEntryBytes": 262144,
          "MaxTotalBytes": 33554432,
          "SlidingExpiration": "00:02:00",
          "AbsoluteExpiration": "00:15:00",
          "VersionSalt": "gateway-markdown-v1",
          "AllowedQueryKeys": ["page", "q"]
        },
        "Cache": {
          "Mode": "Override",
          "MaxAge": 3600,
          "Public": true,
          "VaryByBotType": true
        }
      },
      "extract-headers": {
        "Cache": {
          "Mode": "Add",
          "VaryByBotType": true
        }
      }
    }
  }
}
