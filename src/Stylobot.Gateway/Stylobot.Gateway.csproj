<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <AssemblyName>Stylobot.Gateway</AssemblyName>
        <RootNamespace>Stylobot.Gateway</RootNamespace>
        <ContainerRepository>scottgal/stylobot-gateway</ContainerRepository>
        <ContainerImageTag>latest</ContainerImageTag>
        <ContainerUser>root</ContainerUser>

        <!-- Size optimization -->
        <SelfContained>false</SelfContained>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishTrimmed>false</PublishTrimmed>

        <!-- Reduce output size -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>

        <!-- Disable trim warnings (not using trimming) -->
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>

        <!-- Runtime identifiers for multi-arch Docker builds -->
        <RuntimeIdentifiers>linux-x64;linux-musl-x64;linux-arm64;linux-musl-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <!-- Bot Detection -->
        <ProjectReference Include="..\Mostlylucid.BotDetection\Mostlylucid.BotDetection.csproj" />
        <!-- Control-plane API surface (/api/v1/*) consumed by remote-mode dashboards. -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.Api\Mostlylucid.BotDetection.Api.csproj" />
        <!-- LLM plugin: in-process CPU LlamaSharp provider -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.Llm.LlamaSharp\Mostlylucid.BotDetection.Llm.LlamaSharp.csproj" />
        <!-- LLM plugin: HTTP Ollama provider (selected via BotDetection:AiDetection:Provider=ollama) -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.Llm.Ollama\Mostlylucid.BotDetection.Llm.Ollama.csproj" />
        <!-- Dashboard persistence (event store, SignalR broadcast, visitor cache) -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.UI\Mostlylucid.BotDetection.UI.csproj" />
        <!-- Geo Detection for country code enrichment -->
        <ProjectReference Include="..\Mostlylucid.GeoDetection\Mostlylucid.GeoDetection.csproj" />
        <ProjectReference Include="..\Mostlylucid.GeoDetection.Contributor\Mostlylucid.GeoDetection.Contributor.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Gateway-local persistence schemas (profile calibration store).
             Loaded at startup via GatewaySchemaLoader. -->
        <EmbeddedResource Include="Data\Schema\*.sql" />
    </ItemGroup>

    <ItemGroup>
        <!-- YARP Reverse Proxy -->
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />

        <!-- Automatic HTTPS via Let's Encrypt (ACME) — used when GATEWAY_HTTPS_DOMAIN is set -->
        <PackageReference Include="LettuceEncrypt" Version="1.3.3" />

        <!-- EF Core base only. Postgres / SqlServer / MySql etc. providers are added
             by commercial add-on packs via IBotDetectionExtension; not shipped in
             FOSS Gateway. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />

        <!-- Logging -->
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />

        <!-- OpenAPI -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />

        <!-- OpenTelemetry -->
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.11.0-beta.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    </ItemGroup>

</Project>
