{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "Mostlylucid.BotDetection": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp.ReverseProxy": "Information",
        "Mostlylucid.BotDetection": "Information"
      }
    }
  },
  "Gateway": {
    "HttpPort": 8080,
    "AdminBasePath": "/admin",
    "LogLevel": "Information"
  },
  "StyloBot": {
    "Dashboard": {
      "Admin": {
        "_doc": "POST /stylobot/admin/reload and /stylobot/admin/restart for operator config workflows. Off by default. To enable: set Enabled=true and Token to a long random string (or use env vars STYLOBOT_ADMIN_ENABLED=true and STYLOBOT_ADMIN_TOKEN=<secret>). Callers must send Authorization: Bearer <token>; rejected requests are logged with the source IP. See docs/admin-endpoints.md.",
        "Enabled": false,
        "Token": "",
        "BasePath": "/stylobot/admin"
      }
    }
  },
  "Database": {
    "Provider": "None"
  },
  "BotDetection": {
    "BotThreshold": 0.7,
    "BlockDetectedBots": false,
    "EnableUserAgentDetection": true,
    "EnableHeaderAnalysis": true,
    "EnableIpDetection": true,
    "EnableBehavioralAnalysis": true,
    "LogDetailedReasons": true,
    "LogAllRequests": true,

    "AiDetection": {
      "Provider": "Heuristic",
      "TimeoutMs": 2000,
      "Heuristic": {
        "Enabled": true,
        "LoadLearnedWeights": true,
        "EnableWeightLearning": true
      }
    },

    "ResponseHeaders": {
      "Enabled": true,
      "HeaderPrefix": "X-Bot-",
      "IncludePolicyName": true,
      "IncludeConfidence": true,
      "IncludeDetectors": false,
      "IncludeProcessingTime": true,
      "IncludeBotName": true
    },

    "SecurityTools": {
      "Enabled": true,
      "BlockSecurityTools": true,
      "LogDetections": true
    },

    "Policies": {
      "default": {
        "Description": "Gateway default - fast detection with heuristic",
        "FastPath": ["FastPathReputation", "VerifiedBotInline", "UserAgent", "Header", "Ip", "SecurityTool", "Behavioral", "Inconsistency", "VersionAge", "ReputationBias", "Heuristic"],
        "SlowPath": [],
        "AiPath": [],
        "UseFastPath": true,
        "EscalateToAi": false,
        "EarlyExitThreshold": 0.85,
        "ImmediateBlockThreshold": 0.95
      }
    },

    "BotTypeActionPolicies": {
      "MaliciousBot":   "block-hard",
      "ExploitScanner": "block-hard",
      "ClickFraud":     "block-hard",
      "Tool":           "throttle-tools",
      "Scraper":        "throttle-aggressive",
      "AiBot":          "rate-limit-ai",
      "SearchEngine":   "rate-limit-search",
      "GoodBot":        "rate-limit-search",
      "VerifiedBot":    "rate-limit-search",
      "SocialMediaBot": "rate-limit-social",
      "MonitoringBot":  "rate-limit-monitoring"
    },

    "DetectionPolicies": {
      "Enabled": true,
      "Rules": [
        {
          "Name": "BlockConfirmedMalicious",
          "Types": ["MaliciousBot", "ExploitScanner", "ClickFraud"],
          "Action": "block-hard"
        },
        {
          "Name": "BlockCriticalThreat",
          "Threats": ["Critical"],
          "Action": "block-hard"
        },
        {
          "Name": "ai-scraper-docs-markdown",
          "Path": "/docs/*",
          "Types": ["AiScraper"],
          "Confidence": ">= 0.85",
          "Action": "extract-markdown",
          "Reason": "AI scrapers hitting /docs paths get clean Markdown; saves them parsing chrome."
        },
        {
          "Name": "search-engine-docs-headers",
          "Path": "/docs/*",
          "Types": ["SearchEngine", "SocialMediaBot"],
          "Action": "extract-headers",
          "Reason": "SEO and social-preview crawlers keep the HTML but get extraction metadata headers."
        }
      ]
    }
  },

  "StyloExtract": {
    "DefaultProfile": "RagFull",
    "Actions": {
      "extract-markdown": {
        "Profile": "RagFull",
        "Cache": {
          "Mode": "Override",
          "MaxAge": 3600,
          "Public": true,
          "VaryByBotType": true
        }
      },
      "extract-headers": {
        "Cache": {
          "Mode": "Add",
          "VaryByBotType": true
        }
      }
    }
  }
}
