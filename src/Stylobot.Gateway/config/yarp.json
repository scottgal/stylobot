{
  "ReverseProxy": {
    "Routes": {
      "wordpress": {
        "ClusterId": "wordpress",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "wordpress": {
        "Destinations": {
          "wp1": {
            "Address": "http://localhost:8081"
          }
        }
      }
    }
  }
}
