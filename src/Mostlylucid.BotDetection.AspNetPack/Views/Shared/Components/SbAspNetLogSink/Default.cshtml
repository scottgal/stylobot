@model Mostlylucid.BotDetection.AspNetPack.Ui.LogSinkViewModel
@using Mostlylucid.BotDetection.UI.Models
@functions {
    static HealthBand BandForQueueDepth(long depth, int batchSize)
    {
        if (batchSize <= 0) return HealthBand.Neutral;
        var capacity = (double)batchSize * 10d;
        var ratio = depth / capacity;
        if (ratio > 1.0d) return HealthBand.Danger;
        if (ratio > 0.9d) return HealthBand.Warning;
        if (ratio > 0.5d) return HealthBand.Caution;
        return HealthBand.Good;
    }

    static HealthBand BandForGatewayAge(TimeSpan age)
    {
        if (age == TimeSpan.Zero) return HealthBand.Good;
        if (age < TimeSpan.FromMinutes(5)) return HealthBand.Caution;
        if (age < TimeSpan.FromHours(1))   return HealthBand.Warning;
        return HealthBand.Danger;
    }
}
<section class="sb-aspnet-log-sink sb-aspnet-pack__detail space-y-4">
    @if (!Model.LicensedAndEnabled)
    {
        <div class="card bg-base-100 shadow-sm rounded-xl border border-base-300">
            <div class="card-body p-6 text-center">
                <i class="bx bx-plug text-2xl block mb-2 text-base-content/30"></i>
                <h3 class="card-title text-base justify-center">Log sink not configured</h3>
                <p class="text-sm text-base-content/70 mt-1">
                    Register <code class="px-1 py-0.5 rounded bg-base-200 text-xs">StyloBotGatewayLoggerProvider</code>
                    to enable log forwarding.
                </p>
            </div>
        </div>
    }
    else
    {
        var gatewayValue = Model.GatewayUnreachableAge == TimeSpan.Zero
            ? "reachable"
            : Mostlylucid.BotDetection.AspNetPack.Ui.AspNetPackUiFormatting.FormatTimeSpan(Model.GatewayUnreachableAge);

        var tiles = new List<StatTileViewModel>
        {
            new(
                Title: "Queue depth",
                Value: Model.QueueDepth.ToString("N0"),
                Unit: "records",
                HealthBand: BandForQueueDepth(Model.QueueDepth, Model.BatchSize)),
            new(
                Title: "Batch size",
                Value: Model.BatchSize.ToString("N0"),
                Unit: "records",
                HealthBand: HealthBand.Neutral),
            new(
                Title: "Flush tick",
                Value: string.IsNullOrEmpty(Model.FlushTick) ? "-" : Model.FlushTick,
                HealthBand: HealthBand.Neutral),
            new(
                Title: "Gateway",
                Value: gatewayValue,
                Delta: Model.GatewayUnreachableAge == TimeSpan.Zero ? null : "unreachable for",
                HealthBand: BandForGatewayAge(Model.GatewayUnreachableAge))
        };

        <div class="sb-aspnet-pack__headline-strip grid gap-3"
             style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
            @foreach (var tile in tiles)
            {
                <div class="sb-aspnet-pack__headline-cell">
                    @await Component.InvokeAsync("SbStatTile", new { model = tile })
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.GatewayEndpoint))
        {
            <div class="card bg-base-100 shadow-sm rounded-xl border border-base-300">
                <div class="card-body p-3 md:p-4">
                    <div class="flex items-center gap-2">
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-base-content/60">Gateway endpoint</span>
                        <code class="text-xs px-1.5 py-0.5 rounded bg-base-200 sb-aspnet-pack__code-chip">@Model.GatewayEndpoint</code>
                    </div>
                </div>
            </div>
        }

        @* Recent log entries panel. The rows here come from the gateway's
           FingerprintTimelineAtom (per-fingerprint LFU sliding cache that already
           indexes every span/log/metric the gateway receives) -- we deliberately
           read from that cache instead of holding a parallel ring. The Priority
           column shows the fingerprint's LFU hit-count so the operator can see
           WHY a row floated up: "this fp has 1,247 cached observations, here are
           its last log lines." Bodies are PII-scrubbed at the provider boundary. *@
        <div class="card bg-base-100 shadow-sm rounded-xl border border-base-300">
            <div class="card-body p-3 md:p-4">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="card-title text-base">Recent log lines</h3>
                    <span class="text-[11px] text-base-content/50">
                        from per-fingerprint LFU cache · PII scrubbed
                    </span>
                </div>
                @if (Model.RecentEntries.Count == 0)
                {
                    <div class="text-sm text-base-content/60 py-3">
                        No log lines in the gateway's LFU cache yet. They'll start
                        appearing as soon as the ASP.NET pack drains a batch.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="table table-zebra table-sm sb-aspnet-pack__row-table">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Level</th>
                                    <th>Category</th>
                                    <th>Body</th>
                                    <th class="text-right sb-aspnet-pack__num"
                                        title="LFU hit-count for this entry's fingerprint -- higher = more cached observations">
                                        Priority
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in Model.RecentEntries)
                                {
                                    var levelClass = entry.Level switch
                                    {
                                        Microsoft.Extensions.Logging.LogLevel.Critical or
                                            Microsoft.Extensions.Logging.LogLevel.Error => "badge-error",
                                        Microsoft.Extensions.Logging.LogLevel.Warning   => "badge-warning",
                                        Microsoft.Extensions.Logging.LogLevel.Information => "badge-info",
                                        _ => "badge-ghost"
                                    };
                                    <tr>
                                        <td class="text-xs text-base-content/70 whitespace-nowrap font-mono">
                                            @entry.TimestampUtc.ToString("HH:mm:ss.fff")
                                        </td>
                                        <td>
                                            <span class="badge badge-sm @levelClass">@entry.Level</span>
                                        </td>
                                        <td class="text-xs text-base-content/80 font-mono whitespace-nowrap">
                                            @entry.Category
                                        </td>
                                        <td class="text-xs">
                                            <div class="truncate max-w-[40ch] md:max-w-[60ch]"
                                                 title="@entry.ScrubbedBody">@entry.ScrubbedBody</div>
                                            @if (!string.IsNullOrEmpty(entry.FingerprintId))
                                            {
                                                <div class="text-[10px] text-base-content/40 font-mono mt-0.5">
                                                    fp: @entry.FingerprintId
                                                </div>
                                            }
                                        </td>
                                        <td class="text-right font-mono sb-aspnet-pack__num text-xs">
                                            @entry.FingerprintPriority.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</section>
