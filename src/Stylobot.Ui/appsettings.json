{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StyloBot": {
    "Dashboard": {
      "Enabled": true,
      "BasePath": "/stylobot",
      "AllowUnauthenticatedAccess": false,
      "MonitoringPack": {
        "Enabled": false
      }
    },
    "Api": {
      "EnableOpenApi": false,
      "InjectResponseHeaders": true
    }
  },
  "BotDetection": {
    "Identity": {
      "Enabled": true
    }
  }
}
