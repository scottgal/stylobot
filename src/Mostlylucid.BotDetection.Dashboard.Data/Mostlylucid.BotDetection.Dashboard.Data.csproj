<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Mostlylucid.BotDetection.Dashboard.Data</PackageId>
    <RootNamespace>Mostlylucid.BotDetection.UI</RootNamespace>
    <Description>StyloBot dashboard persistence, read models, query services and invalidation contracts.</Description>
    <MinVerTagPrefix>allbot-v</MinVerTagPrefix>
    <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Mostlylucid.BotDetection/Mostlylucid.BotDetection.csproj" />
    <ProjectReference Include="../Mostlylucid.BotDetection.Dashboard.Contracts/Mostlylucid.BotDetection.Dashboard.Contracts.csproj" />
    <ProjectReference Include="../Mostlylucid.BotDetection.OpenApi/Mostlylucid.BotDetection.OpenApi.csproj" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    <EmbeddedResource Include="Data/Schema/*.sql" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>Mostlylucid.BotDetection.UI</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>Mostlylucid.BotDetection.Test</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>Mostlylucid.BotDetection.Benchmarks</_Parameter1></AssemblyAttribute>
  </ItemGroup>
</Project>
