{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Mostlylucid.BotDetection": "Warning",
      "Mostlylucid.BotDetection.Observability": "Information",
      "Mostlylucid.BotDetection.Observability.Events.SerilogDetectionEventPublisher": "Information",
      "Mostlylucid.BotDetection.Observability.Signals.StyloBotSignalCategory": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": false,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "BotDetection": {
    "MaxRequestsPerMinute": 10000,
    "AiDetection": {
      "LlamaSharp": {
        "ModelPath": "bartowski/gemma-4-1b-it-GGUF/gemma-4-1b-it-Q4_K_M.gguf",
        "ModelCacheDir": "~/.cache/stylobot-models",
        "ContextSize": 512,
        "GpuLayerCount": -1,
        "ThreadCount": 8,
        "Temperature": 0.1,
        "MaxTokens": 150,
        "TimeoutMs": 5000
      }
    },
    "Observability": {
      "PublishDetectionEventsToSerilog": true,
      "SignalLog": {
        "Enabled": true,
        "IncludePrefixes": [],
        "ExcludePrefixes": [ "trace.", "debug." ]
      },
      "OpenTelemetry": {
        "EnableTracing": false,
        "EnableMetrics": false,
        "EnableLogs": false,
        "OtlpEndpoint": null,
        "ServiceName": "stylobot-demo"
      }
    }
  }
}
