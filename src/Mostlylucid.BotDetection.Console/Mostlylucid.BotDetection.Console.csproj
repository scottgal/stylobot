<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Native AOT -->
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Single File -->
        <PublishSingleFile>true</PublishSingleFile>
        <StripSymbols>true</StripSymbols>

        <!-- Optimization -->
        <OptimizationPreference>Speed</OptimizationPreference>
        <IlcOptimizationPreference>Speed</IlcOptimizationPreference>

        <!-- Version -->
        <Version>1.0.0</Version>
        <AssemblyName>stylobot</AssemblyName>


        <!-- RIDs we support -->
        <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

        <!-- Disable default wwwroot inclusion so we can control it explicitly -->
        <EnableDefaultContentItems>false</EnableDefaultContentItems>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
<PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
        <PackageReference Include="XenoAtom.Terminal.UI" Version="3.2.2" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.6" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.6" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.11.2" />
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.11.0-beta.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.11.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mostlylucid.BotDetection\Mostlylucid.BotDetection.csproj" />
        <!-- Api is referenced even though the gateway only opts in via the
             enable-api flag; the reference is conditional-by-runtime, not
             conditional-by-build, so this always pulls in the API surface. Same
             transitive UI dependency the AOT Sidecar already ships, so this
             doesn't break the AOT publish. -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.Api\Mostlylucid.BotDetection.Api.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.Llm.Ollama\Mostlylucid.BotDetection.Llm.Ollama.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.Llm.Cloud\Mostlylucid.BotDetection.Llm.Cloud.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.Llm.LlamaSharp\Mostlylucid.BotDetection.Llm.LlamaSharp.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.Llm.Tunnel\Mostlylucid.BotDetection.Llm.Tunnel.csproj" />
    </ItemGroup>

    <!-- Preserve reflection metadata for assemblies that use reflection-based YAML deserialization -->
    <ItemGroup>
        <TrimmerRootAssembly Include="Mostlylucid.BotDetection" />
        <TrimmerRootAssembly Include="YamlDotNet" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <EmbeddedResource Include="wwwroot\**\*">
            <LogicalName>wwwroot.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!--
        Strip foreign-RID native libraries from the publish directory.
        LLamaSharp.Backend.Cpu ships libllama for every platform + every CPU
        instruction-set variant; under dotnet publish (RID) only the matching
        one is ever loaded, but the rest sit on disk (~90MB of dead weight on
        osx-arm64). dotnet publish does not prune them by default for this
        package, so we do it ourselves below.
    -->
    <Target Name="PruneForeignRuntimeNatives" AfterTargets="Publish"
            Condition="'$(RuntimeIdentifier)' != ''">
        <ItemGroup>
            <_ForeignRids Include="win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64"
                          Exclude="$(RuntimeIdentifier)" />
            <_ForeignNatives Include="$(PublishDir)runtimes/%(_ForeignRids.Identity)/**/*" />
        </ItemGroup>
        <Delete Files="@(_ForeignNatives)" />
        <RemoveDir Directories="$(PublishDir)runtimes/%(_ForeignRids.Identity)" />
        <Message Importance="high"
                 Text="Pruned foreign-RID natives for $(RuntimeIdentifier); kept runtimes/$(RuntimeIdentifier)/ only" />
    </Target>

</Project>
