<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>mostlylucid.stylowall.optimization</PackageId>
        <PackageTags>stylowall;optimization;html-to-markdown;anglesharp;aspnetcore;middleware</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>
            StyloWall Optimization pack: response transforms for the StyloWall semantic
            firewall. Includes HTML to Markdown conversion (AngleSharp-based emitter) for
            bandwidth-efficient delivery to AI scrapers and llms.txt-style consumers.
            More transforms (image rewriting, HTML minification) to follow.
        </Description>
        <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/ReleaseNotes.txt"))</PackageReleaseNotes>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsTrimmable>false</IsTrimmable>
    </PropertyGroup>

    <PropertyGroup>
        <MinVerTagPrefix>stylowall.optimization-v</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mostlylucid.StyloWall\Mostlylucid.StyloWall.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" Version="1.4.0" />
        <PackageReference Include="MinVer" Version="7.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="ReleaseNotes.txt" />
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>

</Project>
