<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- Mocking. NSubstitute removed 2026-08-09: no test in this project used it
             (Moq is the mocking library here). Its removal also retires the pending
             NSubstitute 5.x -> 6.x major upgrade for this project. -->
        <PackageReference Include="Moq" Version="4.20.72" />

        <!-- Verify for snapshot testing -->
        <PackageReference Include="Verify.Xunit" Version="31.12.5" />

        <!-- ASP.NET Core test infrastructure (kept for non-Puppeteer integration tests) -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />

        <!-- Extensions -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.8.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />

        <!-- Browser automation for integration testing.
             Playwright .NET (Microsoft.Playwright) replaces PuppeteerSharp.
             Playwright is the actively-developed Microsoft fork; supports Chromium /
             Firefox / WebKit in one harness, ships its own driver+browsers via the
             `playwright install` CLI run by the InstallChromiumIfNeeded helper in
             DemoAppFactory. -->
        <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />

        <PackageReference Include="Xunit.Extensions.Logging" Version="1.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mostlylucid.BotDetection\Mostlylucid.BotDetection.csproj" />
        <!-- Build-only reference. DemoAppFactory launches the Demo app as a real
             subprocess with "dotnet run" plus the no-build flag, so the Demo binary
             must already exist when the suite runs. Nothing built it: the Demo was not
             referenced here, so "dotnet test" never produced it, and every BDF and
             dashboard test needing a live host failed with "Demo app exited with code
             1". The underlying cause was visible only in the subprocess log at
             /tmp/demo-app-PORT.log.err: "No such file or directory" on the Demo binary.
             That hid the rig's real results from allbot-v8.7.0 onward; 43 of 45
             orchestration failures were this one missing build, not 43 defects.
             ReferenceOutputAssembly=false: MSBuild should BUILD the Demo, not link a
             web app's assembly into this test project.
             PostgreSQL persistence tests live in stylobot-commercial; the
             UI.PostgreSQL project moved out of FOSS. Npgsql package was also
             unused here, no "using Npgsql" in any source file. -->
        <ProjectReference Include="..\Mostlylucid.BotDetection.Demo\Mostlylucid.BotDetection.Demo.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- xunit.runner.json is consumed by the test host at runtime; copying to
             the output directory ensures parallelizeTestCollections=false is honoured
             by `dotnet test`. -->
        <None Update="xunit.runner.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
