{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StyloBot": {
    "Dashboard": {
      "Enabled": true,
      "BasePath": "/stylobot",
      "AllowUnauthenticatedAccess": true,
      "_AllowUnauthenticatedAccess_note": "Dev default: open dashboard. For production, set to false and configure Auth:Mode=Login with Username + PasswordHash (use 'stylobot dashboard hash-password' CLI).",
      "MonitoringPack": {
        "Enabled": true
      }
    },
    "Api": {
      "EnableOpenApi": true,
      "InjectResponseHeaders": true
    }
  },
  "BotDetection": {
    "Identity": {
      "Enabled": true
    }
  },
  "ReverseProxy": {
    "Routes": {},
    "Clusters": {}
  }
}
