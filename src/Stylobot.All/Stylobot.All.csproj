<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <AssemblyName>stylobot-all</AssemblyName>
        <RootNamespace>Stylobot.All</RootNamespace>
        <!-- Not packable. Ships as a binary / Docker image, not a NuGet. -->
        <IsPackable>false</IsPackable>
        <!-- Not AOT. Includes the dashboard pipeline (Razor, SignalR, dynamic JSON)
             which needs reflection. -->
        <PublishAot>false</PublishAot>
        <UserSecretsId>stylobot-all-c4e5a2f1-9b8d-4e3c-a7f2-1d6c4b9e3a5f</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mostlylucid.BotDetection\Mostlylucid.BotDetection.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.UI\Mostlylucid.BotDetection.UI.csproj" />
        <ProjectReference Include="..\Mostlylucid.BotDetection.Api\Mostlylucid.BotDetection.Api.csproj" />
    </ItemGroup>

</Project>
