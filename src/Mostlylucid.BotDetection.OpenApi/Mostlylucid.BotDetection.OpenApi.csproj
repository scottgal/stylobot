<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>true</IsPackable>

        <PackageId>Mostlylucid.BotDetection.OpenApi</PackageId>
        <MinVerTagPrefix>allbot-v</MinVerTagPrefix>
        <Authors>Mostlylucid</Authors>
        <Description>OpenAPI document loader for StyloBot. Reusable across the dashboard Routes tab (catalog cross-reference), the API Holodeck (auto-honeypot generation from documented endpoints), and future SDK / spec-audit tooling. Wraps Microsoft.OpenApi.Readers with caching and $ref resolution.</Description>
        <PackageTags>openapi;swagger;stylobot;bot-detection;documentation</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- XML doc file ships with the package for consumer IntelliSense. 1591 is
             suppressed: we ship docs without nagging about the public members that
             still lack comments. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- Deliberately no Microsoft.OpenApi.Readers dependency. The 1.6.x line expects the
             1.x assembly and fails with TypeLoadException at runtime; the 2.0.0-preview line
             has a moving API that conflicts with other transitive deps in this solution. We
             walk the OpenAPI document with System.Text.Json directly. This loses YAML support
             and $ref auto-resolution but gives us a reliable, AOT-friendly path that only
             requires the BCL. -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    </ItemGroup>

</Project>
